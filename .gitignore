# build output
dist/
# HeroUI Pro 完整包 vendoring（公开 registry 无 dist）
!vendor/
!vendor/**
!vendor/**/dist/
!vendor/**/dist/**

# Mermaid 构建期落盘的主题 SVG（rehype-mermaid 生成，勿入库）
public/generated/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.env.local
.env.*.local

# macOS-specific files
.DS_Store

.vercel
.edgeone

package-lock.json
bun.lockb
yarn.lock

# ide
.idea
*.iml

# official theme docs (local knowledge source; do not commit)
docs/official/

cache/
package/
.obsidian/

# vibe coding
.codex*
.claude
.mimocode
.vercel

# local agent tool state
.mimosa/

# 博文草稿箱：本地可预览，正文不入库不 push（仅保留 README 约定）
src/content/posts/_draftbox/**
!src/content/posts/_draftbox/README.md

# temp/ 项目统一临时工作区：除入口文件外全部忽略（细则见 temp/README.md）
temp/**
!temp/README.md
!temp/AGENTS.md
!temp/.gitignore
!temp/secrets/
temp/secrets/*
!temp/secrets/README.md
tmp/
__tmp__/

# calendar GIF compression backups (local only)
public/assets/images/widgets/calendar/_orig-backup/

# local agent and deployment state
.hallmark/
.wrangler/

# Cloudflare/Workers official skills：skills-lock 锁定版本，本地 npx skills 安装；
# 不 vendor 进仓（cloudflare 单包 300+ 文件）。真源区 .agents/skills/；.cursor/skills 为 junction 桥接。
.agents/skills/agents-sdk/
.agents/skills/cloudflare/
.agents/skills/cloudflare-email-service/
.agents/skills/cloudflare-one/
.agents/skills/cloudflare-one-migrations/
.agents/skills/durable-objects/
.agents/skills/sandbox-migrate-to-next/
.agents/skills/sandbox-next/
.agents/skills/sandbox-stable/
.agents/skills/turnstile-spin/
.agents/skills/web-perf/
.agents/skills/workers-best-practices/
.agents/skills/wrangler/
.cursor/skills

# MCP 本机配置：.agents/mcp.json 是唯一主配置；各工具原生配置是本机适配产物，均不入库
.agents/mcp.json
.mcp.json
.cursor/mcp.json
.vscode/mcp.json
opencode.json

# Python 脚本缓存
__pycache__/

# vault 映射 staging + local fingerprint dumps（manifest.json 入库）
.ob2blog/staging/
.ob2blog/fp-*.txt
.ob2blog/_diff.py

# xAI Grok Bot replica geometry（仅本地学习预览，禁止入库再分发）
public/vendor/grok-bot/**
!public/vendor/grok-bot/README.md

.vercel
