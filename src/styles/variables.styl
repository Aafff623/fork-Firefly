/* ===== 基础变量定义 ===== */
:root
  --radius-large: 1rem
  --content-delay: 150ms

/* ===== 主题相关变量 ===== */
/* 壳层：高级中性灰。彩仅点缀：primary / accent / 高亮 / 链接 */
:root
  --hue-indigo: unquote("calc(var(--hue) - 34)")
  --hue-violet: unquote("calc(var(--hue) + 21)")
  --hue-cool: unquote("calc(var(--hue) - 52)")
  --hue-rose: unquote("calc(var(--hue) + 42)")
  --hue-berry: unquote("calc(var(--hue) + 58)")
  /* —— 点缀色（交互 / 品牌瞬间；壳层仍中性灰）—— */
  --primary: oklch(0.54 0.255 var(--hue))
  --primary-hover: oklch(0.49 0.22 var(--hue))
  --accent-indigo: oklch(0.52 0.22 var(--hue-indigo))
  --accent-violet: oklch(0.64 0.15 var(--hue-violet))
  --accent-cool: oklch(0.55 0.18 var(--hue-cool))
  --accent-rose: oklch(0.62 0.18 var(--hue-rose))
  --accent-berry: oklch(0.58 0.19 var(--hue-berry))
  --primary-gradient: unquote("linear-gradient(135deg, oklch(0.50 0.22 var(--hue-indigo)) 0%, oklch(0.54 0.255 var(--hue)) 48%, oklch(0.64 0.15 var(--hue-violet)) 100%)")
  --grad-rose: unquote("linear-gradient(135deg, oklch(0.54 0.22 var(--hue)) 0%, oklch(0.62 0.18 var(--hue-rose)) 55%, oklch(0.66 0.16 var(--hue-berry)) 100%)")
  --grad-berry: unquote("linear-gradient(120deg, oklch(0.60 0.16 var(--hue-violet)) 0%, oklch(0.58 0.19 var(--hue-berry)) 100%)")
  --grad-aurora: unquote("linear-gradient(135deg, oklch(0.52 0.20 var(--hue-indigo)) 0%, oklch(0.54 0.24 var(--hue)) 40%, oklch(0.62 0.17 var(--hue-rose)) 100%)")
  --hl-indigo: unquote("linear-gradient(to right, oklch(0.88 0.10 var(--hue-indigo) / 0.78), oklch(0.93 0.06 var(--hue-indigo) / 0.55))")
  --hl-primary: unquote("linear-gradient(to right, oklch(0.88 0.11 var(--hue) / 0.80), oklch(0.94 0.06 var(--hue) / 0.55))")
  --hl-violet: unquote("linear-gradient(to right, oklch(0.90 0.09 var(--hue-violet) / 0.75), oklch(0.95 0.05 var(--hue-violet) / 0.50))")
  --hl-cool: unquote("linear-gradient(to right, oklch(0.88 0.09 var(--hue-cool) / 0.72), oklch(0.94 0.05 var(--hue-cool) / 0.50))")
  --hl-rose: unquote("linear-gradient(to right, oklch(0.90 0.10 var(--hue-rose) / 0.72), oklch(0.95 0.06 var(--hue-berry) / 0.48))")
  /* —— 壳层中性灰（chroma ≈ 0，不跟主题紫走）—— */
  --page-bg: oklch(0.97 0.003 260)
  --theme-mesh: unquote("radial-gradient(ellipse 60% 40% at 10% 0%, oklch(0.60 0.12 var(--hue) / 0.04), transparent 55%), radial-gradient(ellipse 50% 35% at 90% 10%, oklch(0.62 0.10 var(--hue-indigo) / 0.03), transparent 50%)")
  --wallpaper-fade: unquote("linear-gradient(to bottom, transparent 0%, oklch(0.97 0.003 260 / 0.55) 55%, var(--page-bg) 100%)")
  --card-bg: white
  --card-bg-transparent: unquote("rgb(255 255 255 / var(--card-transparent-opacity, 0.6))")
  
  --btn-content: oklch(0.42 0.01 260)
  --btn-regular-bg: oklch(0.96 0.004 260)
  --btn-regular-bg-hover: oklch(0.93 0.006 260)
  --btn-regular-bg-active: oklch(0.90 0.008 260)
  
  --btn-plain-bg-hover: oklch(0.95 0.004 260)
  --btn-plain-bg-active: oklch(0.98 0.002 260)
  
  --btn-card-bg-hover: oklch(0.98 0.002 260)
  --btn-card-bg-active: oklch(0.94 0.006 260)
  
  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)
  
  --deep-text: oklch(0.28 0.01 260)
  --title-active: oklch(0.55 0.16 var(--hue))
  
  --line-divider: rgba(0, 0, 0, 0.08)
  --line-color: rgba(0, 0, 0, 0.1)
  --meta-divider: rgba(0, 0, 0, 0.2)
  --content-meta: rgba(0, 0, 0, 0.65)
  
  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --muted: oklch(0.94 0.004 260)
  /* 选中态仍用主色点缀 */
  --selection-bg: oklch(0.90 0.05 var(--hue))
  --codeblock-bg: oklch(0.22 0.01 260)
  --codeblock-topbar-bg: oklch(0.30 0.01 260)
  
  --license-block-bg: rgba(0, 0, 0, 0.03)
  
  --link-underline: oklch(0.90 0.04 var(--hue))
  --link-hover: oklch(0.95 0.01 260)
  --link-active: oklch(0.92 0.02 260)
  
  --float-panel-bg: white
  
  --scrollbar-bg-light: rgba(0, 0, 0, 0.35)
  --scrollbar-bg-hover-light: rgba(0, 0, 0, 0.45)
  --scrollbar-bg-active-light: rgba(0, 0, 0, 0.55)
  
  --scrollbar-bg-dark: rgba(255, 255, 255, 0.35)
  --scrollbar-bg-hover-dark: rgba(255, 255, 255, 0.45)
  --scrollbar-bg-active-dark: rgba(255, 255, 255, 0.55)
  
  --scrollbar-bg: var(--scrollbar-bg-light)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light)
  
  --display-light-icon: 1
  --display-dark-icon: 0
  
  --admonitions-color-tip: oklch(0.7 0.14 180)
  --admonitions-color-note: oklch(0.7 0.14 250)
  --admonitions-color-important: oklch(0.7 0.14 310)
  --admonitions-color-warning: oklch(0.7 0.14 60)
  --admonitions-color-caution: oklch(0.6 0.2 25)
  
  /* TOC：壳灰 + 激活态主色点缀 */
  --toc-badge-bg: oklch(0.94 0.006 260)
  --toc-btn-hover: oklch(0.94 0.006 260)
  --toc-btn-active: oklch(0.92 0.008 260)
  --toc-indicator-bg: oklch(0.93 0.005 260)
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: var(--primary)

  --l2d-msg-bg: var(--primary)

  --color-selection-bar: linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))

/* 卡片跟随主题：仅极淡冷灰，不再铺紫 */
:root:not(.dark) body.card-follow-theme-hue
  --card-bg: oklch(0.995 0.003 260)

/* 暗色主题变量 */
:root.dark
  --primary: oklch(0.73 0.17 var(--hue))
  --primary-hover: oklch(0.79 0.15 var(--hue))
  --accent-indigo: oklch(0.72 0.16 var(--hue-indigo))
  --accent-violet: oklch(0.78 0.12 var(--hue-violet))
  --accent-cool: oklch(0.74 0.14 var(--hue-cool))
  --accent-rose: oklch(0.78 0.14 var(--hue-rose))
  --accent-berry: oklch(0.74 0.15 var(--hue-berry))
  --primary-gradient: unquote("linear-gradient(135deg, oklch(0.64 0.18 var(--hue-indigo)) 0%, oklch(0.73 0.17 var(--hue)) 50%, oklch(0.80 0.12 var(--hue-violet)) 100%)")
  --grad-rose: unquote("linear-gradient(135deg, oklch(0.70 0.16 var(--hue)) 0%, oklch(0.78 0.14 var(--hue-rose)) 55%, oklch(0.76 0.14 var(--hue-berry)) 100%)")
  --grad-berry: unquote("linear-gradient(120deg, oklch(0.76 0.12 var(--hue-violet)) 0%, oklch(0.74 0.15 var(--hue-berry)) 100%)")
  --grad-aurora: unquote("linear-gradient(135deg, oklch(0.68 0.16 var(--hue-indigo)) 0%, oklch(0.73 0.16 var(--hue)) 40%, oklch(0.78 0.14 var(--hue-rose)) 100%)")
  --hl-indigo: unquote("linear-gradient(to right, oklch(0.48 0.12 var(--hue-indigo) / 0.70), oklch(0.40 0.08 var(--hue-indigo) / 0.50))")
  --hl-primary: unquote("linear-gradient(to right, oklch(0.48 0.13 var(--hue) / 0.72), oklch(0.40 0.09 var(--hue) / 0.52))")
  --hl-violet: unquote("linear-gradient(to right, oklch(0.50 0.10 var(--hue-violet) / 0.68), oklch(0.42 0.07 var(--hue-violet) / 0.48))")
  --hl-cool: unquote("linear-gradient(to right, oklch(0.48 0.11 var(--hue-cool) / 0.66), oklch(0.40 0.07 var(--hue-cool) / 0.48))")
  --hl-rose: unquote("linear-gradient(to right, oklch(0.50 0.11 var(--hue-rose) / 0.68), oklch(0.42 0.08 var(--hue-berry) / 0.48))")
  /* 暗色壳：近黑中性灰 */
  --page-bg: oklch(0.16 0.005 260)
  --theme-mesh: unquote("radial-gradient(ellipse 55% 35% at 12% 0%, oklch(0.55 0.12 var(--hue) / 0.08), transparent 55%), radial-gradient(ellipse 45% 30% at 88% 8%, oklch(0.58 0.10 var(--hue-indigo) / 0.06), transparent 50%)")
  --wallpaper-fade: unquote("linear-gradient(to bottom, transparent 0%, oklch(0.16 0.005 260 / 0.55) 55%, var(--page-bg) 100%)")
  --card-bg: oklch(0.22 0.006 260)
  --card-bg-transparent: unquote("rgb(23 23 23 / var(--card-transparent-opacity, 0.6))")
  
  --btn-content: oklch(0.82 0.01 260)
  --btn-regular-bg: oklch(0.28 0.008 260)
  --btn-regular-bg-hover: oklch(0.33 0.01 260)
  --btn-regular-bg-active: oklch(0.38 0.012 260)
  
  --btn-plain-bg-hover: oklch(0.28 0.008 260)
  --btn-plain-bg-active: oklch(0.25 0.006 260)
  
  --btn-card-bg-hover: oklch(0.28 0.008 260)
  --btn-card-bg-active: oklch(0.32 0.01 260)
  
  --line-divider: rgba(255, 255, 255, 0.08)
  --line-color: rgba(255, 255, 255, 0.1)
  --meta-divider: rgba(255, 255, 255, 0.2)
  --content-meta: rgba(255, 255, 255, 0.6)
  
  --muted: oklch(0.24 0.006 260)
  --selection-bg: oklch(0.40 0.08 var(--hue))
  --codeblock-bg: oklch(0.18 0.006 260)
  --codeblock-topbar-bg: oklch(0.14 0.006 260)
  
  --license-block-bg: var(--codeblock-bg)
  
  --link-underline: oklch(0.40 0.06 var(--hue))
  --link-hover: oklch(0.32 0.01 260)
  --link-active: oklch(0.30 0.01 260)
  
  --float-panel-bg: oklch(0.20 0.006 260)
  
  --scrollbar-bg: var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-dark)
  
  --display-light-icon: 0
  --display-dark-icon: 1
  
  --admonitions-color-tip: oklch(0.75 0.14 180)
  --admonitions-color-note: oklch(0.75 0.14 250)
  --admonitions-color-important: oklch(0.75 0.14 310)
  --admonitions-color-warning: oklch(0.75 0.14 60)
  --admonitions-color-caution: oklch(0.65 0.2 25)
  
  --toc-badge-bg: var(--btn-regular-bg)
  --toc-btn-hover: oklch(0.28 0.008 260)
  --toc-btn-active: oklch(0.32 0.01 260)
  --toc-indicator-bg: oklch(0.28 0.008 260)
  --toc-item-active: var(--primary)

  --l2d-msg-bg: var(--primary)

  --color-selection-bar: linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

/* ===== 响应式断点变量 ===== */
:root
  /* 断点定义 */
  --breakpoint-xs: 320px
  --breakpoint-sm: 480px
  --breakpoint-md: 768px
  --breakpoint-lg: 1024px
  --breakpoint-xl: 1280px
  --breakpoint-2xl: 1536px
  
  /* 容器宽度 */
  --container-xs: 100%
  --container-sm: 100%
  --container-md: 100%
  --container-lg: 1024px
  --container-xl: 1280px
  --container-2xl: 1536px

/* ===== 动画变量 ===== */
:root
  /* 缓动函数 */
  --ease-standard: cubic-bezier(0.4, 0, 0.2, 1)
  --ease-decelerate: cubic-bezier(0.25, 0.46, 0.45, 0.94)
  --ease-accelerate: cubic-bezier(0.55, 0.055, 0.675, 0.19)
  --ease-sharp: cubic-bezier(0.4, 0, 0.6, 1)
  
  /* 动画时长 */
  --duration-fast: 100ms
  --duration-normal: 150ms
  --duration-medium: 200ms
  --duration-slow: 250ms
  --duration-slower: 300ms
  
  /* 动画延迟 */
  --delay-none: 0ms
  --delay-short: 30ms
  --delay-medium: 60ms
  --delay-long: 90ms
  --delay-longer: 120ms

/* ===== 间距变量 ===== */
:root
  /* 基础间距 */
  --spacing-xs: 0.25rem    /* 4px */
  --spacing-sm: 0.5rem     /* 8px */
  --spacing-md: 0.75rem    /* 12px */
  --spacing-lg: 1rem       /* 16px */
  --spacing-xl: 1.25rem    /* 20px */
  --spacing-2xl: 1.5rem    /* 24px */
  --spacing-3xl: 2rem      /* 32px */
  --spacing-4xl: 2.5rem    /* 40px */
  --spacing-5xl: 3rem      /* 48px */
  
  /* 组件间距 */
  --widget-gap-mobile: var(--spacing-md)
  --widget-gap-tablet: var(--spacing-lg)
  --widget-gap-desktop: var(--spacing-xl)
  
  /* 侧边栏宽度 */
  --sidebar-width-mobile: 100%
  --sidebar-width-tablet: 280px
  --sidebar-width-desktop: 320px

/* ===== 阴影变量 ===== */
:root
  /* 基础阴影 */
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05)
  --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.1)
  --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.1)
  --shadow-xl: 0 20px 25px rgba(0, 0, 0, 0.1)
  --shadow-2xl: 0 25px 50px rgba(0, 0, 0, 0.25)
  
  /* 特殊阴影 */
  --shadow-navbar: 0 4px 16px rgba(0, 0, 0, 0.1)
  --shadow-navbar-dark: 0 4px 16px rgba(0, 0, 0, 0.2)
  --shadow-button: 0 4px 12px rgba(0, 0, 0, 0.15)
  --shadow-button-dark: 0 4px 12px rgba(255, 255, 255, 0.1)

/* ===== 边框半径变量 ===== */
:root
  --radius-sm: 0.25rem     /* 4px */
  --radius-md: 0.375rem    /* 6px */
  --radius-lg: 0.5rem      /* 8px */
  --radius-xl: 0.75rem     /* 12px */
  --radius-2xl: 1rem       /* 16px */
  --radius-3xl: 1.5rem     /* 24px */
  --radius-full: 9999px

/* ===== 透明度变量 ===== */
:root
  --opacity-0: 0
  --opacity-5: 0.05
  --opacity-10: 0.1
  --opacity-20: 0.2
  --opacity-25: 0.25
  --opacity-30: 0.3
  --opacity-40: 0.4
  --opacity-50: 0.5
  --opacity-55: 0.55
  --opacity-60: 0.6
  --opacity-70: 0.7
  --opacity-75: 0.75
  --opacity-80: 0.8
  --opacity-85: 0.85
  --opacity-90: 0.9
  --opacity-95: 0.95
  --opacity-100: 1

/* ===== 模糊效果变量 ===== */
:root
  --blur-sm: 4px
  --blur-md: 8px
  --blur-lg: 12px
  --blur-xl: 16px
  --blur-2xl: 20px
  --blur-3xl: 24px

/* ===== 变换变量 ===== */
:root
  /* 平移 */
  --translate-xs: 0.125rem   /* 2px */
  --translate-sm: 0.25rem     /* 4px */
  --translate-md: 0.5rem      /* 8px */
  --translate-lg: 0.75rem     /* 12px */
  --translate-xl: 1rem        /* 16px */
  --translate-2xl: 1.5rem      /* 24px */
  --translate-3xl: 2rem       /* 32px */
  
  /* 缩放 */
  --scale-95: 0.95
  --scale-98: 0.98
  --scale-100: 1
  --scale-105: 1.05
  --scale-110: 1.1

/* ===== 层级变量 ===== */
:root
  --z-dropdown: 1000
  --z-sticky: 1020
  --z-fixed: 1030
  --z-modal-backdrop: 1040
  --z-modal: 1050
  --z-popover: 1060
  --z-tooltip: 1070
  --z-toast: 1080
  --z-navbar: 20
  --z-banner: 10
  --z-content: 30

/* ===== 性能优化变量 ===== */
:root
  /* GPU加速 */
  --gpu-transform: translateZ(0)
  --gpu-backface: hidden
  
  /* 动画性能 */
  --animation-fill-mode: both
  --animation-timing: var(--ease-standard)
  --animation-duration: var(--duration-medium)

/* ===== 响应式工具类 ===== */
@media (max-width: 767px)
  :root
    --container-width: var(--container-sm)
    --widget-gap: var(--widget-gap-mobile)
    --sidebar-width: var(--sidebar-width-mobile)

@media (min-width: 768px) and (max-width: 1279px)
  :root
    --container-width: var(--container-md)
    --widget-gap: var(--widget-gap-tablet)
    --sidebar-width: var(--sidebar-width-tablet)

@media (min-width: 1280px)
  :root
    --container-width: var(--container-lg)
    --widget-gap: var(--widget-gap-desktop)
    --sidebar-width: var(--sidebar-width-desktop)
