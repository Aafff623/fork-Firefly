---
import { Icon } from "astro-icon/components";
import DropdownItem from "@/components/common/DropdownItem.astro";
import DropdownPanel from "@/components/common/DropdownPanel.astro";
import type { NavBarLink } from "@/types/config";
import { url } from "@/utils/url-utils";

interface Props {
	link: NavBarLink;
	class?: string;
	isActive?: boolean;
}

const { link, class: className, isActive = false } = Astro.props;

// 检查 link 是否存在
if (!link) {
	return null;
}

const processedLink = link;

const hasChildren = processedLink.children && processedLink.children.length > 0;

/** 顶栏六项各自点缀色 */
function navKey(name: string): string {
	const map: Record<string, string> = {
		主页: "home",
		文章: "articles",
		社交: "social",
		我的: "mine",
		关于: "about",
		链接: "links",
		Home: "home",
		Articles: "articles",
		Social: "social",
		About: "about",
		Links: "links",
	};
	return map[name] || "default";
}

const accentKey = navKey(processedLink.name);
---

<div
	class:list={["dropdown-container", className]}
	data-dropdown
	data-nav-key={accentKey}
>
	{hasChildren ? (
		<button
			class:list={[
				"relative block px-3 py-2 pr-7 text-sm font-medium transition dropdown-trigger nav-accent-link",
				isActive ? "is-active" : "",
			]}
			aria-expanded="false"
			aria-haspopup="true"
			data-dropdown-trigger
		>
			<div class="flex items-center gap-1.5">
				{processedLink.icon && <Icon is:inline name={processedLink.icon} class="text-[1.1rem] mr-1.5 navbar-icon" />}
				{processedLink.name}
			</div>
			<Icon is:inline name="lucide:chevron-down" class="text-[1.2rem] transition-transform duration-200 dropdown-arrow absolute right-2 top-1/2 -translate-y-1/2" />
			{isActive && (
				<span class="nav-accent-underline absolute inset-x-1 -bottom-px h-px" />
			)}
		</button>
		<div class="dropdown-menu" data-dropdown-menu>
			<DropdownPanel class="dropdown-content">
				{processedLink.children?.map((child, index) => (
					<DropdownItem
						href={child.external ? child.url : url(child.url)}
						target={child.external ? "_blank" : undefined}
						isLast={index === (processedLink.children?.length || 0) - 1}
						class="dropdown-item h-10"
					>
						{child.icon && <Icon is:inline name={child.icon} class="text-[1.25rem] mr-3 navbar-icon" />}
						<span>{child.name}</span>
						{child.external && (
							<Icon is:inline name="lucide:square-arrow-out-up-right" class="text-[0.75rem] text-black/25 dark:text-white/25 ml-auto" />
						)}
					</DropdownItem>
				))}
			</DropdownPanel>
		</div>
	) : (
		<a
			aria-label={processedLink.name}
			href={processedLink.external ? processedLink.url : url(processedLink.url)}
			target={processedLink.external ? "_blank" : null}
			class:list={[
				"relative block px-3 py-2 text-sm font-medium transition nav-accent-link",
				isActive ? "is-active" : "",
			]}
		>
			<div class="flex items-center gap-1.5">
				{processedLink.icon && <Icon is:inline name={processedLink.icon} class="text-[1.1rem] mr-1.5 navbar-icon" />}
				{processedLink.name}
				{processedLink.external && <Icon is:inline name="lucide:square-arrow-out-up-right" class="text-[0.875rem] transition -translate-y-px ml-1 text-black/20 dark:text-white/20" />}
			</div>
			{isActive && (
				<span class="nav-accent-underline absolute inset-x-1 -bottom-px h-px" />
			)}
		</a>
	)}
</div>

<style>
	@reference "../../styles/main.css";

	.dropdown-container {
		@apply relative;
		--nav-accent: var(--primary);
	}

	.dropdown-container[data-nav-key="home"] {
		--nav-accent: oklch(0.55 0.12 165);
	}
	.dropdown-container[data-nav-key="articles"] {
		--nav-accent: oklch(0.52 0.14 265);
	}
	.dropdown-container[data-nav-key="social"] {
		--nav-accent: oklch(0.58 0.16 12);
	}
	.dropdown-container[data-nav-key="mine"] {
		--nav-accent: oklch(0.62 0.14 75);
	}
	.dropdown-container[data-nav-key="about"] {
		--nav-accent: oklch(0.55 0.12 300);
	}
	.dropdown-container[data-nav-key="links"] {
		--nav-accent: oklch(0.58 0.12 230);
	}

	.nav-accent-link {
		color: rgb(0 0 0 / 0.7);
	}

	:global(html.dark) .nav-accent-link {
		color: rgb(255 255 255 / 0.8);
	}

	.nav-accent-link:hover,
	.nav-accent-link:focus-visible,
	.nav-accent-link.is-active {
		color: var(--nav-accent);
	}

	.nav-accent-underline {
		background: linear-gradient(
			to right,
			transparent,
			color-mix(in oklch, var(--nav-accent) 55%, transparent),
			transparent
		);
	}

	.dropdown-menu {
		@apply absolute top-full left-0 pt-2 opacity-0 invisible pointer-events-none transition-all duration-150 ease-out transform translate-y-[-8px] z-50;
	}

	.dropdown-container:hover .dropdown-menu,
	.dropdown-container:focus-within .dropdown-menu {
		@apply opacity-100 visible pointer-events-auto translate-y-0;
	}

	.dropdown-container:hover .dropdown-arrow,
	.dropdown-container:focus-within .dropdown-arrow {
		@apply rotate-180;
	}

	/*
	 * 点进子链后：强制收起，盖过仍悬停 / focus-within
	 *（否则 Swup 过渡期间鼠标还在菜单上，会一直挂着）
	 */
	.dropdown-container[data-force-closed] .dropdown-menu,
	.dropdown-container[data-force-closed]:hover .dropdown-menu,
	.dropdown-container[data-force-closed]:focus-within .dropdown-menu {
		opacity: 0 !important;
		visibility: hidden !important;
		pointer-events: none !important;
		transform: translateY(-8px) !important;
		transition-duration: 80ms !important;
	}

	.dropdown-container[data-force-closed] .dropdown-arrow,
	.dropdown-container[data-force-closed]:hover .dropdown-arrow,
	.dropdown-container[data-force-closed]:focus-within .dropdown-arrow {
		transform: rotate(0deg) !important;
	}

	.dropdown-content {
		@apply min-w-[12rem];
	}

	/* 移动端隐藏下拉菜单 */
	@media (max-width: 768px) {
		.dropdown-container {
			@apply hidden;
		}
	}
</style>

<script>
	/**
	 * 导航下拉：hover / 键盘互斥 + 点链立刻收起
	 *
	 * 根因 1：:focus-within 粘住 → 两项叠开。进入/打开时互斥并 blur。
	 * 根因 2：点子项后鼠标仍悬停，:hover 继续撑开 → Swup 过渡期间菜单挂着。
	 * 修复：点子项 / 开始换页时打 data-force-closed，盖过「仍在内部」的 hover。
	 *
	 * 注意：force-closed 只应挡住「指针还没离开」的同一次悬停；
	 * 外部点击 / 换页会打到所有项，若仅靠 pointerleave 清除，
	 * 从未悬停过的项在「第一次移入」时属性仍在 → CSS !important 盖掉 :hover，表现为间歇性失效。
	 * 因此 pointerenter 必须清掉 force-closed（仍在内部时不会再触发 enter，点链收起仍有效）。
	 */
	const INIT_KEY = "data-dropdown-nav-init";
	const FORCE_CLOSED = "data-force-closed";
	/** 首屏 idle 预热的重页（下拉里常见、HTML 较重） */
	const IDLE_WARM_ROUTES = [
		"/dynamic/",
		"/gallery/",
		"/anime/",
		"/bangumi/",
		"/agents/",
		"/timeline/",
		"/collections/",
	];

	function getDropdowns(): NodeListOf<Element> {
		return document.querySelectorAll("[data-dropdown]");
	}

	function preloadUrl(raw: string) {
		if (!raw || raw.startsWith("#") || raw.startsWith("mailto:")) return;
		try {
			const u = new URL(raw, window.location.origin);
			if (u.origin !== window.location.origin) return;
			const path = `${u.pathname}${u.search}`;
			const swup = window.swup as { preload?: (url: string) => unknown } | undefined;
			if (swup?.preload) {
				void swup.preload(path);
			}
		} catch {
			/* ignore bad href */
		}
	}

	function preloadDropdownLinks(dropdown: Element) {
		dropdown.querySelectorAll("a[href]").forEach((node) => {
			const a = node as HTMLAnchorElement;
			if (a.target === "_blank" || a.hasAttribute("download")) return;
			preloadUrl(a.getAttribute("href") || a.href);
		});
	}

	function warmHeavyRoutesOnce() {
		if (document.documentElement.hasAttribute("data-nav-warmed")) return;
		const swup = window.swup as { preload?: (url: string) => unknown } | undefined;
		if (!swup?.preload) return;
		document.documentElement.setAttribute("data-nav-warmed", "1");
		const run = () => {
			IDLE_WARM_ROUTES.forEach((route) => preloadUrl(route));
		};
		const ric = (
			window as Window & {
				requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number;
			}
		).requestIdleCallback;
		if (typeof ric === "function") {
			ric(run, { timeout: 2500 });
		} else {
			window.setTimeout(run, 1200);
		}
	}

	function closeDropdown(dropdown: Element, trigger: Element, menu: Element) {
		trigger.setAttribute("aria-expanded", "false");
		menu.classList.add(
			"opacity-0",
			"invisible",
			"pointer-events-none",
			"translate-y-[-8px]",
		);
		menu.classList.remove(
			"opacity-100",
			"visible",
			"pointer-events-auto",
			"translate-y-0",
		);
	}

	/** 软关闭：收起 + blur，不打 force-closed（外部点击用） */
	function softCloseDropdown(dropdown: Element) {
		const trigger = dropdown.querySelector(
			"[data-dropdown-trigger]",
		) as HTMLElement | null;
		const menu = dropdown.querySelector("[data-dropdown-menu]");
		if (trigger && menu) closeDropdown(dropdown, trigger, menu);

		const active = document.activeElement as HTMLElement | null;
		if (active && dropdown.contains(active)) active.blur();
	}

	/** 强制收起：盖过仍悬停 / focus-within，直到指针离开或再次进入 */
	function forceCloseDropdown(dropdown: Element) {
		dropdown.setAttribute(FORCE_CLOSED, "1");
		softCloseDropdown(dropdown);
	}

	function forceCloseAll() {
		getDropdowns().forEach((dropdown) => forceCloseDropdown(dropdown));
	}

	function closeOthers(except: Element | null) {
		getDropdowns().forEach((other) => {
			if (except && other === except) return;
			const trigger = other.querySelector(
				"[data-dropdown-trigger]",
			) as HTMLElement | null;
			const menu = other.querySelector("[data-dropdown-menu]");
			if (trigger && menu) closeDropdown(other, trigger, menu);

			// 清掉残留 focus，避免 :focus-within 继续撑开菜单
			const active = document.activeElement as HTMLElement | null;
			if (active && other.contains(active)) active.blur();
		});
	}

	function openDropdown(dropdown: Element, trigger: Element, menu: Element) {
		dropdown.removeAttribute(FORCE_CLOSED);
		closeOthers(dropdown);
		trigger.setAttribute("aria-expanded", "true");
		menu.classList.remove(
			"opacity-0",
			"invisible",
			"pointer-events-none",
			"translate-y-[-8px]",
		);
		menu.classList.add(
			"opacity-100",
			"visible",
			"pointer-events-auto",
			"translate-y-0",
		);
	}

	function toggleDropdown(dropdown: Element, trigger: Element, menu: Element) {
		const isOpen = trigger.getAttribute("aria-expanded") === "true";
		if (isOpen) {
			closeDropdown(dropdown, trigger, menu);
		} else {
			openDropdown(dropdown, trigger, menu);
		}
	}

	function bindDropdown(dropdown: Element) {
		if (dropdown.hasAttribute(INIT_KEY)) return;
		dropdown.setAttribute(INIT_KEY, "1");

		const trigger = dropdown.querySelector(
			"[data-dropdown-trigger]",
		) as HTMLElement | null;
		const menu = dropdown.querySelector("[data-dropdown-menu]");
		const items = dropdown.querySelectorAll(
			".dropdown-item",
		) as NodeListOf<HTMLElement>;

		if (!trigger || !menu) return;

		// 指针离开后清强制收起
		dropdown.addEventListener("pointerleave", () => {
			dropdown.removeAttribute(FORCE_CLOSED);
		});

		// 再次移入：清 force-closed，恢复 :hover；关掉其它项残留 focus；预取子链
		dropdown.addEventListener("pointerenter", () => {
			dropdown.removeAttribute(FORCE_CLOSED);
			closeOthers(dropdown);
			preloadDropdownLinks(dropdown);
		});

		trigger.addEventListener("focus", () => {
			preloadDropdownLinks(dropdown);
		});

		// 纯鼠标点击后主动 blur，避免 focus-within 粘住；键盘操作不 blur
		trigger.addEventListener("pointerup", (e: PointerEvent) => {
			if (e.pointerType === "mouse" || e.pointerType === "pen") {
				// 下一帧再 blur，避免打断 click 自身
				requestAnimationFrame(() => {
					if (document.activeElement === trigger) trigger.blur();
				});
			}
		});

		trigger.addEventListener("keydown", (e: KeyboardEvent) => {
			if (e.key === "Enter" || e.key === " ") {
				e.preventDefault();
				toggleDropdown(dropdown, trigger, menu);
			} else if (e.key === "ArrowDown") {
				e.preventDefault();
				openDropdown(dropdown, trigger, menu);
				if (items.length > 0) items[0].focus();
			} else if (e.key === "Escape") {
				forceCloseDropdown(dropdown);
			}
		});

		items.forEach((item, index) => {
			// 点子链：立刻收起（不等鼠标移开 / Swup 播完）
			item.addEventListener("click", () => {
				forceCloseDropdown(dropdown);
			});
			item.addEventListener("keydown", (e: KeyboardEvent) => {
				if (e.key === "ArrowDown") {
					e.preventDefault();
					items[(index + 1) % items.length].focus();
				} else if (e.key === "ArrowUp") {
					e.preventDefault();
					items[(index - 1 + items.length) % items.length].focus();
				} else if (e.key === "Escape") {
					forceCloseDropdown(dropdown);
					trigger.focus();
				} else if (e.key === "Enter") {
					// 键盘回车跟鼠标点一样，马上收
					forceCloseDropdown(dropdown);
				}
			});
		});
	}

	function initNavbarDropdowns() {
		getDropdowns().forEach(bindDropdown);

		if (document.documentElement.hasAttribute("data-dropdown-doc-click")) return;
		document.documentElement.setAttribute("data-dropdown-doc-click", "1");

		// 外部点击：软关闭即可（指针不在菜单上，无需 force-closed）
		document.addEventListener("click", (e) => {
			const target = e.target as Node | null;
			getDropdowns().forEach((dropdown) => {
				if (target && dropdown.contains(target)) return;
				softCloseDropdown(dropdown);
			});
		});
	}

	function bindSwupDropdownClose() {
		const hooks = window.swup?.hooks;
		if (!hooks || document.documentElement.hasAttribute("data-dropdown-swup"))
			return;
		document.documentElement.setAttribute("data-dropdown-swup", "1");
		// 换页一开始就收，避免过渡动画期间菜单还挂着
		hooks.on("visit:start", forceCloseAll);
		hooks.on("content:replace", initNavbarDropdowns);
		warmHeavyRoutesOnce();
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initNavbarDropdowns);
	} else {
		initNavbarDropdowns();
	}

	// 一次性注册 swup:enable 监听，避免脚本每次被 Swup 重执行时重复累积
	if (!document.documentElement.hasAttribute("data-dropdown-global-bound")) {
		document.documentElement.setAttribute("data-dropdown-global-bound", "1");
		document.addEventListener("swup:enable", bindSwupDropdownClose);
	}
	bindSwupDropdownClose();
	warmHeavyRoutesOnce();
</script>