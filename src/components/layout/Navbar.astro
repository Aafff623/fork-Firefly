---
import { Picture } from "astro:assets";
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import DisplaySettings from "@/components/controls/DisplaySettingsIntegrated.svelte";
import LightDarkSwitch from "@/components/controls/LightDarkSwitch.svelte";
import Search from "@/components/controls/Search.svelte";
import MusicPlayer from "@/components/features/MusicPlayer.astro";
import {
	backgroundWallpaper,
	displaySettingsConfig,
	navBarConfig,
	sakuraConfig,
	siteConfig,
	spritePetConfig,
} from "@/config";
import { musicPlayerConfig } from "@/config/musicConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { NavBarLink } from "@/types/config";
import { getFallbackFormat, getImageFormats } from "@/utils/image-utils";
import { isHomePage } from "@/utils/layout-utils";
import { url } from "@/utils/url-utils";
import DropdownMenu from "./DropdownMenu.astro";
import NavMenuPanel from "./NavMenuPanel.astro";

const className = Astro.props.class;

// 获取导航栏透明模式配置
const navbarTransparentMode =
	backgroundWallpaper.mode === "banner"
		? backgroundWallpaper.common?.navbar?.transparentMode || "semi"
		: "semi";

// 获取导航栏毛玻璃效果配置
const navbarEnableBlur =
	backgroundWallpaper.mode === "banner"
		? (backgroundWallpaper.common?.navbar?.enableBlur ?? true)
		: false;

// 获取导航栏模糊度
const navbarBlur =
	backgroundWallpaper.mode === "banner"
		? (backgroundWallpaper.common?.navbar?.blur ?? 20)
		: 0;

// 获取导航栏标题，如果没有设置则使用 siteConfig.title
const navbarTitle = siteConfig.navbar.title || siteConfig.title;

/** 仓库 GitHub 页 */
const githubRepoUrl = "https://github.com/Aafff623/fork-Firefly";

// 获取导航栏宽度配置
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;
const navbarMenuAlign = siteConfig.navbar.menuAlign ?? "center";
const isNavbarMenuCentered = navbarMenuAlign === "center";

// 检查是否为首页
const isHomePageCheck = isHomePage(Astro.url.pathname);

// 检查是否有任何显示设置可用（外观项关闭后，入口主要服务壁纸面板）
const showThemeColor = displaySettingsConfig.themeColorSwitchable;
const isWallpaperSwitchable = displaySettingsConfig.wallpaperModeSwitchable;
const allowLayoutSwitch = displaySettingsConfig.layoutSwitchable;
const overlaySwitchableCfg = displaySettingsConfig.overlaySwitchable;
const hasOverlayUi =
	overlaySwitchableCfg === true ||
	(typeof overlaySwitchableCfg === "object" &&
		!!(
			overlaySwitchableCfg.opacity ||
			overlaySwitchableCfg.blur ||
			overlaySwitchableCfg.cardOpacity
		));
const hasWallpaperPanel =
	isWallpaperSwitchable ||
	displaySettingsConfig.wavesSwitchable ||
	displaySettingsConfig.gradientSwitchable ||
	displaySettingsConfig.bannerTitleSwitchable ||
	displaySettingsConfig.bannerCarouselSwitchable ||
	hasOverlayUi;
const hasDisplaySettings =
	showThemeColor ||
	allowLayoutSwitch ||
	hasWallpaperPanel ||
	displaySettingsConfig.sakuraSwitchable ||
	displaySettingsConfig.avatarFrameSwitchable ||
	(displaySettingsConfig.petPickerSwitchable &&
		spritePetConfig.enable &&
		spritePetConfig.pickerEnabled);
/** 樱花迁顶栏：管线开启即显示粉色图标 */
const showSakuraNavToggle = sakuraConfig.enable;

// 根据 siteConfig.pages 过滤导航栏链接
const pages = siteConfig.pages;

function isPageEnabled(link: NavBarLink): boolean {
	if (!link.pageKey) return true;
	return pages[link.pageKey as keyof typeof pages] !== false;
}

function filterLinks(link: NavBarLink): NavBarLink | null {
	if (!link.children) {
		return isPageEnabled(link) ? link : null;
	}

	const filteredChildren = link.children.filter(isPageEnabled);

	if (filteredChildren.length === 0) return null;
	if (filteredChildren.length === 1) return filteredChildren[0];
	return { ...link, children: filteredChildren };
}

let links: NavBarLink[] = navBarConfig.links
	.map(filterLinks)
	.filter((link): link is NavBarLink => link !== null);

// Spotlight 风格导航：当前页面高亮（精确匹配首页，其余前缀匹配；子链接任一命中即高亮）
const currentPath = Astro.url.pathname;
function isLinkActive(l: NavBarLink): boolean {
	if (l.external) return false;
	if (l.children && l.children.length > 0) {
		return l.children.some((c) => !c.external && isLinkActive(c));
	}
	const href = url(l.url);
	if (href === url("/")) return currentPath === href;
	return currentPath.startsWith(href);
}

// 处理导航栏 Logo 图片，image / url 类型支持亮暗色分别设置
const logoConfig = siteConfig.navbar.logo;
const logoAlt = logoConfig?.alt || siteConfig.title;
const logoIsImage = logoConfig?.type === "image" || logoConfig?.type === "url";
const logoBaseClass = "navbar-logo h-7 w-7 mb-1 mr-2 object-contain";

const logoFiles = import.meta.glob<ImageMetadata>(
	"../../**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
	{ import: "default" },
);

// 仅 src 目录下的本地图片交给 Astro 优化，public 目录和网络图片直接用原地址
async function resolveLocalLogo(value: string): Promise<ImageMetadata | null> {
	if (
		logoConfig?.type !== "image" ||
		!value ||
		value.startsWith("/") ||
		value.startsWith("http")
	) {
		return null;
	}
	const normalizedPath = path
		.normalize(path.join("../../", value))
		.replace(/\\/g, "/");
	const file = logoFiles[normalizedPath];
	return file ? await file() : null;
}

const logoLightValue = logoConfig?.value || "";
const logoDarkValue = logoConfig?.valueDark || "";
const hasDarkLogo = !!logoDarkValue && logoDarkValue !== logoLightValue;

const logoVariants = await Promise.all(
	(hasDarkLogo
		? [
				{ value: logoLightValue, theme: "light", themeClass: "dark:hidden" },
				{
					value: logoDarkValue,
					theme: "dark",
					themeClass: "hidden dark:block",
				},
			]
		: [{ value: logoLightValue, theme: "light", themeClass: "" }]
	)
		.filter((variant) => !!variant.value)
		.map(async (variant) => ({
			theme: variant.theme,
			class: variant.themeClass
				? `${logoBaseClass} ${variant.themeClass}`
				: logoBaseClass,
			image: await resolveLocalLogo(variant.value),
			src: logoConfig?.type === "url" ? variant.value : url(variant.value),
		})),
);
---
<div id="navbar" class="z-50" style={`--navbar-glass-blur: ${navbarBlur}px;`} data-transparent-mode={navbarTransparentMode} data-enable-blur={String(navbarEnableBlur)} data-is-home={isHomePageCheck} data-full-width={navbarWidthFull}>
    <div class:list={[
        className,
        "overflow-visible! h-18 px-4"
    ]}>
        <div class="mx-auto h-full w-full max-w-(--page-width) grid grid-cols-[auto_minmax(0,1fr)_auto] items-center">
            {/* 品牌名：与标签墙同系手写体 */}
            <link
              rel="stylesheet"
              href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Ma+Shan+Zheng&display=swap"
            />
            <a
              href={url('/')}
              class="btn-plain rounded-full h-13 px-3 md:px-5 font-bold active:scale-95 navbar-brand-ripple"
              aria-label={navbarTitle}
            >
                <div class:list={[
                    "flex flex-row items-center text-md relative z-[1]",
                    siteConfig.navbar.followTheme ? "text-(--primary)" : "dark:text-white text-black"
                ]}>
                                    {logoConfig?.type === "icon" ? (
                                        <Icon is:inline name={logoConfig.value || "lucide:house"} class="navbar-logo text-[1.75rem] mb-1 mr-2" />
                                    ) : logoIsImage && logoVariants.length > 0 ? (
                                        logoVariants.map((variant) => variant.image ? (
                                            <Picture
                                                src={variant.image}
                                                alt={logoAlt}
                                                class={variant.class}
                                                data-logo-theme={variant.theme}
                                                formats={getImageFormats()}
                                                fallbackFormat={getFallbackFormat()}
                                                widths={[28, 56]}
                                                loading="eager"
                                                fetchpriority="high"
                                            />
                                        ) : (
                                            <img src={variant.src} alt={logoAlt} class={variant.class} data-logo-theme={variant.theme} fetchpriority="high" />
                                        ))
                                    ) : (
                                        <Icon is:inline name="lucide:house" class="navbar-logo text-[1.75rem] mb-1 mr-2" />
                                    )}
                    {/* SVG 文本：悬停描边→填白；sr-only 保读屏 */}
                    <svg
                      class="navbar-brand-title"
                      aria-hidden="true"
                      focusable="false"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <text
                        class="navbar-brand-title__glyph"
                        x="0"
                        y="1.05em"
                        dominant-baseline="alphabetic"
                      >{navbarTitle}</text>
                    </svg>
                    <span class="sr-only">{navbarTitle}</span>
                </div>
            </a>
            <div class:list={[
                "navbar-liquid-glass hidden lg:flex items-center col-start-2 h-11 px-3 rounded-full",
                isNavbarMenuCentered
                    ? "justify-center"
                    : "justify-start pl-2"
            ]}>
                {links.map((l) => {
                    return <DropdownMenu link={l} isActive={isLinkActive(l)} />;
                })}
            </div>
            <div class="flex col-start-3 justify-self-end items-center gap-1.5 pl-2 lg:pl-4">
                <!--<SearchPanel client:load>-->
                <Search
                    client:load
                />
                <a
                    href={githubRepoUrl}
                    target="_blank"
                    rel="noopener noreferrer me"
                    aria-label="GitHub Repository"
                    title="GitHub"
                    class="btn-plain scale-animation rounded-full h-9 w-9 md:h-11 md:w-11 active:scale-90 inline-flex items-center justify-center"
                >
                    <Icon is:inline name="lucide:github" class="text-[1.25rem]" />
                </a>
                {musicPlayerConfig.showInNavbar && (
                    <button
                        aria-label={i18n(I18nKey.music)}
                        class="btn-plain scale-animation rounded-full h-9 w-9 md:h-11 md:w-11 active:scale-90 relative"
                        id="music-player-switch"
                        data-i18n-idle={i18n(I18nKey.music)}
                        data-i18n-playing={i18n(I18nKey.musicNowPlaying)}
                    >
                        <Icon is:inline name="lucide:music" class="text-[1.25rem]"></Icon>
                        {/* 播放中角标：关面板后仍可知正在播 */}
                        <span class="music-playing-dot pointer-events-none absolute right-1 bottom-1 h-2 w-2 rounded-full bg-(--primary) opacity-0 scale-75 transition-all duration-200" aria-hidden="true"></span>
                    </button>
                )}
                {backgroundWallpaper.playerEnable && backgroundWallpaper.mode !== "none" && (
                    <button
                        aria-label={i18n(I18nKey.videoPlay)}
                        class="btn-plain scale-animation rounded-full h-9 w-9 md:h-11 md:w-11 active:scale-90"
                        id="bg-player-toggle"
                        data-i18n-play={i18n(I18nKey.videoPlay)}
                        data-i18n-pause={i18n(I18nKey.videoPause)}
                    >
                        <span class="bg-player-icon-play"><Icon is:inline name="lucide:play" class="text-[1.5rem]" /></span>
                        <span class="bg-player-icon-pause hidden"><Icon is:inline name="lucide:pause" class="text-[1.5rem]" /></span>
                    </button>
                )}
                {showSakuraNavToggle && (
                    <button
                        type="button"
                        id="sakura-nav-toggle"
                        aria-label={i18n(I18nKey.sakuraEffect)}
                        title={i18n(I18nKey.sakuraEffect)}
                        aria-pressed="false"
                        class="btn-plain scale-animation rounded-full h-9 w-9 md:h-11 md:w-11 active:scale-90 sakura-nav-btn"
                    >
                        <Icon is:inline name="lucide:flower-2" class="text-[1.25rem] sakura-nav-icon" />
                    </button>
                )}
                {hasDisplaySettings && (
                        <button aria-label={i18n(I18nKey.settingsTabWallpaper)} title={i18n(I18nKey.settingsTabWallpaper)} class="btn-plain scale-animation rounded-full h-9 w-9 md:h-11 md:w-11 active:scale-90" id="display-settings-switch">
                            <Icon is:inline name="lucide:sliders-horizontal" class="text-[1.25rem]"></Icon>
                        </button>
                )}
                {/* @ts-ignore */}
                <LightDarkSwitch client:load></LightDarkSwitch>
                <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-full w-9 h-9 md:w-11 md:h-11 active:scale-90 lg:hidden!" id="nav-menu-switch">
                    <Icon is:inline name="lucide:menu" class="text-[1.25rem]"></Icon>
                </button>
            </div>
        </div>
        {musicPlayerConfig.showInNavbar && (
            <div id="music-nav-panel" class="float-panel float-panel-closed absolute transition-all right-16 p-2 pt-4.5 w-80 z-50">
                <MusicPlayer />
            </div>
        )}
        <NavMenuPanel links={links}></NavMenuPanel>
        <DisplaySettings client:load></DisplaySettings>
    </div>
</div>

<style>
	/* 品牌名：SVG 手写体（描边/填色见 navbar.css） */
	.navbar-brand-title {
		display: block;
		height: 1.45em;
		overflow: visible;
		font-family: "Caveat", "Ma Shan Zheng", "Segoe Script", cursive;
		font-weight: 700;
		font-size: 1.35rem;
		letter-spacing: 0.02em;
		line-height: 1.1;
		/* 测长前占位，避免塌缩 */
		min-width: 4.5em;
	}

	.navbar-brand-title__glyph {
		font-family: inherit;
		font-weight: inherit;
		font-size: 1em;
		letter-spacing: inherit;
	}

	/* 顶栏樱花：默认粉色，开启时略提亮 */
	.sakura-nav-btn .sakura-nav-icon {
		color: #f6b3c9; /* 浅粉，比品牌粉更淡 */
	}

	.sakura-nav-btn[aria-pressed="true"] .sakura-nav-icon,
	.sakura-nav-btn.is-sakura-on .sakura-nav-icon {
		color: #f9c4d4;
		filter: drop-shadow(0 0 0.28rem rgb(246 179 201 / 0.28));
	}

	/* 导航栏音乐钮：播放中显示主题色小圆点 */
	#music-player-switch[data-music-playing] .music-playing-dot {
		opacity: 1;
		scale: 1;
		animation: music-dot-pulse 1.6s ease-in-out infinite;
	}
	@keyframes music-dot-pulse {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.45;
		}
	}
</style>

<script>
function loadButtonScript() {
    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let musicBtn = document.getElementById("music-player-switch");
    if (musicBtn) {
        musicBtn.onclick = function () {
            let musicPanel = document.getElementById("music-nav-panel");
            if (musicPanel) {
                musicPanel.classList.toggle("float-panel-closed");
            }
        };
        // 迷你播放态：关面板后用角标 + aria 表示正在播放
        function syncMusicPlayingBadge(playing: boolean) {
            musicBtn!.toggleAttribute("data-music-playing", playing);
            var idle = musicBtn!.getAttribute("data-i18n-idle") ?? "";
            var nowPlaying = musicBtn!.getAttribute("data-i18n-playing") ?? "";
            var label = playing && nowPlaying ? `${nowPlaying} · ${idle}` : idle;
            musicBtn!.setAttribute("aria-label", label);
            musicBtn!.setAttribute("title", label);
        }
        window.addEventListener("fm:play-state", function (e) {
            var ce = e as CustomEvent;
            syncMusicPlayingBadge(!!(ce.detail && ce.detail.isPlaying));
        });
        // Swup / 脚本晚到时按当前状态对齐
        if (window.__fireflyMusic) {
            try {
                syncMusicPlayingBadge(!!window.__fireflyMusic.getState().isPlaying);
            } catch (_) { /* ignore */ }
        }
    }

    // 背景视频播放器控制按钮
    let bgPlayerBtn = document.getElementById("bg-player-toggle");
    if (bgPlayerBtn) {
        bgPlayerBtn.onclick = function () {
            window.dispatchEvent(new CustomEvent("bg-player-toggle"));
        };
        function toggleBgPlayerIcon(playing: boolean) {
            var playIcon = bgPlayerBtn!.querySelector(".bg-player-icon-play");
            var pauseIcon = bgPlayerBtn!.querySelector(".bg-player-icon-pause");
            if (playIcon && pauseIcon) {
                playIcon.classList.toggle("hidden", playing);
                pauseIcon.classList.toggle("hidden", !playing);
            }
            var i18nPlay = bgPlayerBtn!.getAttribute("data-i18n-play") ?? "";
            var i18nPause = bgPlayerBtn!.getAttribute("data-i18n-pause") ?? "";
            var label = playing ? i18nPause : i18nPlay;
            bgPlayerBtn!.setAttribute("title", label);
            bgPlayerBtn!.setAttribute("aria-label", label);
        }
        window.addEventListener("bg-player-state-change", function (e) {
            var ce = e as CustomEvent;
            var detail = ce.detail || {};
            // loading 阶段保持 play 图标，避免“假暂停”
            if (detail.loading && !detail.playing) return;
            toggleBgPlayerIcon(!!detail.playing);
        });
        // 切换壁纸模式时隐藏/显示播放按钮
        window.addEventListener("wallpaperModeChange", function (e) {
            var ce = e as CustomEvent;
            var mode = ce.detail && ce.detail.mode;
            bgPlayerBtn!.style.display = mode === "none" ? "none" : "";
        });
        // Swup 导航时同步播放按钮状态（BackgroundPlayer 可能被重建，也可能持久存在）
        function syncBgPlayerBtn() {
            var playing = document.documentElement.hasAttribute("data-bg-video-playing");
            toggleBgPlayerIcon(playing);
        }
        if (window.swup && window.swup.hooks) {
            window.swup.hooks.on("content:replace", syncBgPlayerBtn);
        } else {
            document.addEventListener("swup:enable", function () {
                window.swup.hooks.on("content:replace", syncBgPlayerBtn);
            });
        }
    }

    document.addEventListener("click", function(event) {
        const panels = ["display-setting", "nav-menu-panel", "music-nav-panel"];
        const buttons = ["display-settings-switch", "nav-menu-switch", "music-player-switch"];

        panels.forEach((id, index) => {
            const panel = document.getElementById(id);
            const button = document.getElementById(buttons[index]);
            if (panel && button && !panel.classList.contains("float-panel-closed")) {
                if (event.target instanceof Node && !panel.contains(event.target) && !button.contains(event.target)) {
                    panel.classList.add("float-panel-closed");
                }
            }
        });
    });
}

loadButtonScript();
</script>

<script>
import {
	getSakuraPinned,
	getStoredSakuraEnabled,
	setSakuraEnabled,
} from "@/utils/setting-utils";

/** 顶栏樱花开关：与设置面板同一套 persist / 事件 */
let sakuraNavToggleBound = false;

function syncSakuraNavBtn(enabled: boolean) {
	const btn = document.getElementById("sakura-nav-toggle");
	if (!btn) return;
	btn.setAttribute("aria-pressed", String(enabled));
	btn.classList.toggle("is-sakura-on", enabled);
}

function initSakuraNavToggle() {
	const btn = document.getElementById("sakura-nav-toggle");
	if (!btn) return;

	const initial =
		getSakuraPinned() ||
		getStoredSakuraEnabled() ||
		document.documentElement.getAttribute("data-sakura-enabled") === "true";
	syncSakuraNavBtn(initial);

	btn.onclick = () => {
		const next = btn.getAttribute("aria-pressed") !== "true";
		setSakuraEnabled(next);
		syncSakuraNavBtn(next);
	};

	if (!sakuraNavToggleBound) {
		sakuraNavToggleBound = true;
		window.addEventListener("sakuraToggle", (e) => {
			const ce = e as CustomEvent<{ enabled?: boolean }>;
			syncSakuraNavBtn(!!ce.detail?.enabled);
		});
	}
}

initSakuraNavToggle();
</script>

<script>
/** 品牌 SVG 标题：字体就绪后测宽 + 估描边周长（供悬停 dash 动画） */
function fitNavbarBrandTitle(root?: ParentNode | null) {
	const scope = root ?? document;
	const svg = scope.querySelector<SVGSVGElement>(".navbar-brand-title");
	const glyph = svg?.querySelector<SVGTextElement>(".navbar-brand-title__glyph");
	if (!svg || !glyph) return;

	const apply = () => {
		const textLen = glyph.getComputedTextLength();
		if (!textLen || !Number.isFinite(textLen)) return;
		const padX = 4;
		const padY = 6;
		const fontSize = Number.parseFloat(getComputedStyle(svg).fontSize) || 21.6;
		const height = fontSize * 1.35;
		const width = textLen + padX * 2;
		svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
		svg.setAttribute("width", String(width));
		svg.setAttribute("height", String(height));
		svg.style.minWidth = "";
		glyph.setAttribute("x", String(padX));
		glyph.setAttribute("y", String(fontSize * 1.05));
		/* 手写体轮廓周长约估：字宽 × 系数 */
		const strokeLen = Math.ceil(textLen * 2.85);
		glyph.style.setProperty("--brand-stroke-len", String(strokeLen));
		glyph.setAttribute("data-stroke-ready", "true");
	};

	const run = () => {
		if (document.fonts?.ready) {
			document.fonts.ready.then(apply).catch(apply);
		} else {
			apply();
		}
	};

	run();
}

function bindNavbarBrandTitleDraw(root?: ParentNode | null) {
	const scope = root ?? document;
	const brand = scope.querySelector<HTMLAnchorElement>("a.navbar-brand-ripple");
	if (!brand || brand.dataset.brandDrawBound === "1") return;
	brand.dataset.brandDrawBound = "1";

	const reduceMotion = () =>
		window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	const startDraw = () => {
		/* 先移除再加，保证每次悬停重播 */
		brand.classList.remove("is-brand-drawing");
		void brand.offsetWidth;
		brand.classList.add("is-brand-drawing");
		if (reduceMotion()) {
			/* 减动：类名仍加上，CSS 直接白实心 */
		}
	};

	const stopDraw = () => {
		brand.classList.remove("is-brand-drawing");
	};

	brand.addEventListener("mouseenter", startDraw);
	brand.addEventListener("mouseleave", stopDraw);
	brand.addEventListener("focus", startDraw);
	brand.addEventListener("blur", stopDraw);
}

function initNavbarBrandTitle() {
	fitNavbarBrandTitle(document);
	bindNavbarBrandTitleDraw(document);
	document.addEventListener("swup:page:view", () => {
		fitNavbarBrandTitle(document);
		bindNavbarBrandTitleDraw(document);
	});
}

if (document.readyState === "loading") {
	document.addEventListener("DOMContentLoaded", initNavbarBrandTitle);
} else {
	initNavbarBrandTitle();
}

window.fitNavbarBrandTitle = fitNavbarBrandTitle;
</script>

<script>
// 为semifull模式添加滚动检测逻辑
function initSemifullScrollDetection() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    const transparentMode = navbar.getAttribute('data-transparent-mode');
    if (transparentMode !== 'semifull') return;

    // 无论首页/非首页，semifull 都由滚动位置决定是否进入 scrolled 状态
    // 先移除之前的滚动监听器，避免重复绑定
    if (window.semifullScrollHandler) {
        window.removeEventListener('scroll', window.semifullScrollHandler as () => void);
        window.semifullScrollHandler = undefined;
    }

    // 初始状态不强制加 scrolled，保持透明；滚动后再切换
    navbar.classList.remove('scrolled');

    let ticking = false;

    function updateNavbarState() {
        if (document.documentElement.classList.contains('is-page-transitioning')) {
            navbar!.classList.remove('scrolled');
            ticking = false;
            return;
        }

        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const threshold = 50; // 滚动阈值，可以根据需要调整
        // 使用批量DOM操作优化性能
        if (scrollTop > threshold) {
            navbar!.classList.add('scrolled');
        } else {
            navbar!.classList.remove('scrolled');
        }

        ticking = false;
    }

    function requestTick() {
        if (!ticking) {
            requestAnimationFrame(updateNavbarState);
            ticking = true;
        }
    }

    // 移除之前的滚动事件监听器（如果存在）
    if (window.semifullScrollHandler) {
        window.removeEventListener('scroll', window.semifullScrollHandler as () => void);
    }

    // 保存新的事件处理器引用
    window.semifullScrollHandler = requestTick as unknown as (() => void);

    // 监听滚动事件
    window.addEventListener('scroll', requestTick, { passive: true });

    // 初始化状态
    updateNavbarState();
}

// 将函数暴露到全局对象，供页面切换时调用
window.initSemifullScrollDetection = initSemifullScrollDetection;

// 页面加载完成后初始化滚动检测
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSemifullScrollDetection);
} else {
    initSemifullScrollDetection();
}
</script>

