                  </g>
                  <g class="site-footer__sprout-g4 site-footer__tree-g4">
                    <g class="site-footer__tree-fruit site-footer__tree-fruit--a">
                      <ellipse
                        cx="53"
                        cy="40"
                        rx="7.1"
                        ry="7.6"
