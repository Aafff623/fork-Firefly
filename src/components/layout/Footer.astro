                    <use href="#sf-w-bloom" x="42" y="22" width="9" height="11"></use>
                    <use href="#sf-w-bloom" x="33" y="18" width="8" height="10"></use>
                    <use href="#sf-w-bloom" x="16" y="40" width="8" height="10"></use>
                    <circle class="site-footer__tree-dew" cx="36" cy="36" r="1.25"
                    ></circle>
