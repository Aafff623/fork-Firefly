          <span class="site-footer__col-title-en">Explore</span>
        </h3>
        <ul class="site-footer__list">
          <li>
            <a href={url("/")}>
              <Icon is:inline name="lucide:home" class="site-footer__link-icon" aria-hidden="true" />
              首页
            </a>
          </li>
          <li>
            <a href={url("/about/")}>
