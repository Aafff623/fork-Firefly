              <button
                type="button"
                id="footer-water-pick"
                class="site-footer__water-pick"
                hidden
                aria-label="摘下园果"
                title="摘一颗"
              ></button>
            </div>
            <aside
              id="footer-water-note"
              class="site-footer__fruit-note"
              hidden
            >
              <p class="site-footer__fruit-note-kicker">园果</p>
              <p class="site-footer__fruit-note-body">一颗只属于这次路过。</p>
              <p class="site-footer__fruit-note-hint">关页就化回泥土。</p>
            </aside>
          </div>
        </div>
      </div>
    </div>

    <!-- 顶带 → 导航过渡：规则线 + 极淡点阵 -->
