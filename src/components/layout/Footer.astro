---
/**
 * 站点底栏 · Hallmark Index Garden colophon
 * 保留 RSS / Sitemap / Astro / Firefly 的 --primary 高亮
 */
import fs from "node:fs";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { footerConfig, profileConfig, siteConfig } from "@/config";
import { url } from "@/utils/url-utils";

const currentYear = new Date().getFullYear();
const wordmark = siteConfig.navbar?.title || profileConfig.name || siteConfig.title;
const issue = `index · elsewhere · ${currentYear}—`;

let customFooterHtml = "";
if (footerConfig.enable) {
	try {
		const footerConfigPath = path.join(
			process.cwd(),
			"src",
			"config",
			"FooterConfig.html",
		);
		customFooterHtml = fs.readFileSync(footerConfigPath, "utf-8");
		customFooterHtml = customFooterHtml.replace(/<!--[\s\S]*?-->/g, "").trim();
	} catch (error) {
		console.warn(
			"FooterConfig.html文件读取失败:",
			error instanceof Error ? error.message : String(error),
		);
	}
}
---

<footer class="site-footer">
  <div class="site-footer__mast">
    <div class="site-footer__wordmark">{wordmark}</div>
    <div class="site-footer__issue">{issue}</div>
  </div>

  {
    customFooterHtml && (
      <div class="site-footer__custom" set:html={customFooterHtml} />
    )
  }

  <div class="site-footer__colophon">
    <div class="site-footer__line">
      <span>
        &copy; <span id="copyright-year">{currentYear}</span>
        {profileConfig.name}. All Rights Reserved.
      </span>
      <span class="site-footer__sep" aria-hidden="true">/</span>
      <a class="link site-footer__icon-link" target="_blank" rel="noopener noreferrer" href={url("rss.xml")}>
        <Icon is:inline name="lucide:rss" class="site-footer__icon" aria-hidden="true" />
        RSS
      </a>
      <span class="site-footer__sep" aria-hidden="true">/</span>
      <a
        class="link site-footer__icon-link"
        target="_blank"
        rel="noopener noreferrer"
        href={url("sitemap-index.xml")}
      >
        <Icon is:inline name="lucide:map" class="site-footer__icon" aria-hidden="true" />
        Sitemap
      </a>
    </div>
    <div class="site-footer__line">
      <span>Powered by</span>
      <a
        class="link"
        target="_blank"
        rel="noopener noreferrer"
        href="https://astro.build">Astro</a
      >
      <span class="site-footer__sep" aria-hidden="true">&</span>
      <a
        class="link"
        target="_blank"
        rel="noopener noreferrer"
        href="https://github.com/CuteLeaf/Firefly">Firefly</a
      >
    </div>
  </div>
  <!--
    请勿删除 Powered by Astro & Firefly。
    额外备案等内容：footerConfig.enable = true 后编辑 FooterConfig.html。
  -->
</footer>
