---
/**
 * 站点底栏 · 三层结构（顶带 / 导航 / 底条）
 * 学 name.com 分区与扫视效率；保留数字花园人设与浇水彩蛋
 */
import fs from "node:fs";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { footerConfig, profileConfig, siteConfig } from "@/config";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { url } from "@/utils/url-utils";

const currentYear = new Date().getFullYear();
const wordmark =
	siteConfig.navbar?.title || profileConfig.name || siteConfig.title;
/* 园记压到一行钩子；英文次级短句 */
const brandBlurbCn = "数字花园里，枝叶随写随长；余白留给路过的你。";
const brandBlurbEn = "Grow slow, leave room for wanderers.";
const showFriends = siteConfig.pages?.friends !== false;

const startYear = Number(
	String(siteConfig.siteStartDate || "").slice(0, 4) || currentYear,
);

/** 园丁上次浇水：最新文章 updated ?? published */
const allPosts = await getCollection("posts", ({ data }) => {
	return import.meta.env.PROD ? data.draft !== true : true;
});
let latestMs = 0;
for (const post of allPosts) {
	const raw = post.data.updated ?? post.data.published;
	const t = raw instanceof Date ? raw.getTime() : new Date(raw).getTime();
	if (!Number.isNaN(t) && t > latestMs) latestMs = t;
}
const wateredOn = latestMs
	? formatDateToYYYYMMDD(new Date(latestMs))
	: String(siteConfig.siteStartDate || "").slice(0, 10) ||
		formatDateToYYYYMMDD(new Date());

const postCount = allPosts.length;
const startDate = new Date(
	`${String(siteConfig.siteStartDate || "2026-08-01").slice(0, 10)}T00:00:00`,
);
const gardenDays = Math.max(
	1,
	Math.floor((Date.now() - startDate.getTime()) / 86400000) + 1,
);

/** 花园状态轮换短文案 → 浇水 title，不占顶区 */
const gardenTips = [
	"今日林间微风，亦宜浇水",
	"少写一行代码，多种一棵念头",
	"客来不妨坐下，落叶声里续一壶茶",
	"枝叶未整齐，心意已先到",
	"花园不怕慢，怕的是从不驻足",
	"园门半开着，欢迎你慢慢逛",
];
const gardenTip = gardenTips[gardenDays % gardenTips.length];

const githubLink = profileConfig.links.find((l) =>
	/github/i.test(l.name + l.url),
);
const emailLink = profileConfig.links.find(
	(l) => /^mailto:/i.test(l.url) || /email|mail/i.test(l.name),
);

let customFooterHtml = "";
if (footerConfig.enable) {
	try {
		const footerConfigPath = path.join(
			process.cwd(),
			"src",
			"config",
			"FooterConfig.html",
		);
		customFooterHtml = fs.readFileSync(footerConfigPath, "utf-8");
		customFooterHtml = customFooterHtml.replace(/<!--[\s\S]*?-->/g, "").trim();
	} catch (error) {
		console.warn(
			"FooterConfig.html文件读取失败:",
			error instanceof Error ? error.message : String(error),
		);
	}
}

const waterTitle = `${gardenTip} · 以最新文章更新日计 · 点我浇一浇`;
---

<footer class="site-footer">
  <!-- 局部景层：复用氛围插画，压低干扰 -->
  <div class="site-footer__scape" aria-hidden="true"></div>
  <div class="site-footer__veil" aria-hidden="true"></div>
  <div class="site-footer__tree site-footer__tree--left" aria-hidden="true"></div>
  <div class="site-footer__tree site-footer__tree--right" aria-hidden="true"></div>
  <div class="site-footer__petals" aria-hidden="true"></div>
  <div class="site-footer__mist" aria-hidden="true"></div>

  <div class="site-footer__inner">
    <!-- 1 · 顶带：品牌左 / 状态 + 浇水右 -->
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <div class="site-footer__wordmark">{wordmark}</div>
        <div class="site-footer__blurb-stack">
          <p class="site-footer__blurb site-footer__blurb--cn">{brandBlurbCn}</p>
          <p class="site-footer__blurb site-footer__blurb--en">{brandBlurbEn}</p>
        </div>
      </div>

      <div class="site-footer__top-right">
        <p class="site-footer__garden-status">
          <span class="site-footer__garden-chip">建站第 {gardenDays} 天</span>
          <span class="site-footer__garden-chip">{postCount} 篇文章</span>
        </p>

        <div class="site-footer__water-wrap">
          <button
            type="button"
            id="footer-water-btn"
            class="site-footer__water"
            title={waterTitle}
            aria-label={`上次浇灌 ${wateredOn}，${gardenTip}，点击播放浇水动画`}
          >
            <span class="site-footer__water-icons" aria-hidden="true">
              <Icon is:inline name="lucide:droplets" class="site-footer__icon-drop" />
              <Icon is:inline name="lucide:feather" class="site-footer__icon-feather" />
            </span>
            <span>上次浇灌：{wateredOn}</span>
          </button>
          <div
            id="footer-water-stage"
            class="site-footer__water-stage"
            aria-hidden="true"
          >
            <canvas
              id="footer-water-canvas"
              class="site-footer__water-canvas"
              width="160"
              height="160"
            ></canvas>
            <svg
              id="footer-water-sprout"
              class="site-footer__water-sprout"
              viewBox="0 0 48 56"
              width="48"
              height="56"
              role="img"
            >
              <title>小草</title>
              <path
                class="site-footer__sprout-stem"
                d="M24 52 V22"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
              />
              <path
                class="site-footer__sprout-leaf site-footer__sprout-leaf--l"
                d="M24 34 C16 30 10 22 12 16 C18 18 22 24 24 30 Z"
                fill="currentColor"
              />
              <path
                class="site-footer__sprout-leaf site-footer__sprout-leaf--r"
                d="M24 30 C30 26 38 20 38 14 C32 16 27 22 24 28 Z"
                fill="currentColor"
              />
              <ellipse
                class="site-footer__sprout-soil"
                cx="24"
                cy="50"
                rx="14"
                ry="3.5"
                fill="currentColor"
                opacity="0.35"
              />
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- 顶带 → 导航过渡：规则线 + 极淡点阵 -->
    <div class="site-footer__band" aria-hidden="true"></div>

    <!-- 2 · 中区：五列均匀铺开，左右留白 -->
    <div class="site-footer__nav">
      <nav class="site-footer__col" aria-label="漫步">
        <h3 class="site-footer__col-title">
          <span class="site-footer__col-title-cn">漫步</span>
          <span class="site-footer__col-title-en">Explore</span>
        </h3>
        <ul class="site-footer__list">
          <li>
            <a href={url("/")}>
              <Icon is:inline name="lucide:home" class="site-footer__link-icon" aria-hidden="true" />
              首页
            </a>
          </li>
          <li>
            <a href={url("/about/")}>
              <Icon is:inline name="lucide:user" class="site-footer__link-icon" aria-hidden="true" />
              关于
            </a>
          </li>
          <li>
            <a href={url("/tags/")}>
              <Icon is:inline name="lucide:tags" class="site-footer__link-icon" aria-hidden="true" />
              标签
            </a>
          </li>
          {
            showFriends ? (
              <li>
                <a href={url("/friends/")}>
                  <Icon is:inline name="lucide:link-2" class="site-footer__link-icon" aria-hidden="true" />
                  友链
                </a>
              </li>
            ) : (
              <li>
                <a href={url("/search/")}>
                  <Icon is:inline name="lucide:search" class="site-footer__link-icon" aria-hidden="true" />
                  搜索
                </a>
              </li>
            )
          }
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label="园径">
        <h3 class="site-footer__col-title">
          <span class="site-footer__col-title-cn">园径</span>
          <span class="site-footer__col-title-en">Paths</span>
        </h3>
        <ul class="site-footer__list">
          <li>
            <a href={url("/dynamic/")}>
              <Icon is:inline name="lucide:activity" class="site-footer__link-icon" aria-hidden="true" />
              动态
            </a>
          </li>
          <li>
            <a href={url("/categories/")}>
              <Icon is:inline name="lucide:folder-tree" class="site-footer__link-icon" aria-hidden="true" />
              分类
            </a>
          </li>
          <li>
            <a href={url("/timeline/")}>
              <Icon is:inline name="lucide:calendar-range" class="site-footer__link-icon" aria-hidden="true" />
              时间轴
            </a>
          </li>
          <li>
            <a href={url("/collections/")}>
              <Icon is:inline name="lucide:library" class="site-footer__link-icon" aria-hidden="true" />
              合集
            </a>
          </li>
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label="园趣">
        <h3 class="site-footer__col-title">
          <span class="site-footer__col-title-cn">园趣</span>
          <span class="site-footer__col-title-en">Leisure</span>
        </h3>
        <ul class="site-footer__list">
          <li>
            <a href={url("/gallery/")}>
              <Icon is:inline name="lucide:images" class="site-footer__link-icon" aria-hidden="true" />
              相册
            </a>
          </li>
          <li>
            <a href={url("/anime/")}>
              <Icon is:inline name="lucide:clapperboard" class="site-footer__link-icon" aria-hidden="true" />
              追番
            </a>
          </li>
          <li>
            <a href={url("/guestbook/")}>
              <Icon is:inline name="lucide:message-square-heart" class="site-footer__link-icon" aria-hidden="true" />
              留言
            </a>
          </li>
          <li>
            <a href={url("/bangumi/")}>
              <Icon is:inline name="lucide:tv" class="site-footer__link-icon" aria-hidden="true" />
              Bangumi
            </a>
          </li>
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label="工具">
        <h3 class="site-footer__col-title">
          <span class="site-footer__col-title-cn">工具</span>
          <span class="site-footer__col-title-en">Tools</span>
        </h3>
        <ul class="site-footer__list">
          <li>
            <a href={url("/search/")}>
              <Icon is:inline name="lucide:search" class="site-footer__link-icon" aria-hidden="true" />
              搜索
            </a>
          </li>
          <li>
            <a href={url("/ask/")}>
              <Icon is:inline name="lucide:bot-message-square" class="site-footer__link-icon" aria-hidden="true" />
              问答
            </a>
          </li>
          <li>
            <a href={url("/agents/")}>
              <Icon is:inline name="lucide:bot" class="site-footer__link-icon" aria-hidden="true" />
              Agents
            </a>
          </li>
          <li>
            <a href={url("/sponsor/")}>
              <Icon is:inline name="lucide:heart-handshake" class="site-footer__link-icon" aria-hidden="true" />
              赞助
            </a>
          </li>
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label="连结">
        <h3 class="site-footer__col-title">
          <span class="site-footer__col-title-cn">连结</span>
          <span class="site-footer__col-title-en">Connect</span>
        </h3>
        <ul class="site-footer__list">
          <li>
            <a href={url("rss.xml")} target="_blank" rel="noopener noreferrer">
              <Icon is:inline name="lucide:rss" class="site-footer__link-icon" aria-hidden="true" />
              RSS
            </a>
          </li>
          <li>
            <a
              href={url("sitemap-index.xml")}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon is:inline name="lucide:map" class="site-footer__link-icon" aria-hidden="true" />
              Sitemap
            </a>
          </li>
          {
            githubLink && (
              <li>
                <a href={githubLink.url} target="_blank" rel="noopener noreferrer">
                  <Icon is:inline name="lucide:github" class="site-footer__link-icon" aria-hidden="true" />
                  GitHub
                </a>
              </li>
            )
          }
          {
            emailLink && (
              <li>
                <a href={emailLink.url}>
                  <Icon is:inline name="lucide:mail" class="site-footer__link-icon" aria-hidden="true" />
                  邮箱
                </a>
              </li>
            )
          }
        </ul>
      </nav>
    </div>

    {
      customFooterHtml && (
        <div class="site-footer__custom" set:html={customFooterHtml} />
      )
    }

    <!-- 3 · 底条：版权 + 署名（浇水只在顶带） -->
    <div class="site-footer__legal">
      <div class="site-footer__legal-left">
        <span class="site-footer__copy">
          &copy; <span id="copyright-year">{currentYear}</span>{" "}
          {profileConfig.name}
        </span>
      </div>

      <div class="site-footer__legal-right">
        <div class="site-footer__powered">
          <span>Powered by</span>
          <a
            class="link"
            target="_blank"
            rel="noopener noreferrer"
            href="https://astro.build">Astro</a
          >
          <span class="site-footer__sep" aria-hidden="true">&amp;</span>
          <a
            class="link"
            target="_blank"
            rel="noopener noreferrer"
            href="https://github.com/CuteLeaf/Firefly">Firefly</a
          >
        </div>
        <span class="site-footer__garden-mark">
          <span class="site-footer__garden-mark-cn">林间小站</span>
          <span class="site-footer__garden-mark-en">A grove that grows with words</span>
        </span>
        <span class="site-footer__stamp" aria-hidden="true">
          Est.<br />{startYear}<br />Firefly
        </span>
      </div>
    </div>
  </div>
  <!--
    请勿删除 Powered by Astro & Firefly。
    额外备案等内容：footerConfig.enable = true 后编辑 FooterConfig.html。
  -->
</footer>

<script>
  import "@/scripts/footer-water";
</script>
