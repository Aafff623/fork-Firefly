---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import CoverImage from "@/components/common/CoverImage.astro";
import PostMetadata from "@/components/layout/PostMeta.astro";
import PostStats from "@/components/layout/PostStats.astro";
import { siteConfig } from "@/config";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import { getFileDirFromPath, getTagUrl } from "@/utils/url-utils";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	pinned?: boolean;
	password?: boolean;
	style: string;
	loading?: "lazy" | "eager";
	/** list 模式变体：featured=首篇 · row=细线行；grid 下由 CSS 重置为普通卡 */
	listVariant?: "featured" | "row";
}
const {
	entry,
	title,
	url,
	published,
	tags,
	category,
	image,
	description,
	pinned,
	password,
	style,
	loading = "lazy",
	listVariant,
} = Astro.props;
const className = Astro.props.class;

// 处理随机图：如果image为"api"，则从配置的API获取随机图
const processedImage = processCoverImageSync(image, entry.id);
const apiUrls = getApiUrlList(image, entry.id);
const hasCover =
	processedImage !== undefined &&
	processedImage !== null &&
	processedImage !== "";

const coverWidth = "30%";

const descriptionLines = Math.max(
	0,
	Math.trunc(siteConfig.postListLayout.descriptionLines ?? 2),
);

// PostMeta 配置
const metaConfig = siteConfig.postListLayout.meta ?? {};
const showCategory = metaConfig.showCategory ?? true;
const metaShowTags = metaConfig.showTags ?? true;
const metaTagCount =
	metaConfig.tagCount !== undefined
		? Math.max(0, Math.trunc(metaConfig.tagCount))
		: 1;
const metaShowWords = metaConfig.showWords ?? true;
const metaShowReadingTime = metaConfig.showReadingTime ?? true;
const metaShowPublished = metaConfig.showPublished ?? true;

// PostStats 配置
const statsConfig = siteConfig.postListLayout.stats ?? {};
const statsShowPublished = statsConfig.showPublished ?? true;
const statsShowWords = statsConfig.showWords ?? true;
const statsShowReadingTime = statsConfig.showReadingTime ?? true;

// 标签显示位置
const tagsPosition = siteConfig.postListLayout.tagsPosition ?? "meta";
const showTagsInMeta = metaShowTags && tagsPosition === "meta";
const showTagsAtBottom = metaShowTags && tagsPosition === "bottom";
const descriptionClampLines = String(descriptionLines);
const shouldClampDescription = descriptionLines > 0;

const { remarkPluginFrontmatter } = await render(entry);
const descriptionText = description || remarkPluginFrontmatter.excerpt || "";
const words = remarkPluginFrontmatter.words;
const minutes = remarkPluginFrontmatter.minutes;
---

<div
  class:list={[
    "post-card-wrapper",
    hasCover ? "has-cover" : "no-cover",
    pinned ? "pinned" : "",
    listVariant === "featured" && "post-card-wrapper--featured",
    listVariant === "row" && "post-card-wrapper--row",
    "card-base flex flex-col-reverse w-full rounded-(--radius-large) overflow-hidden relative",
    className,
  ]}
  style={style}
>
  <!-- pinned icon -->
  <div
    class:list={[
      "post-card-content",
      "pl-4 md:pl-9 pr-4 md:pr-2 pt-4 md:pt-7 pb-4 md:pb-7 relative flex flex-col h-full",
      {
        "w-full md:w-[calc(100%-52px-12px)]": !hasCover,
        "w-full md:w-[calc(100%-var(--coverWidth)-1.5rem)]": hasCover,
      },
    ]}
  >
    <a
      href={url}
      class="post-card-title transition group w-full block font-bold mb-3 text-3xl text-90
        hover:text-(--primary) dark:hover:text-(--primary)
        active:text-(--title-active) dark:active:text-(--title-active)"
    >
      <span class="post-card-title-hl">{title}</span>

      {
        password && (
          <Icon
            is:inline
            name="material-symbols:lock-outline"
            class="inline text-2xl align-middle -translate-y-px"
          />
        )
      }
    </a>

    <!-- metadata -->
    <PostMetadata
      published={published}
      tags={tags}
      showPublished={metaShowPublished}
      showCategory={showCategory}
      showTags={showTagsInMeta}
      maxTags={metaTagCount > 0 ? metaTagCount : undefined}
      showNoTags={true}
      hideUpdateDate={true}
      category={category || undefined}
      pinned={pinned}
      words={words}
      minutes={minutes}
      showWords={metaShowWords}
      showReadingTime={metaShowReadingTime}
      className="mb-4 post-meta card-header-meta"
    />

    <!-- description -->
    <div
      class:list={[
        "transition text-75 md:pr-4 description grow",
        { "description-clamped": shouldClampDescription },
      ]}
      title={descriptionText}
    >
      {descriptionText}
    </div>

    <!-- bottom tags（与 stats 二选一） -->
    {showTagsAtBottom && tags && tags.length > 0 && (
      <div class="post-card-bottom-tags flex flex-wrap items-center gap-1.5 mt-auto pt-3">
        {(metaTagCount > 0 ? tags.slice(0, metaTagCount) : tags).map((tag) => (
          <a
            href={getTagUrl(tag)}
            aria-label={`View all posts with the ${tag.trim()} tag`}
            class="post-card-tag transition text-xs font-medium px-2.5 py-1 rounded-full
              bg-black/5 dark:bg-white/10 text-neutral-500 dark:text-neutral-400
              hover:bg-(--btn-regular-bg) hover:text-(--primary)"
          >
            #{tag.trim()}
          </a>
        ))}
      </div>
    )}

    <!-- stats（与底部标签二选一） -->
    {!showTagsAtBottom && (
      <PostStats
        published={published}
        words={words}
        minutes={minutes}
        showPublished={statsShowPublished}
        showWords={statsShowWords}
        showReadingTime={statsShowReadingTime}
        showIcons={siteConfig.postListLayout.showStatsIcons}
        className="stats mt-auto pt-3 text-black/30 dark:text-white/30 gap-x-2"
      />
    )}
  </div>
  {
    hasCover && (
      <a
        href={url}
        aria-label={title}
        class:list={[
          "post-card-image",
          "group",
          "w-full md:w-(--coverWidth)",
          "aspect-2/1 md:aspect-auto",
          "relative md:absolute md:top-4 md:bottom-4 md:right-4",
          "rounded-(--radius-large) md:rounded-xl overflow-hidden",
        ]}
      >
        <div class="post-card-image-ring" />
        <CoverImage
          src={processedImage}
          basePath={getFileDirFromPath(entry.filePath || "")}
          alt="Cover Image of the Post"
          class="w-full h-full"
          preview={true}
          loading={loading}
          apiUrls={apiUrls}
        />
      </a>
    )
  }

  {
    !hasCover && (
      <a
        href={url}
        aria-label={title}
        class:list={["post-card-enter-btn", "flex"]}
      >
        <Icon
          is:inline
          name="material-symbols:arrow-outward-rounded"
          class="transition mx-auto self-center"
        />
      </a>
    )
  }
</div>

<style define:vars={{ coverWidth, descriptionClampLines }}>
  .description-clamped {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    -webkit-line-clamp: var(--descriptionClampLines);
    line-clamp: var(--descriptionClampLines);
  }

  /* === List Featured：封面侧栏（row 变体由 post-card.css 处理） === */
  :global(.list-mode) .post-card-wrapper--featured {
    flex-direction: row !important;
  }

  :global(.list-mode) .post-card-wrapper--featured.has-cover .post-card-content {
    width: calc(100% - 9rem - 0.75rem) !important;
    padding: 0.85rem 0.65rem 0.85rem 0.9rem !important;
  }

  :global(.list-mode) .post-card-wrapper--featured.has-cover .post-card-image {
    position: absolute !important;
    top: 0.5rem !important;
    bottom: 0.5rem !important;
    right: 0.5rem !important;
    width: 9rem !important;
    aspect-ratio: auto !important;
    border-radius: 0.5rem !important;
  }

  :global(.list-mode) .post-card-wrapper--featured .post-card-title {
    font-size: 1.2rem !important;
    line-height: 1.45 !important;
    margin-bottom: 0.45rem !important;
  }

  :global(.list-mode) .post-card-wrapper--featured.no-cover .post-card-content {
    width: 100% !important;
  }

  @media (min-width: 768px) {
    :global(.list-mode) .post-card-wrapper--featured.has-cover .post-card-content {
      width: calc(100% - var(--coverWidth) - 1.5rem) !important;
      padding: 1.35rem 0.5rem 1.35rem 1.5rem !important;
    }

    :global(.list-mode) .post-card-wrapper--featured.has-cover .post-card-image {
      top: 1rem !important;
      bottom: 1rem !important;
      right: 1rem !important;
      width: var(--coverWidth) !important;
      border-radius: 0.5rem !important;
    }

    :global(.list-mode) .post-card-wrapper--featured .post-card-title {
      font-size: 1.45rem !important;
      line-height: 1.35 !important;
    }
  }

  /* === Grid / Waterfall Mode Styles === */
  /* 封面在顶部（网格与瀑布共用卡片壳） */
  :global(:is(.grid-mode, .waterfall-mode)) .post-card-wrapper {
    flex-direction: column-reverse !important;
    justify-content: flex-end !important;
  }

  :global(.grid-mode) .post-card-wrapper {
    height: 100% !important;
  }

  :global(.waterfall-mode) .post-card-wrapper {
    height: auto !important;
  }

  :global(:is(.grid-mode, .waterfall-mode)) .post-card-content {
    width: 100% !important;
    height: auto !important;
    flex-grow: 1 !important;
  }

  :global(:is(.grid-mode, .waterfall-mode)) .post-card-image {
    position: relative !important;
    top: auto !important;
    bottom: auto !important;
    right: auto !important;
    width: 100% !important;
    margin: 0 !important;
    border-radius: var(--radius-large) var(--radius-large) 0 0 !important;
    max-height: none !important;
    aspect-ratio: 2/1 !important;
  }

  :global(:is(.grid-mode, .waterfall-mode)) .description {
    flex-grow: 0 !important;
  }

  :global(:is(.grid-mode, .waterfall-mode)) .stats {
    margin-top: auto !important;
  }

  :global(:is(.grid-mode, .waterfall-mode)) .has-cover .post-card-content {
    padding-top: 0.8rem !important;
  }

  :global(:is(.grid-mode, .waterfall-mode)) .no-cover .post-card-content {
    width: calc(100% - 52px - 12px) !important;
  }

  :global(:is(.grid-mode, .waterfall-mode)) .post-card-enter-btn {
    display: flex !important;
  }
</style>
