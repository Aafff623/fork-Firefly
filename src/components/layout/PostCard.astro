---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import CoverImage from "@/components/common/CoverImage.astro";
import PostPinAdmin from "@/components/controls/PostPinAdmin.svelte";
import PostMetadata from "@/components/layout/PostMeta.astro";
import PostStats from "@/components/layout/PostStats.astro";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { PinKind } from "@/utils/content-utils";
import { tagAccentStyle } from "@/utils/accent-from-label";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import { decorateListTitle } from "@/utils/title-mood";
import { getFileDirFromPath, getTagUrl } from "@/utils/url-utils";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	pinned?: boolean;
	pinKind?: PinKind | null;
	password?: boolean;
	style: string;
	loading?: "lazy" | "eager";
	/** list 模式变体：featured=首篇 · row=细线行；grid 下由 CSS 重置为普通卡 */
	listVariant?: "featured" | "row";
}
const {
	entry,
	title,
	url,
	published,
	tags,
	category,
	image,
	description,
	pinned,
	pinKind = null,
	password,
	style,
	loading = "lazy",
	listVariant,
} = Astro.props;

const isPinnedCard = pinKind === "sticky" || pinKind === "auto" || !!pinned;
/** Letter/Night 皮肤：仅默认置顶或常驻置顶 */
const useLetterSkin = pinKind === "sticky" || pinKind === "auto";
/** 置顶管理园主 GitHub login（与评论系统无关） */
const adminLogins = ["Aafff623"];
const pinAdminLabels = {
	menu: i18n(I18nKey.pinAdminMenu),
	setSticky: i18n(I18nKey.pinAdminSetSticky),
	unsetSticky: i18n(I18nKey.pinAdminUnsetSticky),
	confirmSet: i18n(I18nKey.pinAdminConfirmSet),
	confirmUnset: i18n(I18nKey.pinAdminConfirmUnset),
	confirmSetDesc: i18n(I18nKey.pinAdminConfirmSetDesc),
	confirmUnsetDesc: i18n(I18nKey.pinAdminConfirmUnsetDesc),
	confirmOk: i18n(I18nKey.pinAdminConfirmOk),
	confirmCancel: i18n(I18nKey.pinAdminConfirmCancel),
	devHint: i18n(I18nKey.pinAdminDevHint),
	prodHint: i18n(I18nKey.pinAdminProdHint),
};
const className = Astro.props.class;
/** 仅列表展示点缀；frontmatter title 保持干净 */
const listTitle = decorateListTitle(title, entry.id);

// 处理随机图：如果image为"api"，则从配置的API获取随机图
const processedImage = processCoverImageSync(image, entry.id);
const apiUrls = getApiUrlList(image, entry.id);
const hasCover =
	processedImage !== undefined &&
	processedImage !== null &&
	processedImage !== "";

const coverWidth = "30%";

const descriptionLines = Math.max(
	0,
	Math.trunc(siteConfig.postListLayout.descriptionLines ?? 2),
);

// PostMeta 配置
const metaConfig = siteConfig.postListLayout.meta ?? {};
const showCategory = metaConfig.showCategory ?? true;
const metaShowTags = metaConfig.showTags ?? true;
const metaTagCount =
	metaConfig.tagCount !== undefined
		? Math.max(0, Math.trunc(metaConfig.tagCount))
		: 1;
const metaShowWords = metaConfig.showWords ?? true;
const metaShowReadingTime = metaConfig.showReadingTime ?? true;
const metaShowPublished = metaConfig.showPublished ?? true;

// PostStats 配置
const statsConfig = siteConfig.postListLayout.stats ?? {};
const statsShowPublished = statsConfig.showPublished ?? true;
const statsShowWords = statsConfig.showWords ?? true;
const statsShowReadingTime = statsConfig.showReadingTime ?? true;

// 标签显示位置
const tagsPosition = siteConfig.postListLayout.tagsPosition ?? "meta";
const showTagsInMeta = metaShowTags && tagsPosition === "meta";
const showTagsAtBottom = metaShowTags && tagsPosition === "bottom";
// 行卡底部标签被 CSS 隐藏：改在 meta（时间/分类旁）补标签
const showTagsInRowMeta =
	metaShowTags && listVariant === "row" && !useLetterSkin;
const metaMaxTags = showTagsInRowMeta
	? 2
	: metaTagCount > 0
		? metaTagCount
		: undefined;
const descriptionClampLines = String(descriptionLines);
const shouldClampDescription = descriptionLines > 0;

const { remarkPluginFrontmatter } = await render(entry);
const descriptionText = description || remarkPluginFrontmatter.excerpt || "";
const words = remarkPluginFrontmatter.words;
const minutes = remarkPluginFrontmatter.minutes;
const railSection = (category || i18n(I18nKey.uncategorized)).trim() || "notes";
const railTags = (tags || []).map((t) => t.trim()).filter(Boolean);
const railWordsLabel =
	typeof words === "number"
		? `${words >= 1000 ? `${(words / 1000).toFixed(1).replace(/\.0$/, "")}k` : words} words`
		: "";
const publishedLabel = formatDateToYYYYMMDD(published);
---

<div
  class:list={[
    "post-card-wrapper",
    hasCover ? "has-cover" : "no-cover",
    /* grid 全卡背景钩子：样式挂在短 class 上，避免长选择器被打包工具吞空格 */
    hasCover && !useLetterSkin && "post-card--bg-cover",
    isPinnedCard ? "pinned" : "",
    useLetterSkin && "post-card-wrapper--letter",
    pinKind === "sticky" && "pinned-sticky",
    pinKind === "auto" && "pinned-auto",
    listVariant === "featured" && "post-card-wrapper--featured",
    listVariant === "row" && "post-card-wrapper--row",
    useLetterSkin
      ? "card-base w-full relative"
      : "card-base flex flex-col-reverse w-full rounded-(--radius-large) overflow-hidden relative",
    className,
  ]}
  style={style}
>
  <!-- pinned icon -->
  <div
    class:list={[
      "post-card-content",
      "pl-4 md:pl-9 pr-4 md:pr-2 pt-4 md:pt-7 pb-4 md:pb-7 relative flex flex-col h-full",
      // Letter 皮肤用 grid 分栏，勿再按 coverWidth 缩内容宽（会留出右侧白缝）
      useLetterSkin
        ? "w-full"
        : {
            "w-full md:w-[calc(100%-52px-12px)]": !hasCover,
            "w-full md:w-[calc(100%-var(--coverWidth)-1.5rem)]": hasCover,
          },
    ]}
  >
    <!-- 标题行 + 园主置顶：三种布局共用内容区，避免盖住封面/进文按钮 -->
    <div class="post-card-head">
      <a
        href={url}
        class="post-card-title transition group min-w-0 flex-1 font-bold text-3xl text-90
          hover:text-(--primary) dark:hover:text-(--primary)
          active:text-(--title-active) dark:active:text-(--title-active)"
      >
        <span class="post-card-title-hl">{listTitle}</span>

        {
          password && (
            <Icon
              is:inline
              name="lucide:lock"
              class="inline text-2xl align-middle -translate-y-px"
            />
          )
        }
      </a>
      <PostPinAdmin
        client:load
        postId={entry.id}
        filePath={entry.filePath || ""}
        sticky={!!pinned}
        adminLogins={adminLogins}
        isDev={import.meta.env.DEV}
        labels={pinAdminLabels}
      />
    </div>

    <!-- metadata -->
    <PostMetadata
      published={published}
      tags={tags}
      showPublished={metaShowPublished}
      showCategory={showCategory}
      showTags={useLetterSkin ? false : showTagsInMeta || showTagsInRowMeta}
      maxTags={metaMaxTags}
      showNoTags={!useLetterSkin && !showTagsInRowMeta}
      hideUpdateDate={true}
      category={category || undefined}
      pinned={pinned}
      pinKind={pinKind}
      words={words}
      minutes={minutes}
      showWords={useLetterSkin ? false : metaShowWords}
      showReadingTime={useLetterSkin ? false : metaShowReadingTime}
      className="mb-4 post-meta card-header-meta"
    />

    <!-- description -->
    <div
      class:list={[
        "transition text-75 md:pr-4 description grow",
        { "description-clamped": shouldClampDescription },
      ]}
      title={descriptionText}
    >
      {descriptionText}
    </div>

    {
      useLetterSkin ? (
        <div class="card-rail" aria-label="post index">
          <span class="meta-accent-link" style={tagAccentStyle(railSection)}
            >{railSection}</span
          >
          <span class="tags">
            {railTags.length > 0 ? (
              railTags
                .slice(0, metaTagCount > 0 ? metaTagCount : railTags.length)
                .map((tag, i) => (
                  <>
                    {i > 0 && <span class="rail-tag-gap" aria-hidden="true" />}
                    <a
                      href={getTagUrl(tag)}
                      class="meta-accent-link"
                      style={tagAccentStyle(tag)}>#{tag}</a
                    >
                  </>
                ))
            ) : (
              <span>—</span>
            )}
          </span>
          <span>{railWordsLabel || publishedLabel}</span>
        </div>
      ) : (
        <>
          {showTagsAtBottom && tags && tags.length > 0 && (
            <div class="post-card-bottom-tags mt-auto" aria-label="tags">
              {(metaTagCount > 0 ? tags.slice(0, metaTagCount) : tags).map(
                (tag) => (
                  <a
                    href={getTagUrl(tag)}
                    aria-label={`View all posts with the ${tag.trim()} tag`}
                    class="post-card-tag transition meta-accent-link"
                    style={tagAccentStyle(tag)}
                  >
                    #{tag.trim()}
                  </a>
                ),
              )}
            </div>
          )}
          {!showTagsAtBottom && (
            <PostStats
              published={published}
              words={words}
              minutes={minutes}
              showPublished={statsShowPublished}
              showWords={statsShowWords}
              showReadingTime={statsShowReadingTime}
              showIcons={siteConfig.postListLayout.showStatsIcons}
              className="stats mt-auto pt-3 text-black/30 dark:text-white/30 gap-x-2"
            />
          )}
        </>
      )
    }
  </div>
  {
    useLetterSkin ? (
      <a href={url} aria-label={title} class="letter-cover group">
        {hasCover && (
          <CoverImage
            src={processedImage}
            basePath={getFileDirFromPath(entry.filePath || "")}
            alt="Cover Image of the Post"
            class="letter-cover__media"
            preview={true}
            loading={loading}
            apiUrls={apiUrls}
          />
        )}
      </a>
    ) : (
      hasCover && (
        <a
          href={url}
          aria-label={title}
          class="post-card-image group w-full md:w-(--coverWidth) aspect-2/1 md:aspect-auto relative md:absolute md:top-4 md:bottom-4 md:right-4 rounded-(--radius-large) md:rounded-xl overflow-hidden"
        >
          <div class="post-card-image-ring" />
          <CoverImage
            src={processedImage}
            basePath={getFileDirFromPath(entry.filePath || "")}
            alt="Cover Image of the Post"
            class="post-card-cover-media w-full h-full"
            preview={true}
            loading={loading}
            apiUrls={apiUrls}
          />
        </a>
      )
    )
  }

  {
    !useLetterSkin && !hasCover && (
      <>
        {/* grid 分层：与有封面同构的 16:9 占位头；list 下由 CSS 隐藏 */}
        <a
          href={url}
          aria-label={title}
          class="post-card-image post-card-image--placeholder group"
        >
          <Icon
            is:inline
            name="lucide:image"
            class="post-card-placeholder-glyph"
          />
        </a>
        <a
          href={url}
          aria-label={title}
          class:list={["post-card-enter-btn", "flex"]}
        >
          <Icon
            is:inline
            name="lucide:square-arrow-out-up-right"
            class="transition mx-auto self-center"
          />
        </a>
      </>
    )
  }
</div>

<style define:vars={{ coverWidth, descriptionClampLines }}>
  .post-card-head {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }

  .post-card-head .post-card-title {
    margin-bottom: 0;
  }

  .description-clamped {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    -webkit-line-clamp: var(--descriptionClampLines);
    line-clamp: var(--descriptionClampLines);
  }

  /* === List Featured：封面侧栏（Letter 置顶卡用独立 grid，必须排除） === */
  :global(.list-mode) .post-card-wrapper--featured:not(.post-card-wrapper--letter) {
    flex-direction: row !important;
  }

  :global(.list-mode)
    .post-card-wrapper--featured.has-cover:not(.post-card-wrapper--letter)
    .post-card-content {
    width: calc(100% - 9rem - 0.75rem) !important;
    padding: 0.85rem 0.65rem 0.85rem 0.9rem !important;
  }

  :global(.list-mode)
    .post-card-wrapper--featured.has-cover:not(.post-card-wrapper--letter)
    .post-card-image {
    position: absolute !important;
    top: 0.5rem !important;
    bottom: 0.5rem !important;
    right: 0.5rem !important;
    width: 9rem !important;
    aspect-ratio: auto !important;
    border-radius: 0.5rem !important;
  }

  :global(.list-mode)
    .post-card-wrapper--featured:not(.post-card-wrapper--letter)
    .post-card-title {
    font-size: 1.2rem !important;
    line-height: 1.45 !important;
    margin-bottom: 0.45rem !important;
  }

  :global(.list-mode)
    .post-card-wrapper--featured.no-cover:not(.post-card-wrapper--letter)
    .post-card-content {
    width: 100% !important;
  }

  @media (min-width: 768px) {
    :global(.list-mode)
      .post-card-wrapper--featured.has-cover:not(.post-card-wrapper--letter)
      .post-card-content {
      width: calc(100% - var(--coverWidth) - 1.5rem) !important;
      padding: 1.35rem 0.5rem 1.35rem 1.5rem !important;
    }

    :global(.list-mode)
      .post-card-wrapper--featured.has-cover:not(.post-card-wrapper--letter)
      .post-card-image {
      top: 1rem !important;
      bottom: 1rem !important;
      right: 1rem !important;
      width: var(--coverWidth) !important;
      border-radius: 0.5rem !important;
    }

    :global(.list-mode)
      .post-card-wrapper--featured:not(.post-card-wrapper--letter)
      .post-card-title {
      font-size: 1.45rem !important;
      line-height: 1.35 !important;
    }
  }

  /* === Card Mode === */
  /* 形态由 post-card-mode.css / post-card-letter.css 管 */
  :global(.card-mode) .post-card-wrapper {
    height: auto !important;
  }

  :global(.card-mode) .post-card-enter-btn {
    display: flex !important;
  }
</style>
