---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import PostCard from "@/components/layout/PostCard.astro";
import { displaySettingsConfig, siteConfig } from "@/config";
import { getPostPinKind } from "@/utils/content-utils";

interface Props {
	page: {
		data: CollectionEntry<"posts">[];
	};
	autoPinnedId?: string | null;
}

const { page, autoPinnedId = null } = Astro.props;

let delay = 0;
const interval = 50;

// 类型别名避免Fragment语法问题
type PostEntry = CollectionEntry<"posts">;

const masonryEnabled = siteConfig.postListLayout.grid.masonry;
const columnWidth = siteConfig.postListLayout.grid.columnWidth || 280;

// 根据配置设置初始布局模式，避免闪烁
const defaultLayout = siteConfig.postListLayout.defaultMode || "list";
const mobileDefaultLayout =
	siteConfig.postListLayout.mobileDefaultMode || defaultLayout;
const layoutSwitchable = displaySettingsConfig.layoutSwitchable;
const initialLayoutClass =
	defaultLayout === "grid"
		? "post-grid-auto grid-mode"
		: defaultLayout === "waterfall"
			? "waterfall-mode"
			: "flex flex-col gap-4 md:gap-4 list-mode";
---

<div
  id="post-list-container"
  class={`transition-all duration-500 ease-in-out mb-4 ${initialLayoutClass}`}
  data-default-layout={defaultLayout}
  data-mobile-default-layout={mobileDefaultLayout}
  data-layout-switchable={layoutSwitchable}
  data-masonry-enabled={masonryEnabled}
  data-column-width={columnWidth}
  style={`--post-card-min-width: ${columnWidth}px;`}
>
  {
    page.data.map((entry: PostEntry, index: number) => {
      const pinKind = getPostPinKind(entry, autoPinnedId);
      return (
      <PostCard
        entry={entry}
        title={entry.data.title}
        tags={entry.data.tags}
        category={entry.data.category}
        published={entry.data.published}
        updated={entry.data.updated}
        url={getPostUrlBySlug(entry.id)}
        image={entry.data.image}
        description={entry.data.description}
        draft={entry.data.draft}
        pinned={entry.data.pinned}
        pinKind={pinKind}
        password={!!entry.data.password}
        loading={index < 2 ? "eager" : "lazy"}
        listVariant={index === 0 ? "featured" : "row"}
        class:list="onload-animation post-card-item"
        style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
      />
      );
    })
  }
</div>

<!-- 立即执行脚本：防止刷新时的布局闪烁 -->
<script is:inline define:vars={{ defaultLayout, mobileDefaultLayout, columnWidth, layoutSwitchable }}>
  (function() {
    // 未开放布局切换时忽略历史偏好，始终用站点默认
    const rawSaved = layoutSwitchable ? localStorage.getItem('postListLayout') : null;
    const savedLayout = (rawSaved === 'list' || rawSaved === 'grid' || rawSaved === 'waterfall')
      ? rawSaved
      : null;
    // 根据视口宽度确定有效的默认布局
    const effectiveDefault = window.innerWidth < 780 ? mobileDefaultLayout : defaultLayout;
    let effectiveLayout = savedLayout || effectiveDefault;
    // 低于380px：列表过窄，强制卡片；瀑布保持 1 列
    if (window.innerWidth < 380 && effectiveLayout === 'list') {
      effectiveLayout = 'grid';
    }

    if (effectiveLayout !== defaultLayout) {
      const container = document.getElementById('post-list-container');

      if (container) {
        // 禁用过渡动画
        container.style.transition = 'none';

        // 移除所有布局类
        container.classList.remove('list-mode', 'grid-mode', 'waterfall-mode', 'post-grid-auto', 'flex', 'flex-col', 'gap-4', 'md:gap-4');

        if (effectiveLayout === 'grid') {
          container.classList.add('grid-mode', 'post-grid-auto');
        } else if (effectiveLayout === 'waterfall') {
          container.classList.add('waterfall-mode');
        } else {
          container.classList.add('list-mode', 'flex', 'flex-col', 'gap-4', 'md:gap-4');
        }

        // 强制重排后恢复过渡动画
        container.offsetHeight;
        container.style.transition = '';
      }
    }
  })();
</script>

<script>
  // 动态布局切换脚本
  function initLayout() {
    const postListContainer = document.getElementById("post-list-container");
    if (!postListContainer) return;

    // 从 localStorage 读取用户偏好（未开放切换时忽略）
    const layoutSwitchable =
      postListContainer.getAttribute("data-layout-switchable") === "true";
    const savedLayout = layoutSwitchable
      ? localStorage.getItem("postListLayout")
      : null;
    const defaultLayout =
      postListContainer.getAttribute("data-default-layout") || "list";
    const mobileDefaultLayout =
      postListContainer.getAttribute("data-mobile-default-layout") || defaultLayout;

    // 根据视口宽度确定有效的默认布局
    const effectiveDefault = window.innerWidth < 780 ? mobileDefaultLayout : defaultLayout;
    let currentLayout = savedLayout || effectiveDefault;

    // 低于380px：列表过窄，强制卡片；瀑布保持 1 列
    if (window.innerWidth < 380 && currentLayout === "list") {
      currentLayout = "grid";
    }

    // 应用布局
    updatePostListLayout(currentLayout);
  }

  function updatePostListLayout(layout: string) {
    const postListContainer = document.getElementById("post-list-container");
    if (!postListContainer) return;

    // Check current layout state
    const isCurrentGrid = postListContainer.classList.contains("grid-mode");
    const isCurrentWaterfall = postListContainer.classList.contains("waterfall-mode");
    const isCurrentList = postListContainer.classList.contains("list-mode");
    const currentLayout = isCurrentGrid
      ? "grid"
      : isCurrentWaterfall
        ? "waterfall"
        : isCurrentList
          ? "list"
          : null;

    // Common logic vars
    const masonryEnabled = postListContainer.getAttribute("data-masonry-enabled") === "true";

    // Helper to apply layout classes (Pure logic, no animation)
    const applyClasses = () => {
        postListContainer.classList.remove(
          "list-mode",
          "grid-mode",
          "waterfall-mode",
          "post-grid-auto",
          "flex",
          "flex-col",
          "gap-4",
          "md:gap-4",
        );
        if (layout === "grid") {
            postListContainer.classList.add("grid-mode");
            if (masonryEnabled) {
                applyMasonryLayout();
            } else {
                postListContainer.classList.add("post-grid-auto");
                resetMasonryLayout();
            }
        } else if (layout === "waterfall") {
            postListContainer.classList.add("waterfall-mode");
            resetMasonryLayout();
        } else {
            postListContainer.classList.add("list-mode", "flex", "flex-col", "gap-4", "md:gap-4");
            resetMasonryLayout();
        }
    };

    // Case 1: First run (Initialization) - No animation
    if (!currentLayout) {
        applyClasses();
        return;
    }

    // Case 2: Same layout (e.g. Resize) - No animation, just refresh masonry
    if (currentLayout === layout) {
        if (layout === "grid" && masonryEnabled) {
            applyMasonryLayout();
        }
        return;
    }

    // Case 3: Layout Change - Smooth Animation
    // 1. Fade OUT
    postListContainer.classList.add("layout-switching");

    // 2. Change Layout after fade out (200ms match CSS)
    setTimeout(() => {
        applyClasses();

        // 3. Fade IN (Short delay to ensure DOM update)
        requestAnimationFrame(() => {
            postListContainer.classList.remove("layout-switching");
        });
    }, 200);
  }

  function resetMasonryLayout() {
    const container = document.getElementById("post-list-container");
    if (!container) return;

    container.style.height = "";
    container.style.position = "";
    container.style.display = "";

    const items = container.querySelectorAll(".post-card-item");
    items.forEach((item) => {
      // @ts-ignore
      item.style.position = "";
      // @ts-ignore
      item.style.top = "";
      // @ts-ignore
      item.style.left = "";
      // @ts-ignore
      item.style.width = "";
    });
  }

  function applyMasonryLayout() {
    const container = document.getElementById("post-list-container");
    if (!container) return;

    const masonryEnabled = container.getAttribute("data-masonry-enabled") === "true";
    if (!masonryEnabled) return;

    // 仅在 grid 模式下应用
    if (!container.classList.contains("grid-mode")) return;

    const items = Array.from(container.querySelectorAll(".post-card-item"));
    if (items.length === 0) return;

    // 瀑布流配置
    const gap = 16; // 1rem = 16px
    const columnWidth = parseInt(container.getAttribute("data-column-width") || "280");

    // 重置容器样式以允许绝对定位
    container.style.position = "relative";
    container.style.display = "block"; // 覆盖 grid display

    // 使用 offsetWidth 避免 transform: scale 的影响
    const containerWidth = container.offsetWidth;
    // 根据容器宽度和最小列宽动态计算列数
    const colCount = Math.max(1, Math.floor((containerWidth + gap) / (columnWidth + gap)));
    const itemWidth = (containerWidth - (colCount - 1) * gap) / colCount;

    const colHeights = new Array(colCount).fill(0);

    items.forEach((item) => {
      // 找到最短的列放置
      const colIndex = colHeights.indexOf(Math.min(...colHeights));

      // @ts-ignore
      item.style.position = "absolute";
      // @ts-ignore
      item.style.width = `${itemWidth}px`;
      // @ts-ignore
      item.style.setProperty('height', 'auto', 'important');

      // 获取高度，优先使用 offsetHeight 避免 transform 影响
      // @ts-ignore
      const height = item.offsetHeight;

      const top = colHeights[colIndex];
      const left = colIndex * (itemWidth + gap);

      // @ts-ignore
      item.style.top = `${top}px`;
      // @ts-ignore
      item.style.left = `${left}px`;

      colHeights[colIndex] += height + gap;
    });

    container.style.height = `${Math.max(...colHeights)}px`;
  }

  // 页面加载时初始化布局
  document.addEventListener("DOMContentLoaded", function () {
    // 延迟一点确保DOM完全加载
    setTimeout(initLayout, 50);

    // 监听图片加载以重新计算布局
    const imgs = document.querySelectorAll('#post-list-container img');
    imgs.forEach(img => {
        // @ts-ignore
        if(img.complete) return;
        img.addEventListener('load', () => {
            applyMasonryLayout();
        });
    });
  });

  // 页面显示时也初始化布局（处理页面切换）
  document.addEventListener("visibilitychange", function () {
    if (!document.hidden) {
      setTimeout(initLayout, 100);
    }
  });

  // 监听布局变化事件
  window.addEventListener("layoutChange", function (event) {
    // @ts-ignore
    const newLayout = event.detail.layout;
    const postListContainer = document.getElementById("post-list-container");
    if (!postListContainer) return;

    updatePostListLayout(newLayout);
  });

  // 监听窗口大小变化
  let resizeTimeout: any;
  window.addEventListener("resize", function () {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(function () {
      initLayout();
    }, 250);
  });

  // 监听页面导航事件（Astro的客户端路由）
  document.addEventListener("astro:page-load", function () {
    setTimeout(initLayout, 50);

    // 监听图片加载
    const imgs = document.querySelectorAll('#post-list-container img');
    imgs.forEach(img => {
        // @ts-ignore
        if(img.complete) return;
        img.addEventListener('load', () => {
            applyMasonryLayout();
        });
    });
  });

  document.addEventListener("astro:after-swap", function () {
    setTimeout(initLayout, 50);
  });

  // 立即执行一次（处理页面刷新）
  setTimeout(initLayout, 0);

  /**
   * grid 卡片标题荧光笔：每次鼠标进入卡片时随机抽色。
   * 排除上一次颜色，连刷同一张也大概率变色。
   */
  const CARD_HL_PALETTE = [
    "--hl-amber",
    "--hl-cool",
    "--hl-rose",
    "--hl-teal",
    "--hl-primary",
    "--hl-gold",
    "--hl-indigo",
    "--hl-coral",
    "--hl-green",
    "--hl-violet",
    "--hl-mint",
    "--hl-berry",
    "--hl-sky",
  ] as const;

  function pickRandomCardHl(card: HTMLElement) {
    const last = card.dataset.hlLast || "";
    const pool = CARD_HL_PALETTE.filter((v) => v !== last);
    const next = pool[Math.floor(Math.random() * pool.length)] || CARD_HL_PALETTE[0];
    card.dataset.hlLast = next;
    card.style.setProperty("--card-hl", `var(${next})`);
  }

  function onPostCardHlMouseOver(event: Event) {
    const e = event as MouseEvent;
    const container = document.getElementById("post-list-container");
    if (!container?.classList.contains("grid-mode") && !container?.classList.contains("waterfall-mode")) return;
    const target = e.target as Element | null;
    const card = target?.closest?.(".post-card-wrapper") as HTMLElement | null;
    if (!card || !container.contains(card)) return;
    const related = e.relatedTarget as Node | null;
    if (related && card.contains(related)) return; // 仍在同一张卡内移动
    pickRandomCardHl(card);
  }

  // 挂 document 一次即可，兼容 Swup / astro 换页
  // @ts-ignore
  if (!window.__postCardHlRandomBound) {
    // @ts-ignore
    window.__postCardHlRandomBound = true;
    document.addEventListener("mouseover", onPostCardHlMouseOver, true);
  }
</script>

<style is:global>
  .post-grid-auto {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--post-card-min-width, 320px), 1fr));
    gap: 1rem;
  }

  /* 移动端列表模式下缩小元数据 */
  @media (max-width: 767px) {
    .list-mode .post-meta-root {
      transform: scale(0.72) !important;
      transform-origin: top left !important;
      margin-bottom: 0.25rem !important;
      width: 139% !important;
    }
    .list-mode .post-meta.card-header-meta {
      transform: scale(0.9) !important;
      width: 111% !important;
      margin-bottom: 0.5rem !important;
      gap: 0.5rem !important;
    }
    .list-mode :global(.post-meta) {
      margin-bottom: 0.25rem !important;
      gap: 0.25rem !important;
    }
  }
</style>

<style>
  /* 布局切换动画 */
  #post-list-container {
    /* 限制过渡属性为 opacity 和 transform，避免响应父元素位置变化 */
    transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* 文章卡片的过渡动画 */
  #post-list-container > :global(*) {
    transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* 布局切换时的动画效果 */
  #post-list-container {
    transition: opacity 0.2s ease-out, transform 0.2s ease-out;
  }

  #post-list-container.layout-switching {
    opacity: 0;
    transform: translateY(10px);
  }

  /* Grid / Waterfall card chrome */
  #post-list-container:is(.grid-mode, .waterfall-mode) :global(.post-card-wrapper) {
    flex-direction: column-reverse !important;
  }

  #post-list-container:is(.grid-mode, .waterfall-mode) :global(.post-card-image) {
    width: 100% !important;
    position: relative !important;
    top: auto !important;
    right: auto !important;
    bottom: auto !important;
    border-radius: var(--radius-large) var(--radius-large) 0 0 !important;
  }

  #post-list-container:is(.grid-mode, .waterfall-mode) :global(.post-card-content) {
    width: 100% !important;
    padding: 1rem !important;
  }

  #post-list-container:is(.grid-mode, .waterfall-mode) :global(.no-cover .post-card-content) {
    padding-right: 4.5rem !important;
  }

  #post-list-container:is(.grid-mode, .waterfall-mode) :global(.post-card-title) {
    font-size: 1.35rem !important;
    line-height: 1.75rem !important;
    margin-bottom: 0.5rem !important;
  }

  #post-list-container:is(.grid-mode, .waterfall-mode) :global(.post-meta) {
    margin-bottom: 0.5rem !important;
    gap: 0.5rem !important;
  }

  #post-list-container:is(.grid-mode, .waterfall-mode) :global(.post-meta .text-xl) {
    font-size: 1rem !important;
    line-height: 1.25rem !important;
  }

  #post-list-container:is(.grid-mode, .waterfall-mode) :global(.meta-icon) {
    width: 1.5rem !important;
    height: 1.5rem !important;
    margin-right: 0.25rem !important;
  }

  #post-list-container:is(.grid-mode, .waterfall-mode) :global(.post-meta .text-sm) {
    font-size: 0.75rem !important;
    line-height: 1rem !important;
  }

  #post-list-container:is(.grid-mode, .waterfall-mode) :global(.card-header-meta .text-sm) {
    font-size: 0.875rem !important;
    line-height: 1.25rem !important;
  }

  #post-list-container:is(.grid-mode, .waterfall-mode) :global(.card-header-meta .meta-icon) {
    width: 2rem !important;
    height: 2rem !important;
    margin-right: 0.5rem !important;
  }

  #post-list-container:is(.grid-mode, .waterfall-mode) :global(.card-header-meta .text-xl) {
    font-size: 1.25rem !important;
    line-height: 1.75rem !important;
  }

  #post-list-container:is(.grid-mode, .waterfall-mode) :global(.post-meta .pinned-btn) {
    height: 2rem !important;
    padding: 0 0.5rem !important;
    gap: 0.25rem !important;
  }

  #post-list-container:is(.grid-mode, .waterfall-mode) :global(.post-meta .pinned-btn .text-xl) {
    font-size: 1.25rem !important;
    line-height: 1.75rem !important;
  }

  #post-list-container:is(.grid-mode, .waterfall-mode) :global(.post-meta .pinned-btn .text-sm) {
    font-size: 0.875rem !important;
    line-height: 1.25rem !important;
  }

  /* 园主置顶：list / grid / waterfall 统一挂在内容区标题行 */
  #post-list-container :global(.post-card-head) {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    margin-bottom: 0.7rem;
  }

  #post-list-container :global(.post-card-head .post-card-title) {
    margin-bottom: 0 !important;
  }

  #post-list-container:is(.grid-mode, .waterfall-mode) :global(.post-card-head) {
    margin-bottom: 0.55rem;
  }

  #post-list-container :global(.pin-chip) {
    width: 2.1rem;
    height: 2.1rem;
  }

</style>
