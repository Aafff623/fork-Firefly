---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import PostPinAdmin from "@/components/controls/PostPinAdmin.svelte";
import PostCard from "@/components/layout/PostCard.astro";
import { displaySettingsConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getPostPinKind } from "@/utils/content-utils";

interface Props {
	page: {
		data: CollectionEntry<"posts">[];
	};
	autoPinnedId?: string | null;
	/** 强制文章列表布局（忽略浏览器 localStorage 偏好）；不传则用站点默认 + 用户偏好 */
	forcedLayout?: "list" | "card";
}

const { page, autoPinnedId = null, forcedLayout } = Astro.props;

let delay = 0;
const interval = 50;

// 类型别名避免Fragment语法问题
type PostEntry = CollectionEntry<"posts">;

// 根据配置设置初始布局模式，避免闪烁
const defaultLayout =
	forcedLayout ?? (siteConfig.postListLayout.defaultMode || "list");
const mobileDefaultLayout =
	forcedLayout ?? (siteConfig.postListLayout.mobileDefaultMode || defaultLayout);
const layoutSwitchable = forcedLayout
	? false
	: displaySettingsConfig.layoutSwitchable;
const initialLayoutClass =
	defaultLayout === "card"
		? "card-mode"
		: "flex flex-col gap-4 md:gap-4 list-mode";
const pinAdminLabels = {
	menu: i18n(I18nKey.pinAdminMenu),
	setSticky: i18n(I18nKey.pinAdminSetSticky),
	unsetSticky: i18n(I18nKey.pinAdminUnsetSticky),
	confirmSet: i18n(I18nKey.pinAdminConfirmSet),
	confirmUnset: i18n(I18nKey.pinAdminConfirmUnset),
	confirmSetDesc: i18n(I18nKey.pinAdminConfirmSetDesc),
	confirmUnsetDesc: i18n(I18nKey.pinAdminConfirmUnsetDesc),
	confirmOk: i18n(I18nKey.pinAdminConfirmOk),
	confirmCancel: i18n(I18nKey.pinAdminConfirmCancel),
	devHint: i18n(I18nKey.pinAdminDevHint),
	prodHint: i18n(I18nKey.pinAdminProdHint),
};
---

<div
  id="post-list-container"
  class={`transition-all duration-500 ease-in-out mb-4 ${initialLayoutClass}`}
  data-default-layout={defaultLayout}
  data-mobile-default-layout={mobileDefaultLayout}
  data-layout-switchable={layoutSwitchable}
>
  {
    page.data.map((entry: PostEntry, index: number) => {
      const pinKind = getPostPinKind(entry, autoPinnedId);
      return (
      <PostCard
        entry={entry}
        title={entry.data.title}
        tags={entry.data.tags}
        category={entry.data.category}
        published={entry.data.published}
        updated={entry.data.updated}
        url={getPostUrlBySlug(entry.id)}
        image={entry.data.image}
        description={entry.data.description}
        draft={entry.data.draft}
        pinned={entry.data.pinned}
        pinKind={pinKind}
        password={!!entry.data.password}
        loading={index < 2 ? "eager" : "lazy"}
        listVariant={index === 0 ? "featured" : "row"}
        class:list="onload-animation post-card-item"
        style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
      />
      );
    })
  }
</div>

<PostPinAdmin
  client:load
  adminLogins={["Aafff623"]}
  isDev={import.meta.env.DEV}
  labels={pinAdminLabels}
/>

<!-- 立即执行脚本：防止刷新时的布局闪烁 -->
<script is:inline define:vars={{ defaultLayout, mobileDefaultLayout, layoutSwitchable }}>
  (function() {
    function migrateLayout(raw) {
      if (raw === 'list' || raw === 'card') return raw;
      if (raw === 'grid' || raw === 'waterfall' || raw === 'brick') {
        try { localStorage.setItem('postListLayout', 'card'); } catch (_) {}
        return 'card';
      }
      return null;
    }

    // 未开放布局切换时忽略历史偏好，始终用站点默认
    const rawSaved = layoutSwitchable ? localStorage.getItem('postListLayout') : null;
    const savedLayout = migrateLayout(rawSaved);
    const effectiveDefault = window.innerWidth < 780 ? mobileDefaultLayout : defaultLayout;
    let effectiveLayout = savedLayout || effectiveDefault;
    // 低于380px：列表过窄，强制卡片
    if (window.innerWidth < 380 && effectiveLayout === 'list') {
      effectiveLayout = 'card';
    }

    if (effectiveLayout !== defaultLayout) {
      const container = document.getElementById('post-list-container');
      if (container) {
        container.style.transition = 'none';
        container.classList.remove(
          'list-mode', 'card-mode', 'grid-mode', 'waterfall-mode', 'brick-mode',
          'post-grid-auto', 'flex', 'flex-col', 'gap-4', 'md:gap-4'
        );
        if (effectiveLayout === 'card') {
          container.classList.add('card-mode');
        } else {
          container.classList.add('list-mode', 'flex', 'flex-col', 'gap-4', 'md:gap-4');
        }
        container.offsetHeight;
        container.style.transition = '';
      }
    }
  })();
</script>

<script>
  function migrateStoredLayout(raw: string | null): "list" | "card" | null {
    if (raw === "list" || raw === "card") return raw;
    if (raw === "grid" || raw === "waterfall" || raw === "brick") {
      try {
        localStorage.setItem("postListLayout", "card");
      } catch (_) {}
      return "card";
    }
    return null;
  }

  // 动态布局切换脚本
  function initLayout() {
    const postListContainer = document.getElementById("post-list-container");
    if (!postListContainer) return;

    const layoutSwitchable =
      postListContainer.getAttribute("data-layout-switchable") === "true";
    const savedLayout = layoutSwitchable
      ? migrateStoredLayout(localStorage.getItem("postListLayout"))
      : null;
    const defaultLayout =
      postListContainer.getAttribute("data-default-layout") || "list";
    const mobileDefaultLayout =
      postListContainer.getAttribute("data-mobile-default-layout") || defaultLayout;

    const effectiveDefault = window.innerWidth < 780 ? mobileDefaultLayout : defaultLayout;
    let currentLayout = savedLayout || effectiveDefault;

    // 低于380px：列表过窄，强制卡片
    if (window.innerWidth < 380 && currentLayout === "list") {
      currentLayout = "card";
    }

    updatePostListLayout(currentLayout);
  }

  function updatePostListLayout(layout: string) {
    const postListContainer = document.getElementById("post-list-container");
    if (!postListContainer) return;

    const isCurrentCard = postListContainer.classList.contains("card-mode");
    const isCurrentList = postListContainer.classList.contains("list-mode");
    const currentLayout = isCurrentCard ? "card" : isCurrentList ? "list" : null;

    const normalized = layout === "card" ? "card" : "list";

    const applyClasses = () => {
      postListContainer.classList.remove(
        "list-mode",
        "card-mode",
        "grid-mode",
        "waterfall-mode",
        "brick-mode",
        "post-grid-auto",
        "flex",
        "flex-col",
        "gap-4",
        "md:gap-4",
      );
      if (normalized === "card") {
        postListContainer.classList.add("card-mode");
      } else {
        postListContainer.classList.add(
          "list-mode",
          "flex",
          "flex-col",
          "gap-4",
          "md:gap-4",
        );
      }
    };

    if (!currentLayout) {
      applyClasses();
      return;
    }

    if (currentLayout === normalized) {
      return;
    }

    postListContainer.classList.add("layout-switching");
    setTimeout(() => {
      applyClasses();
      requestAnimationFrame(() => {
        postListContainer.classList.remove("layout-switching");
      });
    }, 200);
  }

  document.addEventListener("DOMContentLoaded", function () {
    setTimeout(initLayout, 50);
  });

  // 幂等 guard：该脚本为内联模块脚本（无 import），每次被 Swup 重执行都会重新运行，
  // 不守卫会跨跳累积下方 7 个 document/window 监听器（visibilitychange / layoutChange /
  // resize / astro:page-load / astro:after-swap / swup:page:view / swup:contentReplaced）。
  if (!window.__postPageLayoutBound) {
    window.__postPageLayoutBound = true;

    document.addEventListener("visibilitychange", function () {
      if (!document.hidden) {
        setTimeout(initLayout, 100);
      }
    });

    window.addEventListener("layoutChange", function (event) {
      // @ts-ignore
      const newLayout = event.detail.layout;
      if (!document.getElementById("post-list-container")) return;
      updatePostListLayout(newLayout);
    });

    let resizeTimeout: any;
    window.addEventListener("resize", function () {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(function () {
        initLayout();
      }, 250);
    });

    document.addEventListener("astro:page-load", function () {
      setTimeout(initLayout, 50);
    });

    document.addEventListener("astro:after-swap", function () {
      setTimeout(initLayout, 50);
    });

    // Swup 分页 / 站内切页：SSR 仍是默认 class，必须重套用户偏好
    document.addEventListener("swup:page:view", function () {
      setTimeout(initLayout, 50);
    });
    document.addEventListener("swup:contentReplaced", function () {
      setTimeout(initLayout, 50);
    });
  }

  setTimeout(initLayout, 0);

  /**
   * 卡片标题荧光笔：每次鼠标进入卡片时随机抽色（card / list）。
   * Letter 皮肤跳过；排除上一次颜色，连刷同一张也大概率变色。
   */
  const CARD_HL_PALETTE = [
    "--hl-amber",
    "--hl-cool",
    "--hl-rose",
    "--hl-teal",
    "--hl-primary",
    "--hl-gold",
    "--hl-indigo",
    "--hl-coral",
    "--hl-green",
    "--hl-violet",
    "--hl-mint",
    "--hl-berry",
    "--hl-sky",
  ] as const;

  function pickRandomCardHl(card: HTMLElement) {
    const last = card.dataset.hlLast || "";
    const pool = CARD_HL_PALETTE.filter((v) => v !== last);
    const next = pool[Math.floor(Math.random() * pool.length)] || CARD_HL_PALETTE[0];
    card.dataset.hlLast = next;
    card.style.setProperty("--card-hl", `var(${next})`);
  }

  function onPostCardHlMouseOver(event: Event) {
    const e = event as MouseEvent;
    const container = document.getElementById("post-list-container");
    if (
      !container?.classList.contains("card-mode") &&
      !container?.classList.contains("list-mode")
    ) return;
    const target = e.target as Element | null;
    const card = target?.closest?.(".post-card-wrapper") as HTMLElement | null;
    if (!card || !container.contains(card)) return;
    // Letter 皮肤自有悬停色，不用荧光笔
    if (card.classList.contains("post-card-wrapper--letter")) return;
    const related = e.relatedTarget as Node | null;
    if (related && card.contains(related)) return; // 仍在同一张卡内移动
    pickRandomCardHl(card);
  }

  // 挂 document 一次即可，兼容 Swup / astro 换页
  // @ts-ignore
  if (!window.__postCardHlRandomBound) {
    // @ts-ignore
    window.__postCardHlRandomBound = true;
    document.addEventListener("mouseover", onPostCardHlMouseOver, true);
  }
</script>

<style is:global>
  /* 移动端列表模式下缩小元数据 */
  @media (max-width: 767px) {
    .list-mode .post-meta-root {
      transform: scale(0.72) !important;
      transform-origin: top left !important;
      margin-bottom: 0.25rem !important;
      width: 139% !important;
    }
    .list-mode .post-meta.card-header-meta {
      transform: scale(0.9) !important;
      width: 111% !important;
      margin-bottom: 0.5rem !important;
      gap: 0.5rem !important;
    }
    .list-mode :global(.post-meta) {
      margin-bottom: 0.25rem !important;
      gap: 0.25rem !important;
    }
  }
</style>

<style>
  /* 布局切换动画 */
  #post-list-container {
    transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #post-list-container > :global(*) {
    transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #post-list-container {
    transition: opacity 0.2s ease-out, transform 0.2s ease-out;
  }

  #post-list-container.layout-switching {
    opacity: 0;
    transform: translateY(10px);
  }

  /* letter 在卡片模式用左右分栏 */
  #post-list-container.card-mode :global(.post-card-wrapper--letter) {
    display: grid !important;
    flex-direction: unset !important;
  }

  #post-list-container.card-mode :global(.post-meta) {
    margin-bottom: 0.5rem !important;
    gap: 0.5rem !important;
  }

  #post-list-container.card-mode :global(.post-meta .text-xl) {
    font-size: 1rem !important;
    line-height: 1.25rem !important;
  }

  #post-list-container.card-mode :global(.meta-icon) {
    width: 1.5rem !important;
    height: 1.5rem !important;
    margin-right: 0.25rem !important;
  }

  #post-list-container.card-mode :global(.post-meta .text-sm) {
    font-size: 0.75rem !important;
    line-height: 1rem !important;
  }

  #post-list-container.card-mode :global(.card-header-meta .text-sm) {
    font-size: 0.875rem !important;
    line-height: 1.25rem !important;
  }

  #post-list-container.card-mode :global(.card-header-meta .meta-icon) {
    width: 2rem !important;
    height: 2rem !important;
    margin-right: 0.5rem !important;
  }

  #post-list-container.card-mode :global(.card-header-meta .text-xl) {
    font-size: 1.25rem !important;
    line-height: 1.75rem !important;
  }

  #post-list-container.card-mode :global(.post-meta .pinned-btn) {
    height: 2rem !important;
    padding: 0 0.5rem !important;
    gap: 0.25rem !important;
  }

  #post-list-container.card-mode :global(.post-meta .pinned-btn .text-xl) {
    font-size: 1.25rem !important;
    line-height: 1.75rem !important;
  }

  #post-list-container.card-mode :global(.post-meta .pinned-btn .text-sm) {
    font-size: 0.875rem !important;
    line-height: 1.25rem !important;
  }

  /* 园主置顶：list / card 统一挂在内容区标题行 */
  #post-list-container :global(.post-card-head) {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    margin-bottom: 0.7rem;
  }

  #post-list-container :global(.post-card-head .post-card-title) {
    margin-bottom: 0 !important;
  }

  #post-list-container.card-mode :global(.post-card-head) {
    margin-bottom: 0.55rem;
  }

  #post-list-container :global(.pin-chip) {
    width: 2.1rem;
    height: 2.1rem;
  }

</style>
