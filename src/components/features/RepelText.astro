---
/**
 * RepelText — 对齐 agent-cfo DecodeHeadline / use-pointer-repel
 *
 * 对照 frontend/components/landing/use-pointer-repel.ts：
 *   · 指针进入时才 measure；move/leave 时才跑 rAF；静止即停
 *   · 弹簧参数：radius 110 / strength 2.8 / spring 0.11 / damping 0.78
 *   · 不给每个字开 will-change（壁纸/视频上叠几十层合成层，用一会儿就卡）
 *
 * Firefly 额外约束：
 *   · 引擎挂 window 单例，避免 Swup 重跑脚本时 rAF 叠多层
 *   · 默认不做逐词上浮；要入场加 data-repel-enter="1"
 *   · 首帧保留原文，idle 后再拆字
 *   · 横幅拆字禁 text-shadow
 *
 * 用法：class="repel-text"；可选 data-repel-radius / data-repel-strength
 */
---

<style is:global>
	.repel-text {
		cursor: crosshair;
		contain: layout;
	}

	.repel-word {
		display: inline-block;
		white-space: nowrap;
	}

	.repel-word.is-entering {
		opacity: 0;
		transform: translateY(14px);
		animation: repel-word-in 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
	}

	.repel-word.is-settled {
		opacity: 1;
		transform: none;
		animation: none;
	}

	.repel-char {
		display: inline-block;
		transition: none !important;
		transform: translate3d(0, 0, 0);
		/* 阴影绝不能落到单字上：跟字位移时每帧重绘极贵 */
		text-shadow: none !important;
	}

	/*
	 * 横幅可读性靠 banner-dim，不靠大范围 soft shadow。
	 * 覆盖 banner-title.css / layout-styles.css 里的 24px 阴影。
	 */
	.banner-title.repel-text,
	.banner-post-title.repel-text {
		text-shadow: none !important;
	}

	@keyframes repel-word-in {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.repel-text {
			cursor: inherit;
		}

		.repel-word.is-entering {
			opacity: 1;
			transform: none;
			animation: none;
		}
	}

	@media (hover: none), (pointer: coarse) {
		.repel-text {
			cursor: inherit;
		}
	}
</style>

<script>
	/** 与 agent-cfo use-pointer-repel.ts 对齐 */
	const REPEL_RADIUS = 110;
	const REPEL_STRENGTH = 2.8;
	const SPRING = 0.11;
	const DAMPING = 0.78;
	const WORD_STAGGER_MS = 40;
	const WORD_IN_MS = 450;
	const WRITE_EPS = 0.05;

	interface RepelState {
		x: number;
		y: number;
		vx: number;
		vy: number;
		centerX: number;
		centerY: number;
		wx: number;
		wy: number;
	}

	interface RepelScope {
		el: HTMLElement;
		elements: HTMLElement[];
		states: RepelState[];
		pointer: { x: number; y: number; active: boolean };
		radius: number;
		strength: number;
		measured: boolean;
		dirty: boolean;
	}

	type RepelEngine = {
		scheduleInit: () => void;
		prune: () => void;
	};

	function readNumberAttr(el: HTMLElement, name: string, fallback: number): number {
		const raw = el.getAttribute(name);
		if (raw == null || raw === "") return fallback;
		const n = Number(raw);
		return Number.isFinite(n) && n > 0 ? n : fallback;
	}

	function isCjkChar(ch: string): boolean {
		const cp = ch.codePointAt(0) ?? 0;
		return (
			(cp >= 0x3400 && cp <= 0x9fff) ||
			(cp >= 0xf900 && cp <= 0xfaff) ||
			(cp >= 0x3000 && cp <= 0x303f) ||
			(cp >= 0xff00 && cp <= 0xffef)
		);
	}

	function splitWords(text: string): string[] {
		const words: string[] = [];
		let buf = "";
		const flush = () => {
			if (buf) {
				words.push(buf);
				buf = "";
			}
		};
		for (const ch of Array.from(text)) {
			if (/\s/.test(ch)) {
				flush();
				continue;
			}
			if (isCjkChar(ch)) {
				flush();
				words.push(ch);
			} else {
				buf += ch;
			}
		}
		flush();
		return words;
	}

	function createEngine(): RepelEngine {
		const abortByEl = new WeakMap<HTMLElement, AbortController>();
		const observerByEl = new WeakMap<HTMLElement, ResizeObserver>();
		const scopes = new Set<RepelScope>();
		let sharedFrame = 0;
		let initScheduled = false;
		let windowBound = false;

		function findScope(el: HTMLElement): RepelScope | undefined {
			for (const scope of scopes) {
				if (scope.el === el) return scope;
			}
			return undefined;
		}

		function writeTransform(element: HTMLElement, s: RepelState) {
			if (Math.abs(s.x - s.wx) < WRITE_EPS && Math.abs(s.y - s.wy) < WRITE_EPS) {
				return;
			}
			s.wx = s.x;
			s.wy = s.y;
			element.style.transform = `translate3d(${s.x.toFixed(2)}px, ${s.y.toFixed(2)}px, 0)`;
		}

		function measureScope(scope: RepelScope) {
			scope.elements = Array.from(scope.el.querySelectorAll<HTMLElement>(".repel-char"));
			const rects = scope.elements.map((node) => node.getBoundingClientRect());
			scope.states = scope.elements.map((_, index) => {
				const rect = rects[index];
				const prev = scope.states[index];
				const px = prev?.x ?? 0;
				const py = prev?.y ?? 0;
				return {
					x: px,
					y: py,
					vx: prev?.vx ?? 0,
					vy: prev?.vy ?? 0,
					centerX: rect.left + rect.width / 2 - px,
					centerY: rect.top + rect.height / 2 - py,
					wx: prev?.wx ?? 0,
					wy: prev?.wy ?? 0,
				};
			});
			scope.measured = scope.elements.length > 0;
			scope.dirty = false;
		}

		function tickScope(scope: RepelScope): boolean {
			if (!scope.el.isConnected) return false;
			if (scope.dirty) measureScope(scope);
			const { elements, states, pointer } = scope;
			if (!scope.measured || elements.length === 0) return false;

			let moving = false;
			const n = elements.length;
			for (let index = 0; index < n; index++) {
				const element = elements[index];
				const s = states[index];
				if (!element || !s) continue;

				if (pointer.active) {
					const dx = s.centerX + s.x - pointer.x;
					const dy = s.centerY + s.y - pointer.y;
					const dist = Math.hypot(dx, dy);
					if (dist < scope.radius && dist > 1) {
						const force = (1 - dist / scope.radius) * scope.strength;
						s.vx += (dx / dist) * force;
						s.vy += (dy / dist) * force;
					}
				}
				s.vx += -s.x * SPRING;
				s.vy += -s.y * SPRING;
				s.vx *= DAMPING;
				s.vy *= DAMPING;
				s.x += s.vx;
				s.y += s.vy;

				const active =
					Math.abs(s.vx) > 0.03 ||
					Math.abs(s.vy) > 0.03 ||
					(!pointer.active && (Math.abs(s.x) > 0.08 || Math.abs(s.y) > 0.08));
				if (!pointer.active && !active) {
					s.x = 0;
					s.y = 0;
					s.vx = 0;
					s.vy = 0;
				}

				writeTransform(element, s);
				moving = moving || active;
			}
			return moving;
		}

		function scopeNeedsTick(scope: RepelScope): boolean {
			if (scope.pointer.active || scope.dirty) return true;
			return scope.states.some(
				(s) =>
					Math.abs(s.x) > 0.08 ||
					Math.abs(s.y) > 0.08 ||
					Math.abs(s.vx) > 0.03 ||
					Math.abs(s.vy) > 0.03,
			);
		}

		function sharedTick() {
			let anyMoving = false;
			for (const scope of scopes) {
				if (!scopeNeedsTick(scope)) continue;
				if (tickScope(scope)) anyMoving = true;
			}
			if (anyMoving) {
				sharedFrame = requestAnimationFrame(sharedTick);
			} else {
				sharedFrame = 0;
			}
		}

		function startShared() {
			if (!sharedFrame) sharedFrame = requestAnimationFrame(sharedTick);
		}

		function stopShared() {
			if (!sharedFrame) return;
			cancelAnimationFrame(sharedFrame);
			sharedFrame = 0;
		}

		function settleWords(el: HTMLElement, wordCount: number, signal: AbortSignal) {
			const words = el.querySelectorAll<HTMLElement>(".repel-word");
			const clearOne = (w: HTMLElement) => {
				w.classList.remove("is-entering");
				w.classList.add("is-settled");
				w.style.animation = "none";
				w.style.animationDelay = "";
				w.style.opacity = "1";
				w.style.transform = "none";
			};

			words.forEach((w, i) => {
				const delay = i * WORD_STAGGER_MS;
				const onEnd = (e: AnimationEvent) => {
					if (e.target !== w) return;
					clearOne(w);
				};
				w.addEventListener("animationend", onEnd, { signal, once: true });
				window.setTimeout(() => {
					if (signal.aborted) return;
					if (!w.classList.contains("is-settled")) clearOne(w);
				}, delay + WORD_IN_MS + 40);
			});

			const totalMs = Math.max(0, wordCount - 1) * WORD_STAGGER_MS + WORD_IN_MS + 60;
			window.setTimeout(() => {
				if (signal.aborted) return;
				const scope = findScope(el);
				if (scope?.pointer.active) measureScope(scope);
			}, totalMs);
		}

		function teardown(el: HTMLElement) {
			abortByEl.get(el)?.abort();
			abortByEl.delete(el);
			observerByEl.get(el)?.disconnect();
			observerByEl.delete(el);
			const scope = findScope(el);
			if (scope) {
				for (const node of scope.elements) {
					node.style.transform = "";
				}
				scopes.delete(scope);
			}
			delete el.dataset.repelBound;
			if (scopes.size === 0) stopShared();
		}

		function bindPointer(scope: RepelScope, signal: AbortSignal) {
			scope.el.addEventListener(
				"pointerenter",
				() => {
					measureScope(scope);
					scope.pointer.active = true;
				},
				{ signal },
			);
			scope.el.addEventListener(
				"pointermove",
				(e: PointerEvent) => {
					if (!scope.measured || scope.dirty) measureScope(scope);
					scope.pointer.x = e.clientX;
					scope.pointer.y = e.clientY;
					scope.pointer.active = true;
					startShared();
				},
				{ signal, passive: true },
			);
			scope.el.addEventListener(
				"pointerleave",
				() => {
					scope.pointer.active = false;
					startShared();
				},
				{ signal },
			);
		}

		function enhance(el: HTMLElement) {
			const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const interactivePointer = window.matchMedia(
				"(hover: hover) and (pointer: fine)",
			).matches;
			const nextMode = !reduced && interactivePointer ? "interactive" : "static";
			if (
				el.dataset.repelDone === "1" &&
				el.dataset.repelMode === nextMode &&
				findScope(el)
			) {
				return;
			}

			teardown(el);
			el.dataset.repelDone = "1";
			el.dataset.repelMode = nextMode;

			const text = (el.textContent || "").trim();
			if (!text) return;

			if (nextMode === "static") {
				el.textContent = text;
				return;
			}

			if (!el.querySelector(".repel-char")) {
				const wantEnter = el.getAttribute("data-repel-enter") === "1";
				const words = splitWords(text);
				const frag = document.createDocumentFragment();
				words.forEach((word, i) => {
					const w = document.createElement("span");
					w.className = wantEnter ? "repel-word is-entering" : "repel-word is-settled";
					if (wantEnter) w.style.animationDelay = `${i * WORD_STAGGER_MS}ms`;
					for (const ch of Array.from(word)) {
						const c = document.createElement("span");
						c.className = "repel-char";
						c.textContent = ch;
						w.appendChild(c);
					}
					frag.appendChild(w);
					if (i < words.length - 1) frag.appendChild(document.createTextNode(" "));
				});
				el.replaceChildren(frag);
				if (wantEnter) {
					const acEnter = new AbortController();
					abortByEl.set(el, acEnter);
					settleWords(el, words.length, acEnter.signal);
				}
			}

			el.dataset.repelBound = "1";
			const ac = abortByEl.get(el) ?? new AbortController();
			abortByEl.set(el, ac);
			const { signal } = ac;

			const scope: RepelScope = {
				el,
				elements: [],
				states: [],
				pointer: { x: -9999, y: -9999, active: false },
				radius: readNumberAttr(el, "data-repel-radius", REPEL_RADIUS),
				strength: readNumberAttr(el, "data-repel-strength", REPEL_STRENGTH),
				measured: false,
				dirty: false,
			};
			scopes.add(scope);
			bindPointer(scope, signal);

			if (document.fonts?.ready) {
				document.fonts.ready
					.then(() => {
						if (signal.aborted || !scope.measured) return;
						measureScope(scope);
					})
					.catch(() => {});
			}

			if (typeof ResizeObserver !== "undefined") {
				let resizeTimer = 0;
				const ro = new ResizeObserver(() => {
					if (!scope.measured && !scope.pointer.active) return;
					window.clearTimeout(resizeTimer);
					resizeTimer = window.setTimeout(() => {
						scope.dirty = true;
						if (scope.pointer.active) startShared();
					}, 80);
				});
				ro.observe(el);
				observerByEl.set(el, ro);
			}
		}

		function prune() {
			for (const scope of [...scopes]) {
				if (scope.el.isConnected) continue;
				teardown(scope.el);
			}
		}

		function initRepelText() {
			prune();
			document.querySelectorAll(".repel-text").forEach((node) => enhance(node as HTMLElement));
		}

		function bindWindow() {
			if (windowBound) return;
			windowBound = true;
			window.addEventListener(
				"scroll",
				() => {
					let needTick = false;
					for (const scope of scopes) {
						if (!scope.pointer.active && !scope.measured) continue;
						if (!scope.pointer.active) continue;
						scope.dirty = true;
						needTick = true;
					}
					if (needTick) startShared();
				},
				{ passive: true },
			);
		}

		function scheduleInit() {
			if (initScheduled) return;
			initScheduled = true;
			const run = () => {
				initScheduled = false;
				bindWindow();
				initRepelText();
			};
			const ric = (
				window as Window & {
					requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number;
				}
			).requestIdleCallback;
			if (typeof ric === "function") {
				ric(run, { timeout: 200 });
			} else {
				requestAnimationFrame(() => requestAnimationFrame(run));
			}
		}

		return { scheduleInit, prune };
	}

	function getEngine(): RepelEngine {
		if (!window.__repelEngine) window.__repelEngine = createEngine();
		return window.__repelEngine;
	}

	const engine = getEngine();
	engine.scheduleInit();

	if (!window.__repelSwupBound) {
		window.__repelSwupBound = true;
		document.addEventListener("swup:page:view", () => engine.scheduleInit());
		const bindSwup = () => {
			if (!window.swup?.hooks) return;
			window.swup.hooks.on("content:replace", () => engine.prune());
			window.swup.hooks.on("page:view", () => engine.scheduleInit());
		};
		if (window.swup?.hooks) bindSwup();
		else document.addEventListener("swup:enable", bindSwup);
	}
</script>
