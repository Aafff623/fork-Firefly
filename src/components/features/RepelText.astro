---
/**
 * RepelText — agent-cfo landing DecodeHeadline 的 vanilla 复刻（丝滑版）
 *
 * 效果（对照 decode-headline.tsx + use-pointer-repel.ts）：
 *   ① 逐词上浮淡入（opacity 0→1, y 14px→0, 词间 stagger）；结束后 clear 父级 transform
 *   ② 鼠标 110px 半径内字符被推开，离开后弹簧回位（共享 rAF）
 *
 * 用法：给目标元素加 class "repel-text"，本组件自动增强。
 * 可选 data-repel-radius / data-repel-strength（侧栏短名宜更小；横幅用默认）。
 * Swup 换页后自动重新扫描；尊重 prefers-reduced-motion。
 */
---

<style is:global>
	.repel-text {
		cursor: crosshair;
	}

	.repel-word {
		display: inline-block;
		white-space: nowrap;
		opacity: 0;
		transform: translateY(14px);
		animation: repel-word-in 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
	}

	.repel-word.is-settled {
		opacity: 1;
		transform: none;
		animation: none;
	}

	.repel-char {
		display: inline-block;
		transition: none !important;
		transform: translate3d(0, 0, 0);
	}

	/*
	 * 横幅拆字标题：不用 24px 软阴影（跟字重绘极贵）。
	 * 可读性用 1～3px 轻阴影；勿用父级 filter:drop-shadow（子字位移仍会重算滤镜）。
	 */
	.banner-title.repel-text,
	.banner-post-title.repel-text {
		text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55) !important;
	}

	@keyframes repel-word-in {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.repel-word {
			opacity: 1;
			transform: none;
			animation: none;
		}
	}
</style>

<script>
	const REPEL_RADIUS = 110;
	const REPEL_STRENGTH = 2.8;
	const SPRING = 0.11;
	const DAMPING = 0.78;
	const WORD_STAGGER_MS = 55;
	const WORD_IN_MS = 450;
	/** 位移变化小于此值则跳过写 DOM（约 0.05px） */
	const WRITE_EPS = 0.05;

	interface RepelState {
		x: number;
		y: number;
		vx: number;
		vy: number;
		centerX: number;
		centerY: number;
		/** 上次写入 DOM 的位移 */
		wx: number;
		wy: number;
	}

	interface RepelScope {
		el: HTMLElement;
		elements: HTMLElement[];
		states: RepelState[];
		pointer: { x: number; y: number; active: boolean };
		willChangeOn: boolean;
		radius: number;
		strength: number;
	}

	function readNumberAttr(el: HTMLElement, name: string, fallback: number): number {
		const raw = el.getAttribute(name);
		if (raw == null || raw === "") return fallback;
		const n = Number(raw);
		return Number.isFinite(n) && n > 0 ? n : fallback;
	}

	const abortByEl = new WeakMap<HTMLElement, AbortController>();
	const observerByEl = new WeakMap<HTMLElement, ResizeObserver>();
	/** 活跃斥力实例（共享一条 rAF） */
	const scopes = new Set<RepelScope>();
	let sharedFrame = 0;

	// 按「词」切分：连续拉丁/数字算一个词，CJK 逐字成词（中文没有空格分词）
	function splitWords(text: string): string[] {
		const words: string[] = [];
		let buf = "";
		const flush = () => {
			if (buf) {
				words.push(buf);
				buf = "";
			}
		};
		for (const ch of Array.from(text)) {
			if (/\s/.test(ch)) {
				flush();
				continue;
			}
			if (/[㐀-鿿豈-﫿　-〿＀-￯]/.test(ch)) {
				flush();
				words.push(ch);
			} else {
				buf += ch;
			}
		}
		flush();
		return words;
	}

	function setCharsWillChange(scope: RepelScope, on: boolean) {
		if (scope.willChangeOn === on) return;
		scope.willChangeOn = on;
		const value = on ? "transform" : "auto";
		for (const element of scope.elements) {
			element.style.willChange = value;
		}
	}

	function writeTransform(element: HTMLElement, s: RepelState) {
		if (Math.abs(s.x - s.wx) < WRITE_EPS && Math.abs(s.y - s.wy) < WRITE_EPS) return;
		s.wx = s.x;
		s.wy = s.y;
		const rx = Math.round(s.x * 100) / 100;
		const ry = Math.round(s.y * 100) / 100;
		element.style.transform = `translate3d(${rx}px, ${ry}px, 0)`;
	}

	function tickScope(scope: RepelScope): boolean {
		const { elements, states, pointer } = scope;
		let moving = false;
		const n = elements.length;
		for (let index = 0; index < n; index++) {
			const element = elements[index];
			const s = states[index];
			if (!element || !s) continue;

			if (pointer.active) {
				const dx = s.centerX + s.x - pointer.x;
				const dy = s.centerY + s.y - pointer.y;
				const dist = Math.hypot(dx, dy);
				if (dist < scope.radius && dist > 1) {
					const force = (1 - dist / scope.radius) * scope.strength;
					s.vx += (dx / dist) * force;
					s.vy += (dy / dist) * force;
				}
			}
			s.vx += -s.x * SPRING;
			s.vy += -s.y * SPRING;
			s.vx *= DAMPING;
			s.vy *= DAMPING;
			s.x += s.vx;
			s.y += s.vy;

			const active =
				Math.abs(s.vx) > 0.03 ||
				Math.abs(s.vy) > 0.03 ||
				(!pointer.active && (Math.abs(s.x) > 0.08 || Math.abs(s.y) > 0.08));
			if (!pointer.active && !active) {
				s.x = 0;
				s.y = 0;
				s.vx = 0;
				s.vy = 0;
			}

			writeTransform(element, s);
			moving = moving || active;
		}

		if (moving || pointer.active) {
			setCharsWillChange(scope, true);
		} else {
			setCharsWillChange(scope, false);
		}

		return moving;
	}

	function sharedTick() {
		let anyMoving = false;
		for (const scope of scopes) {
			if (tickScope(scope)) anyMoving = true;
		}
		sharedFrame = anyMoving ? requestAnimationFrame(sharedTick) : 0;
	}

	function startShared() {
		if (!sharedFrame) sharedFrame = requestAnimationFrame(sharedTick);
	}

	/** 入场结束：清掉父级 animation/transform（对齐 GSAP clearProps） */
	function settleWords(el: HTMLElement, wordCount: number, signal: AbortSignal) {
		const words = el.querySelectorAll<HTMLElement>(".repel-word");
		const clearOne = (w: HTMLElement) => {
			w.classList.add("is-settled");
			w.style.animation = "none";
			w.style.animationDelay = "";
			w.style.opacity = "1";
			w.style.transform = "none";
		};

		words.forEach((w, i) => {
			const delay = i * WORD_STAGGER_MS;
			const onEnd = (e: AnimationEvent) => {
				if (e.target !== w) return;
				clearOne(w);
			};
			w.addEventListener("animationend", onEnd, { signal, once: true });
			// 兜底：个别浏览器 animationend 丢失时仍清 props
			window.setTimeout(() => {
				if (signal.aborted) return;
				if (!w.classList.contains("is-settled")) clearOne(w);
			}, delay + WORD_IN_MS + 40);
		});

		// 全部词结束后再量一次中心（入场 transform 已清）
		const totalMs = Math.max(0, wordCount - 1) * WORD_STAGGER_MS + WORD_IN_MS + 60;
		window.setTimeout(() => {
			if (signal.aborted) return;
			const scope = findScope(el);
			if (scope) measureScope(scope);
		}, totalMs);
	}

	function findScope(el: HTMLElement): RepelScope | undefined {
		for (const scope of scopes) {
			if (scope.el === el) return scope;
		}
		return undefined;
	}

	function measureScope(scope: RepelScope) {
		scope.elements = Array.from(scope.el.querySelectorAll<HTMLElement>(".repel-char"));
		const rects = scope.elements.map((node) => node.getBoundingClientRect());
		scope.states = scope.elements.map((_, index) => {
			const rect = rects[index];
			const prev = scope.states[index];
			const px = prev?.x ?? 0;
			const py = prev?.y ?? 0;
			return {
				x: px,
				y: py,
				vx: prev?.vx ?? 0,
				vy: prev?.vy ?? 0,
				centerX: rect.left + rect.width / 2 - px,
				centerY: rect.top + rect.height / 2 - py,
				wx: prev?.wx ?? 0,
				wy: prev?.wy ?? 0,
			};
		});
	}

	function teardown(el: HTMLElement) {
		abortByEl.get(el)?.abort();
		abortByEl.delete(el);
		observerByEl.get(el)?.disconnect();
		observerByEl.delete(el);
		const scope = findScope(el);
		if (scope) {
			setCharsWillChange(scope, false);
			scopes.delete(scope);
		}
		delete el.dataset.repelBound;
	}

	function enhance(el: HTMLElement) {
		// 已拆词且仍有字符节点 → 跳过；Swup 换入的新标题需重新增强
		if (el.dataset.repelDone === "1" && el.querySelector(".repel-char")) return;

		const text = (el.textContent || "").trim();
		if (!text) return;

		// 同元素重建时先卸旧监听 / observer，避免 Profile + banner 或 Swup 重扫泄漏
		teardown(el);

		el.dataset.repelDone = "1";
		el.replaceChildren();

		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const words = splitWords(text);

		words.forEach((word, i) => {
			const w = document.createElement("span");
			w.className = "repel-word";
			w.style.animationDelay = `${i * WORD_STAGGER_MS}ms`;
			for (const ch of Array.from(word)) {
				const c = document.createElement("span");
				c.className = "repel-char";
				c.textContent = ch;
				w.appendChild(c);
			}
			el.appendChild(w);
			if (i < words.length - 1) el.appendChild(document.createTextNode(" "));
		});

		if (reduced) {
			el.querySelectorAll<HTMLElement>(".repel-word").forEach((w) => {
				w.classList.add("is-settled");
				w.style.animation = "none";
				w.style.opacity = "1";
				w.style.transform = "none";
			});
			return;
		}

		el.dataset.repelBound = "1";
		const ac = new AbortController();
		abortByEl.set(el, ac);
		const { signal } = ac;

		const scope: RepelScope = {
			el,
			elements: [],
			states: [],
			pointer: { x: -9999, y: -9999, active: false },
			willChangeOn: false,
			radius: readNumberAttr(el, "data-repel-radius", REPEL_RADIUS),
			strength: readNumberAttr(el, "data-repel-strength", REPEL_STRENGTH),
		};
		scopes.add(scope);

		settleWords(el, words.length, signal);

		el.addEventListener(
			"pointerenter",
			() => {
				measureScope(scope);
			},
			{ signal },
		);
		// 只记坐标；写 DOM 全交给共享 rAF。passive 避免阻塞滚动合成
		el.addEventListener(
			"pointermove",
			(e: PointerEvent) => {
				scope.pointer.x = e.clientX;
				scope.pointer.y = e.clientY;
				scope.pointer.active = true;
				startShared();
			},
			{ signal, passive: true },
		);
		el.addEventListener(
			"pointerleave",
			() => {
				scope.pointer.active = false;
				startShared();
			},
			{ signal },
		);

		if (typeof ResizeObserver !== "undefined") {
			const ro = new ResizeObserver(() => {
				measureScope(scope);
			});
			ro.observe(el);
			observerByEl.set(el, ro);
		}
		measureScope(scope);
	}

	function initRepelText() {
		document.querySelectorAll(".repel-text").forEach((node) => enhance(node as HTMLElement));
	}

	function scheduleInitRepelText() {
		requestAnimationFrame(() => {
			initRepelText();
			// 横幅 overlay 经 Swup 替换后偶发晚一拍，再扫一次
			window.setTimeout(initRepelText, 80);
		});
	}

	initRepelText();

	document.addEventListener("swup:contentReplaced", scheduleInitRepelText);
	document.addEventListener("swup:page:view", scheduleInitRepelText);

	function bindSwupRepel() {
		if (!window.swup?.hooks) return;
		window.swup.hooks.on("content:replace", scheduleInitRepelText);
		window.swup.hooks.on("page:view", scheduleInitRepelText);
	}
	if (window.swup?.hooks) {
		bindSwupRepel();
	} else {
		document.addEventListener("swup:enable", bindSwupRepel);
	}
</script>
