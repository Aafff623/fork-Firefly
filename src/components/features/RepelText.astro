---
/**
 * RepelText — agent-cfo landing DecodeHeadline 的 vanilla 复刻（丝滑版）
 *
 * 效果（对照 decode-headline.tsx + use-pointer-repel.ts）：
 *   ① 逐词上浮淡入（opacity 0→1, y 14px→0, 词间 stagger）
 *   ② 鼠标 110px 半径内字符被推开，离开后弹簧回位
 *
 * 用法：给目标元素加 class "repel-text"，本组件自动增强。
 * Swup 换页后自动重新扫描；尊重 prefers-reduced-motion。
 */
---

<style is:global>
	.repel-text {
		cursor: crosshair;
	}

	.repel-word {
		display: inline-block;
		white-space: nowrap;
		opacity: 0;
		transform: translateY(14px);
		animation: repel-word-in 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
	}

	.repel-char {
		display: inline-block;
		will-change: transform;
		transform: translate3d(0, 0, 0);
	}

	/* 斥力激活时弱化父级阴影，避免拆字层每帧重绘昂贵 text-shadow */
	.banner-title.repel-text.is-repelling,
	.banner-post-title.repel-text.is-repelling {
		text-shadow: none !important;
	}

	@keyframes repel-word-in {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.repel-word {
			opacity: 1;
			transform: none;
			animation: none;
		}
	}
</style>

<script>
	const REPEL_RADIUS = 110;
	const REPEL_STRENGTH = 2.8;
	const SPRING = 0.11;
	const DAMPING = 0.78;
	const WORD_STAGGER_MS = 55;
	/** 位移变化小于此值则跳过写 DOM（约 0.05px） */
	const WRITE_EPS = 0.05;

	interface RepelState {
		x: number;
		y: number;
		vx: number;
		vy: number;
		centerX: number;
		centerY: number;
		/** 上次写入 DOM 的位移 */
		wx: number;
		wy: number;
	}

	const abortByEl = new WeakMap<HTMLElement, AbortController>();
	const observerByEl = new WeakMap<HTMLElement, ResizeObserver>();

	// 按「词」切分：连续拉丁/数字算一个词，CJK 逐字成词（中文没有空格分词）
	function splitWords(text: string): string[] {
		const words: string[] = [];
		let buf = "";
		const flush = () => {
			if (buf) {
				words.push(buf);
				buf = "";
			}
		};
		for (const ch of Array.from(text)) {
			if (/\s/.test(ch)) {
				flush();
				continue;
			}
			if (/[㐀-鿿豈-﫿　-〿＀-￯]/.test(ch)) {
				flush();
				words.push(ch);
			} else {
				buf += ch;
			}
		}
		flush();
		return words;
	}

	function teardown(el: HTMLElement) {
		abortByEl.get(el)?.abort();
		abortByEl.delete(el);
		observerByEl.get(el)?.disconnect();
		observerByEl.delete(el);
		el.classList.remove("is-repelling");
		delete el.dataset.repelBound;
	}

	function enhance(el: HTMLElement) {
		// 已拆词且仍有字符节点 → 跳过；Swup 换入的新标题需重新增强
		if (el.dataset.repelDone === "1" && el.querySelector(".repel-char")) return;

		const text = (el.textContent || "").trim();
		if (!text) return;

		// 同元素重建时先卸旧监听 / observer，避免 Profile + banner 或 Swup 重扫泄漏
		teardown(el);

		el.dataset.repelDone = "1";
		el.replaceChildren();

		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const words = splitWords(text);

		words.forEach((word, i) => {
			const w = document.createElement("span");
			w.className = "repel-word";
			w.style.animationDelay = `${i * WORD_STAGGER_MS}ms`;
			for (const ch of Array.from(word)) {
				const c = document.createElement("span");
				c.className = "repel-char";
				c.textContent = ch;
				w.appendChild(c);
			}
			el.appendChild(w);
			if (i < words.length - 1) el.appendChild(document.createTextNode(" "));
		});

		if (reduced) return;

		el.dataset.repelBound = "1";
		const ac = new AbortController();
		abortByEl.set(el, ac);
		const { signal } = ac;

		let elements: HTMLElement[] = [];
		let states: RepelState[] = [];
		let frame = 0;
		const pointer = { x: -9999, y: -9999, active: false };

		const measure = () => {
			elements = Array.from(el.querySelectorAll<HTMLElement>(".repel-char"));
			// 批量读 layout，避免读写交错造成抖动
			const rects = elements.map((node) => node.getBoundingClientRect());
			states = elements.map((_, index) => {
				const rect = rects[index];
				const prev = states[index];
				const px = prev?.x ?? 0;
				const py = prev?.y ?? 0;
				return {
					x: px,
					y: py,
					vx: prev?.vx ?? 0,
					vy: prev?.vy ?? 0,
					centerX: rect.left + rect.width / 2 - px,
					centerY: rect.top + rect.height / 2 - py,
					wx: prev?.wx ?? 0,
					wy: prev?.wy ?? 0,
				};
			});
		};

		const writeTransform = (element: HTMLElement, s: RepelState) => {
			if (Math.abs(s.x - s.wx) < WRITE_EPS && Math.abs(s.y - s.wy) < WRITE_EPS) return;
			s.wx = s.x;
			s.wy = s.y;
			// 数值拼串，避免每帧 toFixed 造临时字符串压力
			const rx = Math.round(s.x * 100) / 100;
			const ry = Math.round(s.y * 100) / 100;
			element.style.transform = `translate3d(${rx}px, ${ry}px, 0)`;
		};

		const tick = () => {
			let moving = false;
			const n = elements.length;
			for (let index = 0; index < n; index++) {
				const element = elements[index];
				const s = states[index];
				if (!element || !s) continue;

				if (pointer.active) {
					const dx = s.centerX + s.x - pointer.x;
					const dy = s.centerY + s.y - pointer.y;
					const dist = Math.hypot(dx, dy);
					if (dist < REPEL_RADIUS && dist > 1) {
						const force = (1 - dist / REPEL_RADIUS) * REPEL_STRENGTH;
						s.vx += (dx / dist) * force;
						s.vy += (dy / dist) * force;
					}
				}
				s.vx += -s.x * SPRING;
				s.vy += -s.y * SPRING;
				s.vx *= DAMPING;
				s.vy *= DAMPING;
				s.x += s.vx;
				s.y += s.vy;

				const active =
					Math.abs(s.vx) > 0.03 ||
					Math.abs(s.vy) > 0.03 ||
					(!pointer.active && (Math.abs(s.x) > 0.08 || Math.abs(s.y) > 0.08));
				if (!pointer.active && !active) {
					s.x = 0;
					s.y = 0;
					s.vx = 0;
					s.vy = 0;
				}

				writeTransform(element, s);
				moving = moving || active;
			}
			frame = moving ? requestAnimationFrame(tick) : 0;
		};

		const start = () => {
			if (!frame) frame = requestAnimationFrame(tick);
		};

		el.addEventListener(
			"pointerenter",
			() => {
				measure();
				el.classList.add("is-repelling");
			},
			{ signal },
		);
		// 只记坐标；写 DOM 全交给 rAF。passive 避免阻塞滚动合成
		el.addEventListener(
			"pointermove",
			(e: PointerEvent) => {
				pointer.x = e.clientX;
				pointer.y = e.clientY;
				pointer.active = true;
				start();
			},
			{ signal, passive: true },
		);
		el.addEventListener(
			"pointerleave",
			() => {
				pointer.active = false;
				el.classList.remove("is-repelling");
				start();
			},
			{ signal },
		);

		if (typeof ResizeObserver !== "undefined") {
			const ro = new ResizeObserver(() => {
				measure();
			});
			ro.observe(el);
			observerByEl.set(el, ro);
		}
		measure();
	}

	function initRepelText() {
		document.querySelectorAll(".repel-text").forEach((node) => enhance(node as HTMLElement));
	}

	function scheduleInitRepelText() {
		requestAnimationFrame(() => {
			initRepelText();
			// 横幅 overlay 经 Swup 替换后偶发晚一拍，再扫一次
			window.setTimeout(initRepelText, 80);
		});
	}

	initRepelText();

	document.addEventListener("swup:contentReplaced", scheduleInitRepelText);
	document.addEventListener("swup:page:view", scheduleInitRepelText);

	function bindSwupRepel() {
		if (!window.swup?.hooks) return;
		window.swup.hooks.on("content:replace", scheduleInitRepelText);
		window.swup.hooks.on("page:view", scheduleInitRepelText);
	}
	if (window.swup?.hooks) {
		bindSwupRepel();
	} else {
		document.addEventListener("swup:enable", bindSwupRepel);
	}
</script>
