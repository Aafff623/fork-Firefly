---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

export interface Props {
	playerUrl: string | string[];
	playerMode?: "order" | "random";
	/** 与横幅壁纸 object-position 对齐，避免切换时裁切不一致露出底色 */
	objectPosition?: string;
}

const {
	playerUrl,
	playerMode = "order",
	objectPosition = "center",
} = Astro.props;

const urls = Array.isArray(playerUrl) ? playerUrl : [playerUrl];
const hasMultiple = urls.length > 1;
const urlsJson = JSON.stringify(urls);

const tPrev = i18n(I18nKey.videoPrev);
const tNext = i18n(I18nKey.videoNext);
const tLoadError = i18n(I18nKey.videoLoadError);
---

{
	urls.length > 0 && (
		<div id="bg-player" class="absolute inset-0 pointer-events-none" aria-hidden="true" data-player-urls={urlsJson} data-player-mode={playerMode} data-player-multiple={hasMultiple ? "true" : "false"}>
			<div
				id="bg-player-overlay"
				class="absolute inset-0 z-[6] overflow-hidden bg-black pointer-events-none transition-opacity duration-500 ease-in-out opacity-0"
			>
				<video
					id="bg-player-video"
					preload="none"
					playsinline
					webkit-playsinline
					class="absolute inset-0 size-full min-w-full min-h-full object-cover"
					style={`object-position: ${objectPosition}; transform: scale(1.02); transform-origin: center;`}
				></video>
			</div>

			<div id="bg-player-controls" class="absolute bottom-4 left-4 z-30 flex items-center gap-1.5 group pointer-events-auto">
				{hasMultiple && (
					<button
						id="bg-prev-btn"
						class="w-11 h-11 flex items-center justify-center rounded-full border border-white/30 bg-black/35 text-white/50 backdrop-blur-sm cursor-pointer transition-all duration-200 opacity-0 scale-90 group-hover:opacity-50 group-hover:scale-100 hover:opacity-80! hover:scale-100!"
						title={tPrev}
						aria-label={tPrev}
					>
						<Icon is:inline name="lucide:skip-back" class="text-[1rem]" />
					</button>
				)}

				{hasMultiple && (
					<button
						id="bg-next-btn"
						class="w-11 h-11 flex items-center justify-center rounded-full border border-white/30 bg-black/35 text-white/50 backdrop-blur-sm cursor-pointer transition-all duration-200 opacity-0 scale-90 group-hover:opacity-50 group-hover:scale-100 hover:opacity-80! hover:scale-100!"
						title={tNext}
						aria-label={tNext}
					>
						<Icon is:inline name="lucide:skip-forward" class="text-[1rem]" />
					</button>
				)}
			</div>

			<div
				id="bg-player-toast"
				class="fixed bottom-20 left-1/2 -translate-x-1/2 z-100 px-4 py-2 rounded-lg bg-black/70 text-white text-sm backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-none"
			>
				{tLoadError}
			</div>
		</div>
	)
}

<script is:inline defer data-swup-ignore-script src="/scripts/background-player.js"></script>

<style>
	/* 仅在真正开始播放后才藏壁纸层；加载中保持壁纸可见垫底 */
	:global([data-bg-video-playing] #banner-images-container),
	:global([data-bg-video-playing] #banner-dim-container),
	:global([data-bg-video-playing] #banner-overlay-container),
	:global([data-bg-video-playing] #header-waves),
	:global([data-bg-video-playing] #wallpaper-gradient) {
		opacity: 0 !important;
		transition: opacity 0.5s ease;
	}

	:global([data-bg-video-playing] #wallpaper-wrapper),
	:global([data-bg-video-loading] #wallpaper-wrapper) {
		background-color: #000;
	}

	:global([data-bg-video-loading] #bg-player-toggle) {
		opacity: 0.55;
		pointer-events: none;
	}
</style>
