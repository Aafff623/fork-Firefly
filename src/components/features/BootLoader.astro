---
/**
 * 硬刷新第一帧：用同色罩挡住壁纸未到时的纯色底。
 * 中心是萤火扣（可点跳过）。软导航不重演；embed 页不挂。
 */
interface Props {
	lang?: string;
}

const { lang = "zh_CN" } = Astro.props;
const isZh = lang.toLowerCase().startsWith("zh");
const skipLabel = isZh ? "页面加载中，点击跳过" : "Loading — click to skip";
---

<style is:inline>
	/* Hallmark · pre-emit critique: P4 H4 E4 S5 R4 V4 */
	#ff-boot {
		--ff-veil: var(--page-bg, oklch(0.16 0.005 260));
		--ff-ink: color-mix(in oklch, var(--deep-text, oklch(0.92 0.01 120)) 88%, transparent);
		--ff-rim: color-mix(in oklch, var(--primary, oklch(0.72 0.1 145)) 42%, oklch(0.82 0.06 95));
		--ff-glass: color-mix(in oklch, var(--page-bg, oklch(0.16 0.005 260)) 72%, oklch(0.28 0.02 145));
		--ff-bug: oklch(0.93 0.09 98);
		--ff-glow: oklch(0.86 0.14 95 / 0.62);
		--ff-ease: cubic-bezier(0.22, 1, 0.36, 1);
		position: fixed;
		inset: 0;
		z-index: 99950;
		display: grid;
		place-items: center;
		margin: 0;
		background: var(--ff-veil);
		color: var(--ff-ink);
		pointer-events: auto;
		animation: ff-boot-failsafe 0.36s 2.2s forwards;
	}
	#ff-boot.is-hold {
		animation: none;
	}
	#ff-boot.is-leaving {
		animation: none;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 0.52s var(--ff-ease),
			visibility 0.52s var(--ff-ease);
	}
	.ff-boot__jar {
		position: relative;
		width: 4.65rem;
		height: 4.65rem;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: transparent;
		cursor: pointer;
		appearance: none;
		-webkit-appearance: none;
		color: inherit;
	}
	.ff-boot__jar:focus {
		outline: none;
	}
	.ff-boot__jar:focus-visible {
		box-shadow: 0 0 0 3px color-mix(in oklch, var(--ff-rim) 55%, transparent);
	}
	.ff-boot__glass {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background:
			radial-gradient(ellipse 55% 40% at 38% 28%, oklch(1 0 0 / 0.22), transparent 58%),
			var(--ff-glass);
		border: 1px solid color-mix(in oklch, var(--ff-rim) 55%, transparent);
		box-shadow:
			inset 0 1px 0 oklch(1 0 0 / 0.18),
			inset 0 -8px 16px oklch(0.12 0.02 145 / 0.28),
			0 0 0 1px color-mix(in oklch, var(--ff-rim) 22%, transparent),
			0 10px 28px oklch(0.1 0.02 145 / 0.28);
		overflow: hidden;
	}
	.ff-boot__sheen {
		position: absolute;
		inset: -20%;
		background: conic-gradient(
			from 0deg,
			transparent 0deg,
			color-mix(in oklch, var(--ff-rim) 70%, white) 18deg,
			transparent 42deg,
			transparent 360deg
		);
		animation: ff-sheen 2.4s linear infinite;
		opacity: 0.55;
		pointer-events: none;
	}
	.ff-boot__latch {
		position: absolute;
		left: 50%;
		bottom: 0.18rem;
		width: 0.62rem;
		height: 0.28rem;
		margin-left: -0.31rem;
		border-radius: 999px;
		background: color-mix(in oklch, var(--ff-rim) 80%, white);
		box-shadow: 0 0 6px color-mix(in oklch, var(--ff-glow) 40%, transparent);
		pointer-events: none;
	}
	.ff-boot__stage {
		position: absolute;
		inset: 0.7rem;
		pointer-events: none;
	}
	.ff-boot__loop {
		position: absolute;
		inset: 0;
		animation: ff-spin 1.32s linear infinite;
	}
	.ff-boot__bug {
		position: absolute;
		top: 8%;
		left: 50%;
		width: 0.38rem;
		height: 0.38rem;
		margin-left: -0.19rem;
		border-radius: 50%;
		background: var(--ff-bug);
		box-shadow:
			0 0 0.15rem 0.04rem oklch(1 0 0 / 0.85),
			0 0 0.7rem 0.22rem var(--ff-glow);
		animation: ff-bob 0.66s ease-in-out infinite alternate;
	}
	.ff-boot__bug::before,
	.ff-boot__bug::after {
		content: "";
		position: absolute;
		top: 0.08rem;
		width: 0.34rem;
		height: 0.16rem;
		border-radius: 50%;
		background: oklch(0.96 0.04 95 / 0.45);
		animation: ff-wing 0.14s steps(2) infinite;
	}
	.ff-boot__bug::before { right: 100%; }
	.ff-boot__bug::after { left: 100%; }
	.ff-boot__glow {
		position: absolute;
		inset: 12%;
		border-radius: 50%;
		background: radial-gradient(circle, var(--ff-glow), transparent 62%);
		opacity: 0.42;
		animation: ff-breathe 1.5s ease-in-out infinite;
		pointer-events: none;
	}
	#ff-boot.is-leaving .ff-boot__bug {
		animation: ff-escape 0.55s var(--ff-ease) forwards;
	}
	#ff-boot.is-leaving .ff-boot__glass {
		transform: scale(0.86);
		opacity: 0.2;
		transition: transform 0.5s var(--ff-ease), opacity 0.5s var(--ff-ease);
	}
	@keyframes ff-spin { to { transform: rotate(1turn); } }
	@keyframes ff-bob { to { transform: translateY(1.55rem); } }
	@keyframes ff-sheen { to { transform: rotate(1turn); } }
	@keyframes ff-breathe {
		50% { opacity: 0.72; transform: scale(1.06); }
	}
	@keyframes ff-wing { 50% { opacity: 0.2; } }
	@keyframes ff-escape {
		to { transform: translate(2.6rem, -3.4rem) scale(0.35); opacity: 0; }
	}
	@keyframes ff-boot-failsafe {
		to { opacity: 0; visibility: hidden; pointer-events: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.ff-boot__loop,
		.ff-boot__bug,
		.ff-boot__bug::before,
		.ff-boot__bug::after,
		.ff-boot__sheen,
		.ff-boot__glow {
			animation: none !important;
		}
		#ff-boot,
		#ff-boot.is-leaving {
			animation: none;
			transition-duration: 0.12s;
		}
	}
</style>

<div id="ff-boot" role="status" aria-live="polite" aria-busy="true">
	<button type="button" class="ff-boot__jar" id="ff-boot-skip" aria-label={skipLabel}>
		<span class="ff-boot__glass" aria-hidden="true">
			<span class="ff-boot__sheen"></span>
			<span class="ff-boot__glow"></span>
			<span class="ff-boot__stage">
				<span class="ff-boot__loop">
					<span class="ff-boot__bug"></span>
				</span>
			</span>
			<span class="ff-boot__latch"></span>
		</span>
	</button>
</div>

<noscript>
	<style>#ff-boot{display:none!important}</style>
</noscript>

<script is:inline>
	(function () {
		var root = document.getElementById("ff-boot");
		if (!root || window.__ffBootBound) return;
		window.__ffBootBound = true;
		document.documentElement.classList.add("ff-booting");

		var gone = false;
		var started = Date.now();
		var MIN_MS = 420;
		var MAX_MS = 1400;

		function leave() {
			if (gone) return;
			gone = true;
			root.classList.add("is-leaving");
			root.setAttribute("aria-busy", "false");
			document.documentElement.classList.remove("ff-booting");
			window.setTimeout(function () {
				if (root.parentNode) root.parentNode.removeChild(root);
			}, 560);
		}

		function afterMin(fn) {
			var wait = MIN_MS - (Date.now() - started);
			if (wait > 0) window.setTimeout(fn, wait);
			else fn();
		}

		function bannerReady() {
			return new Promise(function (resolve) {
				var tryImg = function () {
					var img = document.querySelector("#wallpaper-wrapper img");
					if (!img) {
						resolve();
						return;
					}
					if (img.complete && img.naturalWidth > 0) {
						resolve();
						return;
					}
					img.addEventListener("load", resolve, { once: true });
					img.addEventListener("error", resolve, { once: true });
				};
				if (document.readyState === "loading") {
					document.addEventListener("DOMContentLoaded", tryImg, { once: true });
				} else {
					tryImg();
				}
			});
		}

		var skip = document.getElementById("ff-boot-skip");
		if (skip) skip.addEventListener("click", leave);
		var hold = /[?&]boot=hold(?:&|$)/.test(location.search);
		if (hold) root.classList.add("is-hold");
		if (!hold) {
			Promise.race([
				bannerReady(),
				new Promise(function (resolve) {
					window.setTimeout(resolve, MAX_MS);
				}),
			]).then(function () {
				afterMin(leave);
			});
		}
		document.addEventListener(
			"keydown",
			function onKey(e) {
				if (e.key === "Escape") {
					leave();
					document.removeEventListener("keydown", onKey);
				}
			},
			{ passive: true },
		);
		window.addEventListener(
			"scroll",
			function onScroll() {
				if ((window.scrollY || document.documentElement.scrollTop || 0) > 24) {
					leave();
					window.removeEventListener("scroll", onScroll);
				}
			},
			{ passive: true },
		);
	})();
</script>
