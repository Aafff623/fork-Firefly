---
/**
 * 卡片质感立体标签球（TagCloud.js）。
 * 闲置慢转 · 拖拽灵敏加速 · 轻点一级标签 → /timeline/?tag=
 * 支持 data-view-mode=sphere|list；侧栏标签墙与 /tags/ 复用。
 */
import { getTagList } from "@/utils/content-utils";
import { getTagUrl } from "@/utils/url-utils";

interface Props {
	class?: string;
	/** 球半径（TagCloud radius） */
	radius?: number;
	/** 最多进球标签数；默认 12 */
	limit?: number;
	/** 外框上方标题；空字符串则不显示 */
	title?: string;
	/** 自定义标签；不传则用全站列表。kind=theme 为二级主题（另色、不可点） */
	tags?: { name: string; count: number; kind?: "primary" | "theme" }[];
	/** 「还有 N 个」链到全站标签页 */
	moreHref?: string;
	moreCount?: number;
	/** 侧栏紧凑尺寸 */
	compact?: boolean;
	/** 初始视图：侧栏默认球，/tags/ 页默认列表 */
	defaultMode?: "sphere" | "list";
}

const {
	class: className,
	radius = 72,
	limit = 12,
	title = "",
	tags: tagsProp,
	moreHref,
	moreCount = 0,
	compact = false,
	defaultMode = "sphere",
} = Astro.props;

const initialMode = defaultMode === "list" ? "list" : "sphere";

const source = tagsProp ?? (await getTagList());
const ranked = [...source]
	.map((t) => {
		const rawKind =
			"kind" in t ? (t as { kind?: string }).kind : undefined;
		return {
			name: String(t.name).trim(),
			count: Number(t.count) || 0,
			kind: (rawKind === "theme" ? "theme" : "primary") as
				| "primary"
				| "theme",
		};
	})
	.filter((t) => t.name)
	.sort((a, b) => {
		// 聚焦态：保持传入顺序；浏览态仍按热度
		if (!tagsProp) {
			if (b.count !== a.count) return b.count - a.count;
			return a.name.localeCompare(b.name, "zh-CN");
		}
		return 0;
	});

const shown = ranked.slice(0, Math.max(1, limit));
const cloudId = `tag-sphere-${Math.random().toString(36).slice(2, 9)}`;
/** 进球条目（含 kind，供 remount / 首挂） */
const sphereItems = shown.map((t) => ({ name: t.name, kind: t.kind }));
const hrefByName = Object.fromEntries(
	ranked
		.filter((t) => t.kind !== "theme")
		.map((t) => [t.name, getTagUrl(t.name)]),
);
const showMore = Boolean(moreHref && moreCount > 0);
---

{/* Caveat：英文标签手写体；马善政补中文 */}
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Ma+Shan+Zheng&display=swap"
/>

<section
  class:list={[
    "tag-sphere",
    compact && "tag-sphere--compact",
    className,
  ]}
  data-tag-chalk-sphere
  data-tag-sphere
  data-cloud-id={cloudId}
  data-radius={radius}
  data-href-map={JSON.stringify(hrefByName)}
  data-view-mode={initialMode}
  data-ready={initialMode === "list" ? "1" : "0"}
  style={`--tag-sphere-d: ${Math.max(8, radius * 2)}px;`}
  aria-label={title || "标签立体球"}
>
  {title ? <h3 class="tag-sphere__title">{title}</h3> : null}
  <div class="tag-sphere__frame" data-tag-sphere-frame hidden={initialMode === "list"}>
    {/* 球未就绪时仅占位，避免空白框外再露列表 */}
    <div class="tag-sphere__placeholder" data-tag-sphere-placeholder aria-hidden="true">
      <span class="tag-sphere__placeholder-pulse"></span>
    </div>
    <div class="tag-sphere__stage">
      <div class="tag-sphere__cloud" id={cloudId}></div>
    </div>
  </div>
  {/* 列表模式默认露出；球模式隐藏 */}
  <ul class="tag-sphere__fallback" data-tag-chalk-fallback hidden={initialMode !== "list"}>
    {
      shown.map((t) => (
        <li>
          {t.kind === "theme" ? (
            <span class="tag-sphere__fallback-theme" title="主题标签（不计入统计）">
              #{t.name}
            </span>
          ) : (
            <a href={getTagUrl(t.name)} draggable="false">
              #{t.name}
              <span>({t.count})</span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
  {
    showMore && (
      <a class="tag-sphere__more" href={moreHref} data-tag-chalk-more>
        … +{moreCount}
      </a>
    )
  }
</section>

<script
  is:inline
  define:vars={{ cloudId, sphereItems, hrefByName, radius }}
  data-swup-ignore-script
>
  (function () {
    var SCRIPT_SRC =
      "https://cdn.jsdelivr.net/npm/TagCloud@2.5.0/dist/TagCloud.min.js";
    var DRAG_PX = 6;
    // 闲置慢 / 拖拽快（数值档，库内 slow=0.5 仍偏快）
    var IDLE_MAX_SPEED = 0.28;
    var DRAG_MAX_SPEED = 3.8;
    var IDLE_DIV = 5;
    var DRAG_DIV = 1.15;

    function reducedMotion() {
      return (
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
      );
    }

    function loadTagCloud(cb) {
      if (window.TagCloud) {
        cb();
        return;
      }
      var existed = document.querySelector('script[data-tagcloud-cdn="1"]');
      if (existed) {
        existed.addEventListener("load", cb, { once: true });
        return;
      }
      var s = document.createElement("script");
      s.src = SCRIPT_SRC;
      s.async = true;
      s.dataset.tagcloudCdn = "1";
      s.onload = cb;
      document.head.appendChild(s);
    }

    function destroyCloud(el) {
      if (el && el._tagCloudDestroy) {
        try {
          el._tagCloudDestroy();
        } catch (e) {}
        el._tagCloudDestroy = null;
      }
      if (el) {
        el._tagCloudInstance = null;
        el.innerHTML = "";
      }
    }

    function normalizeItems(list) {
      return (list || []).map(function (item) {
        if (typeof item === "string") {
          return { name: item, kind: "primary" };
        }
        return {
          name: String(item.name || "").trim(),
          kind: item.kind === "theme" ? "theme" : "primary",
        };
      }).filter(function (it) {
        return it.name;
      });
    }

    function fallbackTagHref(name) {
      return (
        "/timeline/?tag=" + encodeURIComponent(String(name).trim())
      );
    }

    function toHtmlItems(itemList, map) {
      return normalizeItems(itemList).map(function (it) {
        var safe = String(it.name)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/"/g, "&quot;");
        if (it.kind === "theme") {
          return (
            '<span class="tag-sphere__link tag-sphere__link--theme" title="主题标签（不计入统计）">#' +
            safe +
            "</span>"
          );
        }
        var href = (map && map[it.name]) || fallbackTagHref(it.name);
        return (
          '<a class="tag-sphere__link tag-sphere__link--primary" href="' +
          href +
          '" draggable="false">#' +
          safe +
          "</a>"
        );
      });
    }

    /** sensitivityDiv：闲置 5，拖拽 2.5 更跟手 */
    function applyPointerToInstance(instance, cloudEl, clientX, clientY, sensitivityDiv) {
      if (!instance || !cloudEl) return;
      var div = sensitivityDiv || IDLE_DIV;
      var rect = cloudEl.getBoundingClientRect();
      instance.mouseX = (clientX - (rect.left + rect.width / 2)) / div;
      instance.mouseY = (clientY - (rect.top + rect.height / 2)) / div;
      instance.active = true;
    }

    function setIdleSpeed(instance) {
      if (!instance) return;
      instance.maxSpeed = IDLE_MAX_SPEED;
    }

    function setDragSpeed(instance) {
      if (!instance) return;
      instance.maxSpeed = DRAG_MAX_SPEED;
    }

    function disarmNativeLinkDrag(host) {
      if (!host || host._tagSphereDragArmed) return;
      host._tagSphereDragArmed = true;
      host.addEventListener(
        "dragstart",
        function (ev) {
          ev.preventDefault();
        },
        true,
      );
    }

    /** 球/列表视图；列表模式暂停球并露出 chalk 列表 */
    function applyViewMode(root, mode) {
      if (!root) return;
      var next = mode === "list" ? "list" : "sphere";
      if (reducedMotion()) next = "list";
      root.setAttribute("data-view-mode", next);
      var frame = root.querySelector("[data-tag-sphere-frame]");
      var fallback = root.querySelector("[data-tag-chalk-fallback]");
      var cloudHost = root.querySelector(".tag-sphere__cloud");
      var instance = cloudHost && cloudHost._tagCloudInstance;

      if (next === "list") {
        if (fallback) fallback.hidden = false;
        if (frame) frame.setAttribute("hidden", "");
        if (instance && typeof instance.pause === "function") instance.pause();
      } else {
        if (fallback) fallback.hidden = true;
        if (frame) frame.removeAttribute("hidden");
        if (instance && typeof instance.resume === "function") instance.resume();
      }
    }

    window.__setTagChalkSphereMode = function (rootOrSelector, mode) {
      var root =
        typeof rootOrSelector === "string"
          ? document.querySelector(rootOrSelector)
          : rootOrSelector;
      if (!root) return;
      applyViewMode(root, mode);
    };

    function bindDragAndClick(el, root) {
      var frame =
        (root && root.querySelector("[data-tag-sphere-frame]")) || el;
      if (!frame || frame._tagSphereInteractBound) return;
      frame._tagSphereInteractBound = true;
      disarmNativeLinkDrag(frame);

      var pressed = false;
      var dragged = false;
      var suppressClick = false;
      var pointerId = null;
      var sx = 0;
      var sy = 0;

      function cloudBox() {
        return el.querySelector(".tagcloud") || el;
      }

      function onDown(ev) {
        if (ev.button != null && ev.button !== 0) return;
        if (root && root.getAttribute("data-view-mode") === "list") return;
        pressed = true;
        dragged = false;
        suppressClick = false;
        sx = ev.clientX;
        sy = ev.clientY;
        pointerId = ev.pointerId;
        try {
          frame.setPointerCapture(ev.pointerId);
        } catch (e) {}
        setDragSpeed(el._tagCloudInstance);
        applyPointerToInstance(
          el._tagCloudInstance,
          cloudBox(),
          ev.clientX,
          ev.clientY,
          DRAG_DIV,
        );
      }

      function onMove(ev) {
        if (!pressed) return;
        var dx = ev.clientX - sx;
        var dy = ev.clientY - sy;
        if (!dragged && dx * dx + dy * dy > DRAG_PX * DRAG_PX) {
          dragged = true;
          suppressClick = true;
          frame.classList.add("is-dragging");
        }
        if (dragged && ev.cancelable) ev.preventDefault();
        setDragSpeed(el._tagCloudInstance);
        applyPointerToInstance(
          el._tagCloudInstance,
          cloudBox(),
          ev.clientX,
          ev.clientY,
          DRAG_DIV,
        );
      }

      function onUp() {
        if (!pressed) return;
        pressed = false;
        if (pointerId != null) {
          try {
            frame.releasePointerCapture(pointerId);
          } catch (e) {}
          pointerId = null;
        }
        frame.classList.remove("is-dragging");
        setIdleSpeed(el._tagCloudInstance);
        if (suppressClick) {
          setTimeout(function () {
            suppressClick = false;
            dragged = false;
          }, 0);
        } else {
          dragged = false;
        }
      }

      frame.addEventListener("pointerdown", onDown);
      frame.addEventListener("pointermove", onMove, { passive: false });
      frame.addEventListener("pointerup", onUp);
      frame.addEventListener("pointercancel", onUp);

      frame.addEventListener(
        "click",
        function (ev) {
          if (!suppressClick && !dragged) return;
          ev.preventDefault();
          ev.stopPropagation();
        },
        true,
      );
    }

    function markReady(root, ready) {
      if (!root) return;
      root.setAttribute("data-ready", ready ? "1" : "0");
    }

    function mountWith(el, nextItems, nextHrefMap, nextRadius) {
      if (!el || !window.TagCloud) return;
      destroyCloud(el);
      var root = el.closest("[data-tag-sphere], [data-tag-chalk-sphere]");
      var fallback = root && root.querySelector("[data-tag-chalk-fallback]");
      var normalized = normalizeItems(nextItems);
      var mode =
        (root && root.getAttribute("data-view-mode")) || "sphere";

      if (reducedMotion() || !normalized.length) {
        el._tagCloudInstance = null;
        markReady(root, true);
        applyViewMode(root, "list");
        if (fallback) fallback.hidden = false;
        return;
      }

      // 列表模式：不挂球，只露列表
      if (mode === "list") {
        el._tagCloudInstance = null;
        markReady(root, true);
        applyViewMode(root, "list");
        return;
      }

      var htmlItems = toHtmlItems(normalized, nextHrefMap);
      var r = Number(nextRadius) || 72;
      var instance = window.TagCloud("#" + el.id, htmlItems, {
        radius: r,
        maxSpeed: "slow",
        initSpeed: "slow",
        direction: 135,
        keep: true,
        useHTML: true,
      });
      el._tagCloudInstance = instance || null;
      setIdleSpeed(instance);

      el._tagCloudDestroy = function () {
        if (el._tagColorWatch) {
          cancelAnimationFrame(el._tagColorWatch);
          el._tagColorWatch = 0;
        }
        el._tagCloudInstance = null;
        if (instance && typeof instance.destroy === "function") {
          instance.destroy();
        }
      };

      var links = el.querySelectorAll("a.tag-sphere__link--primary");
      for (var li = 0; li < links.length; li++) {
        links[li].setAttribute("draggable", "false");
      }

      function enhanceDepthStack() {
        var nodes = el.querySelectorAll(".tagcloud--item");
        for (var i = 0; i < nodes.length; i++) {
          var node = nodes[i];
          if (node.style && node.style.color) node.style.color = "";
          var tr = node.style.transform || node.style.webkitTransform || "";
          var m = tr.match(/scale\(([\d.]+)\)/);
          if (!m) continue;
          var per = parseFloat(m[1]);
          if (isNaN(per)) continue;
          var alpha = Math.max(0, Math.min(1, per * per - 0.25));
          alpha = Math.pow(alpha, 1.55);
          node.style.opacity = String(alpha);
          node.style.filter = "alpha(opacity=" + Math.round(alpha * 100) + ")";
          node.style.zIndex = String(Math.round(per * 1000));
        }
        el._tagColorWatch = requestAnimationFrame(enhanceDepthStack);
      }
      enhanceDepthStack();

      var d = r * 2 + "px";
      el.style.width = d;
      el.style.height = d;
      el.style.margin = "0 auto";
      el.style.position = "relative";
      el.style.left = "0";
      el.style.right = "0";
      el.style.display = "block";
      if (root) root.style.setProperty("--tag-sphere-d", d);

      bindDragAndClick(el, root);
      if (fallback) fallback.hidden = true;
      markReady(root, true);
      applyViewMode(root, "sphere");
    }

    function mount() {
      var el = document.getElementById(cloudId);
      if (!el) return;
      var root = el.closest("[data-tag-sphere], [data-tag-chalk-sphere]");
      markReady(root, false);
      mountWith(el, sphereItems, hrefByName, radius);
    }

    function boot() {
      var el = document.getElementById(cloudId);
      var root = el && el.closest("[data-tag-sphere], [data-tag-chalk-sphere]");
      if (reducedMotion()) {
        markReady(root, true);
        applyViewMode(root, "list");
        return;
      }
      loadTagCloud(mount);
    }

    window.__remountTagChalkSphere = function (id, nextItems) {
      var el = document.getElementById(id);
      if (!el) return;
      var root = el.closest("[data-tag-sphere], [data-tag-chalk-sphere]");
      var r = Number((root && root.getAttribute("data-radius")) || radius);
      var map = hrefByName;
      try {
        var raw = root && root.getAttribute("data-href-map");
        if (raw) map = JSON.parse(raw);
      } catch (e) {}
      markReady(root, false);
      loadTagCloud(function () {
        mountWith(el, nextItems, map, r);
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot);
    } else {
      boot();
    }

    document.addEventListener("swup:page:view", boot);
    document.addEventListener("swup:enable", function () {
      if (window.swup && window.swup.hooks) {
        window.swup.hooks.on("page:view", boot);
      }
    });
  })();
</script>

<style>
  .tag-sphere {
    width: 100%;
  }

  .tag-sphere__title {
    margin: 0 0 0.55rem;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .tag-sphere__frame {
    position: relative;
    border-radius: var(--radius-large, 0.75rem);
    background:
      radial-gradient(
        ellipse 90% 80% at 50% 40%,
        color-mix(in oklch, var(--card-bg, #fff) 92%, white) 0%,
        var(--card-bg, #fff) 72%
      );
    border: 1px solid color-mix(in oklch, var(--line-divider, #000) 70%, transparent);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.55) inset,
      0 8px 22px rgb(40 30 20 / 0.06);
    min-height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  .tag-sphere__frame[hidden] {
    display: none !important;
  }

  .tag-sphere__frame.is-dragging {
    cursor: grabbing;
  }

  :global(html.dark) .tag-sphere__frame {
    background:
      radial-gradient(
        ellipse 90% 80% at 50% 38%,
        color-mix(in oklch, var(--card-bg) 88%, white) 0%,
        var(--card-bg) 75%
      );
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.06) inset,
      0 10px 26px rgb(0 0 0 / 0.28);
  }

  .tag-sphere--compact .tag-sphere__frame {
    min-height: 200px;
  }

  /* 加载占位：仅在球模式且未就绪时显示 */
  .tag-sphere__placeholder {
    display: none;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 1;
  }

  .tag-sphere[data-view-mode="sphere"]:not([data-ready="1"]) .tag-sphere__placeholder {
    display: flex;
  }

  .tag-sphere__placeholder-pulse {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 2px solid color-mix(in oklch, var(--primary) 35%, transparent);
    opacity: 0.55;
    animation: tag-sphere-pulse 1.1s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-sphere__placeholder-pulse {
      animation: none;
    }
  }

  @keyframes tag-sphere-pulse {
    0%,
    100% {
      transform: scale(0.92);
      opacity: 0.35;
    }
    50% {
      transform: scale(1);
      opacity: 0.7;
    }
  }

  .tag-sphere__stage {
    width: var(--tag-sphere-d, 140px);
    height: var(--tag-sphere-d, 140px);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  .tag-sphere__cloud,
  .tag-sphere :global(.tagcloud) {
    width: var(--tag-sphere-d, 140px) !important;
    height: var(--tag-sphere-d, 140px) !important;
    max-width: 100%;
    margin: 0 auto !important;
    position: relative !important;
    left: auto !important;
    right: auto !important;
    inset-inline: auto !important;
  }

  .tag-sphere :global(.tagcloud--item) {
    position: absolute !important;
    isolation: isolate;
  }

  .tag-sphere :global(.tagcloud--item),
  .tag-sphere :global(.tag-sphere__link) {
    font-family: "Caveat", "Ma Shan Zheng", "Segoe Script", cursive !important;
    letter-spacing: 0.02em;
    text-decoration: none !important;
    text-shadow: none !important;
    padding: 2px 4px;
    border-radius: 4px;
    font-size: 1.28em !important;
    line-height: 1.15;
  }

  .tag-sphere :global(.tag-sphere__link--primary) {
    color: oklch(0.28 0.01 70) !important;
    font-weight: 700 !important;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  :global(html.dark) .tag-sphere :global(.tag-sphere__link--primary) {
    color: oklch(0.92 0.01 70) !important;
  }

  .tag-sphere :global(.tag-sphere__link--primary:hover) {
    color: oklch(0.12 0.01 70) !important;
  }

  :global(html.dark) .tag-sphere :global(.tag-sphere__link--primary:hover) {
    color: oklch(0.99 0.005 70) !important;
  }

  .tag-sphere :global(.tag-sphere__link--theme) {
    color: oklch(0.55 0.01 70) !important;
    font-weight: 500 !important;
    font-size: 1.18em !important;
    cursor: default;
  }

  :global(html.dark) .tag-sphere :global(.tag-sphere__link--theme) {
    color: oklch(0.68 0.01 70) !important;
  }

  .tag-sphere__fallback {
    margin: 0;
    padding: 0.15rem 0 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.55rem;
    font-family: "Caveat", "Ma Shan Zheng", "Segoe Script", cursive;
    font-size: 1.05rem;
  }

  .tag-sphere__fallback[hidden] {
    display: none !important;
  }

  .tag-sphere[data-view-mode="list"] .tag-sphere__fallback:not([hidden]) {
    display: flex;
  }

  .tag-sphere__fallback a {
    color: oklch(0.32 0.01 70);
    text-decoration: none;
    font-weight: 600;
  }

  .tag-sphere__fallback a:hover {
    text-decoration: underline;
    color: oklch(0.18 0.01 70);
  }

  :global(html.dark) .tag-sphere__fallback a {
    color: oklch(0.9 0.01 70);
  }

  .tag-sphere__fallback a span {
    opacity: 0.55;
    margin-left: 0.12rem;
    font-weight: 400;
  }

  .tag-sphere__fallback-theme {
    color: oklch(0.52 0.01 70);
    font-weight: 450;
  }

  :global(html.dark) .tag-sphere__fallback-theme {
    color: oklch(0.68 0.01 70);
  }

  .tag-sphere__more {
    display: block;
    margin-top: 0.55rem;
    text-align: center;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--primary);
    text-decoration: none;
    padding: 0.35rem 0.5rem;
    border-radius: 999px;
    border: 1px dashed color-mix(in oklch, var(--primary) 35%, transparent);
  }

  .tag-sphere__more:hover {
    background: color-mix(in oklch, var(--primary) 10%, transparent);
  }
</style>
