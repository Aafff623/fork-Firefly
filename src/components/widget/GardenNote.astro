---
/**
 * 园径便签：左栏轻量卡，季节/花园短句轮换 + 走进数字花园
 */
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { url } from "@/utils/url-utils";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;

const tips = [
	"今日林间微风，亦宜浇水。",
	"少写一行代码，多种一棵念头。",
	"客来不妨坐下，落叶声里续一壶茶。",
	"枝叶未整齐，心意已先到。",
	"园门半开着，欢迎你慢慢逛。",
];
const dayIndex = Math.floor(Date.now() / 86400000) % tips.length;
const tip = tips[dayIndex];
---

<WidgetLayout
  id="garden-note"
  name="园径便签"
  showTitle={showTitle}
  class:list={["garden-note-widget", className]}
  style={style}
>
  <Icon
    slot="title-leading"
    is:inline
    name="lucide:sprout"
    class="widget-title-icon"
    aria-hidden="true"
  />
  <div class="garden-note">
    <p class="garden-note__tip">{tip}</p>
    <a class="garden-note__link" href={url("/about/")}>
      <span>走进数字花园</span>
      <Icon is:inline name="lucide:arrow-right" class="text-[0.7rem]" />
    </a>
  </div>
</WidgetLayout>

<style>
  .garden-note {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding-bottom: 0.15rem;
  }

  .garden-note__tip {
    margin: 0;
    font-family: "Source Serif 4", Georgia, "Times New Roman", serif;
    font-size: 0.86rem;
    font-style: italic;
    line-height: 1.55;
    letter-spacing: 0.01em;
    color: oklch(0.42 0.04 145);
  }

  :global(html.dark) .garden-note__tip {
    color: oklch(0.78 0.04 145);
  }

  .garden-note__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    width: fit-content;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: oklch(0.45 0.08 145);
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .garden-note__link:hover {
    opacity: 0.8;
    transform: translateX(2px);
  }

  :global(html.dark) .garden-note__link {
    color: oklch(0.72 0.07 145);
  }
</style>
