---
/**
 * 园径便签：左栏轻量卡，季节/花园短句轮换 + 走进数字花园
 * 标语与 MiniMax 预生成氛围底图（及可选循环动底）成对按天切换
 */
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { gardenNotes } from "@/data/garden-notes";
import { getSiteDayIndex } from "@/utils/date-utils";
import { url } from "@/utils/url-utils";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;

// 按站点时区（Asia/Shanghai）日历日轮换，而非 UTC
const dayIndex = getSiteDayIndex(gardenNotes.length);
const note = gardenNotes[dayIndex] ?? gardenNotes[0];
const tip = note.tip;
const bgUrl = note.bg;
const bgMotion = note.bgMotion;
const widgetStyle = [style, `--garden-note-bg: url('${bgUrl}')`]
	.filter(Boolean)
	.join("; ");
---

<WidgetLayout
  id="garden-note"
  name="园径便签"
  showTitle={showTitle}
  class:list={[
    "garden-note-widget",
    bgMotion && "garden-note-widget--motion",
    className,
  ]}
  style={widgetStyle}
>
  <Icon
    slot="title-leading"
    is:inline
    name="lucide:sprout"
    class="widget-title-icon"
    aria-hidden="true"
  />
  {
    bgMotion && (
      <video
        class="garden-note__motion"
        src={bgMotion}
        poster={bgUrl}
        muted
        loop
        playsinline
        autoplay
        preload="metadata"
        aria-hidden="true"
      />
    )
  }
  <div class="garden-note">
    <p class="garden-note__tip">{tip}</p>
    <a class="garden-note__link" href={url("/about/")}>
      <span>走进数字花园</span>
      <Icon is:inline name="lucide:arrow-right" class="text-[0.7rem]" />
    </a>
  </div>
</WidgetLayout>

<style>
  /*
   * 底图 / 动底铺满整张 card（含标题行）。
   * video 虽在 collapse-wrapper 槽内，但定位到 widget-layout，并放开 overflow 裁切。
   */
  :global(widget-layout.garden-note-widget.card-base) {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* 避免标题区露出不透明卡底发白 */
    background-color: transparent !important;
  }

  :global(body.wallpaper-transparent) :global(widget-layout.garden-note-widget.card-base),
  :global(.wallpaper-transparent) :global(widget-layout.garden-note-widget.card-base) {
    background-color: transparent !important;
  }

  :global(widget-layout.garden-note-widget.card-base)::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    border-radius: inherit;
    background-image: var(--garden-note-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.42;
  }

  :global(widget-layout.garden-note-widget.card-base)::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    border-radius: inherit;
    /* 轻 veil：通透够见底图，标题/正文仍可读 */
    background: linear-gradient(
      165deg,
      color-mix(in oklch, var(--card-bg) 48%, transparent) 0%,
      color-mix(in oklch, var(--card-bg) 32%, transparent) 100%
    );
    opacity: 1;
  }

  :global(html.dark) :global(widget-layout.garden-note-widget.card-base)::after {
    background: linear-gradient(
      165deg,
      color-mix(in oklch, var(--card-bg) 55%, transparent) 0%,
      color-mix(in oklch, var(--card-bg) 38%, transparent) 100%
    );
  }

  /* 槽位放开裁切，让 video 能铺到标题行 */
  :global(widget-layout.garden-note-widget #garden-note.collapse-wrapper) {
    position: static;
    overflow: visible !important;
  }

  :global(widget-layout.garden-note-widget.card-base) .garden-note__motion {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.42;
    pointer-events: none;
  }

  /* 有动底时静图略压，避免双层糊死；标题行仍靠同一张 cover */
  :global(widget-layout.garden-note-widget--motion.card-base)::before {
    opacity: 0.28;
  }

  :global(widget-layout.garden-note-widget.card-base) > :global(.widget-title),
  :global(widget-layout.garden-note-widget.card-base) > :global(.collapse-wrapper) {
    position: relative;
    z-index: 2;
    background: transparent;
  }

  .garden-note {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding-bottom: 0.15rem;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(widget-layout.garden-note-widget.card-base) .garden-note__motion {
      display: none;
    }

    :global(widget-layout.garden-note-widget--motion.card-base)::before {
      opacity: 0.42;
    }
  }

  .garden-note__tip {
    margin: 0;
    font-family: "Source Serif 4", Georgia, "Times New Roman", serif;
    font-size: 0.86rem;
    font-style: italic;
    line-height: 1.55;
    letter-spacing: 0.01em;
    color: oklch(0.42 0.04 145);
  }

  :global(html.dark) .garden-note__tip {
    color: oklch(0.78 0.04 145);
  }

  .garden-note__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    width: fit-content;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: oklch(0.45 0.08 145);
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .garden-note__link:hover {
    opacity: 0.8;
    transform: translateX(2px);
  }

  :global(html.dark) .garden-note__link {
    color: oklch(0.72 0.07 145);
  }
</style>
