---
/**
 * 园径便签：左栏轻量卡，季节/花园短句轮换 + 走进数字花园
 * 标语与 MiniMax 预生成氛围底图（及可选循环动底）成对按天切换
 */
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { gardenNotes } from "@/data/garden-notes";
import { getSiteDayIndex } from "@/utils/date-utils";
import { url } from "@/utils/url-utils";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;

// 按站点时区（Asia/Shanghai）日历日轮换，而非 UTC
const dayIndex = getSiteDayIndex(gardenNotes.length);
const note = gardenNotes[dayIndex] ?? gardenNotes[0];
const tip = note.tip;
const bgUrl = note.bg;
const bgMotion = note.bgMotion;
const widgetStyle = [style, `--garden-note-bg: url('${bgUrl}')`]
	.filter(Boolean)
	.join("; ");
---

<WidgetLayout
  id="garden-note"
  name="园径便签"
  showTitle={showTitle}
  class:list={[
    "garden-note-widget",
    bgMotion && "garden-note-widget--motion",
    className,
  ]}
  style={widgetStyle}
>
  <Icon
    slot="title-leading"
    is:inline
    name="lucide:sprout"
    class="widget-title-icon"
    aria-hidden="true"
  />
  {
    bgMotion && (
      <video
        class="garden-note__motion"
        data-src={bgMotion}
        poster={bgUrl}
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
      />
    )
  }
  <div class="garden-note">
    <p class="garden-note__tip">{tip}</p>
    <a class="garden-note__link" href={url("/about/")}>
      <span>走进数字花园</span>
      <Icon is:inline name="lucide:arrow-right" class="text-[0.7rem]" />
    </a>
  </div>
</WidgetLayout>

{/* 首屏 LCP 优化：装饰背景视频等 LCP 落定后再加载+播放（data-src 惰性注入），
    避免 518KB 视频在 LCP 窗口抢带宽/解码。视觉不变，仅推迟启动时机。 */}
{bgMotion && (
  <script is:inline>
    (function () {
      function startGardenNoteMotion() {
        var vids = document.querySelectorAll("video.garden-note__motion[data-src]");
        for (var i = 0; i < vids.length; i++) {
          var v = vids[i];
          if (v.getAttribute("data-started")) continue;
          v.setAttribute("data-started", "1");
          v.src = v.getAttribute("data-src");
          v.removeAttribute("data-src");
          v.load();
          var p = v.play();
          if (p && typeof p.catch === "function") p.catch(function () {});
        }
      }
      // 等 LCP 落定（最大内容绘制完成）再启动；无 LCP API 则回退 load+延时
      var started = false;
      function once() {
        if (started) return;
        started = true;
        startGardenNoteMotion();
      }
      if (typeof PerformanceObserver === "function") {
        try {
          var obs = new PerformanceObserver(function () {
            // 每次 LCP 候选都重置一个短空闲定时器，最后一帧后启动
            if (window.__gnMotionTimer) clearTimeout(window.__gnMotionTimer);
            window.__gnMotionTimer = setTimeout(function () {
              obs.disconnect();
              once();
            }, 800);
          });
          obs.observe({ type: "largest-contentful-paint", buffered: true });
          // 兜底：8s 内无 LCP 也启动
          setTimeout(once, 8000);
        } catch (e) {
          setTimeout(once, 3000);
        }
      } else if (typeof requestIdleCallback === "function") {
        requestIdleCallback(once, { timeout: 4000 });
      } else {
        window.addEventListener("load", function () {
          setTimeout(once, 2000);
        });
      }
    })();
  </script>
)}

<style>
  /*
   * 底图 / 动底铺满整张 card（含标题行）。
   * video 虽在 collapse-wrapper 槽内，但定位到 widget-layout，并放开 overflow 裁切。
   */
  :global(widget-layout.garden-note-widget.card-base) {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /*
     * 对齐「最新动态」：实心卡底，不要透明雾罩。
     * 壁纸透明模式也强制近白底，保证字黑度成立。
     */
    background-color: oklch(0.99 0.004 145 / 0.96) !important;
    border-color: color-mix(in oklch, var(--primary) 18%, oklch(0.7 0.01 145 / 0.28)) !important;
    box-shadow:
      0 1px 2px oklch(0.35 0.02 145 / 0.06),
      0 4px 14px oklch(0.4 0.03 145 / 0.05);
  }

  :global(html.dark) :global(widget-layout.garden-note-widget.card-base) {
    background-color: oklch(0.2 0.012 145 / 0.94) !important;
    border-color: oklch(1 0 0 / 0.14) !important;
    box-shadow:
      0 1px 2px oklch(0 0 0 / 0.35),
      0 8px 22px oklch(0 0 0 / 0.28);
  }

  :global(body.wallpaper-transparent) :global(widget-layout.garden-note-widget.card-base),
  :global(.wallpaper-transparent) :global(widget-layout.garden-note-widget.card-base) {
    /* 覆盖全局透明卡规则：便签必须可读 */
    background-color: oklch(0.99 0.004 145 / 0.96) !important;
  }

  :global(html.dark) :global(body.wallpaper-transparent) :global(widget-layout.garden-note-widget.card-base),
  :global(html.dark) :global(.wallpaper-transparent) :global(widget-layout.garden-note-widget.card-base) {
    background-color: oklch(0.2 0.012 145 / 0.94) !important;
  }

  :global(widget-layout.garden-note-widget.card-base)::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    border-radius: inherit;
    background-image: var(--garden-note-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    /* 仅作淡水印，不抢字 */
    opacity: 0.14;
  }

  /* 不再叠灰雾 veil；字直接压在实心卡上 */
  :global(widget-layout.garden-note-widget.card-base)::after {
    content: none;
  }

  /* 槽位放开裁切，让 video 能铺到标题行 */
  :global(widget-layout.garden-note-widget #garden-note.collapse-wrapper) {
    position: static;
    overflow: visible !important;
  }

  :global(widget-layout.garden-note-widget.card-base) .garden-note__motion {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.12;
    pointer-events: none;
  }

  :global(widget-layout.garden-note-widget--motion.card-base)::before {
    opacity: 0.08;
  }

  :global(html.dark) :global(widget-layout.garden-note-widget--motion.card-base)::before,
  :global(html.dark) :global(widget-layout.garden-note-widget.card-base) .garden-note__motion {
    opacity: 0.1;
  }

  :global(html.dark) :global(widget-layout.garden-note-widget.card-base)::before {
    opacity: 0.12;
  }

  :global(widget-layout.garden-note-widget.card-base) > :global(.widget-title),
  :global(widget-layout.garden-note-widget.card-base) > :global(.collapse-wrapper) {
    position: relative;
    z-index: 2;
    background: transparent;
  }

  .garden-note {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding-bottom: 0.15rem;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(widget-layout.garden-note-widget.card-base) .garden-note__motion {
      display: none;
    }

    :global(widget-layout.garden-note-widget--motion.card-base)::before {
      opacity: 0.14;
    }
  }

  .garden-note__tip {
    margin: 0;
    font-family: "Source Serif 4", Georgia, "Times New Roman", serif;
    font-size: 0.86rem;
    font-style: italic;
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0.01em;
    /* 与「最新动态」ink 正文同黑度 */
    color: oklch(0.2 0.008 265);
    text-shadow: none;
  }

  :global(html.dark) .garden-note__tip {
    color: oklch(0.82 0.01 265);
    text-shadow: none;
  }

  .garden-note__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    width: fit-content;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    /* 与最新动态 ink 强调色同级 */
    color: oklch(0.16 0.008 265);
    text-decoration: none;
    text-shadow: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .garden-note__link:hover {
    opacity: 0.85;
    transform: translateX(2px);
  }

  :global(html.dark) .garden-note__link {
    color: oklch(0.9 0.01 265);
    text-shadow: none;
  }
</style>
