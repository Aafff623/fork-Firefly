    margin-top: 0.4rem;
    font-size: 10px;
    color: rgb(163 163 163);
  }

  :global(.heatmap-legend .heatmap-cell) {
    width: 10px;
    height: 10px;
    aspect-ratio: auto;
    cursor: default;
    pointer-events: none;
  }

  :global(.heatmap-legend .heatmap-cell:hover) {
    outline: none;
    transform: none;
  }

  :global(.heatmap-snake) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  /* 月历：当天有发文 → 绿色贡献点 */
  :global(.calendar-contrib-dot) {
    position: absolute;
    bottom: 1px;
    left: 50%;
    transform: translateX(-50%);
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: #40c463;
    box-shadow: 0 0 0 1px rgb(64 196 99 / 0.25);
  }

  :global(.dark .calendar-contrib-dot) {
    background: #39d353;
  }

  :global(.calendar-contrib-dot--month) {
    bottom: 3px;
    width: 4px;
    height: 4px;
  }

  :global(.calendar-contrib-count) {
    position: absolute;
    top: 0;
    right: 1px;
    font-size: 9px;
    font-weight: 700;
    line-height: 1;
    color: #216e39;
  }

  :global(.dark .calendar-contrib-count) {
    color: #39d353;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.heatmap-snake) {
      display: none !important;
    }
  }
</style>
