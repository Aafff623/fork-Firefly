---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { siteConfig } from "@/config/siteConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import { buildHolidayMap } from "@/utils/calendar-holidays";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;

const showHeatmap = widgetConfig?.specificConfig?.calendar?.showHeatmap ?? true;
const showTitle = widgetConfig?.showTitle !== false;

// 月份名称（使用 i18n）
const monthNames = [
	i18n(I18nKey.calendarJanuary),
	i18n(I18nKey.calendarFebruary),
	i18n(I18nKey.calendarMarch),
	i18n(I18nKey.calendarApril),
	i18n(I18nKey.calendarMay),
	i18n(I18nKey.calendarJune),
	i18n(I18nKey.calendarJuly),
	i18n(I18nKey.calendarAugust),
	i18n(I18nKey.calendarSeptember),
	i18n(I18nKey.calendarOctober),
	i18n(I18nKey.calendarNovember),
	i18n(I18nKey.calendarDecember),
];

// 星期名称（简写，使用 i18n）
const weekDays = [
	i18n(I18nKey.calendarSunday),
	i18n(I18nKey.calendarMonday),
	i18n(I18nKey.calendarTuesday),
	i18n(I18nKey.calendarWednesday),
	i18n(I18nKey.calendarThursday),
	i18n(I18nKey.calendarFriday),
	i18n(I18nKey.calendarSaturday),
];

// 年份文本
const yearText = i18n(I18nKey.year);

// 热力图周数文本模板
const heatmapWeekTemplate = i18n(I18nKey.calendarHeatmapWeek);

// 获取当前语言
const currentLang = siteConfig.lang || "en";
const preferEn = !String(currentLang).toLowerCase().startsWith("zh");
/** 2024–2030 节日表（公历固定 + 农历/浮动西方节），供悬停提示 */
const holidayMap = buildHolidayMap(2024, 2030, preferEn);

const calendarDataUrl = url("/api/allPostMeta.json");
const postUrlPrefix = url("/posts/");
---

<WidgetLayout
  name={i18n(I18nKey.calendar)}
  showTitle={showTitle}
  id="calendar-widget"
  class:list={["calendar-notebook-widget", className]}
  style={style}
  contentPadding={false}
>
  <!-- 笔记本日历：对照 bili-goat widgets/日历（GIF 封面 + 活页环 + 珊瑚点缀） -->
  <!-- 首帧 02.gif 改 lazy：日历在侧栏非 LCP 元素，去掉 preload/eager 避免抢首屏带宽；
       calendar-widget.js 的 IntersectionObserver 会在进视口时 warmPreload 兜底加载 -->
  <div class="calendar-shell">
    <header
      class="calendar-cover"
      data-cover-gifs={JSON.stringify([
        "/assets/images/widgets/calendar/02.gif",
        "/assets/images/widgets/calendar/03.gif",
        "/assets/images/widgets/calendar/09.gif",
        "/assets/images/widgets/calendar/08.gif",
        "/assets/images/widgets/calendar/04.gif",
        "/assets/images/widgets/calendar/06.gif",
        "/assets/images/widgets/calendar/07.gif",
        "/assets/images/widgets/calendar/01.gif",
        "/assets/images/widgets/calendar/05.gif",
      ])}
      data-cover-interval-ms="4500"
    >
      <div class="calendar-cover-media" aria-hidden="true">
        <img
          class="calendar-cover-img"
          src="/assets/images/widgets/calendar/02.gif"
          alt=""
          width="360"
          height="200"
          decoding="async"
          loading="lazy"
          draggable="false"
        />
      </div>
      <div class="calendar-cover-scrim" aria-hidden="true"></div>
      <div class="calendar-cover-copy">
        <div class="calendar-cover-day" id="calendar-cover-day"></div>
        <div class="calendar-cover-month" id="calendar-cover-month"></div>
      </div>
      <div class="calendar-cover-nav">
        <button id="prev-month-btn" class="calendar-nav-btn" aria-label="Previous Month" type="button">
          <Icon is:inline name="lucide:chevron-left" class="text-sm" />
        </button>
        <button
          id="current-month-display"
          class="calendar-nav-title"
          type="button"
          aria-label="Change view"
        ></button>
        <div class="calendar-cover-nav-right">
          <button id="reset-month-btn" class="calendar-nav-btn" aria-label="Back to Today" type="button">
            <Icon is:inline name="lucide:rotate-ccw" class="text-sm" />
          </button>
          <button id="next-month-btn" class="calendar-nav-btn" aria-label="Next Month" type="button">
            <Icon is:inline name="lucide:chevron-right" class="text-sm" />
          </button>
        </div>
      </div>
    </header>

    <div class="calendar-ring calendar-ring--left" aria-hidden="true"></div>
    <div class="calendar-ring calendar-ring--right" aria-hidden="true"></div>

    <div class="calendar-body">
      <div class="calendar-container">
        <!-- 日历视图容器 -->
        <div id="calendar-view-container">
          <div class="weekdays grid grid-cols-7 gap-1 mb-2">
            {weekDays.map(day => (
              <div class="calendar-weekday">
                {day}
              </div>
            ))}
          </div>

          <div class="calendar-grid grid grid-cols-7 gap-1 pb-1" id="calendar-grid">
          </div>
        </div>

        {showHeatmap && (
        <div id="heatmap-container" class="heatmap-wrap mt-2 mb-1" style="display: none;">
          <div class="heatmap-months grid gap-0.5 mb-1" id="heatmap-months" style="grid-template-columns: repeat(12, 1fr);"></div>
          <div class="heatmap-grid-wrap relative">
            <div class="heatmap-grid grid" id="heatmap-grid" style="grid-template-columns: repeat(12, 1fr); grid-template-rows: repeat(4, 1fr);"></div>
            <canvas id="heatmap-snake" class="heatmap-snake" aria-hidden="true"></canvas>
          </div>
          <div class="heatmap-legend" aria-hidden="true">
            <span>Less</span>
            <i class="heatmap-cell level-0"></i>
            <i class="heatmap-cell level-1"></i>
            <i class="heatmap-cell level-2"></i>
            <i class="heatmap-cell level-3"></i>
            <i class="heatmap-cell level-4"></i>
            <span>More</span>
          </div>
        </div>
        )}

        <div id="month-view-container" class="grid grid-cols-3 gap-2" style="display: none;"></div>
        <div id="year-view-container" class="grid grid-cols-3 gap-2" style="display: none;"></div>

        <div id="calendar-posts" class="mt-3" style="display: none;">
          <div class="border-t border-black/8 dark:border-white/10 mb-2" id="calendar-posts-divider" style="display: none;"></div>
          <div class="flex flex-col gap-1 max-h-48 overflow-y-auto custom-scrollbar" id="calendar-posts-list"></div>
        </div>
      </div>
    </div>
  </div>
</WidgetLayout>

<script is:inline data-swup-ignore-script define:vars={{ monthNames, yearText, currentLang, calendarDataUrl, postUrlPrefix, heatmapWeekTemplate, holidayMap }}>
  window.__calendarWidgetConfig = {
    monthNames,
    yearText,
    currentLang,
    calendarDataUrl,
    postUrlPrefix,
    heatmapWeekTemplate,
    holidayMap,
  };
</script>
<script is:inline data-swup-ignore-script src="/scripts/calendar-widget.js"></script>

<style>
  /* ── 笔记本日历：GIF 封面保留；外壳对齐 card-base 扁平原感 ── */
  :global(.calendar-notebook-widget) {
    overflow: hidden;
    padding-bottom: 0 !important;
  }

  :global(.calendar-notebook-widget .collapse-wrapper) {
    overflow: hidden !important;
    padding: 0 !important;
  }

  .calendar-shell {
    --cal-accent: #e66b6b;
    --cal-accent-soft: #da89a2;
    --cal-cover-h: 8.6rem;
    position: relative;
    width: 100%;
    border-radius: 0;
    box-shadow: none;
  }

  .calendar-cover {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 0;
    min-height: var(--cal-cover-h);
    padding: 1.15rem 1rem 2.25rem;
    color: #fff;
    container-type: inline-size;
    background: var(--cal-accent);
  }

  .calendar-cover-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    /* 红渐变底仅作加载前占位；真正画面由 .calendar-cover-img 承担 */
    background: transparent;
  }

  .calendar-cover-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
    pointer-events: none;
    user-select: none;
  }

  .calendar-cover-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(120deg, rgb(0 0 0 / 0.28) 0%, transparent 52%),
      linear-gradient(180deg, transparent 42%, rgb(0 0 0 / 0.35));
  }

  .calendar-cover-copy {
    position: relative;
    z-index: 2;
    pointer-events: none;
  }

  .calendar-cover-day {
    font-size: clamp(3rem, 20cqi, 3.85rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.4);
  }

  .calendar-cover-month {
    margin-top: 0.1rem;
    font-size: clamp(1.2rem, 7.5cqi, 1.55rem);
    font-weight: 600;
    line-height: 1.05;
    text-transform: lowercase;
    opacity: 0.96;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.35);
  }

  .calendar-cover-nav {
    position: absolute;
    left: 0.55rem;
    right: 0.55rem;
    bottom: 0.4rem;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
  }

  .calendar-cover-nav-right {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .calendar-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.7rem;
    height: 1.7rem;
    border: 0;
    border-radius: 999px;
    color: #fff;
    background: rgb(0 0 0 / 0.28);
    backdrop-filter: blur(6px);
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .calendar-nav-btn:hover {
    background: rgb(0 0 0 / 0.42);
  }

  .calendar-nav-title {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: rgb(255 255 255 / 0.92);
    font-size: 0.72rem;
    font-weight: 700;
    text-align: center;
    cursor: pointer;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.45);
  }

  .calendar-nav-title:hover {
    color: #fff;
  }

  .calendar-ring {
    position: absolute;
    top: calc(var(--cal-cover-h) - 0.9rem);
    z-index: 4;
    pointer-events: none;
  }

  .calendar-ring--left {
    left: 1.15rem;
  }

  .calendar-ring--right {
    right: 1.15rem;
  }

  .calendar-ring::before {
    content: "";
    display: block;
    width: 0.38rem;
    height: 1.2rem;
    margin: 0.3rem;
    border-radius: 0.18rem;
    background: color-mix(in oklab, var(--card-bg) 88%, white);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
  }

  .calendar-body {
    position: relative;
    z-index: 1;
    background: var(--card-bg);
    border-radius: 0;
    box-shadow: none;
    border-top: 1px solid color-mix(in oklab, var(--line-divider, rgb(0 0 0 / 0.08)) 80%, transparent);
    padding: 1.15rem 0.75rem 0.85rem;
    color: inherit;
  }

  :global(.dark) .calendar-body {
    background: transparent;
    border-top-color: color-mix(in oklab, white 10%, transparent);
  }

  :global(.wallpaper-transparent) .calendar-body {
    background: transparent;
  }

  .calendar-weekday {
    text-align: center;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--cal-accent);
  }

  :global(.dark) .calendar-weekday {
    color: #f0a0a8;
  }

  :global(.calendar-day) {
    transition: all 0.2s ease;
    min-height: 32px;
    border-radius: 999px;
  }

  :global(.calendar-day[data-date]:not([data-date=""]):hover) {
    transform: translateY(-1px);
    background: color-mix(in oklab, var(--cal-accent-soft, #da89a2) 55%, transparent);
  }

  :global(.calendar-day[data-has-post="true"]:hover) {
    transform: translateY(-2px);
    background: var(--cal-accent-soft, #da89a2);
    color: #fff !important;
  }

  :global(.calendar-day-today) {
    color: var(--cal-accent, #e66b6b) !important;
    font-weight: 800;
  }

  :global(.dark .calendar-day-today) {
    color: #f0a0a8 !important;
  }

  /* 节日日：只微微改字色，不抢今日/发文强调 */
  :global(.calendar-day-holiday) {
    color: #b07a6e !important;
    font-weight: 600;
  }

  :global(.dark .calendar-day-holiday) {
    color: #c9a39a !important;
  }

  :global(.calendar-day-holiday[data-has-post="true"]) {
    color: #9a655a !important;
  }

  :global(.dark .calendar-day-holiday[data-has-post="true"]) {
    color: #d4b0a8 !important;
  }

  /* 自定义选中日期样式 */
  :global(.calendar-day-selected) {
    background-color: var(--cal-accent, #e66b6b);
    color: #fff !important;
    border-radius: 999px;
  }

  /* —— 贡献绿标（GitHub 热力色阶）+ 贴合卡片的 12×4 —— */
  :global(.heatmap-wrap) {
    width: 100%;
  }

  :global(.heatmap-month-label) {
    display: block;
    text-align: center;
    font-size: 10px;
    line-height: 1;
    color: rgb(163 163 163);
  }

  :global(.dark .heatmap-month-label) {
    color: rgb(115 115 115);
  }

  :global(.heatmap-grid-wrap) {
    position: relative;
    width: 100%;
  }

  :global(.heatmap-grid) {
    width: 100%;
    gap: 3px;
    row-gap: 3px;
  }

  :global(.heatmap-cell) {
    display: block;
    cursor: pointer;
    min-width: 0;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 3px;
    transition: outline-color 0.15s ease, transform 0.12s ease;
  }

  :global(.heatmap-cell:hover) {
    outline: 1.5px solid rgb(57 211 83 / 0.85);
    outline-offset: 1px;
    transform: scale(1.06);
    z-index: 1;
  }

  :global(.heatmap-cell.level-0) {
    background: #ebedf0; /* snk github-light */
  }
  :global(.heatmap-cell.level-1) {
    background: #9be9a8;
  }
  :global(.heatmap-cell.level-2) {
    background: #40c463;
  }
  :global(.heatmap-cell.level-3) {
    background: #30a14e;
  }
  :global(.heatmap-cell.level-4) {
    background: #216e39;
  }

  :global(.dark .heatmap-cell.level-0) {
    background: #161b22; /* snk github-dark */
  }
  :global(.dark .heatmap-cell.level-1) {
    background: #01311f;
  }
  :global(.dark .heatmap-cell.level-2) {
    background: #034525;
  }
  :global(.dark .heatmap-cell.level-3) {
    background: #0f6d31;
  }
  :global(.dark .heatmap-cell.level-4) {
    background: #00c647;
  }

  :global(.heatmap-legend) {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 3px;
    margin-top: 0.4rem;
    font-size: 10px;
    color: rgb(163 163 163);
  }

  :global(.heatmap-legend .heatmap-cell) {
    width: 10px;
    height: 10px;
    aspect-ratio: auto;
    cursor: default;
    pointer-events: none;
  }

  :global(.heatmap-legend .heatmap-cell:hover) {
    outline: none;
    transform: none;
  }

  :global(.heatmap-snake) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  /* 月历：当天有发文 → 绿色贡献点 */
  :global(.calendar-contrib-dot) {
    position: absolute;
    bottom: 1px;
    left: 50%;
    transform: translateX(-50%);
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: #40c463;
    box-shadow: 0 0 0 1px rgb(64 196 99 / 0.25);
  }

  :global(.dark .calendar-contrib-dot) {
    background: #39d353;
  }

  :global(.calendar-contrib-dot--month) {
    bottom: 3px;
    width: 4px;
    height: 4px;
  }

  :global(.calendar-contrib-count) {
    position: absolute;
    top: 0;
    right: 1px;
    font-size: 9px;
    font-weight: 700;
    line-height: 1;
    color: #216e39;
  }

  :global(.dark .calendar-contrib-count) {
    color: #39d353;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.heatmap-snake) {
      display: none !important;
    }
  }
</style>
