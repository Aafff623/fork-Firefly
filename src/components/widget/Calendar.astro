  }

  /* 自定义选中日期样式 */
  :global(.calendar-day-selected) {
    background-color: var(--btn-regular-bg);
    border-radius: 0.25rem;
  }

  /* —— 贡献绿标（GitHub 热力色阶）+ 贴合卡片的 12×4 —— */
  :global(.heatmap-wrap) {
    width: 100%;
  }

  :global(.heatmap-month-label) {
    display: block;
    text-align: center;
    font-size: 10px;
    line-height: 1;
    color: rgb(163 163 163);
  }

  :global(.dark .heatmap-month-label) {
    color: rgb(115 115 115);
  }

  :global(.heatmap-grid-wrap) {
    position: relative;
    width: 100%;
  }

  :global(.heatmap-grid) {
    width: 100%;
    gap: 3px;
    row-gap: 3px;
  }

  :global(.heatmap-cell) {
    display: block;
    cursor: pointer;
    min-width: 0;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 3px;
    transition: outline-color 0.15s ease, transform 0.12s ease;
  }

  :global(.heatmap-cell:hover) {
    outline: 1.5px solid rgb(57 211 83 / 0.85);
    outline-offset: 1px;
    transform: scale(1.06);
    z-index: 1;
  }

  :global(.heatmap-cell.level-0) {
    background: #ebedf0; /* snk github-light */
  }
  :global(.heatmap-cell.level-1) {
    background: #9be9a8;
  }
  :global(.heatmap-cell.level-2) {
    background: #40c463;
  }
  :global(.heatmap-cell.level-3) {
    background: #30a14e;
  }
  :global(.heatmap-cell.level-4) {
    background: #216e39;
  }

  :global(.dark .heatmap-cell.level-0) {
    background: #161b22; /* snk github-dark */
  }
  :global(.dark .heatmap-cell.level-1) {
    background: #01311f;
  }
  :global(.dark .heatmap-cell.level-2) {
    background: #034525;
  }
  :global(.dark .heatmap-cell.level-3) {
    background: #0f6d31;
  }
  :global(.dark .heatmap-cell.level-4) {
    background: #00c647;
  }

  :global(.heatmap-legend) {
    display: flex;
    align-items: center;
    justify-content: flex-end;
