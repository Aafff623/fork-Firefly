---
/**
 * 分层时钟 — 对照 bilibili-goat/widgets/分层时钟/x.html
 * 保留 3D 分层大方向；样式/字体/徽章做精致化。
 * bare=true：无卡片（嵌站点统计等）
 */
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { layeredClockConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
	bare?: boolean;
}

const { class: className, style, widgetConfig, bare = false } = Astro.props;
const showTitle = widgetConfig?.showTitle === true;

const faceImg = "/assets/images/widgets/layered-clock/05.jpg";
const profileImg = "/assets/images/widgets/layered-clock/04.jpg";
const rootClass = ["lc7", bare ? "lc7--bare" : "lc7--solo", className];

// 天空层：昼夜跟随站点主题；天气场景需站长坐标（见 src/config/layeredClockConfig.ts）
const { skyMode, weather, skyAssets } = layeredClockConfig;
const weatherEnabled =
	weather.enable && weather.latitude !== 0 && weather.longitude !== 0;
const skyAttrs: Record<string, string> = {
	"data-sky-mode": skyMode,
	"data-sky-assets": JSON.stringify(skyAssets),
	...(weatherEnabled
		? {
				"data-weather-lat": String(weather.latitude),
				"data-weather-lon": String(weather.longitude),
				"data-weather-refresh": String(weather.refreshMinutes),
			}
		: {}),
};
---


{
  bare ? (
    <div
      class:list={rootClass}
      id="layered-clock-root"
      role="timer"
      aria-live="polite"
      aria-label={i18n(I18nKey.layeredClock)}
      style={style}
      data-face={faceImg}
      {...skyAttrs}
    >
      <div class="lc7__layer lc7__layer--img" aria-hidden="true"></div>
      <div class="lc7__layer lc7__layer--sky" aria-hidden="true">
        <img class="lc7__sky-base" alt="" decoding="async" loading="lazy" hidden />
        <img class="lc7__sky-weather" alt="" decoding="async" loading="lazy" hidden />
        <div class="lc7__celestial" aria-hidden="true"></div>
        <div class="lc7__stars" aria-hidden="true"></div>
        <div class="lc7__cloud lc7__cloud--a" aria-hidden="true"></div>
        <div class="lc7__cloud lc7__cloud--b" aria-hidden="true"></div>
      </div>
      <div class="lc7__layer lc7__layer--shade" aria-hidden="true"></div>
      <div class="lc7__layer lc7__layer--face">
        <div class="lc7__digits">
          <span class="lc7__digit" data-unit="h">12</span>
          <span class="lc7__sep" aria-hidden="true">:</span>
          <span class="lc7__digit" data-unit="m">00</span>
          <span class="lc7__sep lc7__sep--sec" aria-hidden="true">:</span>
          <span class="lc7__digit lc7__digit--sec" data-unit="s">00</span>
          <span class="lc7__ampm" data-unit="ap">AM</span>
        </div>
        <div class="lc7__hand lc7__hand--hr" aria-hidden="true"></div>
        <div class="lc7__hand lc7__hand--min" aria-hidden="true"></div>
        <div class="lc7__hand lc7__hand--sec" aria-hidden="true"></div>
        <div class="lc7__ring" aria-hidden="true"></div>
      </div>
      <div class="lc7__layer lc7__layer--profile">
        <img class="lc7__profile" src={profileImg} alt="" width="32" height="32" loading="lazy" />
      </div>
    </div>
  ) : (
    <WidgetLayout
      name={i18n(I18nKey.layeredClock)}
      showTitle={showTitle}
      id="layered-clock"
      class:list={["layered-clock-widget", className]}
      style={style}
      contentPadding={false}
    >
      <div
        class:list={rootClass}
        id="layered-clock-root"
        role="timer"
        aria-live="polite"
        aria-label={i18n(I18nKey.layeredClock)}
        data-face={faceImg}
        {...skyAttrs}
      >
        <div class="lc7__layer lc7__layer--img" aria-hidden="true"></div>
        <div class="lc7__layer lc7__layer--sky" aria-hidden="true">
        <img class="lc7__sky-base" alt="" decoding="async" loading="lazy" hidden />
        <img class="lc7__sky-weather" alt="" decoding="async" loading="lazy" hidden />
        <div class="lc7__celestial" aria-hidden="true"></div>
        <div class="lc7__stars" aria-hidden="true"></div>
        <div class="lc7__cloud lc7__cloud--a" aria-hidden="true"></div>
        <div class="lc7__cloud lc7__cloud--b" aria-hidden="true"></div>
      </div>
        <div class="lc7__layer lc7__layer--shade" aria-hidden="true"></div>
        <div class="lc7__layer lc7__layer--face">
          <div class="lc7__digits">
            <span class="lc7__digit" data-unit="h">12</span>
            <span class="lc7__sep" aria-hidden="true">:</span>
            <span class="lc7__digit" data-unit="m">00</span>
            <span class="lc7__sep lc7__sep--sec" aria-hidden="true">:</span>
            <span class="lc7__digit lc7__digit--sec" data-unit="s">00</span>
            <span class="lc7__ampm" data-unit="ap">AM</span>
          </div>
          <div class="lc7__hand lc7__hand--hr" aria-hidden="true"></div>
          <div class="lc7__hand lc7__hand--min" aria-hidden="true"></div>
          <div class="lc7__hand lc7__hand--sec" aria-hidden="true"></div>
          <div class="lc7__ring" aria-hidden="true"></div>
        </div>
        <div class="lc7__layer lc7__layer--profile">
          <img class="lc7__profile" src={profileImg} alt="" width="32" height="32" loading="lazy" />
        </div>
      </div>
    </WidgetLayout>
  )
}

<script is:inline defer data-swup-ignore-script src="/scripts/layered-clock.js"></script>

<style is:global>
  .layered-clock-widget.card-base,
  .layered-clock-widget {
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    overflow: visible;
  }

  .layered-clock-widget .collapse-wrapper {
    padding: 0 !important;
    overflow: visible !important;
    background: transparent !important;
    perspective: 720px;
  }

  #layered-clock-root.lc7 {
    --hrAngle: 0deg;
    --minAngle: 0deg;
    --secAngle: 0deg;
    --lc-ink: #f8fafc;
    --lc-ring: #f1f5f9;
    --lc-shade: hsla(222, 42%, 10%, 0.52);
    --lc-hand: #f8fafc;
    --lc-ampm-bg: rgb(15 23 42 / 0.48);
    --lc-ampm-bd: rgb(255 255 255 / 0.32);
    font-size: 0.36rem;
    font-family: var(--font-jetbrains-mono), ui-monospace, Menlo, Consolas, monospace;
    line-height: 1.45;
    color: var(--lc-ink);
    position: relative;
    width: 12em;
    height: 12em;
    margin: 0;
    border-radius: 50%;
    outline: transparent;
    transform: rotateX(26deg) rotateY(-24deg) rotateZ(22deg);
    transform-style: preserve-3d;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    background: transparent;
    filter: drop-shadow(0 6px 14px rgb(15 23 42 / 0.18));
  }

  #layered-clock-root.lc7--bare {
    font-size: 0.34rem;
  }

  #layered-clock-root.lc7--in-stats {
    font-size: 0.3rem;
    filter: drop-shadow(0 4px 10px rgb(15 23 42 / 0.14));
  }

  #layered-clock-root.lc7--solo {
    font-size: 0.85rem;
    margin: 0.5rem auto;
  }

  #layered-clock-root.lc7:hover,
  #layered-clock-root.lc7:focus-visible {
    transform: rotateX(0) rotateY(0) rotateZ(0);
  }

  #layered-clock-root .lc7__profile {
    background-color: hsl(222, 14%, 42%);
    border: 0;
    border-radius: 50%;
    box-shadow:
      0 0 0 0.18em rgb(255 255 255 / 0.55),
      0 0 0 0.32em rgb(15 23 42 / 0.35);
    display: block;
    margin: 7.75em auto 0 auto;
    width: 2em;
    height: 2em;
    object-fit: cover;
  }

  #layered-clock-root .lc7__digits {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 0.1em;
    line-height: 1;
    margin-top: 2.2em;
    padding: 0.2em 0.55em;
    user-select: none;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-shadow:
      0 1px 2px rgb(0 0 0 / 0.7),
      0 0 10px rgb(0 0 0 / 0.35);
  }

  #layered-clock-root .lc7__digit {
    margin: 0;
    min-width: 1.15ch;
    text-align: center;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.35));
  }

  /* 时 / 分 / 秒：紫系邻近渐变 */
  #layered-clock-root .lc7__digit[data-unit="h"] {
    text-align: right;
    min-width: 1ch;
    background-image: linear-gradient(165deg, #c4b5fd 0%, #8b5cf6 42%, #6d28d9 100%);
  }

  #layered-clock-root .lc7__digit[data-unit="m"] {
    min-width: 2ch;
    background-image: linear-gradient(165deg, #ddd6fe 0%, #a78bfa 40%, #7c3aed 100%);
  }

  #layered-clock-root .lc7__digit[data-unit="s"],
  #layered-clock-root .lc7__digit--sec {
    min-width: 2ch;
    font-size: 0.72em;
    font-weight: 600;
    opacity: 1;
    background-image: linear-gradient(165deg, #e9d5ff 0%, #c084fc 45%, #9333ea 100%);
  }

  #layered-clock-root .lc7__sep {
    opacity: 0.85;
    margin: 0 0.04em;
    font-weight: 500;
    color: #c4b5fd;
    text-shadow: 0 0 8px rgb(139 92 246 / 0.45);
  }

  #layered-clock-root .lc7__sep--sec {
    opacity: 0.7;
    font-size: 0.85em;
    color: #d8b4fe;
  }

  #layered-clock-root .lc7__ampm {
    margin-left: 0.32em;
    padding: 0.14em 0.42em;
    border-radius: 999px;
    font-size: 0.52em;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.15;
    color: #fff;
    background: var(--lc-ampm-bg);
    border: 1px solid var(--lc-ampm-bd);
    backdrop-filter: blur(4px);
    text-shadow: none;
  }

  #layered-clock-root.lc7--in-stats .lc7__sep--sec,
  #layered-clock-root.lc7--in-stats .lc7__digit--sec {
    display: none;
  }

  #layered-clock-root.lc7--in-stats .lc7__digits {
    margin-top: 2.6em;
    gap: 0.14em;
    font-size: 1.18em;
  }

  #layered-clock-root.lc7--in-stats .lc7__ampm {
    font-size: 0.5em;
    padding: 0.16em 0.44em;
  }

  #layered-clock-root .lc7__hand,
  #layered-clock-root .lc7__layer,
  #layered-clock-root .lc7__ring {
    position: absolute;
  }

  #layered-clock-root .lc7__hand {
    bottom: calc(50% - 0.5em);
    left: calc(50% - 0.5em);
    width: 1em;
    mix-blend-mode: difference;
    perspective: 4.25em;
    transform-origin: 0.5em calc(100% - 0.5em);
    transition: 0.5s;
  }

  #layered-clock-root .lc7__hand--hr {
    height: 2.75em;
    transform: rotate(var(--hrAngle)) translateY(-2em);
  }

  #layered-clock-root .lc7__hand--min {
    height: 3.75em;
    transform: rotate(var(--minAngle)) translateY(-2em);
  }

  #layered-clock-root .lc7__hand--sec {
    width: 0.45em;
    height: 3.75em;
    transform: rotate(var(--secAngle)) translateY(-2em);
  }

  #layered-clock-root .lc7__hand::before {
    background-color: var(--lc-hand);
    content: "";
    display: block;
    width: 100%;
    height: 100%;
    transform: rotateX(-30deg);
    transform-origin: 50% 100%;
    box-shadow: 0 0 0.35em rgb(255 255 255 / 0.35);
  }

  #layered-clock-root .lc7__hand--hr::before {
    border-radius: 0.5em 0.5em 0.5em 0.5em / 0.5em 0.5em 0.75em 0.75em;
  }

  #layered-clock-root .lc7__hand--min::before {
    border-radius: 0 0 0.5em 0.5em / 0 0 0.75em 0.75em;
  }

  #layered-clock-root .lc7__hand--sec::before {
    border-radius: 0 0 0.25em 0.25em / 0 0 0.5em 0.5em;
  }

  #layered-clock-root .lc7__layer,
  #layered-clock-root .lc7__ring {
    border-radius: 50%;
    inset: 0;
  }

  #layered-clock-root .lc7__layer--face {
    transform: translateZ(3.75em);
  }

  #layered-clock-root .lc7__layer--img {
    transform: translateZ(-3.75em);
  }

  #layered-clock-root .lc7__layer--profile {
    transform: translateZ(11em);
  }

  #layered-clock-root .lc7__layer--shade {
    background:
      radial-gradient(circle at 42% 28%, rgb(255 255 255 / 0.14), transparent 40%),
      var(--lc-shade);
  }

  /* ── 天空层：昼夜跟随站点主题（data-sky），天气场景叠加（data-weather） ── */
  #layered-clock-root {
    --lc-sky-night: oklch(0.22 0.06 265);
  }

  #layered-clock-root .lc7__layer--sky {
    transform: translateZ(-3.5em);
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.6s ease;
    isolation: isolate;
  }

  #layered-clock-root[data-sky] .lc7__layer--sky {
    opacity: 1;
  }

  #layered-clock-root .lc7__sky-base,
  #layered-clock-root .lc7__sky-weather {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    z-index: 0;
    pointer-events: none;
  }

  #layered-clock-root .lc7__sky-weather {
    z-index: 1;
    mix-blend-mode: screen;
    opacity: 0.88;
  }

  #layered-clock-root[data-sky-gif-ready] .lc7__celestial,
  #layered-clock-root[data-sky-gif-ready] .lc7__stars,
  #layered-clock-root[data-sky-gif-ready] .lc7__cloud {
    opacity: 0;
    visibility: hidden;
  }

  /* 白天：天蓝渐变 + 太阳 + 漂移云 */
  #layered-clock-root[data-sky="day"] .lc7__layer--sky {
    background: linear-gradient(
      180deg,
      oklch(0.68 0.11 235 / 0.92) 0%,
      oklch(0.82 0.08 225 / 0.85) 52%,
      oklch(0.92 0.05 200 / 0.8) 100%
    );
  }

  #layered-clock-root[data-sky="day"] .lc7__celestial {
    position: absolute;
    top: 8%;
    right: 10%;
    width: 22%;
    height: 22%;
    z-index: 2;
    border-radius: 50%;
    background: radial-gradient(
      circle at 42% 42%,
      oklch(0.99 0.08 98) 0%,
      oklch(0.92 0.14 88) 52%,
      oklch(0.85 0.16 75) 100%
    );
    box-shadow:
      0 0 0.25em oklch(0.95 0.12 95 / 0.9),
      0 0 0.9em oklch(0.9 0.14 90 / 0.65);
  }

  #layered-clock-root[data-sky="day"] .lc7__celestial::before {
    content: "";
    position: absolute;
    inset: -40%;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      oklch(0.95 0.1 95 / 0.5) 0deg 14deg,
      transparent 14deg 32deg,
      oklch(0.94 0.1 92 / 0.45) 32deg 46deg,
      transparent 46deg 64deg,
      oklch(0.95 0.1 95 / 0.5) 64deg 78deg,
      transparent 78deg 96deg,
      oklch(0.94 0.1 92 / 0.45) 96deg 110deg,
      transparent 110deg 128deg,
      oklch(0.95 0.1 95 / 0.5) 128deg 142deg,
      transparent 142deg 160deg,
      oklch(0.94 0.1 92 / 0.45) 160deg 174deg,
      transparent 174deg 192deg,
      oklch(0.95 0.1 95 / 0.5) 192deg 206deg,
      transparent 206deg 224deg,
      oklch(0.94 0.1 92 / 0.45) 224deg 238deg,
      transparent 238deg 256deg,
      oklch(0.95 0.1 95 / 0.5) 256deg 270deg,
      transparent 270deg 288deg,
      oklch(0.94 0.1 92 / 0.45) 288deg 302deg,
      transparent 302deg 320deg,
      oklch(0.95 0.1 95 / 0.5) 320deg 334deg,
      transparent 334deg 360deg
    );
  }

  #layered-clock-root .lc7__cloud {
    position: absolute;
    z-index: 2;
    border-radius: 50%;
    background:
      radial-gradient(ellipse 55% 70% at 30% 65%, oklch(100% 0 0 / 0.84) 0%, transparent 70%),
      radial-gradient(ellipse 60% 80% at 55% 40%, oklch(100% 0 0 / 0.8) 0%, transparent 70%),
      radial-gradient(ellipse 50% 60% at 75% 60%, oklch(100% 0 0 / 0.76) 0%, transparent 70%);
    filter: blur(0.12em);
    pointer-events: none;
  }

  #layered-clock-root .lc7__cloud--a {
    top: 22%;
    left: -52%;
    width: 54%;
    height: 16%;
    animation: lc7-cloud-drift 30s linear infinite;
  }

  #layered-clock-root .lc7__cloud--b {
    top: 30%;
    left: -70%;
    width: 42%;
    height: 12%;
    opacity: 0.88;
    animation: lc7-cloud-drift 42s linear infinite;
    animation-delay: -14s;
  }

  #layered-clock-root:not([data-sky="day"]) .lc7__cloud {
    display: none;
  }

  @keyframes lc7-cloud-drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(330%);
    }
  }

  /* 夜晚：深空渐变 + 月牙 + 星点闪烁 */
  #layered-clock-root[data-sky="night"] .lc7__layer--sky {
    background: linear-gradient(
      180deg,
      oklch(0.26 0.06 265 / 0.94) 0%,
      oklch(0.17 0.05 272 / 0.96) 55%,
      oklch(0.11 0.04 278 / 0.97) 100%
    );
  }

  #layered-clock-root[data-sky="night"] .lc7__celestial {
    position: absolute;
    top: 9%;
    right: 11%;
    width: 18%;
    height: 18%;
    z-index: 2;
    border-radius: 50%;
    transform: rotate(-12deg);
    background: oklch(0.93 0.04 95);
    box-shadow:
      inset 0.38em -0.06em 0 0 var(--lc-sky-night),
      0 0 0.45em oklch(0.9 0.05 95 / 0.55);
    filter: drop-shadow(0 0 0.35em oklch(0.9 0.05 95 / 0.45));
  }

  #layered-clock-root:not([data-sky="night"]) .lc7__celestial {
    display: none;
  }

  #layered-clock-root .lc7__stars {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(circle 0.08em at 16% 26%, oklch(0.96 0 0 / 0.95), transparent 62%),
      radial-gradient(circle 0.06em at 30% 12%, oklch(0.96 0 0 / 0.8), transparent 62%),
      radial-gradient(circle 0.09em at 44% 30%, oklch(0.97 0.02 90 / 0.9), transparent 62%),
      radial-gradient(circle 0.06em at 60% 10%, oklch(0.96 0 0 / 0.75), transparent 62%),
      radial-gradient(circle 0.07em at 72% 24%, oklch(0.96 0 0 / 0.85), transparent 62%),
      radial-gradient(circle 0.05em at 84% 12%, oklch(0.96 0 0 / 0.7), transparent 62%),
      radial-gradient(circle 0.07em at 24% 46%, oklch(0.96 0 0 / 0.6), transparent 62%),
      radial-gradient(circle 0.05em at 66% 42%, oklch(0.97 0.02 90 / 0.65), transparent 62%);
    animation: lc7-star-twinkle 3.4s ease-in-out infinite alternate;
    pointer-events: none;
  }

  #layered-clock-root:not([data-sky="night"]) .lc7__stars {
    display: none;
  }

  @keyframes lc7-star-twinkle {
    from {
      opacity: 0.55;
    }
    to {
      opacity: 1;
    }
  }

  /* 多云：太阳/月牙压暗，云变灰变快 */
  #layered-clock-root[data-weather="cloudy"] .lc7__celestial {
    opacity: 0.35;
  }

  #layered-clock-root[data-sky="day"][data-weather="cloudy"] .lc7__cloud {
    background: oklch(0.86 0.01 250 / 0.72);
    animation-duration: 20s;
  }

  /* 天空出现时罩层压淡，保住场景可读性 */
  #layered-clock-root[data-sky="day"] .lc7__layer--shade {
    background:
      radial-gradient(circle at 42% 28%, rgb(255 255 255 / 0.12), transparent 40%),
      hsla(222, 32%, 32%, 0.16);
  }

  #layered-clock-root[data-sky="night"] .lc7__layer--shade {
    background:
      radial-gradient(circle at 42% 28%, rgb(255 255 255 / 0.1), transparent 40%),
      hsla(222, 42%, 10%, 0.3);
  }

  /* 雨：细雨丝下落（叠在 shade 上） */
  #layered-clock-root[data-weather="rain"] .lc7__layer--shade::before,
  #layered-clock-root[data-weather="thunder"] .lc7__layer--shade::before {
    content: "";
    position: absolute;
    inset: -14% 0;
    background: repeating-linear-gradient(
      112deg,
      transparent 0 0.34em,
      oklch(0.88 0.04 240 / 0.32) 0.34em 0.4em
    );
    animation: lc7-rain-fall 0.85s linear infinite;
  }

  @keyframes lc7-rain-fall {
    from {
      transform: translateY(-10%);
    }
    to {
      transform: translateY(10%);
    }
  }

  /* 雪：碎雪点缓落 */
  #layered-clock-root[data-weather="snow"] .lc7__layer--shade::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle 0.09em at 20% 15%, oklch(100% 0 0 / 0.9), transparent 64%),
      radial-gradient(circle 0.07em at 45% 35%, oklch(100% 0 0 / 0.75), transparent 64%),
      radial-gradient(circle 0.1em at 68% 8%, oklch(100% 0 0 / 0.85), transparent 64%),
      radial-gradient(circle 0.06em at 84% 30%, oklch(100% 0 0 / 0.7), transparent 64%),
      radial-gradient(circle 0.08em at 32% 62%, oklch(100% 0 0 / 0.8), transparent 64%);
    background-size: 100% 55%;
    background-repeat: repeat;
    animation: lc7-snow-fall 4.6s linear infinite;
  }

  @keyframes lc7-snow-fall {
