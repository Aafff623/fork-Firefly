---
/**
 * /dynamic/ 右栏：ChatGPT 风时间分组目录（A）+ 滚动高亮（D）
 * SSR 种子 + DynamicTimeline 经 CustomEvent `firefly:dynamic-nav` 增量同步。
 */
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import DynamicNavPanel from "@/components/widget/DynamicNavPanel";
import { dynamicConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import {
	dynamicEntryNavTitle,
	loadDynamicEntries,
} from "@/utils/load-dynamic-entries";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;

const labels = {
	nav: i18n(I18nKey.dynamicNav),
	pinned: i18n(I18nKey.pinned),
	today: i18n(I18nKey.dynamicNavToday),
	yesterday: i18n(I18nKey.dynamicNavYesterday),
	last7Days: i18n(I18nKey.dynamicNavLast7Days),
	older: i18n(I18nKey.dynamicNavOlder),
	empty: i18n(I18nKey.dynamicNoResults),
	loading: i18n(I18nKey.dynamicLoading),
};

const initialItems =
	!dynamicConfig.memos?.enable && siteConfig.pages.dynamic
		? (await loadDynamicEntries()).map((entry) => ({
				id: entry.id,
				published: entry.published,
				title: dynamicEntryNavTitle(entry.html, entry.searchText),
				pinned: Boolean(entry.pinned),
			}))
		: undefined;
---

{
	siteConfig.pages.dynamic && (
		<WidgetLayout
			name={i18n(I18nKey.dynamicNav)}
			showTitle={showTitle}
			id="dynamic-nav"
			class:list={["dynamic-nav-widget", className]}
			style={style}
		>
			<Icon
				slot="title-leading"
				is:inline
				name="lucide:list"
				class="widget-title-icon"
				aria-hidden="true"
			/>
			<DynamicNavPanel client:load labels={labels} initialItems={initialItems} />
		</WidgetLayout>
	)
}

<style is:global>
	.dynamic-nav-widget {
		min-width: 0;
	}

	.dynamic-nav__hint {
		margin: 0;
		padding: 0.35rem 0 0.15rem;
		font-size: 0.8rem;
		color: var(--content-meta);
	}

	.dynamic-nav {
		min-width: 0;
	}

	.dynamic-nav__scroll {
		max-height: min(52vh, 28rem);
		overflow-x: hidden;
		overflow-y: auto;
		margin: 0 -0.15rem;
		padding: 0.1rem 0.15rem 0.35rem;
		scrollbar-width: thin;
	}

	.dynamic-nav__group + .dynamic-nav__group {
		margin-top: 0.55rem;
	}

	.dynamic-nav__group-title {
		position: sticky;
		top: 0;
		z-index: 1;
		margin: 0 0 0.28rem;
		padding: 0.2rem 0.35rem;
		font-size: 0.68rem;
		font-weight: 650;
		letter-spacing: 0.04em;
		color: color-mix(in oklab, var(--content-meta) 92%, transparent);
		background: color-mix(in oklab, var(--card-bg, #fff) 92%, transparent);
		backdrop-filter: blur(6px);
	}

	.dynamic-nav__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.12rem;
	}

	.dynamic-nav__item {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.45rem;
		min-width: 0;
		padding: 0.38rem 0.45rem;
		border-radius: 0.45rem;
		border-left: 2px solid transparent;
		text-decoration: none;
		color: color-mix(in oklab, var(--content-meta) 95%, #111);
		transition:
			background-color 140ms ease,
			border-color 140ms ease,
			color 140ms ease;
	}

	.dynamic-nav__item:hover {
		background: color-mix(in oklab, var(--primary) 8%, transparent);
		color: var(--primary);
	}

	.dynamic-nav__item.is-active {
		border-left-color: var(--primary);
		background: color-mix(in oklab, var(--primary) 12%, transparent);
		color: var(--primary);
	}

	.dynamic-nav__item-title {
		min-width: 0;
		flex: 1;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 0.78rem;
		line-height: 1.35;
		font-weight: 550;
	}

	.dynamic-nav__item-time {
		flex: 0 0 auto;
		font-size: 0.62rem;
		font-variant-numeric: tabular-nums;
		opacity: 0.72;
	}

	:root.dark .dynamic-nav__group-title,
	html.dark .dynamic-nav__group-title {
		background: color-mix(in oklab, var(--card-bg, #1a1a1a) 90%, transparent);
	}

	body.wallpaper-transparent:has(.dynamic-page) .dynamic-nav-widget.card-base {
		background-color: color-mix(in oklab, var(--card-bg) 88%, transparent) !important;
	}

	/* —— 垂直时间刻度轴 —— */
	.dynamic-axis {
		list-style: none;
		margin: 0;
		padding: 0.2rem 0 0.2rem 0.55rem;
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	/* 轴主线 */
	.dynamic-axis::before {
		content: "";
		position: absolute;
		left: 0.55rem;
		top: 0.5rem;
		bottom: 0.5rem;
		width: 2px;
		transform: translateX(-50%);
		border-radius: 2px;
		background: linear-gradient(
			180deg,
			transparent,
			color-mix(in oklab, var(--primary) 30%, transparent) 12%,
			color-mix(in oklab, var(--content-meta) 30%, transparent) 88%,
			transparent
		);
		pointer-events: none;
	}

	.dynamic-axis__item {
		position: relative;
	}

	.dynamic-axis__tick {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.28rem 0.35rem 0.28rem 0;
		text-decoration: none;
		border-radius: 0.4rem;
		transition: background-color 140ms ease;
	}

	.dynamic-axis__tick:hover {
		background: color-mix(in oklab, var(--primary) 7%, transparent);
	}

	.dynamic-axis__dot {
		flex: 0 0 auto;
		width: 0.55rem;
		height: 0.55rem;
		margin-left: -0.02rem;
		border-radius: 50%;
		background: color-mix(in oklab, var(--content-meta) 45%, transparent);
		border: 2px solid var(--card-bg, #fff);
		box-shadow: 0 0 0 1px color-mix(in oklab, var(--content-meta) 25%, transparent);
		transition:
			background-color 160ms ease,
			transform 160ms ease,
			box-shadow 160ms ease;
		position: relative;
		z-index: 1;
	}

	.dynamic-axis__tick:hover .dynamic-axis__dot {
		background: color-mix(in oklab, var(--primary) 70%, transparent);
	}

	.dynamic-axis__tick.is-active .dynamic-axis__dot {
		background: var(--primary);
		transform: scale(1.35);
		box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary) 25%, transparent);
	}

	.dynamic-axis__tick.is-pinned .dynamic-axis__dot {
		background: color-mix(in oklab, var(--primary) 55%, #f59e0b);
	}

	.dynamic-axis__date {
		font-size: 0.72rem;
		font-variant-numeric: tabular-nums;
		font-weight: 550;
		letter-spacing: 0.02em;
		color: color-mix(in oklab, var(--content-meta) 90%, transparent);
		transition: color 140ms ease;
	}

	.dynamic-axis__tick:hover .dynamic-axis__date {
		color: var(--primary);
	}

	.dynamic-axis__tick.is-active .dynamic-axis__date {
		color: var(--primary);
		font-weight: 650;
	}

	:root.dark .dynamic-axis__dot,
	html.dark .dynamic-axis__dot {
		border-color: var(--card-bg, #1a1a1a);
	}
</style>
