---
// LiveChat 浮窗：点击宠物弹出，调 MaxKB API
---

<div id="livechat-widget" class="livechat-widget" aria-hidden="true">
    <div class="livechat-inner">
        <div class="livechat-header" id="livechat-header">
            <div class="livechat-title">
                <span class="livechat-dot"></span>
                <span class="livechat-name">站点问答助手</span>
                <span class="livechat-count" id="livechat-count"></span>
            </div>
            <button class="livechat-close" id="livechat-close" aria-label="收起">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
        </div>
        <div class="livechat-body" id="livechat-body">
            <div class="livechat-messages" id="livechat-messages">
                <div class="livechat-welcome" id="livechat-welcome">
                    <div class="livechat-welcome-icon">问</div>
                    <p>有什么想了解的？<br/>我基于博客内容回答</p>
                </div>
            </div>
            <div class="livechat-input-area">
                <input
                    id="livechat-input"
                    type="text"
                    placeholder="输入你的问题..."
                    autocomplete="off"
                />
                <button id="livechat-send" aria-label="发送">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .livechat-widget {
        position: fixed;
        bottom: 100px;
        right: 24px;
        z-index: 1050;
        width: 360px;
        max-width: calc(100vw - 48px);
        opacity: 0;
        transform: translateY(16px) scale(0.96);
        pointer-events: none;
        transition: opacity 0.25s var(--ease-decelerate, ease-out),
                    transform 0.25s var(--ease-decelerate, ease-out);
    }
    .livechat-widget.open {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: auto;
    }

    .livechat-inner {
        border-radius: var(--radius-2xl, 1rem);
        overflow: hidden;
        background: var(--card-bg);
        border: 1px solid var(--line-divider);
        box-shadow: var(--shadow-2xl);
        display: flex;
        flex-direction: column;
    }

    .livechat-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--line-divider);
        cursor: pointer;
        user-select: none;
    }
    .livechat-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .livechat-dot {
        width: 0.5rem; height: 0.5rem; border-radius: 50%;
        background: oklch(0.7 0.18 145);
        animation: livechat-pulse 1.5s ease-in-out infinite;
    }
    @keyframes livechat-pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }
    .livechat-name {
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--deep-text);
    }
    .livechat-count {
        font-size: 0.75rem;
        color: var(--content-meta);
    }
    .livechat-close {
        width: 1.5rem; height: 1.5rem;
        border: none; background: transparent;
        color: var(--content-meta);
        cursor: pointer;
        transition: transform 0.3s;
        display: flex; align-items: center; justify-content: center;
    }
    .livechat-close svg { width: 1rem; height: 1rem; }
    .livechat-widget.open .livechat-close { transform: rotate(180deg); }

    .livechat-body {
        display: flex;
        flex-direction: column;
        max-height: 420px;
        transition: max-height 0.3s;
    }

    .livechat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        min-height: 200px;
        max-height: 320px;
    }

    .livechat-welcome {
        text-align: center;
        padding: 2rem 1rem;
        color: var(--content-meta);
    }
    .livechat-welcome-icon {
        width: 3rem; height: 3rem;
        margin: 0 auto 0.75rem;
        border-radius: 0.75rem;
        display: flex; align-items: center; justify-content: center;
        color: white; font-size: 1.25rem; font-weight: 700;
        background: var(--primary-gradient);
    }
    .livechat-welcome p { font-size: 0.8125rem; line-height: 1.6; }

    .lc-msg { display: flex; gap: 0.5rem; }
    .lc-msg.me { flex-direction: row-reverse; }
    .lc-msg-avatar {
        width: 1.75rem; height: 1.75rem; border-radius: 0.375rem; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        color: white; font-size: 0.625rem; font-weight: 600;
    }
    .lc-msg-avatar.ai { background: var(--primary-gradient); }
    .lc-msg-avatar.user { background: var(--accent-cool); }
    .lc-msg-body { max-width: 80%; min-width: 0; }
    .lc-msg-bubble {
        padding: 0.625rem 0.875rem; border-radius: 0.875rem;
        font-size: 0.8125rem; line-height: 1.6;
        white-space: pre-wrap; word-break: break-word;
    }
    .lc-msg:not(.me) .lc-msg-bubble {
        background: var(--btn-regular-bg); color: var(--deep-text);
        border-bottom-left-radius: 0.25rem;
    }
    .lc-msg.me .lc-msg-bubble {
        background: var(--primary); color: white;
        border-bottom-right-radius: 0.25rem;
    }
    .lc-msg-time { font-size: 0.625rem; color: var(--content-meta); margin-top: 0.1875rem; }
    .lc-msg.me .lc-msg-time { text-align: right; }

    .lc-sources {
        margin-top: 0.25rem; padding: 0.25rem 0.625rem; border-radius: 0.375rem;
        background: var(--muted); font-size: 0.625rem; color: var(--content-meta);
        line-height: 1.5;
    }
    .lc-sources a { color: var(--primary); text-decoration: none; }
    .lc-sources a:hover { text-decoration: underline; }

    .lc-typing { display: flex; gap: 0.25rem; padding: 0.625rem 0.875rem; }
    .lc-typing span {
        width: 0.375rem; height: 0.375rem; border-radius: 50%;
        background: var(--content-meta);
        animation: lc-bounce 1.2s ease-in-out infinite;
    }
    .lc-typing span:nth-child(2) { animation-delay: 0.15s; }
    .lc-typing span:nth-child(3) { animation-delay: 0.3s; }
    @keyframes lc-bounce {
        0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
        30% { transform: translateY(-4px); opacity: 1; }
    }

    @keyframes lc-in {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .lc-animate { animation: lc-in 0.2s ease-out both; }

    .livechat-input-area {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        border-top: 1px solid var(--line-divider);
    }
    .livechat-input-area input {
        flex: 1;
        height: 2.25rem;
        padding: 0 0.875rem;
        border-radius: 0.625rem;
        background: var(--btn-regular-bg);
        color: var(--deep-text);
        font-size: 0.8125rem;
        outline: none;
        border: 1px solid transparent;
        transition: border-color 0.2s;
    }
    .livechat-input-area input:focus {
        border-color: var(--primary);
    }
    .livechat-input-area input::placeholder {
        color: var(--content-meta);
    }
    .livechat-input-area input:disabled { opacity: 0.5; }
    .livechat-input-area button {
        width: 2.25rem; height: 2.25rem;
        border-radius: 0.625rem;
        border: none;
        display: flex; align-items: center; justify-content: center;
        color: white;
        background: var(--primary);
        cursor: pointer;
        transition: transform 0.15s;
        flex-shrink: 0;
    }
    .livechat-input-area button:hover { transform: scale(1.05); }
    .livechat-input-area button:active { transform: scale(0.95); }
    .livechat-input-area button:disabled { opacity: 0.5; cursor: not-allowed; }
    .livechat-input-area button svg { width: 1rem; height: 1rem; }
</style>

<script>
    const LC_API_BASE = "http://localhost:8080/chat/api";
    const LC_ACCESS_TOKEN = "2777601d60679239";

    let lcToken = null;
    let lcChatId = null;
    let lcLoading = false;
    let lcMsgCount = 0;

    const widget = document.getElementById("livechat-widget");
    const messagesEl = document.getElementById("livechat-messages");
    const inputEl = document.getElementById("livechat-input");
    const sendBtn = document.getElementById("livechat-send");
    const countEl = document.getElementById("livechat-count");

    function lcNow() {
        return new Date().toLocaleTimeString("zh-CN", { hour: "2-digit", minute: "2-digit" });
    }

    function lcEscape(s) {
        return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    function lcUpdateCount() {
        countEl.textContent = lcMsgCount > 0 ? `(${lcMsgCount})` : "";
    }

    function lcAddMsg(role, content, sources) {
        const welcome = document.getElementById("livechat-welcome");
        if (welcome) welcome.remove();
        const isMe = role === "user";
        const row = document.createElement("div");
        row.className = `lc-msg ${isMe ? "me" : ""} lc-animate`;
        let sourcesHtml = "";
        if (sources && sources.length) {
            sourcesHtml = `<div class="lc-sources">📚 ${sources.map(s => `<a href="${s.url}" target="_blank">${lcEscape(s.title)}</a>`).join(" · ")}</div>`;
        }
        row.innerHTML = `
            <div class="lc-msg-avatar ${isMe ? "user" : "ai"}">${isMe ? "我" : "问"}</div>
            <div class="lc-msg-body">
                <div class="lc-msg-bubble">${lcEscape(content)}</div>
                ${sourcesHtml}
                <div class="lc-msg-time">${lcNow()}</div>
            </div>`;
        messagesEl.appendChild(row);
        messagesEl.scrollTop = messagesEl.scrollHeight;
        lcMsgCount++;
        lcUpdateCount();
    }

    function lcAddTyping() {
        const row = document.createElement("div");
        row.className = "lc-msg lc-animate";
        row.id = "lc-typing-row";
        row.innerHTML = `
            <div class="lc-msg-avatar ai">问</div>
            <div class="lc-msg-body">
                <div class="lc-msg-bubble lc-typing"><span></span><span></span><span></span></div>
            </div>`;
        messagesEl.appendChild(row);
        messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function lcRemoveTyping() {
        const t = document.getElementById("lc-typing-row");
        if (t) t.remove();
    }

    async function lcEnsureSession() {
        if (!lcToken) {
            const res = await fetch(`${LC_API_BASE}/auth/anonymous`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ access_token: LC_ACCESS_TOKEN }),
            });
            const data = await res.json();
            if (data.code !== 200) throw new Error("auth failed");
            lcToken = data.data;
        }
        if (!lcChatId) {
            const res = await fetch(`${LC_API_BASE}/open`, {
                headers: { Authorization: "Bearer " + lcToken },
            });
            const data = await res.json();
            if (data.code !== 200) throw new Error("open failed");
            lcChatId = data.data;
        }
    }

    async function lcSend() {
        const text = inputEl.value.trim();
        if (!text || lcLoading) return;
        lcLoading = true;
        sendBtn.disabled = true;
        inputEl.disabled = true;

        lcAddMsg("user", text);
        inputEl.value = "";
        lcAddTyping();

        try {
            await lcEnsureSession();
            const res = await fetch(`${LC_API_BASE}/chat_message/${lcChatId}`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    Authorization: "Bearer " + lcToken,
                },
                body: JSON.stringify({ message: text, stream: false, re_chat: false }),
            });
            const data = await res.json();
            lcRemoveTyping();
            if (data.code === 200 && data.data) {
                const answer = data.data.content || "（没拿到回答）";
                const sources = (data.data.paragraph_list || []).map(p => ({
                    title: p.title || p.document_name || "文章",
                    url: p.source_url || "#",
                }));
                lcAddMsg("assistant", answer, sources);
            } else {
                lcAddMsg("assistant", `出了点问题：${data.message || "未知错误"}`);
            }
        } catch (e) {
            lcRemoveTyping();
            lcAddMsg("assistant", "连不上问答服务。请确认本机 MaxKB 在跑。");
        }

        lcLoading = false;
        sendBtn.disabled = false;
        inputEl.disabled = false;
        inputEl.focus();
    }

    // 打开/关闭
    function lcOpen() {
        widget.classList.add("open");
        widget.setAttribute("aria-hidden", "false");
        inputEl.focus();
    }
    function lcClose() {
        widget.classList.remove("open");
        widget.setAttribute("aria-hidden", "true");
    }
    function lcToggle() {
        widget.classList.contains("open") ? lcClose() : lcOpen();
    }

    // 监听宠物点击事件
    window.addEventListener("pet:livechat:toggle", lcToggle);

    // 头部点击收起
    document.getElementById("livechat-header").addEventListener("click", lcClose);

    sendBtn.addEventListener("click", lcSend);
    inputEl.addEventListener("keydown", e => {
        if (e.key === "Enter") lcSend();
    });
</script>
