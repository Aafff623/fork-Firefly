---
// 浮窗问答：挂与 /ask 页同一个 AskChat 岛（widget 模式：跳过检索与思考链，直发直答）。
// 桌宠点击唤起，气泡→面板两态；浏览器只访问同源代理，密钥不入前端。
import AskChat from "@components/ask/AskChat";
---

<div id="livechat-widget" class="livechat-widget" aria-hidden="true">
    <!-- 折叠态：小气泡 -->
    <div class="lc-bubble" id="lc-bubble">
        <div class="lc-bubble-text">想问什么？</div>
        <div class="lc-bubble-tail"></div>
    </div>

    <!-- 展开态：同一个 AskChat 岛（lite） -->
    <div class="lc-panel" id="lc-panel">
        <div class="lc-panel-header" id="lc-panel-header">
            <div class="lc-panel-title">
                <span class="lc-panel-dot"></span>
                <span class="lc-panel-name">站点问答助手</span>
            </div>
            <button class="lc-panel-close" id="lc-panel-close" aria-label="收起">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
        </div>
        <div class="lc-panel-body" id="lc-panel-body">
            <AskChat client:only="react" mode="widget" />
        </div>
    </div>
</div>

<style>
    /* ===== 容器 ===== */
    .livechat-widget {
        position: fixed;
        bottom: 100px;
        right: 24px;
        z-index: 1050;
        pointer-events: none;
    }
    .livechat-widget.bubble,
    .livechat-widget.open {
        pointer-events: auto;
    }

    /* ===== 折叠态：漫画小气泡 ===== */
    .lc-bubble {
        position: absolute;
        bottom: 0;
        right: 0;
        opacity: 0;
        transform: translateY(8px) scale(0.8);
        transform-origin: bottom right;
        transition: opacity 0.25s var(--ease-decelerate, ease-out),
                    transform 0.25s var(--ease-decelerate, ease-out);
        pointer-events: none;
    }
    .livechat-widget.bubble .lc-bubble {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: auto;
    }
    .livechat-widget.open .lc-bubble {
        opacity: 0;
        transform: translateY(8px) scale(0.8);
        pointer-events: none;
    }

    .lc-bubble-text {
        background: var(--card-bg);
        border: 1px solid var(--line-divider);
        border-radius: 1rem;
        border-bottom-right-radius: 0.25rem;
        padding: 0.625rem 1rem;
        font-size: 0.8125rem;
        color: var(--deep-text);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        white-space: nowrap;
    }
    .lc-bubble-text:hover {
        transform: scale(1.05);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
    }
    .lc-bubble-tail {
        position: absolute;
        bottom: -6px;
        right: 20px;
        width: 12px;
        height: 12px;
        background: var(--card-bg);
        border-right: 1px solid var(--line-divider);
        border-bottom: 1px solid var(--line-divider);
        transform: rotate(45deg);
        border-bottom-right-radius: 3px;
    }

    /* ===== 展开态：聊天面板 ===== */
    .lc-panel {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 420px;
        max-width: calc(100vw - 32px);
        opacity: 0;
        transform: translateY(16px) scale(0.95);
        transform-origin: bottom right;
        transition: opacity 0.25s var(--ease-decelerate, ease-out),
                    transform 0.25s var(--ease-decelerate, ease-out);
        pointer-events: none;
    }
    .livechat-widget.open .lc-panel {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: auto;
    }

    .lc-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.625rem 0.875rem;
        border-bottom: 1px solid var(--line-divider);
        cursor: pointer;
        user-select: none;
        background: var(--card-bg);
        border-radius: 1rem 1rem 0 0;
        border: 1px solid var(--line-divider);
        border-bottom: none;
    }
    .lc-panel-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .lc-panel-dot {
        width: 0.5rem; height: 0.5rem; border-radius: 50%;
        background: oklch(0.7 0.18 145);
        animation: lc-pulse 1.5s ease-in-out infinite;
    }
    @keyframes lc-pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }
    .lc-panel-name {
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--deep-text);
    }
    .lc-panel-close {
        width: 1.5rem; height: 1.5rem;
        border: none; background: transparent;
        color: var(--content-meta);
        cursor: pointer;
        transition: transform 0.3s;
        display: flex; align-items: center; justify-content: center;
    }
    .lc-panel-close svg { width: 0.875rem; height: 0.875rem; }
    .livechat-widget.open .lc-panel-close { transform: rotate(180deg); }

    /* 面板体：让 AskChat 岛自己撑高滚动 */
    .lc-panel-body {
        background: var(--card-bg);
        border: 1px solid var(--line-divider);
        border-top: none;
        border-radius: 0 0 1rem 1rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
        overflow: hidden;
        height: min(720px, calc(100vh - 180px));
        min-height: 520px;
    }
</style>

<script is:inline>
  (() => {
    const widget = document.getElementById("livechat-widget");

    // 三态：hidden → bubble → panel
    // 点击宠物：hidden ↔ bubble
    // 点击气泡：bubble → panel
    // 点击面板头部：panel → bubble
    let lcState = "hidden";

    function lcSetState(state) {
        lcState = state;
        widget.classList.remove("open", "bubble");
        if (state === "panel") {
            widget.classList.add("open");
            widget.setAttribute("aria-hidden", "false");
        } else if (state === "bubble") {
            widget.classList.add("bubble");
            widget.setAttribute("aria-hidden", "false");
        } else {
            widget.setAttribute("aria-hidden", "true");
        }
    }

    function lcToggle() {
        if (lcState === "hidden") {
            lcSetState("bubble");
        } else if (lcState === "bubble") {
            lcSetState("hidden");
        } else {
            lcSetState("bubble");
        }
    }

    // 监听宠物点击事件
    window.addEventListener("pet:livechat:toggle", lcToggle);

    // 点击气泡展开面板
    document.getElementById("lc-bubble").addEventListener("click", () => lcSetState("panel"));

    // 头部点击收起回气泡
    document.getElementById("lc-panel-header").addEventListener("click", () => lcSetState("bubble"));
  })();
</script>
