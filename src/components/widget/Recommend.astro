---
/**
 * 推荐文章（侧栏）：文章页顶替分类位。
 * 服务端 getRelatedPosts 出首屏；侧栏常为静态，靠 #swup-container + allPostMeta 同步重算。
 * 算法：标签相关优先，不足按热度代理补齐（非纯随机）。
 */
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import type { PostForList } from "@/utils/content-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getPostUrlBySlug, url } from "@/utils/url-utils";

export type RelatedPostMeta = {
	id: string;
	title: string;
	category: string;
	published: string;
};

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
	relatedPosts?: PostForList[];
	currentPostId?: string;
}

const {
	class: className,
	style,
	widgetConfig,
	relatedPosts = [],
	currentPostId = "",
} = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;
const limit = widgetConfig?.specificConfig?.recommend?.limit ?? 3;
const title = i18n(I18nKey.recommendedPosts);
const issue = `INDEX · ${i18n(I18nKey.smartRecommend)}`;
const emptyText = i18n(I18nKey.noRecommendedPosts);
const apiUrl = url("/api/allPostMeta.json");

const initialRows: RelatedPostMeta[] = relatedPosts.slice(0, limit).map((p) => ({
	id: p.id,
	title: p.data.title,
	category: (p.data.category || "NOTE").trim(),
	published: formatDateToYYYYMMDD(p.data.published),
}));

const hideRowCategoryKeys =
	initialRows.length > 0 &&
	initialRows.every(
		(row) => row.category.toLowerCase() === initialRows[0].category.toLowerCase(),
	);
---

<WidgetLayout
  name={title}
  showTitle={showTitle}
  id="recommend"
  class:list={["recommend-widget", className]}
  style={style}
>
  <section
    class="recommend-index recommend-index--sidebar"
    aria-label={title}
    data-recommend-root
    data-api-url={apiUrl}
    data-current-id={currentPostId}
    data-limit={String(limit)}
    data-empty-text={emptyText}
    data-issue={issue}
    data-hide-row-keys={hideRowCategoryKeys ? "1" : "0"}
  >
    <header class="recommend-index__mast">
      <span class="recommend-index__issue" data-recommend-issue>{issue}</span>
      <span
        class="recommend-index__same-cat"
        data-recommend-same-cat
        hidden={!hideRowCategoryKeys}
      >
        {hideRowCategoryKeys ? initialRows[0].category : ""}
      </span>
    </header>

    <div class="recommend-index__rows" data-recommend-rows>
      {
        initialRows.length > 0 ? (
          initialRows.map((post) => (
            <a
              href={getPostUrlBySlug(post.id)}
              class="recommend-index__row"
              title={post.title}
            >
              {
                hideRowCategoryKeys ? null : (
                  <span class="recommend-index__key">{post.category}</span>
                )
              }
              <span class="recommend-index__title">{post.title}</span>
              <span class="recommend-index__meta">{post.published}</span>
            </a>
          ))
        ) : (
          <div class="recommend-index__empty" data-recommend-empty>
            {emptyText}
          </div>
        )
      }
    </div>
  </section>
</WidgetLayout>

<script is:inline defer data-swup-ignore-script src="/scripts/recommend-widget.js"></script>
