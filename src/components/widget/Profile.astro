---
/**
 * 侧栏名片：头像点击 → 晃动 + 招手 + 文言问候气泡（不跳转）
 * 名字链到 /about/，外链仍走下方 icons
 */
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import TypewriterText from "@/components/features/TypewriterText.astro";
import { announcementConfig } from "@/config/announcementConfig";
import { profileConfig } from "@/config/profileConfig";
import { avatarGreetings } from "@/data/avatar-greetings";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}
const { style } = Astro.props;
const className = Astro.props.class;

const voiceBio = profileConfig.bio;
const noticeText = announcementConfig.content;
const greetingsJson = JSON.stringify(avatarGreetings.map((g) => g.text));
const aboutUrl = url("/about/");
const frameCfg = profileConfig.avatarFrame;
const frameFeatureOn = frameCfg?.enabled !== false;
const defaultFrameId = frameCfg?.defaultId || "S3-metallic";
const frameOptions = frameCfg?.frames ?? [];
const svgFrames = frameOptions.filter(
	(f) => f.kind === "svg" && typeof f.src === "string" && f.src.length > 0,
);

/** 社交图标悬停品牌色 key */
function socialBrandKey(name: string, icon: string): string {
	const n = `${name} ${icon}`.toLowerCase();
	if (n.includes("github")) return "github";
	if (n.includes("bilibili")) return "bilibili";
	if (n.includes("mail") || n.includes("email")) return "email";
	if (n.includes("twitter") || n.includes("x-twitter") || /(^|\s)x(\s|$)/.test(n))
		return "x";
	if (n.includes("telegram")) return "telegram";
	return "default";
}
---

{/* 对齐时钟：无 card-base 外壳，内容直接浮在壁纸上 */}
<div class:list={["profile-widget", "p-2.5", className]} style={style}>
  <div
    class:list={[
      "profile-avatar-stage relative mx-auto mt-0.5 lg:mt-0 mb-2 w-[58%] max-w-28 lg:w-[60%] lg:max-w-32",
      frameFeatureOn && "profile-avatar-stage--frame-ready",
    ]}
    data-profile-avatar-frame
    data-default-frame={defaultFrameId}
  >
    <button
      type="button"
      aria-label="向园主问好"
      class="profile-avatar-shell group relative block w-full aspect-square overflow-visible rounded-full"
      data-avatar-greet
      data-greetings={greetingsJson}
    >
      <span class="profile-avatar-clip absolute inset-0 overflow-hidden rounded-full pointer-events-none">
        <ImageWrapper
          src={profileConfig.avatar || ""}
          alt="Profile Image of the Author"
          class="profile-avatar-image mx-auto lg:w-full h-full lg:mt-0 object-cover"
          loading="eager"
          fetchpriority="high"
          widths={[350]}
          sizes="350px"
          fadeIn={false}
          showLqip={false}
          showOverlay={false}
        />
      </span>
      {
        frameFeatureOn &&
          svgFrames.map((f) => (
            <img
              class="profile-avatar-frame"
              data-frame-id={f.id}
              src={f.src}
              alt=""
              width="240"
              height="240"
              decoding="async"
              aria-hidden="true"
              draggable="false"
            />
          ))
      }
      <span class="profile-avatar-wave" data-avatar-wave aria-hidden="true">👋</span>
      <span
        class="profile-avatar-bubble"
        data-avatar-bubble
        role="status"
        aria-live="polite"
        hidden
      ></span>
    </button>
  </div>
  <div class="px-2">
    <a
      href={aboutUrl}
      class="repel-text font-bold text-lg text-center mb-0.5 dark:text-neutral-50 transition-colors block hover:text-(--primary)"
      data-repel-radius="52"
      data-repel-strength="2.2"
      aria-label="前往关于页"
    >
      {profileConfig.name}
    </a>
    <div
      class="accent-bar-grad h-0.5 w-4 mx-auto rounded-full mb-1.5 transition"
    >
    </div>
    {/* 同一张卡：格言=原墨光 UI；近况=像素打字机 UI；整段切换，不是同一套样式轮播字 */}
    <div
      class="text-voice-shell text-voice-shell--rotate mb-1.5"
      data-mode="voice"
      data-voice-dwell="5600"
      data-notice-dwell="8200"
      aria-live="polite"
    >
      <div class="voice-rotate-panel voice-rotate-panel--voice" data-panel="voice">
        <div class="text-voice text-center italic text-xs leading-snug line-clamp-3">
          {voiceBio}
        </div>
      </div>
      <div class="voice-rotate-panel voice-rotate-panel--notice" data-panel="notice" aria-hidden="true">
        <TypewriterText
          text={noticeText}
          speed={48}
          deferStart={true}
          class="motto-typewriter"
        />
      </div>
    </div>
        <div class="profile-social flex flex-wrap gap-x-4 gap-y-1.5 justify-center mb-0.5">
            {profileConfig.links.map((item) => {
                    const showName = item.showName;
                    const brand = socialBrandKey(item.name, item.icon);
                    const linkClass = showName || profileConfig.links.length === 1
                        ? "profile-social__link flex items-center gap-1.5 text-(--content-meta) transition"
                        : "profile-social__link flex items-center text-(--content-meta) transition";
                    const showLabel = showName || profileConfig.links.length === 1;

                    if (item.url.startsWith("mailto:")) {
                        const encodedEmail = Buffer.from(item.url.replace("mailto:", "")).toString("base64");
                        return <a rel="me" aria-label={item.name} href="#" data-brand={brand} data-encoded-email={encodedEmail} onclick={`
                                            (function() {
                                                const encodedEmail = this.getAttribute('data-encoded-email');
                                                const decodedEmail = atob(encodedEmail);
                                                this.href = 'mailto:' + decodedEmail;
                                                this.removeAttribute('data-encoded-email');
                                                this.removeAttribute('onclick');
                                                this.click();
                                                return false;
                                            }).call(this);
                                        `.replace(/\s+/g, " ").trim()
                                    },
                                    class={linkClass}>
                            <Icon is:inline name={item.icon} class="text-[1.375rem]"></Icon>
                            {showLabel && <span class="text-sm">{item.name}</span>}
                        </a>
                    }
                    return <a rel="me" aria-label={item.name} href={item.url} target="_blank" data-brand={brand} class={linkClass}>
                            <Icon is:inline name={item.icon} class="text-[1.375rem]"></Icon>
                            {showLabel && <span class="text-sm">{item.name}</span>}
                        </a>
            })}
        </div>
  </div>
</div>

<script>
  function initVoiceNoticeRotate(root?: ParentNode) {
    const scope = root ?? document;
    scope.querySelectorAll(".text-voice-shell--rotate").forEach((node) => {
      const shell = node as HTMLElement & { __voiceRotateTimer?: number };
      if (shell.dataset.rotateBound === "1") return;
      shell.dataset.rotateBound = "1";

      const voicePanel = shell.querySelector<HTMLElement>('[data-panel="voice"]');
      const noticePanel = shell.querySelector<HTMLElement>('[data-panel="notice"]');
      const typewriter = shell.querySelector<HTMLElement>(".motto-typewriter");
      if (!voicePanel || !noticePanel) return;

      const voiceDwell = Number(shell.dataset.voiceDwell || 5600);
      const noticeDwell = Number(shell.dataset.noticeDwell || 8200);
      let mode: "voice" | "notice" = "voice";

      const applyMode = (next: "voice" | "notice") => {
        mode = next;
        shell.dataset.mode = next;
        voicePanel.setAttribute("aria-hidden", next === "voice" ? "false" : "true");
        noticePanel.setAttribute("aria-hidden", next === "notice" ? "false" : "true");
        if (next === "notice" && typewriter) {
          typewriter.dispatchEvent(new CustomEvent("typewriter:restart", { bubbles: true }));
        }
      };

      const tick = () => {
        if (mode === "voice") {
          applyMode("notice");
          shell.__voiceRotateTimer = window.setTimeout(tick, noticeDwell);
        } else {
          applyMode("voice");
          shell.__voiceRotateTimer = window.setTimeout(tick, voiceDwell);
        }
      };

      applyMode("voice");
      shell.__voiceRotateTimer = window.setTimeout(tick, voiceDwell);
    });
  }

  function bootVoiceNoticeRotate() {
    document.querySelectorAll(".text-voice-shell--rotate").forEach((node) => {
      delete (node as HTMLElement).dataset.rotateBound;
    });
    initVoiceNoticeRotate();
  }

  type GreetBtn = HTMLButtonElement & {
    __greetTimer?: number;
    __lastGreet?: string;
  };

  function pickGreeting(list: string[], exclude?: string) {
    const pool = exclude ? list.filter((t) => t !== exclude) : list;
    const src = pool.length ? pool : list;
    return src[Math.floor(Math.random() * src.length)] || "客至，敢不肃容以迎。";
  }

  function initAvatarGreet(root?: ParentNode) {
    const scope = root ?? document;
    scope.querySelectorAll<GreetBtn>("[data-avatar-greet]").forEach((btn) => {
      if (btn.dataset.greetBound === "1") return;
      btn.dataset.greetBound = "1";

      let greetings: string[] = [];
      try {
        greetings = JSON.parse(btn.getAttribute("data-greetings") || "[]");
      } catch {
        greetings = [];
      }
      if (!greetings.length) {
        greetings = ["客至，敢不肃容以迎。", "花园有客，今日亦宜浇水。"];
      }

      const wave = btn.querySelector<HTMLElement>("[data-avatar-wave]");
      const bubble = btn.querySelector<HTMLElement>("[data-avatar-bubble]");

      const dismiss = () => {
        btn.classList.remove("is-greeting");
        if (bubble) {
          bubble.hidden = true;
          bubble.textContent = "";
        }
        if (btn.__greetTimer) {
          window.clearTimeout(btn.__greetTimer);
          btn.__greetTimer = undefined;
        }
      };

      btn.addEventListener("click", () => {
        const text = pickGreeting(greetings, btn.__lastGreet);
        btn.__lastGreet = text;
        btn.classList.remove("is-greeting");
        // 强制重启动画
        void btn.offsetWidth;
        btn.classList.add("is-greeting");
        if (bubble) {
          bubble.hidden = false;
          bubble.textContent = text;
        }
        if (wave) wave.setAttribute("aria-hidden", "false");
        if (btn.__greetTimer) window.clearTimeout(btn.__greetTimer);
        btn.__greetTimer = window.setTimeout(dismiss, 4200);
      });
    });
  }

  function bootProfileWidget() {
    bootVoiceNoticeRotate();
    document.querySelectorAll("[data-avatar-greet]").forEach((node) => {
      delete (node as HTMLElement).dataset.greetBound;
    });
    initAvatarGreet();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootProfileWidget);
  } else {
    bootProfileWidget();
  }
  document.addEventListener("swup:contentReplaced", bootProfileWidget);
  document.addEventListener("swup:content:replace", bootProfileWidget);
  document.addEventListener("swup:page:view", bootProfileWidget);
</script>

<style>
  /* 与 surprise-clock / layered-clock 同款：无底、无边、无影 */
  .profile-widget {
    position: relative;
    overflow: visible;
    background: transparent !important;
    background-color: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  :global(.enable-card-border) .profile-widget,
  :global(.wallpaper-transparent) .profile-widget,
  :global(body.wallpaper-transparent) .profile-widget {
    background: transparent !important;
    background-color: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
  }

  .profile-avatar-stage {
    /* 给招手与气泡留出溢出空间 */
    overflow: visible;
  }

  /* 有装饰框时略放大舞台，避免挂件裁切（none 除外） */
  :global(html[data-avatar-frame]:not([data-avatar-frame="none"]))
    .profile-avatar-stage--frame-ready {
    width: 68%;
    max-width: 8.25rem;
  }

  @media (min-width: 1024px) {
    :global(html[data-avatar-frame]:not([data-avatar-frame="none"]))
      .profile-avatar-stage--frame-ready {
      width: 72%;
      max-width: 9.25rem;
    }
  }

  .profile-avatar-stage:has(.is-greeting) {
    margin-bottom: 3.25rem;
  }

  .profile-avatar-shell {
    padding: 0.2rem;
    background: color-mix(in oklch, var(--card-bg) 82%, #b9aa98);
    border: 1px solid color-mix(in oklch, var(--line-divider) 68%, #a89987);
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--card-bg) 68%, white),
      0 0.28rem 0.7rem rgb(69 58 45 / 0.1);
    animation: profile-avatar-breathe 4.8s ease-in-out infinite;
    cursor: pointer;
  }

  :global(html[data-avatar-frame]:not([data-avatar-frame="none"]))
    .profile-avatar-stage--frame-ready
    .profile-avatar-shell {
    padding: 0.12rem;
    background: color-mix(in oklch, var(--card-bg) 90%, white);
    border-color: color-mix(in oklch, var(--line-divider) 40%, transparent);
    box-shadow: 0 0.2rem 0.55rem rgb(69 58 45 / 0.08);
  }

  .profile-avatar-clip {
    z-index: 1;
  }

  .profile-avatar-frame {
    display: none;
    position: absolute;
    z-index: 2;
    inset: -18%;
    width: 136%;
    height: 136%;
    max-width: none;
    pointer-events: none;
    user-select: none;
    object-fit: contain;
  }

  :global(html[data-avatar-frame="S3-metallic"])
    .profile-avatar-frame[data-frame-id="S3-metallic"],
  :global(html[data-avatar-frame="S6-laurel"])
    .profile-avatar-frame[data-frame-id="S6-laurel"] {
    display: block;
  }

  /* —— CSS 框（从挑选页迁入）—— */
  @property --af-a {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }

  :global(html[data-avatar-frame="C3-conic-spin"])
    .profile-avatar-stage--frame-ready
    .profile-avatar-shell {
    padding: 3px;
    border: 0;
    background: conic-gradient(
      from var(--af-a, 0deg),
      #ddd6fe,
      #7c3aed,
      #f9a8d4,
      #93c5fd,
      #ddd6fe
    );
    animation:
      profile-avatar-breathe 4.8s ease-in-out infinite,
      af-spin 6s linear infinite;
    box-shadow: 0 0.2rem 0.55rem rgb(69 58 45 / 0.08);
  }

  :global(html[data-avatar-frame="C3-conic-spin"])
    .profile-avatar-stage--frame-ready
    .profile-avatar-clip {
    inset: 4px;
    background: var(--card-bg, #fff);
  }

  :global(html[data-avatar-frame="C2-dual-soft"])
    .profile-avatar-stage--frame-ready
    .profile-avatar-shell {
    border: 0;
    padding: 0;
    background: transparent;
    box-shadow:
      0 0 0 3px #fff,
      0 0 0 6px #c4b5fd,
      0 0 0 9px rgb(167 139 250 / 0.35),
      0 8px 20px rgb(100 60 180 / 0.18);
  }

  :global(html.dark[data-avatar-frame="C2-dual-soft"])
    .profile-avatar-stage--frame-ready
    .profile-avatar-shell {
    box-shadow:
      0 0 0 3px color-mix(in oklch, var(--card-bg) 80%, white),
      0 0 0 6px #a78bfa,
      0 0 0 9px rgb(167 139 250 / 0.28),
      0 8px 20px rgb(0 0 0 / 0.35);
  }

  :global(html[data-avatar-frame="C6-metallic"])
    .profile-avatar-stage--frame-ready
    .profile-avatar-shell {
    padding: 4px;
    border: 0;
    background: linear-gradient(
      135deg,
      #f8fafc,
      #94a3b8 30%,
      #e2e8f0 50%,
      #64748b 75%,
      #f1f5f9
    );
    box-shadow: 0 4px 14px rgb(15 23 42 / 0.2);
  }

  :global(html[data-avatar-frame="C6-metallic"])
    .profile-avatar-stage--frame-ready
    .profile-avatar-clip {
    inset: 4px;
  }

  :global(html[data-avatar-frame="C5-stars-css"])
    .profile-avatar-stage--frame-ready
    .profile-avatar-shell {
    padding: 5px;
    border: 0;
    background:
      radial-gradient(circle at 50% 4%, #fde68a 0 2px, transparent 2.5px),
      radial-gradient(circle at 88% 22%, #fff 0 1.5px, transparent 2px),
      radial-gradient(circle at 96% 55%, #fde68a 0 2px, transparent 2.5px),
      radial-gradient(circle at 78% 90%, #fff 0 1.5px, transparent 2px),
      radial-gradient(circle at 22% 92%, #fde68a 0 2px, transparent 2.5px),
      radial-gradient(circle at 4% 48%, #fff 0 1.5px, transparent 2px),
      linear-gradient(#c4b5fd, #93c5fd);
    box-shadow: 0 0.2rem 0.55rem rgb(69 58 45 / 0.1);
  }

  :global(html[data-avatar-frame="C5-stars-css"])
    .profile-avatar-stage--frame-ready
    .profile-avatar-clip {
    inset: 5px;
    background: var(--card-bg, #fff);
  }

  @keyframes af-spin {
    to {
      --af-a: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-avatar-frame="C3-conic-spin"])
      .profile-avatar-stage--frame-ready
      .profile-avatar-shell {
      animation: profile-avatar-breathe 4.8s ease-in-out infinite;
    }
  }

  .profile-avatar-shell :global(.profile-avatar-image),
  .profile-avatar-shell :global(.profile-avatar-image picture),
  .profile-avatar-shell :global(.profile-avatar-image img) {
    width: 100%;
    height: 100%;
    border-radius: inherit;
  }

  .profile-avatar-wave {
    position: absolute;
    right: -0.15rem;
    bottom: -0.1rem;
    z-index: 3;
    font-size: 1.35rem;
    line-height: 1;
    opacity: 0;
    transform: scale(0.6) rotate(-12deg);
    pointer-events: none;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.18));
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  /* 头像下方横排气泡，避免侧栏窄宽导致一字一行 */
  .profile-avatar-bubble {
    position: absolute;
    left: 50%;
    top: calc(100% + 0.4rem);
    bottom: auto;
    z-index: 4;
    min-width: 8.5rem;
    max-width: min(12rem, 70vw);
    width: max-content;
    padding: 0.45rem 0.65rem;
    border-radius: 0.65rem;
    border: 1px solid color-mix(in oklch, var(--line-divider) 70%, transparent);
    background: color-mix(in oklch, var(--card-bg) 94%, white);
    box-shadow: 0 4px 14px rgb(40 30 20 / 0.1);
    color: color-mix(in oklch, var(--content-meta, #444) 40%, var(--primary));
    font-size: 0.72rem;
    line-height: 1.5;
    text-align: center;
    writing-mode: horizontal-tb;
    white-space: normal;
    word-break: keep-all;
    overflow-wrap: anywhere;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .profile-avatar-bubble[hidden] {
    display: none !important;
  }

  .profile-avatar-bubble::before {
    content: "";
    position: absolute;
    left: 50%;
    top: -4px;
    bottom: auto;
    width: 8px;
    height: 8px;
    border-left: 1px solid color-mix(in oklch, var(--line-divider) 70%, transparent);
    border-bottom: 1px solid color-mix(in oklch, var(--line-divider) 70%, transparent);
    background: color-mix(in oklch, var(--card-bg) 94%, white);
    transform: translateX(-50%) rotate(135deg);
  }

  /* 社交：默认灰，悬停品牌色 */
  .profile-social__link:hover,
  .profile-social__link:focus-visible {
    color: var(--brand, var(--primary));
  }

  .profile-social__link[data-brand="github"] {
    --brand: #24292f;
  }
  :global(html.dark) .profile-social__link[data-brand="github"] {
    --brand: #f0f6fc;
  }
  .profile-social__link[data-brand="bilibili"] {
    --brand: #fb7299;
  }
  .profile-social__link[data-brand="email"] {
    --brand: #5b8def;
  }
  .profile-social__link[data-brand="x"] {
    --brand: #24292f;
  }
  :global(html.dark) .profile-social__link[data-brand="x"] {
    --brand: #f0f6fc;
  }
  .profile-social__link[data-brand="telegram"] {
    --brand: #26a5e4;
  }

  .profile-avatar-shell.is-greeting {
    animation: profile-avatar-shake 0.55s ease;
  }

  .profile-avatar-shell.is-greeting .profile-avatar-wave {
    opacity: 1;
    transform: scale(1) rotate(0deg);
    animation: profile-wave-hand 0.9s ease-in-out infinite;
  }

  @keyframes profile-avatar-breathe {
    0%, 100% { transform: translateY(0) scale(1); }
    50% {
      transform: translateY(-0.12rem) scale(1.012);
      box-shadow:
        0 0 0 1px color-mix(in oklch, var(--card-bg) 68%, white),
        0 0.38rem 0.82rem rgb(69 58 45 / 0.12);
    }
  }

  @keyframes profile-avatar-shake {
    0%, 100% { transform: translateX(0) rotate(0deg); }
    20% { transform: translateX(-3px) rotate(-2.5deg); }
    40% { transform: translateX(3px) rotate(2deg); }
    60% { transform: translateX(-2px) rotate(-1.5deg); }
    80% { transform: translateX(2px) rotate(1deg); }
  }

  @keyframes profile-wave-hand {
    0%, 100% { transform: scale(1) rotate(-8deg); }
    50% { transform: scale(1.08) rotate(14deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-avatar-shell { animation: none; }
    .profile-avatar-shell.is-greeting { animation: none; }
    .profile-avatar-shell.is-greeting .profile-avatar-wave {
      animation: none;
    }
  }

</style>
