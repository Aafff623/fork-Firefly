---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}
const { style } = Astro.props;
const className = Astro.props.class;
---

<div class:list={["card-base", "p-3", className]} style={style}>
  <a
    aria-label="Go to About Page"
    href={url("/about/")}
    class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
       aspect-square w-full max-w-48 lg:max-w-none overflow-hidden rounded-full active:scale-95"
  >
    <div
      class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center rounded-full"
    >
      <Icon is:inline
        name="fa7-regular:address-card"
        class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl"
      />
    </div>
    <ImageWrapper
      src={profileConfig.avatar || ""}
      alt="Profile Image of the Author"
      class="profile-avatar-image mx-auto lg:w-full h-full lg:mt-0 object-cover"
      loading="eager"
      fetchpriority="high"
      widths={[350]}
      sizes="350px"
    />
  </a>
  <div class="px-2">
    <div
      class="repel-text font-bold text-xl text-center mb-1 dark:text-neutral-50 transition"
    >
      {profileConfig.name}
    </div>
    <div
      class="accent-bar-grad h-1 w-5 mx-auto rounded-full mb-2 transition"
    >
    </div>
    <div class="text-voice text-center mb-2.5 italic text-sm leading-relaxed">
      {profileConfig.bio}
    </div>
        <div class="flex flex-wrap gap-x-5 gap-y-2 justify-center mb-1">
            {profileConfig.links.length > 1 && profileConfig.links.map(item =>
                    {
                    const showName = item.showName;
                    // Spotlight 风格：无底座图标行，灰色 → hover 主题色
                    const className = showName
                        ? "flex items-center gap-1.5 text-(--content-meta) transition hover:text-(--primary)"
                        : "flex items-center text-(--content-meta) transition hover:text-(--primary)";

                    if (item.url.startsWith("mailto:")) {
                        const encodedEmail = Buffer.from(item.url.replace("mailto:", "")).toString("base64");
                        return <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail} onclick={`
                                            (function() {
                                                const encodedEmail = this.getAttribute('data-encoded-email');
                                                const decodedEmail = atob(encodedEmail);
                                                this.href = 'mailto:' + decodedEmail;
                                                this.removeAttribute('data-encoded-email');
                                                this.removeAttribute('onclick');
                                                this.click();
                                                return false;
                                            }).call(this);
                                        `.replace(/\s+/g, " ").trim()
                                    },
                                    class={className}>
                            <Icon is:inline name={item.icon} class="text-[1.375rem]"></Icon>
                            {showName && <span class="text-sm">{item.name}</span>}
                        </a>
                    } else {
                        return <a rel="me" aria-label={item.name} href={item.url} target="_blank" class={className}>
                            <Icon is:inline name={item.icon} class="text-[1.375rem]"></Icon>
                            {showName && <span class="text-sm">{item.name}</span>}
                        </a>
                    }
                    }
            )}
            {profileConfig.links.length == 1 && (function(item){
                const singleClass = "flex items-center gap-1.5 text-(--content-meta) transition hover:text-(--primary)";
                if (item.url.startsWith("mailto:")) {
                        const encodedEmail = Buffer.from(item.url.replace("mailto:", "")).toString("base64");
                        return <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail} onclick={`
                                            (function() {
                                                const encodedEmail = this.getAttribute('data-encoded-email');
                                                const decodedEmail = atob(encodedEmail);
                                                this.href = 'mailto:' + decodedEmail;
                                                this.removeAttribute('data-encoded-email');
                                                this.removeAttribute('onclick');
                                                this.click();
                                                return false;
                                            }).call(this);
                                        `.replace(/\s+/g, " ").trim()
                                    },
                                    class={singleClass}>
                            <Icon is:inline name={item.icon} class="text-[1.375rem]"></Icon>
                            <span class="text-sm">{item.name}</span>
                        </a>
                    } else {
                        return <a rel="me" aria-label={item.name} href={item.url} target="_blank"
                                            class={singleClass}>
                                <Icon is:inline name={item.icon} class="text-[1.375rem]"></Icon>
                                <span class="text-sm">{item.name}</span>
                            </a>
                    }
            })(profileConfig.links[0])}
        </div>
  </div>
</div>
