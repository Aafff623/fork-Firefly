---
/**
 * 站点概览：统计 + 精简站点信息 + 迷你分层时钟（右侧装饰融合）
 * 分层时钟源：bilibili-goat/widgets/分层时钟/x.html
 */
import { readFileSync } from "node:fs";
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import LayeredClock from "@/components/widget/LayeredClock.astro";
import { licenseConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "@/utils/content-utils";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
const siteStartDate = siteConfig.siteStartDate || "2026-08-01";

const posts = await getSortedPosts();
const categories = await getCategoryList();
const tags = await getTagList();

let totalWords = 0;
for (const post of posts) {
	if (!post.body) continue;
	const text = post.body
		.replace(/```[\s\S]*?```/g, "")
		.replace(/`[^`]*`/g, "")
		.replace(/\s+/g, " ")
		.trim();
	const chineseChars = text.match(/[\u4e00-\u9fa5]/g) || [];
	const englishChars = text.match(/[a-zA-Z]/g) || [];
	totalWords += chineseChars.length + englishChars.length;
}

function formatCompact(num: number): string {
	if (num >= 10000) return `${(num / 10000).toFixed(1).replace(/\.0$/, "")}万`;
	if (num >= 1000) return `${(num / 1000).toFixed(1).replace(/\.0$/, "")}k`;
	return String(num);
}

let blogVersion = "unknown";
try {
	const pkg = JSON.parse(
		readFileSync(new URL("../../../package.json", import.meta.url), "utf-8"),
	);
	blogVersion = pkg.version || "unknown";
} catch {}

const licenseName = licenseConfig.enable ? licenseConfig.name : "";
const daysLabel = i18n(I18nKey.siteStatsDays).replace("{days}", "").trim();

const metrics = [
	{
		label: i18n(I18nKey.siteStatsPostCount),
		value: String(posts.length),
	},
	{
		label: i18n(I18nKey.siteStatsCategoryCount),
		value: String(categories.length),
	},
	{
		label: i18n(I18nKey.siteStatsTagCount),
		value: String(tags.length),
	},
	{
		label: i18n(I18nKey.siteStatsTotalWords),
		value: formatCompact(totalWords),
	},
];
---

<WidgetLayout
  name={i18n(I18nKey.siteStats)}
  showTitle={showTitle}
  id="site-stats"
  class:list={["site-overview-widget", className]}
  style={style}
>
  <Icon
    slot="title-leading"
    is:inline
    name="lucide:chart-column"
    class="widget-title-icon"
    aria-hidden="true"
  />
  <div
    class="site-overview"
    data-site-start={siteStartDate}
    data-days-label={daysLabel}
  >
    <div class="site-overview__grid" role="list">
      {
        metrics.map((m) => (
          <div class="site-overview__cell" role="listitem">
            <b class="site-overview__num">{m.value}</b>
            <span class="site-overview__label">{m.label}</span>
          </div>
        ))
      }
    </div>

    <div class="site-overview__rail">
      <div class="site-overview__rail-meta">
        <span class="site-overview__run">
          {i18n(I18nKey.siteStatsRunningDays)}
          <b data-stat-id="running-days">—</b>
          <span data-days-suffix>{daysLabel}</span>
        </span>
        <span class="site-overview__dot" aria-hidden="true">·</span>
        <a
          class="site-overview__link"
          href="https://github.com/CuteLeaf/Firefly"
          target="_blank"
          rel="noopener noreferrer"
          title={i18n(I18nKey.siteInfoBlogVersion)}
        >
          Firefly v{blogVersion}
        </a>
        {
          licenseName && (
            <>
              <span class="site-overview__dot" aria-hidden="true">
                ·
              </span>
              <span
                class="site-overview__meta"
                title={i18n(I18nKey.siteInfoLicense)}
              >
                {licenseName}
              </span>
            </>
          )
        }
      </div>

      <div class="site-overview__clock">
        <LayeredClock bare={true} class="lc7--in-stats" />
      </div>
    </div>
  </div>
</WidgetLayout>

<style is:global>
  .site-overview-widget.card-base {
    padding-bottom: 0.45rem !important;
  }

  .site-overview {
    --so-ink: oklch(22% 0.02 var(--hue));
    --so-muted: oklch(48% 0.02 var(--hue));
    --so-rule: oklch(88% 0.012 var(--hue));
    --so-accent: oklch(48% 0.18 var(--hue));
    --so-soft: oklch(96% 0.01 var(--hue));
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  :root.dark .site-overview {
    --so-ink: oklch(95% 0.01 var(--hue));
    --so-muted: oklch(72% 0.02 var(--hue));
    --so-rule: oklch(30% 0.02 var(--hue));
    --so-accent: oklch(78% 0.12 55);
    --so-soft: oklch(22% 0.02 var(--hue));
  }

  .site-overview__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.35rem;
  }

  .site-overview__cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.12rem;
    min-width: 0;
    padding: 0.45rem 0.2rem;
    border-radius: 0.45rem;
    background: var(--so-soft);
  }

  .site-overview__num {
    font-family: "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--so-ink);
    font-variant-numeric: tabular-nums;
  }

  .site-overview__label {
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--so-muted);
    white-space: nowrap;
  }

  /* 底栏：文案在左，迷你分层钟在右（黄框位） */
  .site-overview__rail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem;
    padding-top: 0.4rem;
    padding-bottom: 0.1rem;
    border-top: 1px solid var(--so-rule);
  }

  .site-overview__rail-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.35rem;
    min-width: 0;
    flex: 1 1 auto;
    font-family: "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace;
    font-size: 0.64rem;
    letter-spacing: 0.03em;
    color: var(--so-muted);
    line-height: 1.35;
  }

  .site-overview__clock {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 3.6rem;
    min-height: 3.4rem;
    padding: 0.15rem 0.05rem 0.2rem;
    perspective: 360px;
    isolation: isolate;
  }

  .site-overview__run b {
    color: var(--so-ink);
    font-weight: 700;
    margin: 0 0.15rem;
    font-variant-numeric: tabular-nums;
  }

  .site-overview__dot {
    opacity: 0.55;
  }

  .site-overview__link {
    color: var(--so-accent);
    text-decoration: none;
    font-weight: 500;
  }

  .site-overview__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .site-overview__meta {
    color: var(--so-muted);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

<script is:inline>
  (function () {
    function calcRunningDays(startStr) {
      if (!startStr) return 0;
      var parts = String(startStr).split("-").map(Number);
      if (parts.length < 3 || parts.some(function (n) { return !n && n !== 0; })) {
        return 0;
      }
      var start = Date.UTC(parts[0], parts[1] - 1, parts[2]);
      var now = new Date();
      var today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
      var days = Math.floor((today - start) / 86400000);
      return days < 0 ? 0 : days;
    }

    function updateRunningDays() {
      document.querySelectorAll(".site-overview[data-site-start]").forEach(function (root) {
        var start = root.getAttribute("data-site-start") || "";
        var days = calcRunningDays(start);
        root.querySelectorAll('[data-stat-id="running-days"]').forEach(function (el) {
          el.textContent = String(days);
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", updateRunningDays);
    } else {
      updateRunningDays();
    }
    document.addEventListener("swup:contentReplaced", function () {
      setTimeout(updateRunningDays, 50);
    });
  })();
</script>
