---
/**
 * 标签墙：立体标签球（TagChalkSphere）+ 标题右侧球/列表切换。
 * 浏览态按 collapseThreshold 进球，多余走「… +N」→ /tags/；
 * 文章页聚焦：一级 tags + 二级 themeTags。
 */
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import TagChalkSphere from "@/components/widget/TagChalkSphere.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import { getTagList } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

const allTags = await getTagList();

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
	/** 传入则进入「本文标签」聚焦（即使为空数组） */
	focusTags?: string[];
	/** 二级主题标签（Agent）；仅聚焦态展示 */
	focusThemeTags?: string[];
	/**
	 * 仅列表（无立体球）：给移动底栏用，避免与左栏再 SSR 一份 TagChalkSphere 巨型脚本。
	 */
	listOnly?: boolean;
}
const {
	class: className,
	style,
	widgetConfig,
	focusTags,
	focusThemeTags,
	listOnly = false,
} = Astro.props;

const maxVisible = Math.max(
	1,
	Number(widgetConfig?.specificConfig?.collapseThreshold ?? 12),
);
const showTitle = widgetConfig?.showTitle !== false;

/** 一级或二级任一数组传入即聚焦（文章页） */
const isFocusMode =
	Array.isArray(focusTags) || Array.isArray(focusThemeTags);

const normalize = (list?: string[]) =>
	[...new Set((list ?? []).map((t) => t.trim()).filter(Boolean))];

const primaryNames = normalize(focusTags);
const themeNames = normalize(focusThemeTags).filter(
	(n) => !primaryNames.includes(n),
);

const rankedTags = [...allTags]
	.map((t) => ({ name: t.name.trim(), count: t.count }))
	.filter((t) => t.name)
	.sort((a, b) => {
		if (b.count !== a.count) return b.count - a.count;
		return a.name.localeCompare(b.name, "zh-CN");
	});

const countByName = new Map(rankedTags.map((t) => [t.name, t.count]));

type SphereItem = {
	name: string;
	count: number;
	kind: "primary" | "theme";
};

const focusList: SphereItem[] = isFocusMode
	? [
			...primaryNames.map((name) => ({
				name,
				count: countByName.get(name) ?? 1,
				kind: "primary" as const,
			})),
			...themeNames.map((name) => ({
				name,
				count: 0,
				kind: "theme" as const,
			})),
		]
	: [];

const sphereTags: SphereItem[] = isFocusMode
	? focusList
	: rankedTags.slice(0, maxVisible).map((t) => ({
			name: t.name,
			count: t.count,
			kind: "primary" as const,
		}));

const hiddenCount = Math.max(0, rankedTags.length - maxVisible);
const showMore = !isFocusMode && hiddenCount > 0;
const emptyFocus = isFocusMode && focusList.length === 0;

const emptyLabel = i18n(I18nKey.noTags);
const titleAll = i18n(I18nKey.tagWall);
const tagsIndexUrl = url("/tags/");

/** 全量列表给客户端浏览态重挂用 */
const catalogJson = JSON.stringify(
	rankedTags.map((t) => ({ name: t.name, count: t.count })),
);
---
<WidgetLayout
  name={titleAll}
  showTitle={showTitle}
  id="tags"
  isCollapsed={false}
  moreUrl={tagsIndexUrl}
  class:list={["tags-widget", { "tags-widget--focus": isFocusMode }, className]}
  style={style}
>
  {!listOnly && (
    <div slot="title-icon" class="tags-widget__mode" data-tag-wall-mode-toggle>
      <button
        type="button"
        class="tags-widget__mode-btn"
        data-tag-wall-mode="sphere"
        aria-label="立体球模式"
        title="立体球"
        aria-pressed="true"
      >
        <Icon is:inline name="lucide:globe" class="tags-widget__mode-icon tags-widget__mode-icon--globe" />
      </button>
      <button
        type="button"
        class="tags-widget__mode-btn"
        data-tag-wall-mode="list"
        aria-label="列表模式"
        title="列表"
        aria-pressed="false"
      >
        <Icon is:inline name="lucide:list" class="tags-widget__mode-icon" />
      </button>
    </div>
  )}
  <div
    class="tags-widget__body"
    data-tag-wall
    data-tag-wall-focus={isFocusMode ? "1" : "0"}
    data-tags-catalog={listOnly ? undefined : catalogJson}
    data-max-visible={String(maxVisible)}
    data-tag-wall-list-only={listOnly ? "1" : undefined}
  >
    <p
      class:list={["tags-widget__empty", { "is-visible": emptyFocus }]}
      data-tag-wall-empty
      hidden={!emptyFocus}
    >
      {emptyLabel}
    </p>
    {
      !emptyFocus && listOnly && (
        <ul class="tags-widget__plain-list" data-tag-wall-plain-list>
          {sphereTags.map((t) => (
            <li>
              <a
                href={url(`/timeline/?tag=${encodeURIComponent(t.name)}`)}
                class:list={[
                  "tags-widget__plain-link",
                  t.kind === "theme" && "tags-widget__plain-link--theme",
                ]}
              >
                <span>{t.name}</span>
                {t.kind !== "theme" && t.count > 0 && (
                  <span class="tags-widget__plain-count">{t.count}</span>
                )}
              </a>
            </li>
          ))}
          {showMore && (
            <li>
              <a class="tags-widget__plain-more" href={tagsIndexUrl}>
                … +{hiddenCount}
              </a>
            </li>
          )}
        </ul>
      )
    }
    {
      !emptyFocus && !listOnly && (
        <TagChalkSphere
          class="tags-widget__sphere"
          compact
          title=""
          tags={sphereTags}
          limit={Math.max(sphereTags.length, 1)}
          radius={70}
          moreHref={showMore ? tagsIndexUrl : undefined}
          moreCount={showMore ? hiddenCount : 0}
        />
      )
    }
  </div>
</WidgetLayout>

<style is:global>
  .tags-widget__empty {
    display: none;
    margin: 0;
    padding: 0.75rem 0.5rem;
    font-size: 0.78rem;
    color: oklch(0.45 0.02 70);
    text-align: center;
  }

  .tags-widget__empty.is-visible {
    display: block;
  }

  .tags-widget__plain-list {
    list-style: none;
    margin: 0;
    padding: 0.15rem 0.1rem 0.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .tags-widget__plain-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.28rem 0.45rem;
    border-radius: 0.45rem;
    font-size: 0.82rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .tags-widget__plain-link:hover {
    background: color-mix(in oklch, var(--primary) 12%, transparent);
  }

  .tags-widget__plain-link--theme {
    opacity: 0.72;
    pointer-events: none;
  }

  .tags-widget__plain-count {
    font-size: 0.72rem;
    opacity: 0.55;
  }

  .tags-widget__plain-more {
    display: block;
    padding: 0.28rem 0.45rem;
    font-size: 0.78rem;
    opacity: 0.7;
    text-decoration: none;
  }

  html.dark .tags-widget__empty {
    color: oklch(0.7 0.02 70);
  }

  widget-layout.tags-widget.tags-widget--focus .tag-sphere__more,
  .tags-widget.tags-widget--focus .tag-sphere__more {
    display: none !important;
  }

  .tags-widget__mode {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    /* 离开卡片右缘，避免贴边 */
    margin-right: 1.35rem;
    padding: 0.12rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklch, var(--line-divider, #000) 55%, transparent);
    background: color-mix(in oklch, var(--card-bg, #fff) 88%, transparent);
  }

  .tags-widget__mode-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.55rem;
    height: 1.55rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: color-mix(in oklch, var(--content-meta, #666) 90%, transparent);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .tags-widget__mode-btn:hover {
    color: var(--primary);
  }

  .tags-widget__mode-btn[aria-pressed="true"] {
    background: color-mix(in oklch, var(--primary) 14%, transparent);
    color: var(--primary);
  }

  .tags-widget__mode-icon {
    width: 0.95rem;
    height: 0.95rem;
  }

  /* 地球图标略放大，更接近 3D 球体观感 */
  .tags-widget__mode-icon--globe {
    width: 1.05rem;
    height: 1.05rem;
  }

  .tags-widget__mode-btn[data-tag-wall-mode="sphere"][aria-pressed="true"] {
    background: color-mix(in oklch, var(--primary) 18%, transparent);
  }
</style>

<script is:inline data-swup-ignore-script>
  (function () {
    var MODE_KEY = "firefly-tag-wall-mode";

    function isPostPath(pathname) {
      return /\/posts\//.test(pathname || "");
    }

    function parseTagList(raw) {
      if (raw == null || raw === "") return [];
      try {
        var parsed = JSON.parse(raw);
        return Array.isArray(parsed)
          ? parsed.map(function (t) { return String(t).trim(); }).filter(Boolean)
          : [];
      } catch (e) {
        return [];
      }
    }

    /** @returns {{ primary: string[], theme: string[] } | null} */
    function readFocusPayload() {
      if (!isPostPath(location.pathname)) return null;
      var host = document.getElementById("swup-container");
      var primary = parseTagList(
        host && host.getAttribute("data-current-post-tags"),
      );
      var theme = parseTagList(
        host && host.getAttribute("data-current-post-theme-tags"),
      );
      return { primary: primary, theme: theme };
    }

    function uniq(list) {
      var seen = new Set();
      var out = [];
      (list || []).forEach(function (n) {
        if (!n || seen.has(n)) return;
        seen.add(n);
        out.push(n);
      });
      return out;
    }

    function readStoredMode() {
      try {
        var m = localStorage.getItem(MODE_KEY);
        return m === "list" ? "list" : "sphere";
      } catch (e) {
        return "sphere";
      }
    }

    function writeStoredMode(mode) {
      try {
        localStorage.setItem(MODE_KEY, mode);
      } catch (e) {}
    }

    function syncModeButtons(widget, mode) {
      var btns = widget.querySelectorAll("[data-tag-wall-mode]");
      btns.forEach(function (btn) {
        var on = btn.getAttribute("data-tag-wall-mode") === mode;
        btn.setAttribute("aria-pressed", on ? "true" : "false");
      });
    }

    function currentItemsForWall(body) {
      var payload = readFocusPayload();
      var focusMode = payload !== null;
      var catalog = [];
      try {
        catalog = JSON.parse(body.getAttribute("data-tags-catalog") || "[]");
      } catch (e) {
        catalog = [];
      }
      var maxVisible = Number(body.getAttribute("data-max-visible") || 12);
      if (focusMode) {
        var primaryNames = uniq(payload.primary);
        var primarySet = new Set(primaryNames);
        var themeNames = uniq(payload.theme).filter(function (n) {
          return !primarySet.has(n);
        });
        return primaryNames
          .map(function (n) {
            return { name: n, kind: "primary" };
          })
          .concat(
            themeNames.map(function (n) {
              return { name: n, kind: "theme" };
            }),
          );
      }
      return catalog.slice(0, maxVisible).map(function (t) {
        return { name: t.name, kind: "primary" };
      });
    }

    function applyWallMode(widget, mode) {
      var body = widget.querySelector("[data-tag-wall]");
      var sphere = body && body.querySelector("[data-tag-chalk-sphere]");
      if (!sphere) return;
      var next = mode === "list" ? "list" : "sphere";
      sphere.setAttribute("data-view-mode", next);
      syncModeButtons(widget, next);
      writeStoredMode(next);

      if (typeof window.__setTagChalkSphereMode === "function") {
        window.__setTagChalkSphereMode(sphere, next);
      }

      // 切回球模式时重挂，避免列表态未创建实例
      if (next === "sphere" && body) {
        var cloud = sphere.querySelector(".tag-sphere__cloud");
        var cloudId = cloud && cloud.id;
        if (cloudId && typeof window.__remountTagChalkSphere === "function") {
          window.__remountTagChalkSphere(cloudId, currentItemsForWall(body));
        }
      }
    }

    function bindModeToggles() {
      document.querySelectorAll("widget-layout.tags-widget").forEach(function (widget) {
        if (widget._tagWallModeBound) return;
        widget._tagWallModeBound = true;
        var toggle = widget.querySelector("[data-tag-wall-mode-toggle]");
        if (!toggle) return;
        var initial = readStoredMode();
        applyWallMode(widget, initial);
        toggle.addEventListener("click", function (ev) {
          var btn = ev.target && ev.target.closest
            ? ev.target.closest("[data-tag-wall-mode]")
            : null;
          if (!btn || !toggle.contains(btn)) return;
          applyWallMode(widget, btn.getAttribute("data-tag-wall-mode") || "sphere");
        });
      });
    }

    function applyTagWallFocus() {
      var widgets = document.querySelectorAll("widget-layout.tags-widget");
      if (!widgets.length) return;

      var payload = readFocusPayload();
      var focusMode = payload !== null;
      var primaryNames = focusMode ? uniq(payload.primary) : [];
      var primarySet = new Set(primaryNames);
      var themeNames = focusMode
        ? uniq(payload.theme).filter(function (n) {
            return !primarySet.has(n);
          })
        : [];

      widgets.forEach(function (widget) {
        var body = widget.querySelector("[data-tag-wall]");
        if (!body) return;

        widget.classList.toggle("tags-widget--focus", focusMode);
        body.setAttribute("data-tag-wall-focus", focusMode ? "1" : "0");

        var catalog = [];
        try {
          catalog = JSON.parse(body.getAttribute("data-tags-catalog") || "[]");
        } catch (e) {
          catalog = [];
        }
        var maxVisible = Number(body.getAttribute("data-max-visible") || 12);

        /** @type {{ name: string, kind: string }[]} */
        var items;
        if (focusMode) {
          items = primaryNames
            .map(function (n) {
              return { name: n, kind: "primary" };
            })
            .concat(
              themeNames.map(function (n) {
                return { name: n, kind: "theme" };
              }),
            );
        } else {
          items = catalog.slice(0, maxVisible).map(function (t) {
            return { name: t.name, kind: "primary" };
          });
        }

        var empty = body.querySelector("[data-tag-wall-empty]");
        var sphere = body.querySelector("[data-tag-chalk-sphere]");
        var more = body.querySelector("[data-tag-chalk-more]");

        if (focusMode && items.length === 0) {
          if (empty) {
            empty.classList.add("is-visible");
            empty.hidden = false;
          }
          if (sphere) sphere.style.display = "none";
          return;
        }

        if (empty) {
          empty.classList.remove("is-visible");
          empty.hidden = true;
        }
        if (sphere) sphere.style.display = "";

        var mode = readStoredMode();
        if (sphere) sphere.setAttribute("data-view-mode", mode);

        var cloud = sphere && sphere.querySelector(".tag-chalk-sphere__cloud, .tag-sphere__cloud");
        var cloudId = cloud && cloud.id;
        if (cloudId && typeof window.__remountTagChalkSphere === "function") {
          window.__remountTagChalkSphere(cloudId, items);
        }

        if (sphere && typeof window.__setTagChalkSphereMode === "function") {
          window.__setTagChalkSphereMode(sphere, mode);
        }
        syncModeButtons(widget, mode);

        if (more) {
          more.style.display = focusMode ? "none" : "";
        }
      });
    }

    function boot() {
      bindModeToggles();
      applyTagWallFocus();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot);
    } else {
      boot();
    }

    document.addEventListener("swup:contentReplaced", boot);
    document.addEventListener("swup:page:view", boot);

    function bindSwup() {
      if (!window.swup || !window.swup.hooks) return;
      window.swup.hooks.on("content:replace", function () {
        setTimeout(boot, 0);
      });
      window.swup.hooks.on("page:view", boot);
    }
    if (window.swup && window.swup.hooks) bindSwup();
    else document.addEventListener("swup:enable", bindSwup);
  })();
</script>
