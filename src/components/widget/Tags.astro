---
/**
 * 标签墙：立体标签球（TagChalkSphere）。
 * 浏览态按 collapseThreshold 进球，多余走「… +N」→ /tags/；
 * 文章页聚焦：一级 tags（进统计、可点）+ 二级 themeTags（Agent 主题、另色、不计统计）。
 */
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import TagChalkSphere from "@/components/widget/TagChalkSphere.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import { getTagList } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

const allTags = await getTagList();

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
	/** 传入则进入「本文标签」聚焦（即使为空数组） */
	focusTags?: string[];
	/** 二级主题标签（Agent）；仅聚焦态展示 */
	focusThemeTags?: string[];
}
const { class: className, style, widgetConfig, focusTags, focusThemeTags } =
	Astro.props;

const maxVisible = Math.max(
	1,
	Number(widgetConfig?.specificConfig?.collapseThreshold ?? 12),
);
const showTitle = widgetConfig?.showTitle !== false;

/** 一级或二级任一数组传入即聚焦（文章页） */
const isFocusMode =
	Array.isArray(focusTags) || Array.isArray(focusThemeTags);

const normalize = (list?: string[]) =>
	[...new Set((list ?? []).map((t) => t.trim()).filter(Boolean))];

const primaryNames = normalize(focusTags);
const themeNames = normalize(focusThemeTags).filter(
	(n) => !primaryNames.includes(n),
);

const rankedTags = [...allTags]
	.map((t) => ({ name: t.name.trim(), count: t.count }))
	.filter((t) => t.name)
	.sort((a, b) => {
		if (b.count !== a.count) return b.count - a.count;
		return a.name.localeCompare(b.name, "zh-CN");
	});

const countByName = new Map(rankedTags.map((t) => [t.name, t.count]));

type SphereItem = {
	name: string;
	count: number;
	kind: "primary" | "theme";
};

const focusList: SphereItem[] = isFocusMode
	? [
			...primaryNames.map((name) => ({
				name,
				count: countByName.get(name) ?? 1,
				kind: "primary" as const,
			})),
			...themeNames.map((name) => ({
				name,
				count: 0,
				kind: "theme" as const,
			})),
		]
	: [];

const sphereTags: SphereItem[] = isFocusMode
	? focusList
	: rankedTags.slice(0, maxVisible).map((t) => ({
			name: t.name,
			count: t.count,
			kind: "primary" as const,
		}));

const hiddenCount = Math.max(0, rankedTags.length - maxVisible);
const showMore = !isFocusMode && hiddenCount > 0;
const emptyFocus = isFocusMode && focusList.length === 0;

const emptyLabel = i18n(I18nKey.noTags);
const titleAll = i18n(I18nKey.tagWall);
const tagsIndexUrl = url("/tags/");

/** 全量列表给客户端浏览态重挂用 */
const catalogJson = JSON.stringify(
	rankedTags.map((t) => ({ name: t.name, count: t.count })),
);
---
<WidgetLayout
  name={titleAll}
  showTitle={showTitle}
  id="tags"
  isCollapsed={false}
  moreUrl={tagsIndexUrl}
  class:list={["tags-widget", { "tags-widget--focus": isFocusMode }, className]}
  style={style}
>
  <div
    class="tags-widget__body"
    data-tag-wall
    data-tag-wall-focus={isFocusMode ? "1" : "0"}
    data-tags-catalog={catalogJson}
    data-max-visible={String(maxVisible)}
  >
    <p
      class:list={["tags-widget__empty", { "is-visible": emptyFocus }]}
      data-tag-wall-empty
      hidden={!emptyFocus}
    >
      {emptyLabel}
    </p>
    {
      !emptyFocus && (
        <TagChalkSphere
          class="tags-widget__sphere"
          compact
          title=""
          tags={sphereTags}
          limit={Math.max(sphereTags.length, 1)}
          radius={70}
          moreHref={showMore ? tagsIndexUrl : undefined}
          moreCount={showMore ? hiddenCount : 0}
        />
      )
    }
  </div>
</WidgetLayout>

<style is:global>
  .tags-widget__empty {
    display: none;
    margin: 0;
    padding: 0.75rem 0.5rem;
    font-size: 0.78rem;
    color: oklch(0.45 0.02 70);
    text-align: center;
  }

  .tags-widget__empty.is-visible {
    display: block;
  }

  html.dark .tags-widget__empty {
    color: oklch(0.7 0.02 70);
  }

  widget-layout.tags-widget.tags-widget--focus .tag-sphere__more,
  .tags-widget.tags-widget--focus .tag-sphere__more {
    display: none !important;
  }
</style>

<script is:inline data-swup-ignore-script>
  (function () {
    function isPostPath(pathname) {
      return /\/posts\//.test(pathname || "");
    }

    function parseTagList(raw) {
      if (raw == null || raw === "") return [];
      try {
        var parsed = JSON.parse(raw);
        return Array.isArray(parsed)
          ? parsed.map(function (t) { return String(t).trim(); }).filter(Boolean)
          : [];
      } catch (e) {
        return [];
      }
    }

    /** @returns {{ primary: string[], theme: string[] } | null} */
    function readFocusPayload() {
      if (!isPostPath(location.pathname)) return null;
      var host = document.getElementById("swup-container");
      var primary = parseTagList(
        host && host.getAttribute("data-current-post-tags"),
      );
      var theme = parseTagList(
        host && host.getAttribute("data-current-post-theme-tags"),
      );
      return { primary: primary, theme: theme };
    }

    function uniq(list) {
      var seen = new Set();
      var out = [];
      (list || []).forEach(function (n) {
        if (!n || seen.has(n)) return;
        seen.add(n);
        out.push(n);
      });
      return out;
    }

    function applyTagWallFocus() {
      var widgets = document.querySelectorAll("widget-layout.tags-widget");
      if (!widgets.length) return;

      var payload = readFocusPayload();
      var focusMode = payload !== null;
      var primaryNames = focusMode ? uniq(payload.primary) : [];
      var primarySet = new Set(primaryNames);
      var themeNames = focusMode
        ? uniq(payload.theme).filter(function (n) {
            return !primarySet.has(n);
          })
        : [];

      widgets.forEach(function (widget) {
        var body = widget.querySelector("[data-tag-wall]");
        if (!body) return;

        widget.classList.toggle("tags-widget--focus", focusMode);
        body.setAttribute("data-tag-wall-focus", focusMode ? "1" : "0");

        var catalog = [];
        try {
          catalog = JSON.parse(body.getAttribute("data-tags-catalog") || "[]");
        } catch (e) {
          catalog = [];
        }
        var maxVisible = Number(body.getAttribute("data-max-visible") || 12);

        /** @type {{ name: string, kind: string }[]} */
        var items;
        if (focusMode) {
          items = primaryNames
            .map(function (n) {
              return { name: n, kind: "primary" };
            })
            .concat(
              themeNames.map(function (n) {
                return { name: n, kind: "theme" };
              }),
            );
        } else {
          items = catalog.slice(0, maxVisible).map(function (t) {
            return { name: t.name, kind: "primary" };
          });
        }

        var empty = body.querySelector("[data-tag-wall-empty]");
        var sphere = body.querySelector("[data-tag-chalk-sphere]");
        var more = body.querySelector("[data-tag-chalk-more]");

        if (focusMode && items.length === 0) {
          if (empty) {
            empty.classList.add("is-visible");
            empty.hidden = false;
          }
          if (sphere) sphere.style.display = "none";
          return;
        }

        if (empty) {
          empty.classList.remove("is-visible");
          empty.hidden = true;
        }
        if (sphere) sphere.style.display = "";

        var cloud = sphere && sphere.querySelector(".tag-chalk-sphere__cloud, .tag-sphere__cloud");
        var cloudId = cloud && cloud.id;
        if (cloudId && typeof window.__remountTagChalkSphere === "function") {
          window.__remountTagChalkSphere(cloudId, items);
        }

        if (more) {
          more.style.display = focusMode ? "none" : "";
        }
      });
    }

    function boot() {
      applyTagWallFocus();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot);
    } else {
      boot();
    }

    document.addEventListener("swup:contentReplaced", applyTagWallFocus);
    document.addEventListener("swup:page:view", applyTagWallFocus);

    function bindSwup() {
      if (!window.swup || !window.swup.hooks) return;
      window.swup.hooks.on("content:replace", function () {
        setTimeout(applyTagWallFocus, 0);
      });
      window.swup.hooks.on("page:view", applyTagWallFocus);
    }
    if (window.swup && window.swup.hooks) bindSwup();
    else document.addEventListener("swup:enable", bindSwup);
  })();
</script>
