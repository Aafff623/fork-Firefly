---
/**
 * 标签墙：砖石错落嵌砖（对照文章 brick dense）+ 青灰/红褐棋盘色。
 * 浏览态只展示固定数量（按篇数优先），末砖「…」链到 /tags/；
 * 文章页聚焦当前文标签（侧栏常为静态，靠 data-current-post-tags + 脚本同步）。
 */
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import { getTagList } from "@/utils/content-utils";
import { getTagUrl, url } from "@/utils/url-utils";

const allTags = await getTagList();

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
	/** 传入则进入「本文标签」聚焦（即使为空数组） */
	focusTags?: string[];
}
const { class: className, style, widgetConfig, focusTags } = Astro.props;

/** 浏览态最多露几块砖（不含「…」）；沿用 collapseThreshold 配置 */
const maxVisible = Math.max(
	1,
	Number(widgetConfig?.specificConfig?.collapseThreshold ?? 10),
);
const showTitle = widgetConfig?.showTitle !== false;

const isFocusMode = Array.isArray(focusTags);
const focusSet = new Set(
	(focusTags ?? []).map((t) => t.trim()).filter(Boolean),
);

/** 篇数多的优先，同数按名 */
const rankedTags = [...allTags].sort((a, b) => {
	if (b.count !== a.count) return b.count - a.count;
	return a.name.localeCompare(b.name, "zh-CN");
});

const browseTags = rankedTags.slice(0, maxVisible);
const hiddenCount = Math.max(0, rankedTags.length - browseTags.length);
const showMoreBrick = !isFocusMode && hiddenCount > 0;

const visibleCount = isFocusMode
	? rankedTags.filter((t) => focusSet.has(t.name.trim())).length
	: browseTags.length;

const emptyLabel = i18n(I18nKey.noTags);
const titleAll = i18n(I18nKey.tagWall);
const moreLabel = i18n(I18nKey.more);
const tagsIndexUrl = url("/tags/");
---
<WidgetLayout
  name={titleAll}
  showTitle={showTitle}
  id="tags"
  isCollapsed={false}
  moreUrl={tagsIndexUrl}
  class:list={["tags-widget", { "tags-widget--focus": isFocusMode }, className]}
  style={style}
>
  <div
    class="tag-wall"
    role="list"
    aria-label={titleAll}
    data-max-visible={maxVisible}
    data-tag-wall-focus={isFocusMode ? "1" : "0"}
  >
    <p
      class:list={["tag-wall__empty", { "is-visible": isFocusMode && visibleCount === 0 }]}
      data-tag-wall-empty
      hidden={!(isFocusMode && visibleCount === 0)}
    >
      {emptyLabel}
    </p>
    {
      rankedTags.map((t, index) => {
        const name = t.name.trim();
        const beyondCap = !isFocusMode && index >= maxVisible;
        const filteredOut = isFocusMode && !focusSet.has(name);
        const hide = beyondCap || filteredOut;
        return (
          <a
            role="listitem"
            href={getTagUrl(name)}
            class:list={[
              "tag-wall__brick",
              { "is-filtered-out": hide },
            ]}
            data-tag={name}
            data-rank={index}
            aria-label={`${name}，${t.count} 篇`}
            title={`${name} · ${t.count}`}
            aria-hidden={hide ? "true" : undefined}
          >
            <span class="tag-wall__name">#{name}</span>
            <span class="tag-wall__count">{t.count}</span>
          </a>
        );
      })
    }
    {
      showMoreBrick && (
        <a
          role="listitem"
          href={tagsIndexUrl}
          class="tag-wall__brick tag-wall__brick--more"
          data-tag-more
          aria-label={`${moreLabel}，还有 ${hiddenCount} 个标签`}
          title={`${moreLabel} · +${hiddenCount}`}
        >
          <span class="tag-wall__name">…</span>
          <span class="tag-wall__count">+{hiddenCount}</span>
        </a>
      )
    }
  </div>
</WidgetLayout>

{/* 结构/聚焦兜底；砖面材质与配色以 tags.css 为准，勿在此覆盖 background */}
<style is:global>
  .tag-wall__empty {
    display: none;
    grid-column: 1 / -1;
    margin: 0;
    padding: 0.65rem 0.5rem;
    font-size: 0.78rem;
    color: oklch(0.45 0.02 70);
    text-align: center;
  }

  .tag-wall__empty.is-visible {
    display: block;
  }

  html.dark .tag-wall__empty {
    color: oklch(0.7 0.02 70);
  }

  .tag-wall__brick--more .tag-wall__name {
    font-size: 1.15rem;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  widget-layout.tags-widget.tags-widget--focus .tag-wall__brick--more,
  .tags-widget.tags-widget--focus .tag-wall__brick--more {
    display: none !important;
  }
</style>

<script is:inline data-swup-ignore-script>
  (function () {
    function isPostPath(pathname) {
      return /\/posts\//.test(pathname || "");
    }

    function readFocusTags() {
      if (!isPostPath(location.pathname)) return null;
      const host = document.getElementById("swup-container");
      const raw = host?.getAttribute("data-current-post-tags");
      if (raw == null || raw === "") return [];
      try {
        const parsed = JSON.parse(raw);
        return Array.isArray(parsed)
          ? parsed.map(function (t) { return String(t).trim(); }).filter(Boolean)
          : [];
      } catch {
        return [];
      }
    }

    function applyTagWallFocus() {
      const widgets = document.querySelectorAll("widget-layout.tags-widget");
      if (!widgets.length) return;

      const focusTags = readFocusTags();
      const focusMode = focusTags !== null;
      const focusSet = focusMode ? new Set(focusTags) : null;

      widgets.forEach(function (widget) {
        const wall = widget.querySelector(".tag-wall");
        if (!wall) return;

        widget.classList.toggle("tags-widget--focus", focusMode);
        wall.setAttribute("data-tag-wall-focus", focusMode ? "1" : "0");

        const maxVisible = Number(wall.getAttribute("data-max-visible") || 10);
        let visible = 0;

        wall.querySelectorAll(".tag-wall__brick[data-tag]").forEach(function (brick) {
          const name = brick.getAttribute("data-tag") || "";
          const rank = Number(brick.getAttribute("data-rank") || 0);
          var hide = false;
          if (focusMode) {
            hide = !focusSet || !focusSet.has(name);
          } else {
            hide = rank >= maxVisible;
          }
          brick.classList.toggle("is-filtered-out", hide);
          brick.setAttribute("aria-hidden", hide ? "true" : "false");
          if (!hide) visible += 1;
        });

        const more = wall.querySelector("[data-tag-more]");
        if (more) {
          more.style.display = focusMode ? "none" : "";
          more.setAttribute("aria-hidden", focusMode ? "true" : "false");
        }

        const empty = wall.querySelector("[data-tag-wall-empty]");
        if (empty) {
          const showEmpty = focusMode && visible === 0;
          empty.classList.toggle("is-visible", showEmpty);
          empty.hidden = !showEmpty;
        }
      });
    }

    function boot() {
      applyTagWallFocus();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot);
    } else {
      boot();
    }

    document.addEventListener("swup:contentReplaced", applyTagWallFocus);
    document.addEventListener("swup:page:view", applyTagWallFocus);

    function bindSwup() {
      if (!window.swup || !window.swup.hooks) return;
      window.swup.hooks.on("content:replace", function () {
        setTimeout(applyTagWallFocus, 0);
      });
      window.swup.hooks.on("page:view", applyTagWallFocus);
    }
    if (window.swup && window.swup.hooks) bindSwup();
    else document.addEventListener("swup:enable", bindSwup);
  })();
</script>
