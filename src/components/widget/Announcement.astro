---
/**
 * 侧栏公告：主题卡壳 + 编辑/报纸家具（folio · 双线 · 衬线标题 · drop cap）
 * 样式见 src/styles/announcement-press.css
 *
 * 调研取舍（Newsprint / Broadsheet / Guardian / Hallmark editorial）：
 * - 保留 card-base 圆角与主题色，不另起奶油纸直角卡
 * - 报纸感靠排版家具，不靠换底色
 */
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { announcementConfig } from "@/config/announcementConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";

const config = announcementConfig;

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}
const { class: className, style } = Astro.props;

const issueDate = new Date().toISOString().slice(0, 10);
const title = config.title || i18n(I18nKey.announcement);
const loveLetter = config.loveLetter;
const showLoveLetter = Boolean(loveLetter) && loveLetter?.enable !== false;
const loveNote = loveLetter?.note || "Open it! 💗💗💗";
const loveHeading = loveLetter?.heading || "💌520💌";
const loveMessage =
	loveLetter?.message ||
	"Your eyes are really beautiful — and mine are better, because I have you in them.";
---

{/* showTitle=false：自绘 masthead，避免与紫条标题重复，仍套 card-base */}
<WidgetLayout
  id="announcement"
  showTitle={false}
  class:list={["announcement-widget", className]}
  style={style}
>
  <article class="announcement-press" data-widget-type="announcement">
    <header class="announcement-press__mast">
      <div class="announcement-press__folio">
        <span class="announcement-press__vol">Vol. II</span>
        <span class="announcement-press__folio-sep" aria-hidden="true">·</span>
        <time datetime={issueDate}>{issueDate}</time>
        <span class="announcement-press__folio-grow"></span>
        {
          config.closable && (
            <button
              type="button"
              class="announcement-press__close"
              onclick="this.closest('widget-layout')?.remove()"
              aria-label={i18n(I18nKey.announcementClose)}
            >
              <Icon is:inline name="lucide:x" class="text-[0.7rem]" />
            </button>
          )
        }
      </div>

      <h2 class="announcement-press__nameplate">
        {config.icon && (
          <Icon is:inline name={config.icon} class="announcement-press__title-icon" aria-hidden="true" />
        )}
        {title}
      </h2>
      <div class="announcement-press__double-rule" aria-hidden="true"></div>
      <p class="announcement-press__kicker">Notice · 在研 · Agent 工作流</p>
    </header>

    {
      showLoveLetter && (
        <section class="love-letter" aria-label="520情书">
          <input id="love-letter-open" type="checkbox" class="love-letter__check" />
          <label class="love-letter__hit" for="love-letter-open" aria-label="打开或合上情书"></label>
          <div class="love-letter__front">
            <div class="love-letter__stage">
              <img
                class="love-letter__heart"
                src="/assets/images/announcement/love.png"
                alt=""
                width="90"
                height="90"
                draggable="false"
              />
              <div class="love-letter__note">{loveNote}</div>
            </div>
          </div>
          <div class="love-letter__inside">
            <div class="love-letter__text">
              <h3 class="love-letter__heading">{loveHeading}</h3>
              <p class="love-letter__message">{loveMessage}</p>
            </div>
          </div>
        </section>
      )
    }

    <p class="announcement-press__lede">{config.content}</p>

    {
      config.link && config.link.enable !== false && (
        <footer class="announcement-press__colophon">
          <a
            href={config.link.url}
            target={config.link.external ? "_blank" : "_self"}
            rel={config.link.external ? "noopener noreferrer" : undefined}
            class="announcement-press__cta"
          >
            <span>{config.link.text}</span>
            <Icon
              is:inline
              name={config.link.external ? "lucide:square-arrow-out-up-right" : "lucide:arrow-right"}
              class="text-[0.75rem]"
            />
          </a>
        </footer>
      )
    }
  </article>
</WidgetLayout>
