---
/**
 * 意想不到时钟：对照 bilibili-goat widgets/意想不到时钟
 * 侧栏等比压缩；亮数字正立放大，其余数字横躺淡显。
 */
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle === true;
---

<WidgetLayout
  name={i18n(I18nKey.surpriseClock)}
  showTitle={showTitle}
  id="surprise-clock"
  class:list={["surprise-clock-widget", className]}
  style={style}
  contentPadding={false}
>
  <div
    class="surprise-clock"
    id="surprise-clock-root"
    role="timer"
    aria-live="polite"
    aria-label={i18n(I18nKey.surpriseClock)}
  ></div>
</WidgetLayout>

<script is:inline data-swup-ignore-script>
  (function () {
    const ROOT_ID = "surprise-clock-root";
    let raf = 0;
    /** @type {HTMLElement[]} */
    let digitGroups = [];
    let builtFor = null;

    function build(root) {
      if (builtFor === root && digitGroups.length) return;
      root.innerHTML = "";
      digitGroups = [];
      builtFor = root;

      const time10 = Array.from({ length: 10 }, (_, i) => i);
      const time6 = time10.slice(0, 6);
      const time3 = time10.slice(0, 3);
      const structure = [
        [time3, time10],
        [time6, time10],
        [time6, time10],
      ];

      structure.forEach((digits) => {
        const group = document.createElement("div");
        group.className = "surprise-clock__group";
        root.appendChild(group);
        digitGroups.push(group);
        digits.forEach((digitList) => {
          const digit = document.createElement("div");
          digit.className = "surprise-clock__digit";
          digitList.forEach((n) => {
            const el = document.createElement("div");
            el.className = "surprise-clock__num";
            el.textContent = String(n);
            digit.appendChild(el);
          });
          group.appendChild(digit);
        });
      });
    }

    function tick() {
      raf = requestAnimationFrame(tick);
      const root = document.getElementById(ROOT_ID);
      if (!root) return;
      build(root);

      const date = new Date();
      const time = [date.getHours(), date.getMinutes(), date.getSeconds()]
        .map((n) => `0${n}`.slice(-2).split("").map((e) => +e))
        .reduce((p, n) => p.concat(n), []);

      const label = time
        .map((n, i) => (i && i % 2 === 0 ? `:${n}` : String(n)))
        .join("");
      if (root.getAttribute("aria-label") !== label) {
        root.setAttribute("aria-label", label);
      }

      time.forEach((n, i) => {
        const group = digitGroups[Math.floor(i * 0.5)];
        if (!group) return;
        const digit = group.children[i % 2];
        if (!digit) return;
        Array.from(digit.children).forEach((el, i2) => {
          el.classList.toggle("is-bright", i2 === n);
        });
      });
    }

    function start() {
      if (raf) cancelAnimationFrame(raf);
      digitGroups = [];
      builtFor = null;
      raf = requestAnimationFrame(tick);
    }

    start();
    document.addEventListener("swup:contentReplaced", () => {
      setTimeout(start, 80);
    });
    document.addEventListener("astro:page-load", () => {
      setTimeout(start, 80);
    });
  })();
</script>

<style>
  :global(.surprise-clock-widget) {
    overflow: hidden;
  }

  :global(.surprise-clock-widget .collapse-wrapper) {
    padding: 0 !important;
  }

  .surprise-clock {
    --sc-h: 8.75rem;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    width: 100%;
    height: var(--sc-h);
    overflow: hidden;
    color: #fff;
    text-align: center;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    border-radius: var(--radius-large, 0.9rem);
    /* 蓝紫光带：可读白字优先 */
    background:
      radial-gradient(ellipse 80% 60% at 15% 10%, rgb(147 197 253 / 0.45), transparent 55%),
      radial-gradient(ellipse 70% 55% at 90% 85%, rgb(196 181 253 / 0.4), transparent 50%),
      linear-gradient(128deg, #2563eb 0%, #4f46e5 48%, #7c3aed 100%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.18);
  }

  :global(.surprise-clock__group) {
    display: inline-flex;
    align-items: center;
    height: var(--sc-h, 8.75rem);
  }

  :global(.surprise-clock__group:not(:last-child)::after) {
    content: ":";
    display: inline-flex;
    align-items: center;
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1;
    padding: 0 0.18rem;
    opacity: 0.9;
    text-shadow: 0 2px 12px rgb(15 23 42 / 0.35);
  }

  /* 每列只清晰显示当前亮数字；其余叠在同一格淡出 */
  :global(.surprise-clock__digit) {
    position: relative;
    display: inline-block;
    width: 1.7rem;
    height: 2.5rem;
    margin: 0 0.05rem;
  }

  :global(.surprise-clock__num) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgb(255 255 255 / 0.22);
    font-size: 1.05rem;
    line-height: 1;
    opacity: 0;
    transform: rotate(-70deg) scale(0.55);
    transition:
      opacity 160ms ease,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
      color 140ms ease,
      font-size 200ms ease;
    pointer-events: none;
  }

  :global(.surprise-clock__num.is-bright) {
    opacity: 1;
    color: #fff;
    font-size: 1.85rem;
    font-weight: 800;
    transform: rotate(0deg) scale(1);
    text-shadow:
      0 1px 0 rgb(255 255 255 / 0.25),
      0 4px 16px rgb(15 23 42 / 0.35);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.surprise-clock__num) {
      transition-duration: 0.01ms !important;
    }
  }
</style>
