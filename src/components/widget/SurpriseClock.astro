---
/**
 * 意想不到时钟：对照 bilibili-goat widgets/意想不到时钟
 * bare=true 时无 WidgetLayout（供 ClockCorner 角区嵌底）
 */
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { backgroundWallpaper, layeredClockConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
	/** 无卡片外壳，交给 ClockCorner 排布 */
	bare?: boolean;
}

const { class: className, style, widgetConfig, bare = false } = Astro.props;
const showTitle = widgetConfig?.showTitle === true;

// 天空层：昼夜跟随站点主题；天气场景需站长坐标（与分层时钟共用 layeredClockConfig）
const { skyMode, weather, skyAssets } = layeredClockConfig;
const weatherEnabled =
	weather.enable && weather.latitude !== 0 && weather.longitude !== 0;
// 天空整体偏淡；略亮于氛围垫底，仍不抢主数字
const atmoOpacity = backgroundWallpaper.atmosphere?.opacity ?? 0.52;
const skyBlend = Math.min(0.52, Math.max(0.28, atmoOpacity * 0.68));
const rootStyle = [style, `--sc-sky-blend: ${skyBlend}`]
	.filter(Boolean)
	.join("; ");
const skyAttrs: Record<string, string> = {
	"data-sky-mode": skyMode,
	"data-sky-assets": JSON.stringify(skyAssets),
	...(weatherEnabled
		? {
				"data-weather-lat": String(weather.latitude),
				"data-weather-lon": String(weather.longitude),
				"data-weather-refresh": String(weather.refreshMinutes),
			}
		: {}),
};
---

{
  bare ? (
    <div
      class:list={["surprise-clock", "surprise-clock--bare", className]}
      id="surprise-clock-root"
      role="timer"
      aria-live="polite"
      aria-label={i18n(I18nKey.surpriseClock)}
      style={rootStyle}
      {...skyAttrs}
    />
  ) : (
    <WidgetLayout
      name={i18n(I18nKey.surpriseClock)}
      showTitle={showTitle}
      id="surprise-clock"
      class:list={["surprise-clock-widget", className]}
      style={style}
      contentPadding={false}
    >
      <div
        class="surprise-clock"
        id="surprise-clock-root"
        role="timer"
        aria-live="polite"
        aria-label={i18n(I18nKey.surpriseClock)}
        style={`--sc-sky-blend: ${skyBlend}`}
        {...skyAttrs}
      />
    </WidgetLayout>
  )
}

<script is:inline defer data-swup-ignore-script src="/scripts/surprise-clock.js"></script>

<style>
  :global(.surprise-clock-widget.card-base),
  :global(.surprise-clock-widget) {
    background: transparent !important;
    background-color: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    overflow: visible;
  }

  :global(.enable-card-border .surprise-clock-widget.card-base),
  :global(.wallpaper-transparent .surprise-clock-widget.card-base) {
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
  }

  :global(.surprise-clock-widget .collapse-wrapper) {
    padding: 0 !important;
    overflow: visible !important;
    background: transparent !important;
  }

  .surprise-clock {
    --sc-h: 7.85rem;
    --sc-muted: rgb(0 0 0 / 0.32);
    --sc-bright: var(--primary);
    --sc-sky-night: oklch(0.22 0.06 265);
    --sc-pixel: var(--font-jetbrains-mono), "Sarasa UI SC", "Microsoft YaHei UI", ui-monospace, monospace;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.08rem;
    width: 100%;
    height: var(--sc-h);
    /* 天空只在角区内轻扩，禁止左溢到中间栏 */
    overflow: hidden;
    color: var(--sc-bright);
    text-align: center;
    font-family: var(--sc-pixel);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    border-radius: 0;
    background: transparent;
    -webkit-font-smoothing: none;
    -moz-osx-font-smoothing: unset;
    text-rendering: optimizeSpeed;
  }

  .surprise-clock--bare {
    padding-right: 0;
    justify-content: center;
  }

  :global(.dark) .surprise-clock {
    --sc-muted: rgb(255 255 255 / 0.18);
    --sc-bright: color-mix(in oklch, var(--primary) 72%, white);
    --sc-sky-night: oklch(0.16 0.05 272);
  }

  /* ── 天空层：昼夜跟随站点主题（data-sky），天气场景叠加（data-weather） ── */
  /* 轻扩 + 软边：图片略放大，但不伸出侧栏、不挡中间内容 */
  :global(.surprise-clock__sky) {
    --sc-sky-mask-x: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.45) 10%,
      #000 22%,
      #000 78%,
      rgba(0, 0, 0, 0.45) 90%,
      transparent 100%
    );
    --sc-sky-mask-y: linear-gradient(
      180deg,
      transparent 0%,
      rgba(0, 0, 0, 0.5) 12%,
      #000 26%,
      #000 74%,
      rgba(0, 0, 0, 0.5) 88%,
      transparent 100%
    );
    --sc-sky-mask-r: radial-gradient(
      ellipse 108% 96% at 50% 46%,
      #000 0%,
      #000 40%,
      rgba(0, 0, 0, 0.55) 70%,
      transparent 92%
    );
    position: absolute;
    inset: -0.65rem;
    z-index: 0;
    overflow: hidden;
    border-radius: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
    isolation: isolate;
    -webkit-mask-image: var(--sc-sky-mask-x), var(--sc-sky-mask-y), var(--sc-sky-mask-r);
    mask-image: var(--sc-sky-mask-x), var(--sc-sky-mask-y), var(--sc-sky-mask-r);
    -webkit-mask-composite: source-in, source-in;
    mask-composite: intersect;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  :global(.surprise-clock[data-sky] .surprise-clock__sky) {
    opacity: var(--sc-sky-blend, 0.38);
  }

  :global(.surprise-clock__sky-base),
  :global(.surprise-clock__sky-weather) {
    position: absolute;
    inset: -6%;
    width: 112%;
    height: 112%;
    max-width: none;
    object-fit: cover;
    object-position: center 40%;
    z-index: 0;
    pointer-events: none;
  }

  /* 亮色：天空偏淡，太阳/云靠对比与饱和略抬 */
  :global(.surprise-clock__sky-base) {
    opacity: 0.5;
    filter: brightness(1.06) contrast(1.08) saturate(1.08);
  }

  :global(html.dark .surprise-clock__sky-base) {
    opacity: 0.6;
    filter: brightness(1.04) contrast(1.06) saturate(1.05);
  }

  :global(.surprise-clock__sky-weather) {
    z-index: 1;
    mix-blend-mode: screen;
    opacity: 0.7;
  }

  /* GIF 就绪：藏星；太阳/云留淡光叠亮（不抢像素图） */
  :global(.surprise-clock[data-sky-gif-ready] .surprise-clock__stars) {
    opacity: 0;
    visibility: hidden;
  }

  :global(.surprise-clock[data-sky-gif-ready][data-sky="day"] .surprise-clock__celestial) {
    opacity: 0.62;
    mix-blend-mode: screen;
    filter: brightness(1.15) saturate(1.1);
  }

  :global(.surprise-clock[data-sky-gif-ready][data-sky="day"] .surprise-clock__cloud) {
    opacity: 0.55;
    mix-blend-mode: soft-light;
    filter: brightness(1.2);
  }

  :global(.surprise-clock[data-sky-gif-ready][data-sky="night"] .surprise-clock__celestial) {
    opacity: 0;
    visibility: hidden;
  }

  :global(.surprise-clock[data-sky-gif-ready]:not([data-sky="day"]) .surprise-clock__cloud) {
    opacity: 0;
    visibility: hidden;
  }

  /* 数字组抬到天空之上 —— 不做 mask / 不降透明度，保持主体浓度 */
  :global(.surprise-clock__group) {
    position: relative;
    z-index: 1;
  }

  /* 白天天空底色：略亮一点的淡垫 */
  :global(.surprise-clock[data-sky="day"] .surprise-clock__sky) {
    background: radial-gradient(
      ellipse 100% 90% at 50% 42%,
      oklch(0.68 0.07 235 / 0.24) 0%,
      oklch(0.78 0.05 222 / 0.14) 50%,
      transparent 78%
    );
  }

  /* 太阳：更亮核心 + 更强光晕 */
  :global(.surprise-clock[data-sky="day"] .surprise-clock__celestial) {
    position: absolute;
    top: 6%;
    right: 2%;
    width: 2.6rem;
    height: 2.6rem;
    z-index: 2;
    border-radius: 50%;
    background: radial-gradient(
      circle at 42% 42%,
      oklch(1 0.06 98) 0%,
      oklch(0.96 0.14 90) 48%,
      oklch(0.88 0.17 75) 100%
    );
    box-shadow:
      0 0 0.4rem oklch(0.98 0.12 95 / 1),
      0 0 1.35rem oklch(0.94 0.15 90 / 0.8),
      0 0 2.4rem oklch(0.9 0.14 85 / 0.45);
  }

  :global(.surprise-clock[data-sky="day"] .surprise-clock__celestial::before) {
    content: "";
    position: absolute;
    inset: -42%;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      oklch(0.98 0.12 95 / 0.72) 0deg 12deg,
      transparent 12deg 32deg,
      oklch(0.97 0.11 92 / 0.65) 32deg 44deg,
      transparent 44deg 64deg,
      oklch(0.98 0.12 95 / 0.72) 64deg 76deg,
      transparent 76deg 96deg,
      oklch(0.97 0.11 92 / 0.65) 96deg 108deg,
      transparent 108deg 128deg,
      oklch(0.98 0.12 95 / 0.72) 128deg 140deg,
      transparent 140deg 160deg,
      oklch(0.97 0.11 92 / 0.65) 160deg 172deg,
      transparent 172deg 192deg,
      oklch(0.98 0.12 95 / 0.72) 192deg 204deg,
      transparent 204deg 224deg,
      oklch(0.97 0.11 92 / 0.65) 224deg 236deg,
      transparent 236deg 256deg,
      oklch(0.98 0.12 95 / 0.72) 256deg 268deg,
      transparent 268deg 288deg,
      oklch(0.97 0.11 92 / 0.65) 288deg 300deg,
      transparent 300deg 320deg,
      oklch(0.98 0.12 95 / 0.72) 320deg 332deg,
      transparent 332deg 360deg
    );
    animation: sc-sun-pulse 4s ease-in-out infinite alternate;
  }

  @keyframes sc-sun-pulse {
    from {
      opacity: 0.85;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: scale(1.06);
    }
  }

  /* 云朵：更白更实一点 */
  :global(.surprise-clock__cloud) {
    position: absolute;
    z-index: 2;
    height: 2.4rem;
    border-radius: 50%;
    background:
      radial-gradient(ellipse 55% 70% at 30% 65%, oklch(100% 0 0 / 0.96) 0%, transparent 70%),
      radial-gradient(ellipse 60% 80% at 55% 40%, oklch(100% 0 0 / 0.92) 0%, transparent 70%),
      radial-gradient(ellipse 50% 60% at 75% 60%, oklch(100% 0 0 / 0.88) 0%, transparent 70%);
    filter: blur(0.1rem);
    opacity: 0.95;
    pointer-events: none;
  }

  :global(.surprise-clock__cloud--a) {
    top: 14%;
    left: -18%;
    width: 6.5rem;
    animation: sc-cloud-drift 38s linear infinite;
  }

  :global(.surprise-clock__cloud--b) {
    top: 22%;
    left: -35%;
    width: 5rem;
    opacity: 0.88;
    animation: sc-cloud-drift 52s linear infinite;
    animation-delay: -18s;
  }

  :global(.surprise-clock:not([data-sky="day"]) .surprise-clock__cloud) {
    display: none;
  }

  @keyframes sc-cloud-drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(44rem);
    }
  }

  /* 夜晚天空底色：同样偏淡 */
  :global(.surprise-clock[data-sky="night"] .surprise-clock__sky) {
    background: radial-gradient(
      ellipse 100% 90% at 50% 42%,
      oklch(0.28 0.055 265 / 0.28) 0%,
      oklch(0.18 0.04 272 / 0.15) 50%,
      transparent 78%
    );
  }

  /* 月牙：实心圆 + inset 咬缺口 */
  :global(.surprise-clock[data-sky="night"] .surprise-clock__celestial) {
    position: absolute;
    top: 9%;
    right: 3%;
    width: 2.1rem;
    height: 2.1rem;
    z-index: 2;
    border-radius: 50%;
    transform: rotate(-12deg);
    background: oklch(0.93 0.04 95);
    box-shadow:
      inset 0.5rem -0.08rem 0 0 var(--sc-sky-night),
      0 0 0.5rem oklch(0.9 0.05 95 / 0.55);
    filter: drop-shadow(0 0 0.35rem oklch(0.9 0.05 95 / 0.45));
  }

  :global(.surprise-clock:not([data-sky="night"]) .surprise-clock__celestial) {
    display: none;
  }

  :global(.surprise-clock__stars) {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(circle 0.08rem at 8% 20%, oklch(0.96 0 0 / 0.9), transparent 62%),
      radial-gradient(circle 0.06rem at 18% 62%, oklch(0.96 0 0 / 0.8), transparent 62%),
      radial-gradient(circle 0.09rem at 30% 30%, oklch(0.97 0.02 90 / 0.85), transparent 62%),
      radial-gradient(circle 0.06rem at 42% 12%, oklch(0.96 0 0 / 0.75), transparent 62%),
      radial-gradient(circle 0.08rem at 55% 55%, oklch(0.96 0 0 / 0.8), transparent 62%),
      radial-gradient(circle 0.05rem at 64% 22%, oklch(0.96 0 0 / 0.7), transparent 62%),
      radial-gradient(circle 0.07rem at 74% 68%, oklch(0.96 0 0 / 0.75), transparent 62%),
      radial-gradient(circle 0.06rem at 86% 34%, oklch(0.97 0.02 90 / 0.8), transparent 62%),
      radial-gradient(circle 0.05rem at 94% 12%, oklch(0.96 0 0 / 0.7), transparent 62%);
    animation: sc-star-twinkle 3.4s ease-in-out infinite alternate;
    pointer-events: none;
  }

  :global(.surprise-clock:not([data-sky="night"]) .surprise-clock__stars) {
    display: none;
  }

  @keyframes sc-star-twinkle {
    from {
      opacity: 0.55;
    }
    to {
      opacity: 1;
    }
  }

  /* 多云：太阳/月牙压暗，云变灰变快 */
  :global(.surprise-clock[data-weather="cloudy"] .surprise-clock__celestial) {
    opacity: 0.4;
  }

  :global(.surprise-clock[data-sky="day"][data-weather="cloudy"] .surprise-clock__cloud) {
    background: oklch(0.86 0.01 250 / 0.72);
    animation-duration: 20s;
  }

  /* 雨：细雨丝下落（压在数字前方，纵深感） */
  :global(.surprise-clock[data-weather="rain"]::before),
  :global(.surprise-clock[data-weather="thunder"]::before) {
    content: "";
    position: absolute;
    inset: -14% 0;
    z-index: 2;
    pointer-events: none;
    background: repeating-linear-gradient(
      112deg,
      transparent 0 0.34rem,
      oklch(0.88 0.04 240 / 0.3) 0.34rem 0.4rem
    );
    animation: sc-rain-fall 0.85s linear infinite;
  }

  @keyframes sc-rain-fall {
    from {
      transform: translateY(-10%);
    }
    to {
      transform: translateY(10%);
    }
  }

  /* 雪：碎雪点缓落 */
  :global(.surprise-clock[data-weather="snow"]::after) {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      radial-gradient(circle 0.07rem at 12% 15%, oklch(100% 0 0 / 0.9), transparent 64%),
      radial-gradient(circle 0.06rem at 30% 45%, oklch(100% 0 0 / 0.75), transparent 64%),
      radial-gradient(circle 0.08rem at 48% 8%, oklch(100% 0 0 / 0.85), transparent 64%),
      radial-gradient(circle 0.05rem at 66% 32%, oklch(100% 0 0 / 0.7), transparent 64%),
      radial-gradient(circle 0.07rem at 82% 58%, oklch(100% 0 0 / 0.8), transparent 64%);
    background-size: 100% 55%;
    background-repeat: repeat;
    animation: sc-snow-fall 4.6s linear infinite;
  }

  @keyframes sc-snow-fall {
    from {
      background-position: 0 -3rem;
    }
    to {
      background-position: 0 6rem;
    }
  }

  /* 雾：底部雾带浮动 */
  :global(.surprise-clock[data-weather="fog"]::after) {
    content: "";
    position: absolute;
    inset: 42% 0 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(0deg, oklch(0.92 0.01 250 / 0.48), transparent 85%);
    animation: sc-fog-drift 7s ease-in-out infinite alternate;
  }

  @keyframes sc-fog-drift {
    from {
      opacity: 0.55;
      transform: translateX(-4%);
    }
    to {
      opacity: 0.9;
      transform: translateX(4%);
    }
  }

  /* 雷暴：雨 + 低频闪 */
  :global(.surprise-clock[data-weather="thunder"] .surprise-clock__sky) {
    animation: sc-thunder-flash 8s linear infinite;
  }

  @keyframes sc-thunder-flash {
    0%,
    91%,
    95%,
    100% {
      filter: none;
    }
    93% {
      filter: brightness(1.75);
    }
  }

  :global(.surprise-clock__group) {
    display: inline-flex;
    align-items: center;
    height: var(--sc-h, 7.85rem);
  }

  :global(.surprise-clock__group[data-unit="hour"]) {
    --sc-group-start: oklch(0.66 0.2 292);
    --sc-group-end: oklch(0.61 0.2 255);
  }

  :global(.surprise-clock__group[data-unit="minute"]) {
    --sc-group-start: oklch(0.72 0.19 350);
    --sc-group-end: oklch(0.7 0.18 20);
  }

  :global(.surprise-clock__group[data-unit="second"]) {
    --sc-group-start: oklch(0.72 0.15 205);
    --sc-group-end: oklch(0.75 0.14 165);
  }

  /* 像素冒号 */
  :global(.surprise-clock__group:not(:last-child)::after) {
    content: ":";
    display: inline-flex;
    align-items: center;
    font-family: var(--sc-pixel, "DotGothic16", monospace);
    font-size: 1.55rem;
    font-weight: 400;
    line-height: 1;
    padding: 0 0.1rem;
    color: var(--sc-bright, var(--primary));
    opacity: 0.9;
    text-shadow: none;
    -webkit-font-smoothing: none;
  }

  :global(.surprise-clock__digit) {
    position: relative;
    display: inline-block;
    width: 1.65rem;
    height: var(--sc-h, 7.85rem);
    margin: 0 0.02rem;
    overflow: hidden;
    vertical-align: top;
  }

  :global(.surprise-clock__digit-track) {
    display: flex;
    flex-direction: column;
    align-items: center;
    will-change: transform;
    transform: translateY(var(--sc-shift, 0px));
    transition: transform 320ms steps(8, end);
  }

  :global(.surprise-clock__num) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 1.2rem;
    /* 旁路数字更虚 + 轻闪烁，滴答感 */
    color: var(--sc-muted, rgb(0 0 0 / 0.22));
    opacity: 0.52;
    font-family: var(--sc-pixel, "DotGothic16", monospace);
    font-size: 0.82rem;
    font-weight: 400;
    line-height: 1;
    transform: rotate(-45deg);
    filter: blur(0.25px) saturate(0.75);
    transition:
      font-size 160ms steps(4, end),
      transform 280ms steps(6, end),
      color 120ms linear,
      height 160ms steps(4, end);
    pointer-events: none;
    -webkit-font-smoothing: none;
    animation: sc-tick-blink 1.05s ease-in-out infinite;
  }

  :global(html.dark .surprise-clock__num:not(.is-bright)) {
    color: rgb(255 255 255 / 0.18);
  }

  @keyframes sc-tick-blink {
    0%,
    100% {
      opacity: 0.38;
    }
    50% {
      opacity: 0.58;
    }
  }

  :global(.surprise-clock__glyph) {
    display: inline-block;
  }

  /* 亮字：像素艺术主数字（不闪）；天空淡化后轻阴影咬轮廓 */
  :global(.surprise-clock__num.is-bright) {
    color: var(--sc-bright, var(--primary));
    opacity: 1;
    height: 2.2rem;
    font-size: 1.95rem;
    font-weight: 400;
    transform: rotate(0deg);
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.22);
    filter: none;
    animation: none;
  }

  :global(.surprise-clock__group .surprise-clock__num.is-bright .surprise-clock__glyph) {
    background: linear-gradient(125deg, var(--sc-group-start), var(--sc-group-end));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    filter: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.surprise-clock__num),
    :global(.surprise-clock__digit-track) {
      transition-duration: 0.01ms !important;
      transition-timing-function: linear !important;
    }

    :global(.surprise-clock__num:not(.is-bright)) {
      animation: none;
      opacity: 0.5;
    }

    /* 天空/天气动画降级：保留静态场景 */
    :global(.surprise-clock__sky),
    :global(.surprise-clock__celestial),
    :global(.surprise-clock__stars),
    :global(.surprise-clock__cloud),
    :global(.surprise-clock__sky-base),
    :global(.surprise-clock__sky-weather),
    :global(.surprise-clock::before),
    :global(.surprise-clock::after) {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
