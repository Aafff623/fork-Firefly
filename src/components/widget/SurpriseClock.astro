---
/**
 * 意想不到时钟：对照 bilibili-goat widgets/意想不到时钟
 * bare=true 时无 WidgetLayout（供 ClockCorner 角区嵌底）
 */
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
	/** 无卡片外壳，交给 ClockCorner 排布 */
	bare?: boolean;
}

const { class: className, style, widgetConfig, bare = false } = Astro.props;
const showTitle = widgetConfig?.showTitle === true;
---

{
  bare ? (
    <div
      class:list={["surprise-clock", "surprise-clock--bare", className]}
      id="surprise-clock-root"
      role="timer"
      aria-live="polite"
      aria-label={i18n(I18nKey.surpriseClock)}
      style={style}
    />
  ) : (
    <WidgetLayout
      name={i18n(I18nKey.surpriseClock)}
      showTitle={showTitle}
      id="surprise-clock"
      class:list={["surprise-clock-widget", className]}
      style={style}
      contentPadding={false}
    >
      <div
        class="surprise-clock"
        id="surprise-clock-root"
        role="timer"
        aria-live="polite"
        aria-label={i18n(I18nKey.surpriseClock)}
      />
    </WidgetLayout>
  )
}

<script is:inline data-swup-ignore-script>
  (function () {
    // 仅翻页计时；已去掉鼠标悬停斥力/复式位移
    const ROOT_ID = "surprise-clock-root";

    let raf = 0;
    /** @type {HTMLElement[]} */
    let digitGroups = [];
    let builtFor = null;

    function build(root) {
      if (builtFor === root && digitGroups.length) return;
      root.innerHTML = "";
      digitGroups = [];
      builtFor = root;

      const time10 = Array.from({ length: 10 }, (_, i) => i);
      const time6 = time10.slice(0, 6);
      const time3 = time10.slice(0, 3);
      const structure = [
        [time3, time10],
        [time6, time10],
        [time6, time10],
      ];

      const units = ["hour", "minute", "second"];
      const gradients = [
        ["oklch(0.66 0.2 292)", "oklch(0.61 0.2 255)"],
        ["oklch(0.72 0.19 350)", "oklch(0.7 0.18 20)"],
        ["oklch(0.72 0.15 205)", "oklch(0.75 0.14 165)"],
      ];
      structure.forEach((digits, index) => {
        const group = document.createElement("div");
        group.className = "surprise-clock__group";
        group.dataset.unit = units[index];
        group.style.setProperty("--sc-group-start", gradients[index][0]);
        group.style.setProperty("--sc-group-end", gradients[index][1]);
        root.appendChild(group);
        digitGroups.push(group);
        digits.forEach((digitList) => {
          const digit = document.createElement("div");
          digit.className = "surprise-clock__digit";
          const track = document.createElement("div");
          track.className = "surprise-clock__digit-track";
          digitList.forEach((n) => {
            const el = document.createElement("div");
            el.className = "surprise-clock__num";
            const glyph = document.createElement("span");
            glyph.className = "surprise-clock__glyph";
            glyph.style.background = `linear-gradient(125deg, ${gradients[index][0]}, ${gradients[index][1]})`;
            glyph.style.backgroundClip = "text";
            glyph.style.setProperty("-webkit-background-clip", "text");
            glyph.style.setProperty("-webkit-text-fill-color", "transparent");
            glyph.textContent = String(n);
            el.appendChild(glyph);
            track.appendChild(el);
          });
          digit.appendChild(track);
          group.appendChild(digit);
        });
      });
    }

    function tick() {
      raf = requestAnimationFrame(tick);
      const root = document.getElementById(ROOT_ID);
      if (!root) return;
      build(root);

      const date = new Date();
      const time = [date.getHours(), date.getMinutes(), date.getSeconds()]
        .map((n) => `0${n}`.slice(-2).split("").map((e) => +e))
        .reduce((p, n) => p.concat(n), []);

      const label = time
        .map((n, i) => (i && i % 2 === 0 ? `:${n}` : String(n)))
        .join("");
      if (root.getAttribute("aria-label") !== label) {
        root.setAttribute("aria-label", label);
      }

      time.forEach((n, i) => {
        const group = digitGroups[Math.floor(i * 0.5)];
        if (!group) return;
        const digit = group.children[i % 2];
        if (!(digit instanceof HTMLElement)) return;
        const track = digit.querySelector(".surprise-clock__digit-track");
        if (!(track instanceof HTMLElement)) return;
        Array.from(track.children).forEach((el, i2) => {
          el.classList.toggle("is-bright", i2 === n);
        });
        const bright = track.children[n];
        if (bright instanceof HTMLElement) {
          const mid = digit.clientHeight * 0.5 - bright.offsetHeight * 0.5;
          track.style.setProperty("--sc-shift", `${mid - bright.offsetTop}px`);
        }
      });
    }

    function start() {
      if (raf) cancelAnimationFrame(raf);
      digitGroups = [];
      builtFor = null;
      raf = requestAnimationFrame(tick);
    }

    start();
    document.addEventListener("swup:contentReplaced", () => {
      setTimeout(start, 80);
    });
    document.addEventListener("astro:page-load", () => {
      setTimeout(start, 80);
    });
  })();
</script>

<style>
  @import url("https://fonts.googleapis.com/css2?family=DotGothic16&display=swap");

  :global(.surprise-clock-widget.card-base),
  :global(.surprise-clock-widget) {
    background: transparent !important;
    background-color: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    overflow: visible;
  }

  :global(.enable-card-border .surprise-clock-widget.card-base),
  :global(.wallpaper-transparent .surprise-clock-widget.card-base) {
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
  }

  :global(.surprise-clock-widget .collapse-wrapper) {
    padding: 0 !important;
    overflow: visible !important;
    background: transparent !important;
  }

  .surprise-clock {
    --sc-h: 7.85rem;
    --sc-muted: rgb(0 0 0 / 0.18);
    --sc-bright: var(--primary);
    --sc-pixel: "DotGothic16", "Sarasa UI SC", "Microsoft YaHei UI", ui-monospace, monospace;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.08rem;
    width: 100%;
    height: var(--sc-h);
    overflow: hidden;
    color: var(--sc-bright);
    text-align: center;
    font-family: var(--sc-pixel);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    border-radius: 0;
    background: transparent;
    -webkit-font-smoothing: none;
    -moz-osx-font-smoothing: unset;
    text-rendering: optimizeSpeed;
  }

  .surprise-clock--bare {
    padding-right: 0;
    justify-content: center;
  }

  :global(.dark) .surprise-clock {
    --sc-muted: rgb(255 255 255 / 0.26);
    --sc-bright: color-mix(in oklch, var(--primary) 72%, white);
  }

  :global(.surprise-clock__group) {
    display: inline-flex;
    align-items: center;
    height: var(--sc-h, 7.85rem);
  }

  :global(.surprise-clock__group[data-unit="hour"]) {
    --sc-group-start: oklch(0.66 0.2 292);
    --sc-group-end: oklch(0.61 0.2 255);
  }

  :global(.surprise-clock__group[data-unit="minute"]) {
    --sc-group-start: oklch(0.72 0.19 350);
    --sc-group-end: oklch(0.7 0.18 20);
  }

  :global(.surprise-clock__group[data-unit="second"]) {
    --sc-group-start: oklch(0.72 0.15 205);
    --sc-group-end: oklch(0.75 0.14 165);
  }

  /* 像素冒号 */
  :global(.surprise-clock__group:not(:last-child)::after) {
    content: ":";
    display: inline-flex;
    align-items: center;
    font-family: var(--sc-pixel, "DotGothic16", monospace);
    font-size: 1.55rem;
    font-weight: 400;
    line-height: 1;
    padding: 0 0.1rem;
    color: var(--sc-bright, var(--primary));
    opacity: 0.9;
    text-shadow: none;
    -webkit-font-smoothing: none;
  }

  :global(.surprise-clock__digit) {
    position: relative;
    display: inline-block;
    width: 1.65rem;
    height: var(--sc-h, 7.85rem);
    margin: 0 0.02rem;
    overflow: hidden;
    vertical-align: top;
  }

  :global(.surprise-clock__digit-track) {
    display: flex;
    flex-direction: column;
    align-items: center;
    will-change: transform;
    transform: translateY(var(--sc-shift, 0px));
    transition: transform 320ms steps(8, end);
  }

  :global(.surprise-clock__num) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 1.2rem;
    /* 旁路数字更虚 + 轻闪烁，滴答感 */
    color: var(--sc-muted, rgb(0 0 0 / 0.12));
    opacity: 0.55;
    font-family: var(--sc-pixel, "DotGothic16", monospace);
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1;
    transform: rotate(-90deg);
    transition:
      font-size 160ms steps(4, end),
      transform 280ms steps(6, end),
      color 120ms linear,
      height 160ms steps(4, end);
    pointer-events: none;
    -webkit-font-smoothing: none;
    animation: sc-tick-blink 1.05s ease-in-out infinite;
  }

  :global(html.dark .surprise-clock__num:not(.is-bright)) {
    color: rgb(255 255 255 / 0.14);
  }

  @keyframes sc-tick-blink {
    0%,
    100% {
      opacity: 0.38;
    }
    50% {
      opacity: 0.62;
    }
  }

  :global(.surprise-clock__glyph) {
    display: inline-block;
  }

  /* 亮字：像素艺术主数字（不闪） */
  :global(.surprise-clock__num.is-bright) {
    color: var(--sc-bright, var(--primary));
    opacity: 1;
    height: 2.2rem;
    font-size: 1.95rem;
    font-weight: 400;
    transform: rotate(0deg);
    text-shadow: none;
    animation: none;
  }

  :global(.surprise-clock__group .surprise-clock__num.is-bright .surprise-clock__glyph) {
    background: linear-gradient(125deg, var(--sc-group-start), var(--sc-group-end));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    filter: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.surprise-clock__num),
    :global(.surprise-clock__digit-track) {
      transition-duration: 0.01ms !important;
      transition-timing-function: linear !important;
    }

    :global(.surprise-clock__num:not(.is-bright)) {
      animation: none;
      opacity: 0.42;
    }
  }
</style>
