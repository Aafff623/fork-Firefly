---
import { Icon } from "astro-icon/components";
import LoginCard from "./LoginCard.astro";
import LoginStage from "./LoginStage.astro";
---

<dialog
	class="login-dialog"
	data-login-dialog
	aria-labelledby="login-dialog-title"
>
	<div class="login-dialog__panel">
		<LoginStage />
		<div class="login-dialog__pane">
			<LoginCard headingId="login-dialog-title" embedded />
		</div>
		<button
			type="button"
			class="login-dialog__close"
			data-login-close
			aria-label="关闭"
		>
			<Icon is:inline name="lucide:x" class="login-dialog__close-icon" />
		</button>
	</div>
</dialog>

<script>
	function isModifiedClick(event: MouseEvent): boolean {
		return (
			event.button !== 0 ||
			event.metaKey ||
			event.ctrlKey ||
			event.shiftKey ||
			event.altKey
		);
	}

	function currentPath(): string {
		return window.location.pathname.replace(/\/+$/, "") || "/";
	}

	function bootLoginModal(): void {
		if (window.__loginModalBound) return;
		const dialog = document.querySelector<HTMLDialogElement>("[data-login-dialog]");
		if (!dialog) return;
		window.__loginModalBound = true;

		const card = dialog.querySelector<HTMLElement>("[data-login-card]");
		const closeButton = dialog.querySelector<HTMLButtonElement>("[data-login-close]");

		const closeDialog = () => {
			if (dialog.open) {
				dialog.close();
				document.dispatchEvent(new CustomEvent("firefly:login-closed"));
			}
		};

		const openDialog = (next: string) => {
			if (card) {
				card.setAttribute("data-login-next", next);
				card.dispatchEvent(new Event("firefly:login-sync"));
			}
			if (!dialog.open) {
				dialog.showModal();
				document.dispatchEvent(new CustomEvent("firefly:login-opened"));
			}
		};

		closeButton?.addEventListener("click", closeDialog);
		dialog.addEventListener("click", (event) => {
			if (event.target === dialog) closeDialog();
		});
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") closeDialog();
		});
		document.addEventListener("swup:visit:start", closeDialog);

		document.addEventListener("firefly:login-open", ((event: CustomEvent<{ next?: string }>) => {
			const next = event.detail?.next || `${window.location.pathname}${window.location.search}` || "/";
			openDialog(next);
		}) as EventListener);

		document.addEventListener(
			"click",
			(event) => {
				if (isModifiedClick(event)) return;
				const target = event.target;
				if (!(target instanceof Element)) return;
				const link = target.closest<HTMLAnchorElement>('a[href^="/login/"]');
				if (!link || link.hasAttribute("data-login-fullpage")) return;
				if (currentPath() === "/login") return;
				event.preventDefault();
				event.stopImmediatePropagation();
				const url = new URL(link.href, window.location.origin);
				const next =
					url.searchParams.get("next") ||
					`${window.location.pathname}${window.location.search}` ||
					"/";
				openDialog(next);
			},
			true,
		);
	}

	bootLoginModal();
	document.addEventListener("swup:page:view", bootLoginModal);
</script>

<style>
	.login-dialog {
		/* Tailwind preflight 的 * { margin: 0 } 会重置 dialog 原生 margin:auto 居中，显式恢复 */
		margin: auto;
		padding: 0;
		border: 0;
		background: transparent;
		max-width: calc(100vw - 1.5rem);
		max-height: calc(100dvh - 2rem);
	}

	.login-dialog::backdrop {
		background: rgb(8 10 18 / 0.45);
		backdrop-filter: blur(6px);
	}

	.login-dialog__panel {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
		width: min(75vw, 72rem);
		height: min(75vh, 42rem);
		border-radius: var(--radius-large);
		overflow: hidden;
		background: var(--card-bg);
		box-shadow: 0 24px 70px rgb(0 0 0 / 0.35);
	}

	.login-dialog__pane {
		display: grid;
		place-items: center;
		min-width: 0;
		padding: 1.4rem;
		overflow: auto;
	}

	/* 窄屏 / 矮屏：隐藏舞台，退化为常规尺寸卡片 */
	@media (max-width: 900px), (max-height: 620px) {
		.login-dialog__panel {
			grid-template-columns: minmax(0, 1fr);
			width: min(28rem, calc(100vw - 2rem));
			height: auto;
		}
	}

	.login-dialog__close {
		position: absolute;
		top: 0.65rem;
		right: 0.65rem;
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: color-mix(in oklch, var(--card-bg) 70%, transparent);
		color: var(--content-meta);
		cursor: pointer;
	}

	.login-dialog__close:hover {
		color: var(--deep-text);
		background: color-mix(in oklch, var(--card-bg) 92%, var(--deep-text));
	}

	.login-dialog__close:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	.login-dialog__close-icon {
		width: 1rem;
		height: 1rem;
	}
</style>
