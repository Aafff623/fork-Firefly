---
/**
 * 文章底部分享条：只做分享，不含打赏 CTA。
 */
import { Icon } from "astro-icon/components";
import SharePoster from "@/components/misc/SharePoster.svelte";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { siteConfig } from "@/config";

interface Props {
	title: string;
	author: string;
	description: string;
	pubDate: string;
	coverImage?: string | null;
	coverImageSelector?: string | null;
	pageUrl: string;
	siteTitle: string;
	avatar?: string | null;
	avatarSelector?: string | null;
	class?: string;
}

const {
	title,
	author,
	description,
	pubDate,
	coverImage = null,
	coverImageSelector = null,
	pageUrl,
	siteTitle,
	avatar = null,
	avatarSelector = null,
	class: className,
} = Astro.props;

const enablePoster = siteConfig.post.sharePoster !== false;
---

{
  enablePoster && (
    <div class:list={["share-bar onload-animation", className]}>
      <div class="share-bar__inner">
        <div class="share-bar__copy">
          <span class="share-bar__kicker">SHARE</span>
          <h3 class="share-bar__title">{i18n(I18nKey.shareOnSocial)}</h3>
          <p class="share-bar__desc">{i18n(I18nKey.shareOnSocialDescription)}</p>
        </div>
        <div class="share-bar__actions">
          <button
            type="button"
            class="share-bar__action share-bar__action--copy"
            data-share-copy
            data-share-url={pageUrl}
            data-copied-label="✓"
            title={i18n(I18nKey.copyLink)}
          >
            <span class="share-bar__action-icon" aria-hidden="true">
              <Icon is:inline name="lucide:link" class="share-bar__action-glyph" />
            </span>
            <span data-share-copy-label>{i18n(I18nKey.copyLink)}</span>
          </button>
          <SharePoster
            client:load
            title={title}
            author={author}
            description={description}
            pubDate={pubDate}
            coverImage={coverImage}
            coverImageSelector={coverImageSelector}
            url={pageUrl}
            siteTitle={siteTitle}
            avatar={avatar}
            avatarSelector={avatarSelector}
          />
        </div>
      </div>
    </div>
  )
}

<style is:global>
  .share-bar {
    margin-bottom: 1.5rem;
  }

  .share-bar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.25rem;
    padding: 1rem 1.15rem;
    border-radius: 0.75rem;
    border: 1px solid oklch(88% 0.012 var(--hue));
    background: oklch(99% 0.004 var(--hue));
    box-shadow: 0 0 0 1px oklch(0.3 0.01 260 / 0.04);
  }

  html.dark .share-bar__inner {
    border-color: oklch(32% 0.02 var(--hue));
    background: oklch(18% 0.022 var(--hue));
  }

  .wallpaper-transparent .share-bar__inner {
    background: oklch(99% 0.004 var(--hue)) !important;
    backdrop-filter: none !important;
  }

  html.dark .wallpaper-transparent .share-bar__inner {
    background: oklch(18% 0.022 var(--hue)) !important;
  }

  .share-bar__kicker {
    display: block;
    font-family: "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace;
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: oklch(48% 0.02 var(--hue));
    margin-bottom: 0.2rem;
  }

  .share-bar__title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--deep-text);
    line-height: 1.3;
  }

  .share-bar__desc {
    margin: 0.25rem 0 0;
    font-size: 0.84rem;
    color: var(--content-meta);
    max-width: 36ch;
  }

  .share-bar__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  /* 复制 / 分享：统一轮廓按钮 + 中性图标底，避免 primary 满色与 btn-regular 混搭 */
  .share-bar__action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.375rem;
    padding: 0.35rem 0.9rem 0.35rem 0.4rem;
    border-radius: 0.6rem;
    border: 1px solid oklch(88% 0.012 var(--hue));
    background: color-mix(in oklch, var(--card-bg, oklch(99% 0.004 var(--hue))) 88%, white);
    color: var(--deep-text);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    white-space: nowrap;
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      box-shadow 0.18s ease;
  }

  html.dark .share-bar__action {
    border-color: oklch(34% 0.02 var(--hue));
    background: color-mix(in oklch, var(--card-bg, oklch(18% 0.022 var(--hue))) 92%, black);
    color: oklch(94% 0.01 var(--hue));
  }

  .share-bar__action-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.45rem;
    background: oklch(96% 0.008 var(--hue));
    color: oklch(46% 0.025 var(--hue));
    flex-shrink: 0;
    transition:
      background 0.18s ease,
      color 0.18s ease;
  }

  html.dark .share-bar__action-icon {
    background: oklch(26% 0.02 var(--hue));
    color: oklch(76% 0.02 var(--hue));
  }

  .share-bar__action-glyph {
    width: 1rem !important;
    height: 1rem !important;
    font-size: 1rem !important;
  }

  .share-bar__action:hover {
    border-color: color-mix(in oklch, var(--primary) 28%, oklch(88% 0.012 var(--hue)));
    box-shadow: 0 6px 16px -12px oklch(0% 0 0 / 0.28);
  }

  html.dark .share-bar__action:hover {
    border-color: color-mix(in oklch, var(--primary) 32%, oklch(34% 0.02 var(--hue)));
  }

  .share-bar__action:hover .share-bar__action-icon {
    background: color-mix(in oklch, var(--primary) 11%, oklch(96% 0.008 var(--hue)));
    color: var(--primary);
  }

  html.dark .share-bar__action:hover .share-bar__action-icon {
    background: color-mix(in oklch, var(--primary) 16%, oklch(26% 0.02 var(--hue)));
    color: color-mix(in oklch, var(--primary) 85%, white);
  }

  .share-bar__action:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .share-bar__action.is-copied {
    border-color: oklch(72% 0.06 145);
  }

  .share-bar__action.is-copied .share-bar__action-icon {
    background: oklch(95% 0.03 145);
    color: oklch(42% 0.1 145);
  }
</style>

<script is:inline data-swup-ignore-script>
  (function () {
    function bindCopy() {
      document.querySelectorAll("[data-share-copy]").forEach(function (btn) {
        if (btn.dataset.bound === "1") return;
        btn.dataset.bound = "1";
        btn.addEventListener("click", async function () {
          var url = btn.getAttribute("data-share-url") || location.href;
          var label = btn.querySelector("[data-share-copy-label]");
          var copied = btn.getAttribute("data-copied-label") || "已复制";
          var original = label ? label.textContent : "";
          try {
            await navigator.clipboard.writeText(url);
            btn.classList.add("is-copied");
            if (label) label.textContent = copied;
            setTimeout(function () {
              btn.classList.remove("is-copied");
              if (label) label.textContent = original;
            }, 1600);
          } catch (e) {
            window.prompt("复制链接：", url);
          }
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bindCopy);
    } else {
      bindCopy();
    }
    document.addEventListener("swup:contentReplaced", bindCopy);
  })();
</script>
