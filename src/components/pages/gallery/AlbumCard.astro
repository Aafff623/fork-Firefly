---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getLqipProps } from "@/utils/lqip-utils";
import { url } from "@/utils/url-utils";

interface Props {
	id: string;
	name: string;
	cover: string;
	description?: string;
	date?: string;
	location?: string;
	tags?: string[];
	photoCount: number;
	encrypted?: boolean;
	category?: string;
}

const {
	id,
	name,
	cover,
	description,
	date,
	location,
	tags,
	photoCount,
	encrypted,
	category,
} = Astro.props;

// LQIP 渐变占位
const lqipProps = cover ? getLqipProps(cover, undefined, true) : { style: "" };
---

<a
  href={url(`/gallery/${id}/`)}
  data-tags={tags?.join(",") || ""}
  data-category={category || ""}
  class="album-card group relative block overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg hover:scale-[1.02]"
>
  <!-- Cover Image -->
  <div class="aspect-4/3 relative overflow-hidden">
    {cover ? (
      <>
        <div class="lqip-placeholder absolute inset-0 pointer-events-none" style={lqipProps.style} aria-hidden="true"></div>
        <img
          src={cover}
          alt={name}
          class="w-full h-full object-cover pointer-events-none opacity-0 transition-all duration-500 ease-out group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
      </>
    ) : (
      <div class="w-full h-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center">
        <Icon is:inline name="lucide:camera" class="text-gray-400 text-5xl" aria-hidden="true" />
      </div>
    )}

    <!-- Photo count badge -->
    <div class="absolute top-2 right-2 px-2 py-1 rounded-full text-xs text-white font-medium bg-black/50 backdrop-blur-sm">
      {photoCount} {i18n(I18nKey.galleryPhotos)}
    </div>

    {/* Encrypted badge */}
    {encrypted && (
      <div class="absolute top-2 left-2 px-2 py-1 rounded-full text-xs text-white font-medium bg-black/50 backdrop-blur-sm flex items-center gap-1">
        <Icon is:inline name="lucide:lock" class="w-3 h-3" aria-hidden="true" />
      </div>
    )}

    <!-- Gradient overlay + info -->
    <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/20 to-transparent" />
    <div class="absolute bottom-0 left-0 right-0 p-4">
      <h3 class="font-bold text-base text-white line-clamp-1 drop-shadow-lg">
        {name}
      </h3>

      {description && (
        <p class="text-xs text-white/75 line-clamp-1 mt-1 leading-relaxed" title={description}>
          {description}
        </p>
      )}

      <div class="flex items-center gap-3 text-xs text-white/70 mt-1.5 flex-wrap">
        {date && <span>{date}</span>}
        {location && (
          <span class="inline-flex items-center gap-0.5">
            <Icon is:inline name="lucide:map-pin" class="w-3 h-3" aria-hidden="true" />
            {location}
          </span>
        )}
      </div>

      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1 mt-2">
          {tags.slice(0, 4).map((tag) => (
            <span class="text-[0.6rem] px-1.5 py-0.5 rounded bg-white/20 text-white/90 backdrop-blur-sm">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>
</a>
