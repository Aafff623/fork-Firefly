---
/**
 * 130 行视觉特效 — 改编自 bilibili-goat `categories/effects/130行视觉特效`
 * 缩小嵌在 about-intro 名片旁留白；CSS-only，悬停展开。
 */
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["about-prism", className]} data-about-prism aria-hidden="true">
  <div class="about-prism__stage">
    <div class="about-prism__shell">
      <div class="about-prism__wrap">
        <div class="about-prism__a"></div>
        <div class="about-prism__b"></div>
        <div class="about-prism__c"></div>
      </div>
      <div class="about-prism__wrap about-prism__wrap--2">
        <div class="about-prism__a"></div>
        <div class="about-prism__b"></div>
        <div class="about-prism__c"></div>
        <div class="about-prism__d"></div>
        <div class="about-prism__e"></div>
        <div class="about-prism__f"></div>
      </div>
      <div class="about-prism__wrap about-prism__wrap--3">
        <div class="about-prism__a"></div>
        <div class="about-prism__b"></div>
        <div class="about-prism__c"></div>
        <div class="about-prism__d"></div>
        <div class="about-prism__e"></div>
        <div class="about-prism__f"></div>
      </div>
    </div>
  </div>
</div>

<style>
  .about-prism {
    --ap-ink: #2f3338;
    --ap-mid: #6b7280;
    --ap-soft: #a8b0b8;
    --ap-scale: 0.32;
    flex: 1 1 7.5rem;
    min-width: 6.5rem;
    max-width: 11rem;
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
  }

  :global(:root.dark) .about-prism {
    --ap-ink: #d1d5db;
    --ap-mid: #9ca3af;
    --ap-soft: #6b7280;
  }

  .about-prism__stage {
    width: 100%;
    height: 6.25rem;
    border-radius: 0.55rem;
    border: 1px solid color-mix(in oklab, var(--line-color), transparent);
    background:
      radial-gradient(
        circle at 40% 30%,
        color-mix(in oklab, var(--primary) 16%, transparent),
        transparent 60%
      ),
      color-mix(in oklab, rgb(68, 127, 130) 28%, var(--card-bg));
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  :global(:root.dark) .about-prism__stage {
    background:
      radial-gradient(
        circle at 40% 30%,
        color-mix(in oklab, var(--primary) 22%, transparent),
        transparent 60%
      ),
      color-mix(in oklab, rgb(68, 127, 130) 22%, #152022);
  }

  .about-prism__shell {
    position: relative;
    width: 18rem;
    height: 20rem;
    transform: scale(var(--ap-scale));
    transform-origin: center center;
    left: -0.6rem;
  }

  .about-prism__a,
  .about-prism__b,
  .about-prism__c {
    position: absolute;
    height: 300px;
    width: 30px;
    background-color: var(--ap-ink);
    top: 49px;
    left: 0;
    transform: rotate(60deg) skew(30deg);
  }

  .about-prism__b {
    background-color: var(--ap-soft);
    transform: rotate(180deg) skew(30deg);
    left: 180px;
    top: 36px;
  }

  .about-prism__c {
    background-color: var(--ap-mid);
    transform: rotate(-60deg) skew(30deg);
    left: 101px;
    top: 199px;
  }

  .about-prism__a::after,
  .about-prism__b::after,
  .about-prism__c::after {
    content: "";
    position: absolute;
    width: 0;
    height: 278px;
    left: 165px;
    top: -141px;
    transform: rotate(-90deg) skew(0deg);
    border-bottom: 23px solid transparent;
    border-right: 20px solid var(--ap-ink);
    transition: 0.5s ease;
  }

  .about-prism__b::after {
    border-right-color: var(--ap-soft);
  }

  .about-prism__c::after {
    border-right-color: var(--ap-mid);
  }

  .about-prism__wrap--2 {
    position: absolute;
    transform: scale(0.5);
    margin-left: 56px;
    margin-top: 121px;
  }

  .about-prism__wrap--3 {
    position: absolute;
    transform: scale(0.22);
    margin-left: 88px;
    margin-top: 188px;
  }

  .about-prism__d,
  .about-prism__e,
  .about-prism__f {
    position: absolute;
    background-color: var(--ap-ink);
    width: 130px;
    height: 25px;
    top: 270px;
    left: -160px;
    transform: rotate(60deg) skew(30deg);
  }

  .about-prism__e {
    background-color: var(--ap-mid);
    top: 400px;
    left: 173px;
    transform: rotate(120deg) skew(30deg);
  }

  .about-prism__f {
    background-color: var(--ap-soft);
    top: 35px;
    left: 100px;
    transform: rotate(180deg) skew(30deg);
  }

  .about-prism__shell:hover .about-prism__a::after,
  .about-prism__shell:hover .about-prism__b::after,
  .about-prism__shell:hover .about-prism__c::after {
    height: 290px;
    top: 31px;
    left: 76px;
  }

  @media (max-width: 640px) {
    .about-prism {
      max-width: none;
      width: 100%;
      flex-basis: 100%;
    }

    .about-prism__stage {
      height: 5.5rem;
    }

    .about-prism {
      --ap-scale: 0.28;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-prism__a::after,
    .about-prism__b::after,
    .about-prism__c::after {
      transition: none;
    }
  }
</style>
