---
/**
 * About 联系条：
 * - 头像：进页旋转（独立于右侧条）
 * - 右侧条（联系我 / 名字 / 分享钮）：从头像旁缓缓横向展开
 */
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;

const preferred = ["GitHub", "Bilibili", "Twitter", "Email", "Telegram"] as const;
const linkMap = new Map(profileConfig.links.map((l) => [l.name, l]));
const fanLinks = preferred
	.map((name) => linkMap.get(name))
	.filter((l): l is (typeof profileConfig.links)[number] => Boolean(l))
	.slice(0, 5);

const title = "联系我";
const subtitle = `@${profileConfig.name}`;
const githubAvatar = "https://github.com/Aafff623.png?size=160";
---

<div
  class:list={["about-pop-card", "is-enter", className]}
  data-about-pop-card
>
  <div class="about-pop-card__row">
    <div class="about-pop-card__photo">
      <ImageWrapper
        src={githubAvatar}
        alt={`GitHub avatar of ${profileConfig.name}`}
        class="about-pop-card__avatar"
        loading="eager"
        widths={[160]}
        sizes="80px"
        fadeIn={false}
        showLqip={false}
        showOverlay={false}
      />
    </div>

    <!-- 要卷开的就是这块：联系我 + 名字 + 分享钮 -->
    <div class="about-pop-card__bar" data-about-pop-bar>
      <div class="about-pop-card__bar-inner">
        <span class="about-pop-card__rule" aria-hidden="true"></span>
        <div class="about-pop-card__text">
          <p class="about-pop-card__title">{title}</p>
          <p class="about-pop-card__sub">{subtitle}</p>
          <p class="about-pop-card__hint">点右侧展开社交链接</p>
        </div>
        <button
          type="button"
          class="about-pop-card__btn"
          aria-expanded="false"
          aria-controls="about-pop-card-fan"
          aria-label="展开社交链接"
          data-about-pop-toggle
        >
          <Icon is:inline name="lucide:share-2" class="about-pop-card__btn-icon" aria-hidden="true" />
        </button>
      </div>

      <div
        id="about-pop-card-fan"
        class="about-pop-card__box"
        data-about-pop-fan
        aria-hidden="true"
      >
        {
          fanLinks.map((item) => {
            const isMail = item.url.startsWith("mailto:");
            if (isMail) {
              const encodedEmail = Buffer.from(
                item.url.replace("mailto:", ""),
              ).toString("base64");
              return (
                <a
                  class="about-pop-card__link"
                  href="#"
                  rel="me"
                  aria-label={item.name}
                  data-encoded-email={encodedEmail}
                  data-about-pop-mail
                >
                  <Icon is:inline name={item.icon} />
                </a>
              );
            }
            return (
              <a
                class="about-pop-card__link"
                href={item.url}
                target="_blank"
                rel="noopener noreferrer me"
                aria-label={item.name}
              >
                <Icon is:inline name={item.icon} />
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</div>

<script>
  function playBarUnroll(root: HTMLElement) {
    const bar = root.querySelector("[data-about-pop-bar]");
    const inner = root.querySelector(".about-pop-card__bar-inner");
    if (!(bar instanceof HTMLElement) || !(inner instanceof HTMLElement)) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      bar.style.width = `${inner.offsetWidth}px`;
      bar.style.borderColor = "";
      bar.style.boxShadow = "";
      return;
    }

    bar.getAnimations().forEach((a) => a.cancel());
    const targetW = inner.offsetWidth;
    const line = getComputedStyle(root).getPropertyValue("--apc-line").trim() ||
      "color-mix(in oklab, var(--line-color), transparent)";
    const shadow = "0 10px 28px -14px color-mix(in oklab, var(--deep-text) 10%, transparent)";

    bar.style.width = "0px";
    bar.animate(
      [
        {
          width: "0px",
          borderColor: "transparent",
          boxShadow: "none",
        },
        {
          width: `${Math.max(24, targetW * 0.12)}px`,
          borderColor: line,
          offset: 0.12,
        },
        {
          width: `${targetW}px`,
          borderColor: line,
          boxShadow: shadow,
        },
      ],
      {
        duration: 2900,
        delay: 220,
        easing: "cubic-bezier(0.33, 0.05, 0.25, 1)",
        fill: "forwards",
      },
    );
  }

  function replayEnter(root: HTMLElement) {
    root.classList.remove("is-enter");
    void root.offsetWidth;
    root.classList.add("is-enter");
    // 右侧条用 WAAPI 驱动宽度，保证「缓缓展开」可见、可重播
    playBarUnroll(root);
  }

  function bindAboutPopCard(root: Element) {
    if (!(root instanceof HTMLElement)) return;

    if (root.dataset.bound === "1") {
      replayEnter(root);
      return;
    }
    root.dataset.bound = "1";
    replayEnter(root);

    const btn = root.querySelector("[data-about-pop-toggle]");
    const fan = root.querySelector("[data-about-pop-fan]");
    if (!(btn instanceof HTMLElement) || !(fan instanceof HTMLElement)) return;

    btn.addEventListener("click", () => {
      const open = !fan.classList.contains("is-open");
      fan.classList.toggle("is-open", open);
      btn.classList.toggle("is-active", open);
      btn.setAttribute("aria-expanded", open ? "true" : "false");
      fan.setAttribute("aria-hidden", open ? "false" : "true");
    });

    root.querySelectorAll("[data-about-pop-mail]").forEach((el) => {
      el.addEventListener("click", (e) => {
        if (!(el instanceof HTMLAnchorElement)) return;
        const encoded = el.getAttribute("data-encoded-email");
        if (!encoded) return;
        e.preventDefault();
        el.href = `mailto:${atob(encoded)}`;
        el.removeAttribute("data-encoded-email");
        el.click();
      });
    });
  }

  function init() {
    document.querySelectorAll("[data-about-pop-card]").forEach(bindAboutPopCard);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
  document.addEventListener("swup:contentReplaced", () => {
    setTimeout(init, 30);
  });
</script>

<style>
  .about-pop-card {
    --apc-bar-w: 15.25rem;
    --apc-bar-h: 5.35rem;
    --apc-photo: 5.35rem;
    --apc-surface: color-mix(in oklab, var(--card-bg) 92%, transparent);
    --apc-ink: var(--deep-text);
    --apc-muted: color-mix(in oklab, var(--content-meta) 90%, transparent);
    --apc-line: color-mix(in oklab, var(--line-color), transparent);
    --apc-shadow: color-mix(in oklab, var(--deep-text) 10%, transparent);
    --apc-ease: cubic-bezier(0.22, 1, 0.36, 1);
    /* 右侧条：偏线性，避免 ease-out 前半段几乎不动 */
    --apc-unroll-ease: cubic-bezier(0.33, 0.05, 0.25, 1);
    --apc-unroll: 2.9s;

    position: relative;
    width: calc(var(--apc-photo) * 0.55 + var(--apc-bar-w) + 6.5rem);
    max-width: 100%;
    min-height: calc(var(--apc-bar-h) + 1.25rem);
    display: flex;
    align-items: center;
    padding: 0.55rem 0.25rem;
    flex-shrink: 0;
    color: var(--apc-ink);
  }

  :global(:root.dark) .about-pop-card {
    --apc-surface: color-mix(in oklab, var(--card-bg) 88%, transparent);
    --apc-shadow: color-mix(in oklab, black 40%, transparent);
  }

  .about-pop-card__row {
    display: flex;
    align-items: center;
    position: relative;
  }

  /* —— 头像：独立旋转 —— */
  .about-pop-card__photo {
    position: relative;
    z-index: 3;
    width: var(--apc-photo);
    height: var(--apc-photo);
    flex-shrink: 0;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid color-mix(in oklab, var(--card-bg) 70%, var(--line-color));
    background: var(--apc-surface);
    margin-right: calc(var(--apc-photo) * -0.42);
    box-shadow: 0 6px 16px -8px var(--apc-shadow);
  }

  .about-pop-card.is-enter .about-pop-card__photo {
    animation: about-pop-rotate-photo 1.8s var(--apc-ease) 0.15s both;
  }

  @keyframes about-pop-rotate-photo {
    from {
      transform: rotate(-24deg);
      opacity: 0.5;
    }
    to {
      transform: rotate(-360deg);
      opacity: 1;
    }
  }

  .about-pop-card__photo :global(img),
  .about-pop-card__avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /*
   * 右侧条 = 要卷开的主体（联系我 / 名字 / 分享钮）。
   * width 从 0 → 满宽 + overflow 裁切，从头像旁往右缓缓展开。
   */
  .about-pop-card__bar {
    position: relative;
    z-index: 1;
    height: var(--apc-bar-h);
    width: 0;
    overflow: hidden;
    border-radius: 1.1rem;
    background: var(--apc-surface);
    backdrop-filter: blur(10px) saturate(1.02);
    border: 1px solid transparent;
    box-shadow: none;
    transform-origin: left center;
    will-change: width;
  }

  .about-pop-card__bar-inner {
    width: var(--apc-bar-w);
    height: var(--apc-bar-h);
    display: flex;
    align-items: center;
    box-sizing: border-box;
    padding: 0.55rem 0.7rem 0.55rem 2.55rem;
  }

  .about-pop-card__rule {
    position: absolute;
    left: 2.2rem;
    top: 0.85rem;
    bottom: 0.85rem;
    width: 2px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--primary) 55%, transparent);
  }

  .about-pop-card__text {
    min-width: 0;
    flex: 1;
    padding-right: 0.45rem;
  }

  .about-pop-card__title,
  .about-pop-card__sub,
  .about-pop-card__hint {
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.25;
  }

  .about-pop-card__title {
    font-family: ui-monospace, "JetBrains Mono", Menlo, Consolas, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--primary);
    font-weight: 600;
  }

  .about-pop-card__sub {
    margin-top: 0.2rem;
    font-size: 0.98rem;
    font-weight: 650;
    color: var(--apc-ink);
  }

  .about-pop-card__hint {
    margin-top: 0.18rem;
    font-size: 0.68rem;
    color: var(--apc-muted);
  }

  .about-pop-card__btn {
    appearance: none;
    border: 1px solid color-mix(in oklab, var(--primary) 28%, var(--line-color));
    background: color-mix(in oklab, var(--primary) 8%, var(--card-bg));
    color: var(--primary);
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 999px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .about-pop-card__btn:hover {
    background: color-mix(in oklab, var(--primary) 14%, var(--card-bg));
    border-color: color-mix(in oklab, var(--primary) 45%, var(--line-color));
  }

  .about-pop-card__btn:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .about-pop-card__btn.is-active {
    background: color-mix(in oklab, var(--primary) 18%, var(--card-bg));
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary) 16%, transparent);
  }

  .about-pop-card__btn-icon {
    width: 1.05rem;
    height: 1.05rem;
  }

  .about-pop-card__box {
    opacity: 0;
    pointer-events: none;
    border-radius: 50%;
    background-color: color-mix(in oklab, var(--apc-surface) 85%, transparent);
    position: absolute;
    top: 50%;
    right: -1.1rem;
    transform: translate(50%, -50%);
    transition: opacity 0.3s ease;
    box-shadow: 0 0 0 1px var(--apc-line);
    border: 3px solid color-mix(in oklab, var(--card-bg) 80%, var(--line-color));
    z-index: 2;
  }

  .about-pop-card__box::after {
    content: "";
    display: block;
    width: 5.75rem;
    height: 5.75rem;
    border-radius: 50%;
    background: radial-gradient(
      circle at 40% 35%,
      color-mix(in oklab, var(--primary) 12%, transparent),
      transparent 65%
    );
  }

  .about-pop-card__link {
    width: 2.55rem;
    height: 2.55rem;
    border-radius: 50%;
    font-size: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    left: 0.85rem;
    top: calc(2.85rem - 1.25rem);
    border: 1px solid var(--apc-line);
    color: var(--deep-text);
    background-color: var(--apc-surface);
    transition-duration: 0.3s;
    text-decoration: none;
    opacity: 0;
  }

  .about-pop-card__link:hover {
    transition-delay: 0s !important;
    border-color: color-mix(in oklab, var(--primary) 40%, var(--line-color));
    background-color: color-mix(in oklab, var(--primary) 12%, var(--card-bg));
    color: var(--primary);
  }

  .about-pop-card__box.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .about-pop-card__box.is-open .about-pop-card__link {
    left: 0.95rem;
    opacity: 1;
  }

  .about-pop-card__box.is-open .about-pop-card__link:nth-of-type(1) {
    transform: rotate(-90deg) translateX(5.4rem) rotate(90deg);
    transition-delay: 0s;
  }
  .about-pop-card__box.is-open .about-pop-card__link:nth-of-type(2) {
    transform: rotate(-45deg) translateX(5.4rem) rotate(45deg);
    transition-delay: 0.1s;
  }
  .about-pop-card__box.is-open .about-pop-card__link:nth-of-type(3) {
    transform: rotate(0deg) translateX(5.85rem) rotate(0deg);
    transition-delay: 0.2s;
  }
  .about-pop-card__box.is-open .about-pop-card__link:nth-of-type(4) {
    transform: rotate(45deg) translateX(5.4rem) rotate(-45deg);
    transition-delay: 0.3s;
  }
  .about-pop-card__box.is-open .about-pop-card__link:nth-of-type(5) {
    transform: rotate(90deg) translateX(5rem) rotate(-90deg);
    transition-delay: 0.4s;
  }

  @media (max-width: 720px) {
    .about-pop-card {
      width: 100%;
      justify-content: flex-start;
      padding-right: 4.5rem;
    }

    .about-pop-card__bar {
      flex: 1;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .about-pop-card.is-enter .about-pop-card__photo,
    .about-pop-card.is-enter .about-pop-card__bar {
      animation: none;
    }

    .about-pop-card__bar {
      width: var(--apc-bar-w);
      border-color: var(--apc-line);
      box-shadow: 0 10px 28px -14px var(--apc-shadow);
    }
  }
</style>
