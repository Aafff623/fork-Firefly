---
/**
 * 层层海浪背景 — 改编自 bilibili-goat `categories/effects/层层海浪`
 * 创新：主题色系、构建期确定性分层、顶部雾面保证可读、减弱动效降层。
 */

interface Wave {
	x: number;
	y: number;
	opacity: number;
	duration: string;
}

/** 简易确定性伪随机，避免每次构建海浪乱跳 */
function mulberry32(seed: number) {
	return () => {
		let t = (seed += 0x6d2b79f5);
		t = Math.imul(t ^ (t >>> 15), t | 1);
		t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}

const rand = mulberry32(20260802);
const WAVE_COUNT = 14;

const waves: Wave[] = Array.from({ length: WAVE_COUNT }, (_, i) => ({
	x: rand() * 100 - 50,
	y: -4 - i * 2.6 + rand() * 6 - 3,
	opacity: 0.12 + rand() * 0.28,
	duration: `${(8 + rand() * 16).toFixed(1)}s`,
}));
---

<div class="about-waves" data-about-waves aria-hidden="true">
  <div class="about-waves__sky"></div>
  <svg
    class="about-waves__svg"
    viewBox="0 0 1000 400"
    preserveAspectRatio="none"
    focusable="false"
  >
    <defs>
      <path
        id="about-wave-shape"
        d="M 0 2000 0 300 Q 120 220 300 300 t 300 0 300 0 300 0 300 0 300 0 v400 z"
      ></path>
      <path id="about-wave-path" d="M -600 0 0 0"></path>
      <linearGradient id="about-wave-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="white" stop-opacity="0"></stop>
        <stop offset="35%" stop-color="white" stop-opacity="0.55"></stop>
        <stop offset="100%" stop-color="white" stop-opacity="1"></stop>
      </linearGradient>
      <mask id="about-wave-mask">
        <rect width="1000" height="400" fill="url(#about-wave-fade)"></rect>
      </mask>
    </defs>
    <g id="about-waves-layer" mask="url(#about-wave-mask)">
      {
        waves.map((w) => (
          <use
            href="#about-wave-shape"
            x={w.x}
            y={w.y}
            fill="currentColor"
            opacity={w.opacity}
          >
            <animateMotion dur={w.duration} repeatCount="indefinite">
              <mpath href="#about-wave-path"></mpath>
            </animateMotion>
          </use>
        ))
      }
    </g>
  </svg>
</div>

<style>
  .about-waves {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    border-radius: inherit;
  }

  .about-waves__sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        120% 80% at 15% 0%,
        color-mix(in oklab, var(--primary) 14%, transparent),
        transparent 55%
      ),
      linear-gradient(
        180deg,
        color-mix(in oklab, var(--card-bg) 88%, transparent) 0%,
        color-mix(in oklab, var(--primary) 6%, var(--card-bg)) 55%,
        color-mix(in oklab, #3b82f6 10%, var(--card-bg)) 100%
      );
  }

  :global(:root.dark) .about-waves__sky {
    background:
      radial-gradient(
        120% 80% at 15% 0%,
        color-mix(in oklab, var(--primary) 18%, transparent),
        transparent 55%
      ),
      linear-gradient(
        180deg,
        color-mix(in oklab, var(--card-bg) 92%, #0b1220) 0%,
        color-mix(in oklab, var(--primary) 10%, #0f172a) 60%,
        color-mix(in oklab, #1d4ed8 16%, #0b1220) 100%
      );
  }

  .about-waves__svg {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -8%;
    width: 100%;
    height: 72%;
    color: color-mix(in oklab, var(--primary) 72%, #38bdf8);
    opacity: 0.9;
  }

  :global(:root.dark) .about-waves__svg {
    color: color-mix(in oklab, var(--primary) 65%, #60a5fa);
    opacity: 0.85;
  }

  @media (prefers-reduced-motion: reduce) {
    .about-waves__svg animateMotion {
      display: none;
    }

    .about-waves__svg {
      opacity: 0.55;
    }
  }
</style>
