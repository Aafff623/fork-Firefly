---
/**
 * 3D 翻页漫画 — 改编自 bilibili-goat `categories/effects/3D翻页漫画`
 * 纸质分镜进视口后再挂 background，避免首屏拖垮。
 * 角色：骑士少女延续（纸质漫感 + 终端像素）
 */
const pages = [
	{ cls: "b", i: 2, s: undefined as number | undefined, src: "/assets/images/about/flip-comic/panel-01.webp" },
	{ cls: "c", i: 4, s: 1, src: "/assets/images/about/flip-comic/panel-02.webp" },
	{ cls: "d", i: 3, s: 2, src: "/assets/images/about/flip-comic/panel-03.webp" },
	{ cls: "e", i: 2, s: 3, src: "/assets/images/about/flip-comic/panel-04.webp" },
	{ cls: "f", i: 1, s: 4, src: "/assets/images/about/flip-comic/panel-05.webp" },
];
---

<div class="about-flip" data-about-flip id="about-flip-root">
  <div class="about-flip__stage" aria-label="3D 翻页漫画，悬停或点击翻页">
    <div class="about-flip__book" tabindex="0" role="button" aria-pressed="false" aria-label="翻开漫画">
      {
        pages.map((p) => (
          <div
            class:list={["about-flip__page", `about-flip__page--${p.cls}`]}
            style={`--i:${p.i};${p.s !== undefined ? `--s:${p.s};` : ""}`}
            data-bg={p.src}
          />
        ))
      }
    </div>
  </div>
  <p class="about-flip__hint" data-about-flip-hint>悬停或点击翻页</p>
</div>

<style is:global>
  .about-flip {
    margin: 1.25rem 0 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    content-visibility: auto;
    contain-intrinsic-size: auto 22rem;
  }

  .about-flip__stage {
    width: 100%;
    max-width: 28rem;
    min-height: 22rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem 2.5rem;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in oklab, var(--line-color), transparent);
    /* 多色氛围：青 + 琥珀 + 淡紫，不再单紫铺底 */
    background:
      radial-gradient(
        circle at 22% 18%,
        color-mix(in oklab, #0d9488 22%, transparent),
        transparent 48%
      ),
      radial-gradient(
        circle at 78% 72%,
        color-mix(in oklab, #d97706 16%, transparent),
        transparent 50%
      ),
      radial-gradient(
        circle at 55% 40%,
        color-mix(in oklab, var(--primary) 10%, transparent),
        transparent 55%
      ),
      color-mix(in oklab, #334155 8%, var(--card-bg));
    overflow: visible;
  }

  :root.dark .about-flip__stage {
    background:
      radial-gradient(
        circle at 22% 18%,
        color-mix(in oklab, #2dd4bf 18%, transparent),
        transparent 48%
      ),
      radial-gradient(
        circle at 78% 72%,
        color-mix(in oklab, #fbbf24 12%, transparent),
        transparent 50%
      ),
      radial-gradient(
        circle at 55% 40%,
        color-mix(in oklab, var(--primary) 14%, transparent),
        transparent 55%
      ),
      color-mix(in oklab, #1e293b 55%, #0f172a);
  }

  .about-flip__book {
    --book-w: min(15rem, 58vw);
    --book-h: calc(var(--book-w) * 1.48);
    width: var(--book-w);
    height: var(--book-h);
    position: relative;
    transform-style: preserve-3d;
    perspective: 1000px;
    transition: transform 0.8s ease;
    /* 合上时偏右：展开向左翻页后整体视觉居中 */
    margin-right: 0;
    transform: translateX(2.75rem);
    cursor: pointer;
    outline: none;
  }

  .about-flip__book:focus-visible {
    box-shadow: 0 0 0 3px color-mix(in oklab, #0d9488 45%, transparent);
    border-radius: 0.35rem;
  }

  .about-flip__page {
    width: var(--book-w);
    height: calc(var(--book-h) - 1.1rem);
    position: absolute;
    transform-origin: left center;
    background-color: color-mix(in oklab, var(--card-bg) 70%, #576574);
    background-size: cover;
    background-position: center;
    transition: transform calc(var(--i) * 0.3s), z-index 0s;
    z-index: calc(var(--i) * 99);
    box-shadow: 0 6px 18px color-mix(in oklab, black 18%, transparent);
  }

  .about-flip__page--b,
  .about-flip__page--c {
    border: solid 14px #576574;
    border-left: none;
    top: -12px;
    border-radius: 0 14px 14px 0;
    height: var(--book-h);
  }

  .about-flip__book:hover .about-flip__page--b,
  .about-flip__book.is-open .about-flip__page--b {
    border-left: 14px solid #576574;
  }

  .about-flip__book:hover .about-flip__page--c,
  .about-flip__book:hover .about-flip__page--d,
  .about-flip__book:hover .about-flip__page--e,
  .about-flip__book:hover .about-flip__page--f,
  .about-flip__book.is-open .about-flip__page--c,
  .about-flip__book.is-open .about-flip__page--d,
  .about-flip__book.is-open .about-flip__page--e,
  .about-flip__book.is-open .about-flip__page--f {
    transform: rotateY(-180deg);
    transition: transform calc(var(--s) * 0.4s);
    z-index: calc(var(--s) * -99);
  }

  .about-flip__book:hover,
  .about-flip__book.is-open {
    /* 翻开后继续右移，补偿页面向左展开，使展开态居中 */
    transform: translateX(5.25rem);
  }

  .about-flip__hint {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--content-meta) 75%, transparent);
    font-family: ui-monospace, "JetBrains Mono", Menlo, Consolas, monospace;
  }

  @media (max-width: 640px) {
    .about-flip__stage {
      min-height: 18rem;
      padding: 1rem 1.25rem;
    }

    .about-flip__book {
      margin-right: 0;
      transform: translateX(1.35rem);
    }

    .about-flip__book:hover,
    .about-flip__book.is-open {
      transform: translateX(2.85rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-flip__book,
    .about-flip__page {
      transition: none !important;
    }

    .about-flip__book:hover,
    .about-flip__book.is-open {
      transform: translateX(2.75rem);
    }

    .about-flip__book:hover .about-flip__page--c,
    .about-flip__book:hover .about-flip__page--d,
    .about-flip__book:hover .about-flip__page--e,
    .about-flip__book:hover .about-flip__page--f,
    .about-flip__book.is-open .about-flip__page--c,
    .about-flip__book.is-open .about-flip__page--d,
    .about-flip__book.is-open .about-flip__page--e,
    .about-flip__book.is-open .about-flip__page--f {
      transform: none;
    }
  }
</style>

<script>
  function loadFlipBgs(root: HTMLElement) {
    if (root.dataset.bgLoaded === "1") return;
    root.dataset.bgLoaded = "1";
    root.querySelectorAll<HTMLElement>("[data-bg]").forEach((el) => {
      const src = el.dataset.bg;
      if (!src) return;
      el.style.backgroundImage = `url(${src})`;
      el.removeAttribute("data-bg");
    });
  }

  function bindFlip(root: Element) {
    if (!(root instanceof HTMLElement) || root.dataset.bound === "1") return;
    root.dataset.bound = "1";

    const book = root.querySelector(".about-flip__book");
    if (!(book instanceof HTMLElement)) return;

    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          loadFlipBgs(root);
          io.disconnect();
        }
      },
      { rootMargin: "120px" },
    );
    io.observe(root);

    const setOpen = (open: boolean) => {
      book.classList.toggle("is-open", open);
      book.setAttribute("aria-pressed", open ? "true" : "false");
    };

    book.addEventListener("click", () => {
      loadFlipBgs(root);
      setOpen(!book.classList.contains("is-open"));
    });

    book.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" && e.key !== " ") return;
      e.preventDefault();
      loadFlipBgs(root);
      setOpen(!book.classList.contains("is-open"));
    });

    const hint = root.querySelector("[data-about-flip-hint]");
    if (hint && window.matchMedia("(hover: none)").matches) {
      hint.textContent = "点击翻页";
    }
  }

  function init() {
    document.querySelectorAll("[data-about-flip]").forEach(bindFlip);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
  document.addEventListener("swup:contentReplaced", () => setTimeout(init, 40));
</script>
