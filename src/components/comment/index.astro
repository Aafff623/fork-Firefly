---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { commentConfig } from "@/config/commentConfig";
import Key from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { CommentConfig } from "@/types/commentConfig";
import { toPostSlug } from "@/utils/url-utils";

interface Props {
	post?: CollectionEntry<"posts"> | CollectionEntry<"spec">;
	customPath?: string;
	title?: string;
	/** 页面级后端覆盖；动态时间线用它保留 Waline，避免全局 Giscus 破坏逐条回复。 */
	service?: CommentConfig["type"];
}

const { post, customPath, title: customTitle, service } = Astro.props as Props;

// 根据页面类型确定路径
const slugFromPath = (customPath || "/").replace(/^\/+|\/+$/g, "") || "index";
const slug = post ? toPostSlug(post.id) : slugFromPath;
const path = customPath
	? customPath
	: post
		? post.collection === "posts"
			? `/posts/${slug}`
			: `/${slug}`
		: `/${slug}`;
const url = `${Astro.site?.href}${path}`;
const postTitle = post && "title" in post.data ? post.data.title : undefined;

const commentService: CommentConfig["type"] =
	service ?? commentConfig?.type ?? "none";

// 只载入当前页面实际使用的评论实现，避免 Giscus 文章携带 Waline CSS/JS。
const Artalk =
	commentService === "artalk" ? (await import("./Artalk.astro")).default : null;
const Disqus =
	commentService === "disqus" ? (await import("./Disqus.astro")).default : null;
const Giscus =
	commentService === "giscus" ? (await import("./Giscus.astro")).default : null;
const Twikoo =
	commentService === "twikoo" ? (await import("./Twikoo.astro")).default : null;
const Waline =
	commentService === "waline" ? (await import("./Waline.astro")).default : null;
---

{
  commentService !== "none" && (
    <div id="post-comments" class="card-base p-8 mb-6 relative overflow-hidden">
      <!-- 评论区装饰性背景 -->
      <div class="absolute top-0 right-0 w-32 h-32 opacity-5 pointer-events-none">
        <svg viewBox="0 0 100 100" class="w-full h-full">
          <circle cx="50" cy="50" r="40" fill="currentColor" class="text-(--primary)" />
          <circle cx="50" cy="50" r="25" fill="none" stroke="currentColor" stroke-width="2" class="text-(--primary)" />
          <circle cx="50" cy="50" r="10" fill="currentColor" class="text-(--primary)" />
        </svg>
      </div>
      <!-- 评论区标题 -->
      <div class="relative z-10 mb-6">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-1 h-6 bg-linear-to-b from-(--primary) to-transparent rounded-full"></div>
          <Icon is:inline name="lucide:message-circle" class="text-xl text-(--primary)" aria-hidden="true" />
          <h3 class="text-xl font-bold text-(--btn-content)">{i18n(Key.commentSection)}</h3>
        </div>
        <p class="text-sm text-(--content-meta) ml-4">{i18n(Key.commentSubtitle)}</p>
      </div>
      <!-- 评论内容区域 -->
      <div class="relative z-10 pl-2 pr-2">
        {Twikoo && <Twikoo path={path} />}
        {Waline && <Waline path={path} />}
        {Giscus && <Giscus />}
        {Disqus && <Disqus identifier={slug} url={url} title={customTitle || postTitle || slug} />}
        {Artalk && <Artalk path={path} />}
        {commentService === "none" && (
          <div class="text-center py-8 text-(--content-meta)">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-(--btn-regular-bg) flex items-center justify-center">
              <Icon is:inline name="lucide:message-circle" class="w-8 h-8 text-(--primary)" aria-hidden="true" />
            </div>
            <p>{i18n(Key.commentNotConfigured)}</p>
          </div>
        )}
      </div>
    </div>
  )
}
