---
import "@waline/client/waline.css";
import { commentConfig } from "@/config";
import { url as siteUrl } from "@/utils/url-utils";
import stickerSuggestStyles from "./sticker-suggest/sticker-suggest.css?url";

interface Props {
	path: string;
}

const uploadApi = siteUrl("/api/comment-image/");

const stickerCfg = commentConfig.waline?.stickerSuggest;
const stickerSuggestEnabled = stickerCfg?.enabled === true;
const stickerSuggestBoot = stickerSuggestEnabled
	? {
			endpoint: siteUrl(
				stickerCfg?.endpoint || "/api/comment-sticker-suggest/",
			),
			debounceMs: stickerCfg?.debounceMs ?? 300,
			minChars: stickerCfg?.minChars ?? 2,
			maxResults: stickerCfg?.maxResults ?? 6,
		}
	: null;

const config = {
	...commentConfig.waline,
	el: "#waline",
	path: Astro.props.path,
	dark: "html.dark",
	// 默认开启表情搜索（Giphy）；勿设 search: false
	...(commentConfig.waline?.visitorCount ? { pageview: true } : {}),
};
// stickerSuggest 仅给旁挂用，勿传入 Waline.init
delete (config as { stickerSuggest?: unknown }).stickerSuggest;
---
<!--
  微信式单框：不默认开预览、并隐藏预览按钮。
  原因：Waline 客户端预览用轻量 marked，自定义表情短码/部分语法预览不渲染；
  提交后由服务端 markdown-it 才正确出图（官方文档「有限的预览支持」）。
-->
<div
  class="relative w-full waline-shell"
  data-waline-config={JSON.stringify(config)}
  data-upload-api={uploadApi}
  data-sticker-suggest={stickerSuggestBoot ? JSON.stringify(stickerSuggestBoot) : undefined}
>
  <p class="waline-hint">
    像发消息一样写就好：点工具栏插入表情 / 图片，表情会直接显示。插图 ≤5MB。
  </p>
  <div class="waline-loading" aria-hidden="true">
    <div class="waline-loading-editor"></div>
    <div class="waline-loading-lines">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>
  <div id="waline"></div>
  {stickerSuggestEnabled && <link rel="stylesheet" href={stickerSuggestStyles} />}
  <script>
    import {
      bootWalineFromShell,
      registerWalineSwupHooks,
    } from "@/lib/waline-boot";

    registerWalineSwupHooks();
    bootWalineFromShell();
  </script>
  {
    stickerSuggestEnabled && (
      <script>
        import { attachStickerSuggestFromShell } from "./sticker-suggest/attach";
        // 等 Waline init 旁挂编辑器后再挂联想层 // 中文注释
        const boot = () => attachStickerSuggestFromShell();
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", () => setTimeout(boot, 0));
        } else {
          setTimeout(boot, 0);
        }
        // Swup 等软导航后可能重建评论区 // 中文注释
        document.addEventListener("swup:page:view", () => setTimeout(boot, 50));
      </script>
    )
  }
  <script>
    import { attachAgentAvatars } from "./agent-avatar";
    // agent 协作者评论：按昵称映射本地头像 // 中文注释
    const bootAvatars = () => attachAgentAvatars();
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => setTimeout(bootAvatars, 0));
    } else {
      setTimeout(bootAvatars, 0);
    }
    // Swup 等软导航后可能重建评论区 // 中文注释
    document.addEventListener("swup:page:view", () => setTimeout(bootAvatars, 50));
  </script>
</div>

<style is:global>
  /* 评论区字号 / 插图比例：覆盖 Waline 默认偏小编辑字号与未限宽插图 */
  .waline-shell {
    --waline-font-size: 1.05rem;
  }

  /* 昵称 / 邮箱 / 网址：强制一行三列，别叠成三层高楼 */
  .waline-shell .wl-header {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: stretch;
    gap: 0.45rem;
    margin: 0 0 0.35rem;
  }

  .waline-shell .wl-header-item {
    flex: 1 1 0 !important;
    width: auto !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0.15rem 0 !important;
    border-bottom: none !important;
  }

  .waline-shell .wl-header label {
    display: block;
    margin: 0 0 0.15rem;
    font-size: 0.72rem;
    line-height: 1.2;
    opacity: 0.78;
  }

  .waline-shell .wl-header input {
    width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box;
    font-size: 0.86rem !important;
    line-height: 1.35;
    padding: 0.28rem 0.4rem !important;
  }

  /* agent 协作者评论：头像加品牌色 ring 作身份标识 */
  .waline-shell .wl-card.agent-claude-code .wl-avatar,
  .waline-shell .wl-card.agent-kimi-code .wl-avatar,
  .waline-shell .wl-card.agent-cursor .wl-avatar,
  .waline-shell .wl-card.agent-pi .wl-avatar,
  .waline-shell .wl-card.agent-opencode .wl-avatar,
  .waline-shell .wl-card.agent-codex .wl-avatar {
    outline: 2px solid color-mix(in srgb, var(--primary, #8b5cf6) 55%, transparent);
    outline-offset: 1px;
  }

  /* agent 头像已是圆形 PNG：强制圆罩 + 铺满，避免方块套圆 */
  .waline-shell .wl-avatar,
  .waline-shell .wl-avatar img {
    border-radius: 50% !important;
    overflow: hidden;
  }
  .waline-shell .wl-avatar img {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  /*
   * 暗色：Waline 默认不少节点继承 #000（#waline / .wl-comment / 表头标签等），
   * 叠在深色 card 上会「黑字撞黑底」。变量 + 容器底色一起拉白。
   */
  html.dark .waline-shell,
  html.dark .waline-shell #waline {
    --waline-white: #fff;
    --waline-light-grey: rgb(255 255 255 / 0.72);
    --waline-dark-grey: rgb(255 255 255 / 0.88);
    --waline-color: rgb(255 255 255 / 0.92);
    --waline-bgcolor: transparent;
    --waline-bgcolor-light: rgb(255 255 255 / 0.06);
    --waline-bgcolor-hover: rgb(255 255 255 / 0.1);
    --waline-border-color: rgb(255 255 255 / 0.14);
    --waline-disable-bgcolor: rgb(255 255 255 / 0.06);
    --waline-disable-color: rgb(255 255 255 / 0.45);
    --waline-code-bgcolor: rgb(255 255 255 / 0.08);
    --waline-info-bgcolor: rgb(255 255 255 / 0.06);
    --waline-info-color: rgb(255 255 255 / 0.62);
    color: var(--waline-color);
  }

  /* 切断黑字继承：评论壳、编辑区、列表区、卡片正文 */
  html.dark .waline-shell #waline,
  html.dark .waline-shell .wl-comment,
  html.dark .waline-shell .wl-panel,
  html.dark .waline-shell .wl-header,
  html.dark .waline-shell .wl-header-item,
  html.dark .waline-shell .wl-footer,
  html.dark .waline-shell .wl-info,
  html.dark .waline-shell .wl-meta-head,
  html.dark .waline-shell .wl-meta-foot,
  html.dark .waline-shell .wl-sort,
  html.dark .waline-shell .wl-rss,
  html.dark .waline-shell .wl-cards,
  html.dark .waline-shell .wl-card,
  html.dark .waline-shell .wl-card-item {
    color: var(--waline-color);
  }

  html.dark .waline-shell .wl-empty,
  html.dark .waline-shell .wl-sort li,
  html.dark .waline-shell .wl-text,
  html.dark .waline-shell .wl-count,
  html.dark .waline-shell .wl-power,
  html.dark .waline-shell .wl-text-number,
  html.dark .waline-shell .wl-meta,
  html.dark .waline-shell .wl-time,
  html.dark .waline-shell label {
    color: var(--waline-light-grey) !important;
  }

  html.dark .waline-shell .wl-sort li.active {
    color: var(--waline-theme-color, var(--primary, #27ae60)) !important;
  }

  /* 正文评论：强制浅色，避免 Markdown 子节点带回黑字 */
  html.dark .waline-shell .wl-card .wl-nick,
  html.dark .waline-shell .wl-card .wl-content,
  html.dark .waline-shell .wl-card .wl-content p,
  html.dark .waline-shell .wl-card .wl-content span,
  html.dark .waline-shell .wl-card .wl-content li,
  html.dark .waline-shell .wl-card .wl-content blockquote,
  html.dark .waline-shell .wl-card .wl-quote {
    color: var(--waline-color) !important;
  }

  html.dark .waline-shell .wl-card .wl-content a {
    color: var(--waline-theme-color, var(--primary, #7dd3a0));
  }

  html.dark .waline-shell .wl-editor,
  html.dark .waline-shell .wl-input {
    color: var(--waline-color) !important;
    background: var(--waline-bgcolor-light);
    -webkit-text-fill-color: var(--waline-color);
  }

  html.dark .waline-shell .wl-editor::placeholder,
  html.dark .waline-shell .wl-input::placeholder {
    color: rgb(255 255 255 / 0.48);
    -webkit-text-fill-color: rgb(255 255 255 / 0.48);
  }

  /* 视觉层镜像（短码→表情）也跟暗色字色 */
  html.dark .waline-shell .waline-editor-visual {
    color: var(--waline-color);
  }

  html.dark .waline-shell .waline-hint {
    color: rgb(255 255 255 / 0.6);
  }

  .waline-shell .wl-editor {
    position: relative;
    z-index: 2;
    font-size: 1rem !important;
    line-height: 1.65;
    min-height: 6.5em;
  }

  /* textarea 保留短码作为提交原文，视觉层把已知短码即时替换成图片。 */
  .waline-shell .waline-editor-visual-host {
    position: relative;
  }

  /* 评论编辑器默认保持轻量，点击或获得焦点后恢复完整编辑状态。 */
  .waline-shell .waline-editor-collapsible {
    transition: box-shadow 180ms ease, border-color 180ms ease;
  }

  .waline-shell .waline-editor-collapsible:not(.waline-editor-expanded) .wl-header {
    max-height: 0;
    margin: 0;
    padding-block: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: max-height 180ms ease, opacity 140ms ease, padding 180ms ease;
  }

  .waline-shell .waline-editor-collapsible:not(.waline-editor-expanded) .wl-editor {
    min-height: 2.9em !important;
    height: 2.9em !important;
    max-height: 2.9em;
    overflow: hidden;
  }

  .waline-shell .waline-editor-collapsible:not(.waline-editor-expanded) .wl-info .wl-btn {
    display: none;
  }

  .waline-shell .waline-editor-collapsible:not(.waline-editor-expanded) .wl-footer {
    padding-top: 0.35rem;
  }

  .waline-shell .waline-editor-collapsible.waline-editor-expanded {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--primary, #8b5cf6) 12%, transparent);
  }

  .waline-shell .waline-editor-visual {
    position: absolute;
    z-index: 1;
    box-sizing: border-box;
    pointer-events: none;
    color: var(--waline-color);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .waline-shell .waline-editor-visual-active .wl-editor {
    background: transparent !important;
    color: transparent !important;
    -webkit-text-fill-color: transparent;
    caret-color: transparent;
    text-decoration: none !important;
  }

  .waline-shell .waline-editor-visual-active .wl-editor::selection {
    background: transparent !important;
    color: transparent !important;
  }

  .waline-shell .waline-editor-visual-selection {
    background: color-mix(in srgb, var(--primary, #8b5cf6) 18%, transparent);
    border-radius: 0.25em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .waline-shell .waline-editor-visual-uploading {
    display: inline-flex;
    align-items: center;
    min-height: 1.45em;
    padding: 0 0.45em;
    border: 1px solid color-mix(in srgb, var(--primary, #8b5cf6) 24%, transparent);
    border-radius: 0.35em;
    color: var(--waline-color-mute, #888);
    background: color-mix(in srgb, var(--primary, #8b5cf6) 8%, transparent);
    font-size: 0.9em;
  }

  .waline-shell .waline-editor-visual-uploading::before {
    content: none;
  }

  .waline-shell .waline-editor-visual-uploading-spinner {
    display: inline-block;
    flex: 0 0 0.8em;
    width: 0.8em;
    height: 0.8em;
    margin-right: 0.45em;
    border: 2px solid color-mix(in srgb, var(--primary, #8b5cf6) 24%, transparent);
    border-top-color: var(--primary, #8b5cf6);
    border-radius: 999px;
    animation: waline-upload-spin 0.8s linear infinite;
  }

  .waline-shell .waline-editor-visual-image {
    display: block;
    max-width: min(100%, 20rem);
    max-height: 12rem;
    width: auto;
    height: auto;
    margin: 0;
    border-radius: 0.45rem;
    object-fit: contain;
    vertical-align: middle;
  }

  .waline-shell .waline-editor-visual-image-wrap,
  .waline-shell .waline-editor-visual-uploading-wrap {
    position: relative;
    display: inline-block;
    max-width: min(100%, 20rem);
    margin: 0.75em 0 0.9em;
    vertical-align: top;
    pointer-events: none;
  }

  .waline-shell .waline-editor-visual-uploading-wrap {
    max-width: none;
  }

  .waline-shell .waline-editor-visual-image-remove {
    position: absolute;
    top: 0.2rem;
    right: 0.2rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.35rem;
    height: 1.35rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, #0f172a 72%, transparent);
    color: #fff;
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
    pointer-events: auto;
    opacity: 0.92;
  }

  .waline-shell .waline-editor-visual-image-remove:hover,
  .waline-shell .waline-editor-visual-image-remove:focus-visible {
    opacity: 1;
    background: color-mix(in srgb, #0f172a 88%, transparent);
    outline: none;
  }

  .waline-shell .waline-editor-visual-emoji {
    display: inline-block;
    width: 1.45em;
    height: 1.45em;
    margin: -0.15em 0.08em;
    vertical-align: middle;
    object-fit: contain;
  }

  .waline-shell .waline-editor-visual-caret {
    display: inline-block;
    width: 1px;
    height: 1.35em;
    margin: -0.15em 0.02em;
    vertical-align: text-bottom;
    background: currentColor;
    animation: waline-editor-caret-blink 1s step-end infinite;
  }

  @keyframes waline-editor-caret-blink {
    0%,
    45% {
      opacity: 1;
    }

    46%,
    100% {
      opacity: 0;
    }
  }

  @keyframes waline-upload-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* 强制隐藏预览入口与预览面板 */
  .waline-shell button.wl-action[title="预览"],
  .waline-shell button.wl-action[title="Preview"],
  .waline-shell button.wl-action[title="preview"],
  .waline-shell .wl-preview {
    display: none !important;
  }

  .waline-shell .wl-card .wl-content {
    font-size: 1rem;
    line-height: 1.65;
  }

  .waline-shell .wl-card .wl-content img {
    display: block;
    max-width: min(100%, 18rem);
    max-height: 13rem;
    width: auto;
    height: auto;
    object-fit: contain;
    margin: 0.5rem 0;
    border-radius: 0.45rem;
  }

  /* Waline 表情是图片节点，不能沿用普通插图的展示尺寸。 */
  .waline-shell .wl-card .wl-content img[src*="/emojis@"] {
    display: inline-block;
    width: 1.35em;
    height: 1.35em;
    max-width: 1.35em;
    max-height: 1.35em;
    margin: -0.12em 0.08em;
    border-radius: 0;
    object-fit: contain;
    vertical-align: middle;
  }

  .waline-shell .wl-emoji-popup img,
  .waline-shell .wl-gif-popup img {
    max-height: 4.5rem;
  }
</style>

<style>
  .waline-hint {
    margin: 0 0 0.55rem;
    padding: 0;
    border: none;
    border-radius: 0;
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--content-meta, #888);
    background: transparent;
  }

  .waline-hint code {
    font-size: 0.75rem;
    padding: 0.05rem 0.25rem;
    border-radius: 0.25rem;
    background: color-mix(in oklch, var(--card-bg, #fff) 70%, transparent);
  }

  .waline-shell:not(.waline-ready) #waline {
    visibility: hidden;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .waline-shell.waline-ready .waline-loading {
    display: none;
  }

  .waline-loading {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 0.25rem 0 0.5rem;
  }

  .waline-loading-editor {
    height: 3rem;
    border-radius: 0.65rem;
    background: linear-gradient(
      90deg,
      color-mix(in oklch, var(--card-bg, #fff) 88%, var(--primary, #8b5cf6) 12%) 0%,
      color-mix(in oklch, var(--card-bg, #fff) 72%, var(--primary, #8b5cf6) 28%) 50%,
      color-mix(in oklch, var(--card-bg, #fff) 88%, var(--primary, #8b5cf6) 12%) 100%
    );
    background-size: 200% 100%;
    animation: waline-loading-shimmer 1.1s ease-in-out infinite;
  }

  .waline-loading-lines {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .waline-loading-lines span {
    display: block;
    height: 0.72rem;
    border-radius: 999px;
    background: color-mix(in oklch, var(--line-divider, #ddd) 72%, transparent);
    animation: waline-loading-pulse 1.2s ease-in-out infinite;
  }

  .waline-loading-lines span:nth-child(1) {
    width: 92%;
  }

  .waline-loading-lines span:nth-child(2) {
    width: 78%;
    animation-delay: 0.12s;
  }

  .waline-loading-lines span:nth-child(3) {
    width: 64%;
    animation-delay: 0.24s;
  }

  @keyframes waline-loading-shimmer {
    0% {
      background-position: 100% 0;
    }

    100% {
      background-position: -100% 0;
    }
  }

  @keyframes waline-loading-pulse {
    0%,
    100% {
      opacity: 0.45;
    }

    50% {
      opacity: 0.9;
    }
  }
</style>
