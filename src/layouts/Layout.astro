      document.documentElement.style.setProperty("--content-delay", "0ms");

      // 同页链接点击不需要过渡保护
      const targetHref = el.getAttribute("href") || "";
      const targetPathname = (() => {
        try {
          return new URL(targetHref, window.location.href).pathname;
        } catch {
          return targetHref;
        }
      })();
      const isSamePage = pathsEqual(targetPathname, window.location.pathname);
      if (isSamePage) {
        document.documentElement.classList.remove("is-page-transitioning");
      }
      if (!isSamePage) {
        // 添加页面切换保护，防止导航栏闪烁
        document.documentElement.classList.add("is-page-transitioning");
      }

      const navbar = document.getElementById("navbar-wrapper");
      const topRow = document.getElementById("top-row");
      if (stickyNavbar && topRow) {
        topRow.classList.remove("navbar-scroll-hidden");
      } else if (bannerEnabled && navbar) {
        const threshold = window.innerHeight * (BANNER_HEIGHT_HOME / 100) - 88;
        if (document.documentElement.scrollTop >= threshold) {
          navbar.classList.add("navbar-hidden");
        }
      }
    });
    window.swup.hooks.replace(
      "page:load",
      async (
        visit: {
          meta: Record<string, unknown>;
        },
        args: unknown,
        defaultHandler?: (
          visit: unknown,
          args: unknown,
        ) => Promise<ArticlePrefetchResult>,
      ) => {
        if (!defaultHandler) throw new Error("Missing Swup page loader");
        const page = await defaultHandler(visit, args);
        if (visit.meta.fireflyDeferredArticleHistory !== true) return page;

        visit.meta.fireflyResolvedArticleUrl = page.url;
        return {
          ...page,
          // Swup normally updates history before renderPage(). Keep the visible URL on
          // the source page until content:replace commits the prepared article.
          url: String(visit.meta.fireflySourceArticleUrl),
        };
