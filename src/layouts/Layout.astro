      const mainGrid = document.getElementById("main-grid");
      if (mainGrid) {
        mainGrid.style.removeProperty("transition");
      }

      // 按落地 URL 再同步一次幕布状态（防缓存/回退偏差）
      syncCurtainFocusFromUrl(window.location.pathname);
      // DOM 重建：侧栏可见性缓存失效重测
      sidebarMetricsDirty = true;

      // 定位立刻对齐；侧栏测量 / overflow 进场后再做，缩短主栏透明窗
      applyWallpaperChrome();
      scheduleSidebarLayoutSync();
      scheduleContentOverflowEnhancements();

      // 文章页 TOC：进场后再 init，避免 replace 同步阻塞
      const tocWrapper = document.getElementById("toc-wrapper");
      if (tocWrapper) {
        const tocElement = document.querySelector("table-of-contents");
        if (tocElement && typeof (tocElement as any).init === "function") {
          window.setTimeout(() => {
            (tocElement as any).init();
          }, 120);
        }
      }

      const navbar = document.getElementById("navbar");
      if (navbar?.getAttribute("data-transparent-mode") === "semifull") {
        if (typeof (window as any).initSemifullScrollDetection === "function") {
          (window as any).initSemifullScrollDetection();
        }
      }

      // 在移动端恢复文章列表容器的过渡动画（在主内容区位置动画完成后）
      const isMobile = window.innerWidth < 1024;
      if (isMobile) {
        setTimeout(() => {
          const postListContainer = document.getElementById("post-list-container");
          if (postListContainer) {
            postListContainer.style.transition = "";
          }
        }, 600);
      }

      // 同步主题状态 - 解决从首页进入文章页面时代码块渲染问题
      const storedTheme = localStorage.getItem("theme") || siteConfig.themeColor.defaultMode || "light";
      let isDark = false;

      if (storedTheme === "system") {
        isDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      } else if (storedTheme === "time") {
        const tz = siteConfig.timezone || "Asia/Shanghai";
        const lightFrom = siteConfig.themeColor.timeSchedule?.lightFromHour ?? 7;
        const darkFrom = siteConfig.themeColor.timeSchedule?.darkFromHour ?? 19;
        // C：Intl.DateTimeFormat 贵在构造——会话级缓存，软导航不再逐次重建
        const hourFormatter = (timeThemeHourFormatter ??= new Intl.DateTimeFormat(
          "en-US",
          { timeZone: tz, hour: "numeric", hourCycle: "h23" },
        ));
        const hourPart = hourFormatter
          .formatToParts(new Date())
          .find((p) => p.type === "hour")?.value;
        const hour = Number(hourPart);
        isDark =
          Number.isFinite(hour) && (hour >= darkFrom || hour < lightFrom);
      } else {
        isDark = storedTheme === "dark";
      }

      const expectedTheme = isDark
        ? expressiveCodeConfig.darkTheme
        : expressiveCodeConfig.lightTheme;
      const currentTheme = document.documentElement.getAttribute("data-theme");

      if (currentTheme !== expectedTheme) {
        document.documentElement.setAttribute("data-theme", expectedTheme);
      }

      setTimeout(() => {
        if (document.getElementById("tcomment")) {
          document.dispatchEvent(
            new CustomEvent("firefly:page:loaded", {
