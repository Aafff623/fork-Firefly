    <!-- Font Setup (Astro Font API) -->
    <FontSetup />
    <!-- 文字斥力效果（agent-cfo DecodeHeadline 复刻），增强 .repel-text 元素 -->
    <RepelText />
  </head>
  <body
    class="min-h-screen"
    class:list={[
      {
        "is-home": isHomePageCheck,
        "lg:is-home": isHomePageCheck,
        "enable-banner": enableBanner,
        "sticky-navbar": siteConfig.navbar.stickyNavbar ?? false,
      },
    ]}
  >

    <div id="progress-bar"></div>

    {/* 卡片样式：面板未开放时强制站点默认，开放时才读 localStorage */}
    <script is:inline define:vars={{
      defaultBorder: siteConfig.card?.border ?? false,
      defaultFollowTheme: siteConfig.card?.followTheme ?? false,
      cardBorderSwitchable: displaySettingsConfig.cardBorderSwitchable,
      cardFollowThemeSwitchable: displaySettingsConfig.cardFollowThemeSwitchable,
    }}>
      (function() {
        var border = defaultBorder;
        if (cardBorderSwitchable) {
          var storedBorder = localStorage.getItem("cardBorderEnabled");
          if (storedBorder !== null) border = storedBorder === "true";
        }
        if (border) document.documentElement.classList.add("enable-card-border");
        else document.documentElement.classList.remove("enable-card-border");

        var follow = false;
        if (cardFollowThemeSwitchable) {
          var storedFollow = localStorage.getItem("cardFollowThemeEnabled");
          follow = storedFollow !== null ? storedFollow === "true" : defaultFollowTheme;
        }
        if (follow) document.body.classList.add("card-follow-theme-hue");
        else document.body.classList.remove("card-follow-theme-hue");
      })();
    </script>

    <!-- 页面顶部渐变高光效果 - 只在full和semifull模式下显示 -->
    {shouldShowTopHighlight && <div class="top-gradient-highlight" />}
    <ConfigCarrier />
    {musicPlayerConfig.enable !== false && <MusicManager />}
    <slot />



    <!-- Sakura Effect：嵌入页不要 Intro，否则点开评论 iframe 就满屏飘花 -->
    {!embed && <SakuraEffect />}

    {
      !embed && (
        <>
          <FancyboxManager />
          <NoteCardPreview />
          <CodeGroupManager />
        </>
      )
    }

    <script>
      // V7 hero 大图懒换（friends/guestbook/dynamic 等 .hero-bg 使用方）：
      // 首绘先用渐变兜底，LCP 落定 + idle 后再注回 --hero-img 真图，
      // 1.7-2.8MB 的 hero GIF 不再抢占首屏关键路径；swup 换页后重扫
      const armHeroBgDeferral = () => {
        const els = document.querySelectorAll(
          ".hero-bg:not([data-hero-armed])",
        );
        if (!els.length) return;
        const restore = (el: Element) => {
          el.setAttribute("data-hero-armed", "done");
          const val = (el as HTMLElement).dataset.heroImg;
          if (!val) return;
          (el as HTMLElement).style.setProperty("--hero-img", val);
          el.classList.remove("hero-img-deferred");
        };
        els.forEach((el) => {
          const val = getComputedStyle(el as HTMLElement)
            .getPropertyValue("--hero-img")
            .trim();
          el.setAttribute("data-hero-armed", "pending");
          if (!val || !val.includes("url(")) return; // 无底图使用方不处理
          (el as HTMLElement).dataset.heroImg = val;
          el.classList.add("hero-img-deferred");
          // 兜底图先行渲染；真图在 idle 后再拉（弱网下 GIF 到达晚也不挡首屏）
          const schedule =
            "requestIdleCallback" in window
              ? (cb: () => void) =>
                  (window as unknown as {
                    requestIdleCallback: (
                      cb: () => void,
                      o?: { timeout: number },
                    ) => number;
                  }).requestIdleCallback(cb, { timeout: 1200 })
              : (cb: () => void) => window.setTimeout(cb, 600);
          schedule(() => restore(el));
        });
      };
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", armHeroBgDeferral, {
          once: true,
        });
      } else {
        armHeroBgDeferral();
      }
      document.addEventListener("swup:page:view", armHeroBgDeferral);
    </script>
