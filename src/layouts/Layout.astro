        progressBar.classList.add("loading");
      }

    });
    // C：time 主题的小时格式化器会话级缓存（软导航复用，免逐次构造）
    let timeThemeHourFormatter: Intl.DateTimeFormat | null = null;
    window.swup.hooks.on("page:view", () => {
