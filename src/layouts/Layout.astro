}
*/

  const bannerEnabled = !!document.getElementById("wallpaper-wrapper");
  const stickyNavbar = siteConfig.navbar.stickyNavbar ?? false;

  function setClickOutsideToClose(panel: string, ignores: string[]) {
      document.addEventListener("click", (event) => {
          let panelDom = document.getElementById(panel);
          if (!panelDom) return;
          let tDom = event.target;
          if (!(tDom instanceof Node)) return; // Ensure the event target is an HTML Node
          for (let ig of ignores) {
              let ie = document.getElementById(ig);
              if (ie == tDom || ie?.contains(tDom)) {
                  return;
              }
          }
          panelDom.classList.add("float-panel-closed");
      });
  }
  setClickOutsideToClose("display-setting", [
    "display-setting",
    "display-settings-switch",
  ]);
  setClickOutsideToClose("nav-menu-panel", [
    "nav-menu-panel",
    "nav-menu-switch",
  ]);
  setClickOutsideToClose("search-panel", [
    "search-panel",
    "search-bar",
    "search-switch",
  ]);
  setClickOutsideToClose("wallpaper-mode-panel", [
    "wallpaper-mode-panel",
    "wallpaper-mode-switch",
  ]);

  function initCustomScrollbar() {
    // 只处理katex元素的滚动条，使用浏览器原生滚动条
    const katexElements = document.querySelectorAll(
      ".katex-display:not([data-scrollbar-initialized])"
    ) as NodeListOf<HTMLElement>;
    katexElements.forEach((element) => {
      if (!element.parentNode) return;

      const container = document.createElement("div");
      container.className = "katex-display-container";
      element.parentNode.insertBefore(container, element);
      container.appendChild(element);

      // 使用浏览器原生滚动条，无自定义样式
      container.style.cssText = `
			overflow-x: auto;
		`;

      element.setAttribute("data-scrollbar-initialized", "true");
    });
  }

  function initHorizontalOverflowContainers() {
    const markdownTables = document.querySelectorAll(
      ".custom-md table:not([data-horizontal-scroll-ready])"
    ) as NodeListOf<HTMLElement>;

    markdownTables.forEach((table) => {
      if (table.parentElement?.classList.contains("horizontal-scroll-container")) {
        table.dataset.horizontalScrollReady = "true";
        return;
      }

      const container = document.createElement("div");
      container.className = "horizontal-scroll-container";
      table.parentNode?.insertBefore(container, table);
      container.appendChild(table);
      table.dataset.horizontalScrollReady = "true";
    });

  }

  function initContentOverflowEnhancements() {
    initCustomScrollbar();
    initHorizontalOverflowContainers();
  }

  /** 进场后再跑：避免 content:replace 同步 DOM 改造拉长主栏 opacity:0 空白 */
  function scheduleContentOverflowEnhancements() {
    const run = () => initContentOverflowEnhancements();
    const ric = (
      window as Window & {
        requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number;
      }
    ).requestIdleCallback;
    if (typeof ric === "function") {
      ric(run, { timeout: 400 });
    } else {
      window.setTimeout(run, 120);
    }
  }

  function scheduleSidebarLayoutSync() {
    const run = () => {
      updateMainGridCols();
      updateSidebarComponentsVisibility();
    };
    requestAnimationFrame(() => {
      const ric = (
        window as Window & {
          requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number;
        }
      ).requestIdleCallback;
      if (typeof ric === "function") {
        ric(run, { timeout: 280 });
      } else {
        window.setTimeout(run, 50);
      }
    });
  }

  /** 壁纸/主栏定位：进场前后共用，避免 replace + view 双写分叉 */
  let wallpaperChromeLastRun = 0;
  function applyWallpaperChrome() {
    // C：content:replace 与 page:view 在每次软导航各调用一次本函数（等价 DOM
    // 双写）；50ms 内的重复调用直接短路
    const now = Date.now();
    if (now - wallpaperChromeLastRun < 50) return;
    wallpaperChromeLastRun = now;
    const isHome = pathsEqual(window.location.pathname, url("/"));
    const currentMode = document.documentElement.getAttribute("data-wallpaper-mode");
    const isMobileForBanner = window.innerWidth < 1024;
    const wrapper = document.getElementById("wallpaper-wrapper") as HTMLElement | null;
    const mainEl = document.querySelector(
      ".w-full.z-30.pointer-events-none",
    ) as HTMLElement | null;

    if (isMobileForBanner && (currentMode === "banner" || currentMode === "fullscreen")) {
      if (!isHome) {
        if (wrapper) {
          wrapper.style.display = "none";
          wrapper.classList.add("mobile-hide-banner");
        }
        if (mainEl) {
          mainEl.classList.add("mobile-main-no-banner");
          mainEl.style.setProperty("top", "5.5rem", "important");
          mainEl.style.position = "";
          mainEl.style.zIndex = "";
          mainEl.style.setProperty("margin-top", "0", "important");
        }
      } else {
        if (wrapper) {
          wrapper.style.display = "block";
          wrapper.classList.remove("mobile-hide-banner");
        }
        if (mainEl) {
          window.setTimeout(() => {
            mainEl.style.removeProperty("transition");
          }, 50);
        }
      }
    }

    if (!isMobileForBanner && currentMode === "fullscreen" && mainEl) {
      mainEl.style.position = "relative";
      mainEl.style.zIndex = "30";
      mainEl.style.setProperty("top", "0", "important");
      mainEl.style.setProperty("margin-top", "1rem", "important");
    }

    if (!isMobileForBanner && currentMode === "banner" && mainEl) {
      mainEl.style.setProperty("top", "calc(var(--banner-height) - 3.5rem)", "important");
      mainEl.style.position = "";
      mainEl.style.zIndex = "";
      mainEl.style.setProperty("margin-top", "0", "important");
    }
  }

  function showBanner() {
    const isBannerMode = backgroundWallpaper.mode === "banner";
    if (!isBannerMode) return;

    // 使用requestAnimationFrame优化DOM操作
    requestAnimationFrame(() => {
      // Handle single image banner (desktop)
      const banner = document.getElementById("banner");
      if (banner) {
        banner.classList.remove("opacity-0", "scale-105");
      }

      // Handle mobile single image banner - 使用与电脑端相同的逻辑
      const mobileBanner = document.querySelector(
        '.block.lg\\:hidden[alt="Mobile banner image of the blog"]'
      );
      if (mobileBanner) {
        // 移动端使用与电脑端相同的初始化逻辑
        mobileBanner.classList.remove("opacity-0", "scale-105");
        mobileBanner.classList.add("opacity-100");
      }
    });
  }

  const isPostPath = (rawUrl: string) => {
    try {
      return /^\/posts\/[^/]+\/?$/.test(new URL(rawUrl, window.location.href).pathname);
    } catch {
      return false;
    }
  };

  type ArticlePrefetchResult = { url: string; html: string };
  type ArticlePrefetchTask = {
    href: string;
    resolve: (page: ArticlePrefetchResult) => void;
    reject: (error: unknown) => void;
  };
  const ARTICLE_PREFETCH_CONCURRENCY = 2;
  const articlePrefetchPending = new Map<string, Promise<ArticlePrefetchResult>>();
  const articlePrefetchHigh: ArticlePrefetchTask[] = [];
  const articlePrefetchLow: ArticlePrefetchTask[] = [];
  let articlePrefetchActive = 0;
  let articleNavigationSequence = 0;
  let navigationPriorityTimeout: ReturnType<typeof setTimeout> | null = null;

  const emitNavigationPriority = (active: boolean) => {
    document.documentElement.classList.toggle("is-navigation-priority", active);
    window.dispatchEvent(
      new CustomEvent("firefly:navigation-priority", { detail: { active } }),
    );
  };

  const beginNavigationPriority = () => {
    emitNavigationPriority(true);
    const progressBar = document.getElementById("progress-bar");
    progressBar?.classList.remove("finishing", "done");
    progressBar?.classList.add("loading");
    if (navigationPriorityTimeout) clearTimeout(navigationPriorityTimeout);
    navigationPriorityTimeout = setTimeout(() => {
      navigationPriorityTimeout = null;
      emitNavigationPriority(false);
    }, 15_000);
  };

  const endNavigationPriority = () => {
    if (navigationPriorityTimeout) clearTimeout(navigationPriorityTimeout);
    navigationPriorityTimeout = null;
    emitNavigationPriority(false);
  };

  const showArticleNavigationError = () => {
    const existing = document.getElementById("article-navigation-error");
    existing?.remove();
    const notice = document.createElement("div");
    notice.id = "article-navigation-error";
    notice.className = "article-navigation-error";
    notice.setAttribute("role", "alert");
    notice.textContent = "文章暂时加载失败，已保留当前页面，请稍后重试。";
    document.body.appendChild(notice);
    requestAnimationFrame(() => notice.classList.add("is-visible"));
    setTimeout(() => {
      notice.classList.remove("is-visible");
      setTimeout(() => notice.remove(), 180);
    }, 4_000);
  };

  const canIntentPrefetch = () => {
    if (document.hidden) return false;
    const connection = (
      navigator as Navigator & {
        connection?: { saveData?: boolean; effectiveType?: string };
      }
    ).connection;
    return !connection?.saveData && !connection?.effectiveType?.endsWith("2g");
  };

  const pumpArticlePrefetch = () => {
    while (articlePrefetchActive < ARTICLE_PREFETCH_CONCURRENCY) {
      const task = articlePrefetchHigh.shift() ?? articlePrefetchLow.shift();
      if (!task) return;
      articlePrefetchActive += 1;
      void window.swup
        .fetchPage(task.href)
        .then((page: ArticlePrefetchResult) => {
          window.swup.cache.set(task.href, page);
          task.resolve(page);
        })
        .catch(task.reject)
        .finally(() => {
          articlePrefetchActive -= 1;
          articlePrefetchPending.delete(task.href);
          pumpArticlePrefetch();
        });
    }
  };

  const prepareArticle = (
    href: string,
    options: { priority: boolean; force: boolean },
  ): Promise<ArticlePrefetchResult> => {
    if (window.swup.cache.has(href)) {
      return Promise.resolve(window.swup.cache.get(href) as ArticlePrefetchResult);
    }
    const pending = articlePrefetchPending.get(href);
    if (pending) return pending;
    if (!options.force && !canIntentPrefetch()) {
      return Promise.reject(new Error("intent_prefetch_deferred"));
    }
    const promise = new Promise<ArticlePrefetchResult>((resolve, reject) => {
      const task = { href, resolve, reject };
      (options.priority ? articlePrefetchHigh : articlePrefetchLow).push(task);
      pumpArticlePrefetch();
    });
    articlePrefetchPending.set(href, promise);
    return promise;
  };

  const commitDeferredArticleHistory = (visit: {
    to: { url: string; hash?: string };
    history: { popstate: boolean };
    meta: Record<string, unknown>;
  }) => {
    if (visit.meta.fireflyDeferredArticleHistory !== true) return;

    const resolvedUrl =
      typeof visit.meta.fireflyResolvedArticleUrl === "string"
        ? visit.meta.fireflyResolvedArticleUrl
        : visit.to.url;
    const nextUrl = `${resolvedUrl}${visit.to.hash ?? ""}`;
    const swupInternal = window.swup as typeof window.swup & {
      currentHistoryIndex: number;
    };
    const nextIndex = swupInternal.currentHistoryIndex + 1;

    window.history.pushState(
      {
        url: nextUrl,
        random: Math.random(),
        source: "swup",
        index: nextIndex,
      },
      "",
      nextUrl,
    );
    swupInternal.currentHistoryIndex = nextIndex;
    visit.to.url = resolvedUrl;
    visit.history.popstate = false;
    window.swup.classes.remove("is-popstate");
    visit.meta.fireflyDeferredArticleHistory = false;
  };

  const articleLinkFromEvent = (event: Event): HTMLAnchorElement | null => {
    const target = event.target instanceof Element ? event.target.closest("a[href]") : null;
    if (!(target instanceof HTMLAnchorElement)) return null;
    if (target.matches("[download], [target='_blank'], [data-no-swup]")) return null;
    const destination = new URL(target.href, window.location.href);
    if (
      destination.origin !== window.location.origin ||
      destination.hash ||
      !isPostPath(destination.href) ||
      pathsEqual(destination.pathname, window.location.pathname)
    ) {
      return null;
    }
    return target;
  };

  if (!(window as Window & { __fireflyArticleIntentBound?: boolean }).__fireflyArticleIntentBound) {
    (window as Window & { __fireflyArticleIntentBound?: boolean }).__fireflyArticleIntentBound = true;
    const intent = (event: Event) => {
      const link = articleLinkFromEvent(event);
      if (!link) return;
      void prepareArticle(link.href, { priority: true, force: false }).catch(() => undefined);
    };
    document.addEventListener("pointerover", intent, { capture: true, passive: true });
    document.addEventListener("focusin", intent, { capture: true });
    document.addEventListener("touchstart", intent, { capture: true, passive: true });
    document.addEventListener(
      "click",
      (event) => {
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }
        const link = articleLinkFromEvent(event);
        if (!link || window.swup.cache.has(link.href)) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        const sequence = ++articleNavigationSequence;
        beginNavigationPriority();
        void prepareArticle(link.href, { priority: true, force: true })
          .then(() => {
            if (sequence !== articleNavigationSequence) return;
            window.swup.navigate(link.href, {
              meta: { fireflyPreparedArticle: true },
            });
          })
          .catch(() => {
            if (sequence !== articleNavigationSequence) return;
            document.documentElement.classList.remove("is-page-transitioning");
            endNavigationPriority();
            const progressBar = document.getElementById("progress-bar");
            progressBar?.classList.remove("loading", "finishing", "done");
            showArticleNavigationError();
          });
      },
      { capture: true },
    );

    const preloadMarkedArticles = () => {
      const marked = [...document.querySelectorAll<HTMLAnchorElement>("a[data-swup-preload]")].slice(0, 2);
      for (const link of marked) {
        void prepareArticle(link.href, { priority: false, force: false }).catch(() => undefined);
      }
    };
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(preloadMarkedArticles, { timeout: 1_500 });
    } else {
      setTimeout(preloadMarkedArticles, 250);
    }
    document.addEventListener("swup:page:view", preloadMarkedArticles);
  }

  const commitIncomingLayout = (visit: {
    to: { url: string };
    meta: Record<string, unknown>;
  }) => {
    const bodyElement = document.body;
    const isHomePage = pathsEqual(visit.to.url, url("/"));

    // 目标 DOM 已经替换后再切布局。等待网络时保持旧页和旧滚动位置不动。
    const wasCurtain = document.documentElement.classList.contains("curtain-focus");
    const curtainChanged = syncCurtainFocusFromUrl(visit.to.url);
    const mainGrid = document.getElementById("main-grid");
    if (mainGrid && !(curtainChanged || wasCurtain)) {
      mainGrid.style.setProperty("transition", "none", "important");
    }

    bodyElement.classList.toggle("lg:is-home", isHomePage);
    bodyElement.classList.toggle("is-home", isHomePage);

    const currentWallpaperMode = document.documentElement.getAttribute("data-wallpaper-mode");
    if (currentWallpaperMode !== "banner") {
      bodyElement.classList.remove("enable-banner");
      bodyElement.classList.add("no-banner-layout");
      bodyElement.classList.toggle("wallpaper-transparent", currentWallpaperMode === "overlay");
    }

    const navbar = document.getElementById("navbar");
    if (navbar) {
      navbar.setAttribute("data-is-home", isHomePage.toString());
      if (
        navbar.getAttribute("data-transparent-mode") === "semifull" &&
        typeof (window as any).initSemifullScrollDetection === "function"
      ) {
        (window as any).initSemifullScrollDetection();
      }
    }

    const isMobile = window.innerWidth < 1024;
    if (isMobile) {
      const postListContainer = document.getElementById("post-list-container");
      if (postListContainer) postListContainer.style.transition = "none";
    }

    const wallpaperWrapper = document.getElementById("wallpaper-wrapper");
    const mainContentWrapper = document.querySelector(
      ".w-full.z-30.pointer-events-none"
    ) as HTMLElement | null;

    if (isMobile && wallpaperWrapper && mainContentWrapper) {
      if (isHomePage) {
        mainContentWrapper.style.setProperty("transition", "none", "important");
        wallpaperWrapper.classList.remove("mobile-hide-banner");
        wallpaperWrapper.style.display = "";
        setTimeout(() => {
          mainContentWrapper.classList.remove("mobile-main-no-banner");
          const visitCurrentMode = document.documentElement.getAttribute("data-wallpaper-mode");
          if (visitCurrentMode === "fullscreen") {
            mainContentWrapper.style.position = "relative";
            mainContentWrapper.style.zIndex = "30";
            mainContentWrapper.style.setProperty("top", "0", "important");
            mainContentWrapper.style.setProperty("margin-top", "1rem", "important");
          } else if (visitCurrentMode === "overlay" || visitCurrentMode === "none") {
            mainContentWrapper.style.setProperty("top", "5.5rem", "important");
            mainContentWrapper.style.position = "";
            mainContentWrapper.style.zIndex = "";
            mainContentWrapper.style.setProperty("margin-top", "0", "important");
          } else {
            mainContentWrapper.style.removeProperty("top");
            mainContentWrapper.style.position = "";
            mainContentWrapper.style.zIndex = "";
            mainContentWrapper.style.setProperty("margin-top", "0", "important");
          }
        }, 150);
      } else {
        wallpaperWrapper.classList.add("mobile-hide-banner");
        mainContentWrapper.classList.add("mobile-main-no-banner");
        mainContentWrapper.style.setProperty("top", "5.5rem", "important");
        mainContentWrapper.style.position = "";
        mainContentWrapper.style.zIndex = "";
        mainContentWrapper.style.setProperty("margin-top", "0", "important");
      }
    } else if (!isMobile && wallpaperWrapper) {
      wallpaperWrapper.style.display = "";
      wallpaperWrapper.classList.remove("mobile-hide-banner");
      if (mainContentWrapper) {
        mainContentWrapper.classList.remove("mobile-main-no-banner");
        const visitDesktopMode = document.documentElement.getAttribute("data-wallpaper-mode");
        if (visitDesktopMode === "fullscreen") {
          mainContentWrapper.style.position = "relative";
          mainContentWrapper.style.zIndex = "30";
          mainContentWrapper.style.setProperty("top", "0", "important");
          mainContentWrapper.style.setProperty("margin-top", "1rem", "important");
        } else if (visitDesktopMode === "banner") {
          mainContentWrapper.style.setProperty("top", "calc(var(--banner-height) - 3.5rem)", "important");
          mainContentWrapper.style.position = "";
          mainContentWrapper.style.zIndex = "";
          mainContentWrapper.style.setProperty("margin-top", "0", "important");
        }
      }
    }

