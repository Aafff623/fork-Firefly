      const isArticleVisit =
        !visit.history.popstate && !visit.to.hash && isPostPath(visit.to.url);
      if (isArticleVisit) {
		beginNavigationPriority();
		document.documentElement.classList.add("is-page-transitioning");
        visit.animation.animate = false;
        visit.scroll.reset = false;
        visit.meta.fireflySourceArticleUrl =
          window.location.pathname + window.location.search + window.location.hash;
        visit.meta.fireflyDeferredArticleHistory = true;
        // Suppress Swup's eager history push. content:replace creates the real entry
        // only after the prepared article DOM has replaced the old page.
        visit.history.popstate = true;
