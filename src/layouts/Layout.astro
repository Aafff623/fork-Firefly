        document.documentElement.classList.remove("is-page-transitioning");
        scrollFunction();
      }, 200);
    });
		window.swup.hooks.on("visit:abort", endNavigationPriority);
		window.swup.hooks.on("fetch:error", endNavigationPriority);


  };
  if (window?.swup?.hooks) {
    setup();
  } else {
    document.addEventListener("swup:enable", setup);
  }

  document.addEventListener("astro:page-load", scheduleContentOverflowEnhancements);
  document.addEventListener("password:decrypted", () => {
    setTimeout(scheduleContentOverflowEnhancements, 200);
  });
  let backToTopBtn = document.getElementById("back-to-top-btn");
  let toc = document.getElementById("toc-wrapper");
  let navbar = document.getElementById("navbar-wrapper");
  let lastStickyNavbarScrollTop = 0;
  const STICKY_NAVBAR_SCROLL_DELTA = 6;
  const STICKY_NAVBAR_SHOW_AT_TOP = 48;
  const sidebarStickyState: Record<
    "left" | "right",
    { topClass: "top-0" | "top-4"; hasVisibleTop: boolean }
  > = {
    left: { topClass: "top-0", hasVisibleTop: false },
    right: { topClass: "top-0", hasVisibleTop: false },
  };

  // D2：topContainer 可见性读数缓存——offsetHeight 是强制布局读，滚动期
  // 每帧 ×2 侧纯属浪费；可见性只在 resize / 软导航（DOM 重建）后变化。
  // 与 sidebarStickyState 同处：updateSidebarStickySpacing 会被首次
  // scrollFunction() 同步调用，声明晚于调用点则读到 undefined。
  let sidebarMetricsDirty = true;
  const sidebarTopVisibleCache: { left: boolean; right: boolean } = {
    left: false,
    right: false,
  };

  // 必须在 scrollFunction() 首次调用前定义，否则 const TDZ 会中断后续壁纸淡入
  const isCurrentPagePost = () =>
    isPostPath(window.location.href) || window.location.pathname.includes("/post/");

  // 优化的滚动处理函数
  // D2：navbar/top-row 查询缓存（滚动中每帧 getElementById 是纯浪费；
  // 元素被 swup 替换后缓存失效再重取）
  let cachedNavbarEl = document.getElementById("navbar");
  let cachedTopRowEl = document.getElementById("top-row");
  // D1b：滚动进行中暂停水波动画（肉眼不可察），停滚 160ms 后恢复
  let wavesPauseTimer: number | undefined;

  function scrollFunction() {
    if (document.documentElement.classList.contains("is-page-transitioning")) {
      return;
    }

    const scrollTop = document.documentElement.scrollTop;
    const bannerHeight = window.innerHeight * (BANNER_HEIGHT / 100);
    const navbarElement = cachedNavbarEl ?? document.getElementById("navbar");
    if (navbarElement) cachedNavbarEl = navbarElement;
    const topRow = cachedTopRowEl ?? document.getElementById("top-row");
    if (topRow) cachedTopRowEl = topRow;

    document.documentElement.classList.add("waves-scrolling");
    if (wavesPauseTimer) window.clearTimeout(wavesPauseTimer);
    wavesPauseTimer = window.setTimeout(() => {
      document.documentElement.classList.remove("waves-scrolling");
    }, 160);

    // 根据滚动位置动态更新侧边栏 sticky 间距
    updateSidebarStickySpacing();

    // 使用批量DOM操作优化性能
    const operations: (() => void)[] = [];

    if (backToTopBtn) {
      operations.push(() => {
        if (scrollTop > bannerHeight) {
          backToTopBtn.classList.remove("hide");
        } else {
          backToTopBtn.classList.add("hide");
        }
      });
    }

    if (bannerEnabled && toc) {
      operations.push(() => {
        if (scrollTop > bannerHeight) {
          toc.classList.remove("toc-hide");
        } else {
          toc.classList.add("toc-hide");
        }
      });
    }

    // sticky 顶栏：下滑隐藏、上滑再出现（带 CSS transform 过渡）
    if (stickyNavbar && topRow) {
      operations.push(() => {
        if (scrollTop <= STICKY_NAVBAR_SHOW_AT_TOP) {
          topRow.classList.remove("navbar-scroll-hidden");
        } else if (scrollTop > lastStickyNavbarScrollTop + STICKY_NAVBAR_SCROLL_DELTA) {
          topRow.classList.add("navbar-scroll-hidden");
        } else if (scrollTop < lastStickyNavbarScrollTop - STICKY_NAVBAR_SCROLL_DELTA) {
          topRow.classList.remove("navbar-scroll-hidden");
        }
        lastStickyNavbarScrollTop = scrollTop;
      });
    } else if (bannerEnabled && navbar) {
      operations.push(() => {
        const threshold = window.innerHeight * (BANNER_HEIGHT_HOME / 100) - 88;

        if (scrollTop >= threshold) {
          navbar.classList.add("navbar-hidden");
        } else {
          navbar.classList.remove("navbar-hidden");
        }
      });
    }

    if (navbarElement) {
      operations.push(() => {
        if (scrollTop > 8) {
          navbarElement.classList.add("navbar-sticky-shadow");
        } else {
          navbarElement.classList.remove("navbar-sticky-shadow");
        }
      });
    }

    // 批量执行DOM操作
    if (operations.length > 0) {
      requestAnimationFrame(() => {
        operations.forEach((op) => op());
      });
    }
  }

