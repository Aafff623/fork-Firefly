---
/* Hallmark · macrostructure: Split Studio + Index-First · tone: editorial
 * genre: editorial · theme: Firefly tokens (hue 290) · enrichment: none
 * pre-emit critique: P4 H4 E4 S4 R4 V4
 */
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import {
	commentConfig,
	friendsPageConfig,
	getEnabledFriends,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

if (!siteConfig.pages.friends) {
	return Astro.redirect("/404/");
}

const friendsPost = await getEntry("spec", "friends");

if (!friendsPost) {
	throw new Error("friends page content not found");
}

const { Content } = await render(friendsPost);

const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	friendsPageConfig.showComment !== false;

const items = getEnabledFriends();
const allTags = [...new Set(items.flatMap((item) => item.tags || []))].sort();

const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description =
	friendsPageConfig.description || i18n(I18nKey.friendsDescription);
---

<MainGridLayout title={title} description={description}>
  <div class="friends-shell flex w-full relative min-h-32">
    {/* 像素双人图作卡片背景，内容叠在上面 */}
    <div class="friends-panel card-base z-10 relative w-full">
      <header class="friends-mast">
        <p class="friends-mast-meta">
          <span>FRIENDS · LINK</span>
          <span>{items.length > 0 ? `${items.length}` : "OPEN"}</span>
        </p>
        <h1 class="friends-title">{title}</h1>
        {
          description && (
            <p class="friends-lede">{description}</p>
          )
        }
      </header>

      {
        items.length > 0 && (
          <friend-filter class="friends-filter">
            <div class="friends-search">
              <Icon
                is:inline
                name="lucide:search"
                class="friends-search-icon"
              />
              <input
                type="text"
                data-search
                placeholder={i18n(I18nKey.searchFriends) || "搜索友链..."}
                class="friends-search-input"
              />
            </div>
            <div class="friends-tags">
              <button
                data-tag="all"
                class="friends-tag"
                data-active
              >
                {i18n(I18nKey.all)}
              </button>
              {allTags.map((tag) => (
                <button data-tag={tag} class="friends-tag">
                  {tag}
                </button>
              ))}
            </div>
          </friend-filter>
        )
      }

      <div class="friends-grid">
        {
          items.length === 0 && (
            <div class="friends-empty-state col-span-full">
              <div class="friends-empty-rule" aria-hidden="true" />
              <div class="friends-empty-body">
                <Icon is:inline name="lucide:link-2-off" class="friends-empty-icon" />
                <div>
                  <p class="friends-empty-title">{i18n(I18nKey.friendsEmpty)}</p>
                  <p class="friends-empty-hint">名单空着 · 先看下方如何互换</p>
                </div>
              </div>
            </div>
          )
        }
        {
          items.map((item) => (
            <a
              href={item.siteurl}
              target="_blank"
              rel="noopener noreferrer"
              data-tags={item.tags?.join(",")}
              class="friend-card group"
            >
              <div class="friend-card-avatar">
                <img src={item.imgurl} alt={item.title} loading="lazy" />
              </div>
              <div class="friend-card-body">
                <div class="friend-card-head">
                  <span class="font-bold friend-card-name">{item.title}</span>
                  <Icon
                    is:inline
                    name="lucide:arrow-up-right"
                    class="friend-card-ext"
                  />
                </div>
                <p class="friend-card-desc line-clamp-1" title={item.desc}>
                  {item.desc}
                </p>
                {
                  item.tags && item.tags.length > 0 && (
                    <div class="friend-card-tags">
                      {item.tags.slice(0, 3).map((tag) => (
                        <span class="friend-card-tag">{tag}</span>
                      ))}
                    </div>
                  )
                }
              </div>
            </a>
          ))
        }
      </div>

      <div class="friends-empty hidden flex-col items-center justify-center py-10 text-[var(--content-meta)]">
        <Icon is:inline name="lucide:search-x" class="text-3xl mb-2 opacity-60" />
        <div class="text-sm">{i18n(I18nKey.searchNoResults)}</div>
      </div>
    </div>
  </div>

  {
    friendsPageConfig.showCustomContent !== false && (
      <div class="mt-4 friends-spec card-base z-10 relative w-full">
        <Markdown class="">
          <Content />
        </Markdown>
      </div>
    )
  }

  {
    isCommentEnabled && (
      <div class="mt-4">
        <Comment post={friendsPost} customPath="/friends/" />
      </div>
    )
  }

  <script slot="head" is:inline>
    if (!customElements.get("friend-filter")) {
      class FriendFilter extends HTMLElement {
        selectedTag = "all";

        connectedCallback() {
          this.addEventListener("click", this.handleClick);
          const input = this.querySelector("[data-search]");
          if (input) {
            input.addEventListener("input", () => this.applyFilters());
          }
        }

        disconnectedCallback() {
          this.removeEventListener("click", this.handleClick);
        }

        handleClick(e) {
          const button = e.target.closest("button");
          if (!button || !button.dataset.tag) return;

          this.selectedTag = button.dataset.tag;
          this.querySelectorAll("button[data-tag]").forEach((f) => {
            f.removeAttribute("data-active");
          });
          button.setAttribute("data-active", "");
          this.applyFilters();
        }

        applyFilters() {
          const container = this.closest(".card-base");
          if (!container) return;

          const input = this.querySelector("[data-search]");
          const query = (input?.value || "").toLowerCase().trim();
          const cards = container.querySelectorAll(".friend-card");
          let hasVisible = false;

          cards.forEach((card) => {
            const cardEl = card;
            const tags = (cardEl.dataset.tags || "").split(",");
            const name = (
              cardEl.querySelector(".font-bold")?.textContent || ""
            ).toLowerCase();
            const desc = (
              cardEl.querySelector(".line-clamp-1")?.textContent || ""
            ).toLowerCase();

            const tagMatch =
              this.selectedTag === "all" ||
              (this.selectedTag && tags.includes(this.selectedTag));
            const searchMatch =
              !query ||
              name.includes(query) ||
              desc.includes(query) ||
              tags.some((t) => t.toLowerCase().includes(query));

            if (tagMatch && searchMatch) {
              cardEl.style.display = "";
              hasVisible = true;
            } else {
              cardEl.style.display = "none";
            }
          });

          const emptyEl = container.querySelector(".friends-empty");
          if (emptyEl) {
            emptyEl.classList.toggle("hidden", hasVisible);
            emptyEl.classList.toggle("flex", !hasVisible);
          }
        }
      }
      customElements.define("friend-filter", FriendFilter);
    }

    function bindFriendsCopy(root) {
      const scope = root || document;
      scope.querySelectorAll(".friends-copy").forEach((btn) => {
        if (btn.dataset.bound === "1") return;
        btn.dataset.bound = "1";
        btn.addEventListener("click", async () => {
          const text = btn.getAttribute("data-copy") || "";
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            const ta = document.createElement("textarea");
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand("copy");
            ta.remove();
          }
          btn.classList.add("is-done");
          window.setTimeout(() => btn.classList.remove("is-done"), 1400);
        });
      });
    }

    bindFriendsCopy();
    document.addEventListener("astro:page-load", () => bindFriendsCopy());
    document.addEventListener("swup:page:view", () => bindFriendsCopy());
  </script>

  <style>
    .friends-shell {
      border-radius: 0.35rem;
      overflow: visible;
    }

    /* 友链主卡：像素氛围图铺底，正文半透叠上 */
    .friends-panel {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      padding: 1.25rem 1.35rem 1.5rem;
      /* 压过 card-base 实底，让底图透出来 */
      background-color: transparent !important;
      background-image: none !important;
    }

    @media (min-width: 768px) {
      .friends-panel {
        padding: 1.5rem 1.85rem 1.75rem;
      }
    }

    .friends-panel::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 0;
      background:
        url("/assets/friends/friends-hero.jpg") center 62% / cover no-repeat;
      pointer-events: none;
    }

    .friends-panel::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      /* 半透磨砂，保证字可读，仍能看见双人场景 */
      background: color-mix(in oklab, var(--card-bg, #fff) 78%, transparent);
      backdrop-filter: blur(1.5px);
    }

    :global(html.dark) .friends-panel::before {
      /* 暗色略提亮底图，避免泥灰死黑 */
      filter: brightness(1.12) saturate(1.08) contrast(1.05);
    }

    :global(html.dark) .friends-panel::after {
      /* 更深遮罩 + 轻模糊，托住浅色字 */
      background: color-mix(in oklab, var(--card-bg, #111) 88%, transparent);
      backdrop-filter: blur(2.5px);
    }

    .friends-panel > * {
      position: relative;
      z-index: 1;
    }

    .friends-mast {
      margin: 0 0 1.15rem;
      padding-bottom: 0.9rem;
      border-bottom: 1px solid color-mix(in oklab, var(--line-color), transparent);
    }

    .friends-mast-meta {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin: 0 0 0.55rem;
      font-family: ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: color-mix(in oklab, var(--content-meta) 85%, transparent);
    }

    .friends-title {
      margin: 0;
      font-size: clamp(1.55rem, 2.4vw, 1.85rem);
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: -0.02em;
      /* --content-title 未定义时会 inherit 成黑，暗色必炸 */
      color: var(--deep-text, rgb(0 0 0 / 0.88));
      font-style: normal;
    }

    :global(html.dark) .friends-title {
      color: rgb(255 255 255 / 0.92);
    }

    .friends-lede {
      margin: 0.45rem 0 0;
      max-width: 42rem;
      font-size: 0.92rem;
      line-height: 1.65;
      color: color-mix(in oklab, var(--content-meta) 95%, transparent);
    }

    :global(html.dark) .friends-mast-meta,
    :global(html.dark) .friends-lede {
      color: rgb(255 255 255 / 0.68);
    }

    :global(html.dark) .friends-empty-icon {
      opacity: 0.7;
      color: rgb(255 255 255 / 0.72);
    }

    :global(html.dark) .friends-empty-title {
      color: rgb(255 255 255 / 0.88);
    }

    :global(html.dark) .friends-empty-hint {
      color: rgb(255 255 255 / 0.58);
    }

    :global(html.dark) .friend-card {
      border-color: rgb(255 255 255 / 0.12);
      background: rgb(255 255 255 / 0.04);
    }

    :global(html.dark) .friend-card:hover {
      border-color: color-mix(in oklab, var(--primary) 50%, transparent);
      background: color-mix(in oklab, var(--primary) 10%, transparent);
    }

    :global(html.dark) .friend-card-name {
      color: rgb(255 255 255 / 0.9);
    }

    :global(html.dark) .friend-card-desc {
      color: rgb(255 255 255 / 0.58);
    }

    :global(html.dark) .friend-card-tag {
      background: rgb(255 255 255 / 0.08);
      color: rgb(255 255 255 / 0.65);
    }

    :global(html.dark) .friends-spec :global(.friends-col-kicker) {
      color: rgb(255 255 255 / 0.55);
    }

    :global(html.dark) .friends-spec :global(.friends-col-title),
    :global(html.dark) .friends-spec :global(.friends-step-title),
    :global(html.dark) .friends-spec :global(.friends-field-value),
    :global(html.dark) .friends-spec :global(.friends-notes-dt) {
      color: rgb(255 255 255 / 0.92);
    }

    :global(html.dark) .friends-spec :global(.friends-site-desc),
    :global(html.dark) .friends-spec :global(.friends-step-body),
    :global(html.dark) .friends-spec :global(.friends-notes-dd),
    :global(html.dark) .friends-spec :global(.friends-field-label) {
      color: rgb(255 255 255 / 0.62);
    }

    :global(html.dark) .friends-spec :global(.friends-field),
    :global(html.dark) .friends-spec :global(.friends-template) {
      background: rgb(255 255 255 / 0.06);
      border-color: rgb(255 255 255 / 0.1);
    }

    :global(html.dark) .friends-spec :global(.friends-copy) {
      background: rgb(255 255 255 / 0.1);
      color: rgb(255 255 255 / 0.85);
    }

    .friends-filter {
      display: block;
      margin-bottom: 1rem;
    }

    .friends-search {
      position: relative;
      margin-bottom: 0.65rem;
    }

    .friends-search-icon {
      position: absolute;
      left: 0.75rem;
      top: 50%;
      transform: translateY(-50%);
      width: 1rem;
      height: 1rem;
      color: color-mix(in oklab, var(--content-meta) 70%, transparent);
      pointer-events: none;
    }

    .friends-search-input {
      width: 100%;
      padding: 0.6rem 0.85rem 0.6rem 2.35rem;
      border-radius: 0.55rem;
      border: 1px solid color-mix(in oklab, var(--line-color), transparent);
      background: transparent;
      font-size: 0.875rem;
      color: inherit;
      outline: none;
      transition:
        border-color 180ms cubic-bezier(0.16, 1, 0.3, 1),
        box-shadow 180ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .friends-search-input::placeholder {
      color: color-mix(in oklab, var(--content-meta) 65%, transparent);
    }

    .friends-search-input:hover {
      border-color: color-mix(in oklab, var(--primary) 35%, var(--line-color));
    }

    .friends-search-input:focus-visible {
      border-color: var(--primary);
      box-shadow: 0 0 0 2px color-mix(in oklab, var(--primary) 28%, transparent);
    }

    .friends-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .friends-tag {
      padding: 0.3rem 0.7rem;
      border-radius: 999px;
      border: 1px solid color-mix(in oklab, var(--line-color), transparent);
      background: transparent;
      font-size: 0.78rem;
      font-weight: 500;
      color: color-mix(in oklab, var(--content-meta) 95%, transparent);
      cursor: pointer;
      transition:
        border-color 160ms cubic-bezier(0.16, 1, 0.3, 1),
        background-color 160ms cubic-bezier(0.16, 1, 0.3, 1),
        color 160ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .friends-tag:hover {
      border-color: color-mix(in oklab, var(--primary) 40%, var(--line-color));
      color: var(--primary);
    }

    .friends-tag:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    .friends-tag[data-active] {
      border-color: color-mix(in oklab, var(--primary) 55%, var(--line-color));
      background: color-mix(in oklab, var(--primary) 12%, transparent);
      color: var(--primary);
    }

    .friends-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 16.5rem), 1fr));
      gap: 0.65rem;
    }

    .friends-empty-state {
      padding: 0.35rem 0 0.15rem;
    }

    .friends-empty-rule {
      height: 1px;
      margin-bottom: 0.85rem;
      background: linear-gradient(
        90deg,
        var(--primary),
        color-mix(in oklab, var(--line-color), transparent) 42%,
        transparent
      );
    }

    .friends-empty-body {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 0;
      padding: 0.55rem 0.15rem 0.35rem;
    }

    .friends-empty-icon {
      width: 1.35rem;
      height: 1.35rem;
      flex-shrink: 0;
      opacity: 0.45;
      color: var(--content-meta);
    }

    .friends-empty-title {
      margin: 0;
      font-size: 0.9rem;
      font-weight: 600;
      color: color-mix(in oklab, var(--content-meta) 95%, transparent);
    }

    .friends-empty-hint {
      margin: 0.15rem 0 0;
      font-size: 0.78rem;
      color: color-mix(in oklab, var(--content-meta) 72%, transparent);
    }

    .friend-card {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 0;
      padding: 0.65rem 0.75rem;
      border-radius: 0.65rem;
      border: 1px solid color-mix(in oklab, var(--line-color), transparent);
      background: transparent;
      text-decoration: none;
      color: inherit;
      transition:
        border-color 180ms cubic-bezier(0.16, 1, 0.3, 1),
        background-color 180ms cubic-bezier(0.16, 1, 0.3, 1),
        transform 160ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .friend-card:hover {
      border-color: color-mix(in oklab, var(--primary) 42%, var(--line-color));
      background: color-mix(in oklab, var(--primary) 5%, transparent);
    }

    .friend-card:active {
      transform: translateY(1px);
    }

    .friend-card:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    .friend-card-avatar {
      width: 3rem;
      height: 3rem;
      flex-shrink: 0;
      border-radius: 0.55rem;
      overflow: hidden;
      border: 1px solid color-mix(in oklab, var(--line-color), transparent);
      background: color-mix(in oklab, var(--content-meta) 8%, transparent);
    }

    .friend-card-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .friend-card-body {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 0.12rem;
    }

    .friend-card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .friend-card-name {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 0.95rem;
      font-weight: 700;
      transition: color 160ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .friend-card:hover .friend-card-name {
      color: var(--primary);
    }

    .friend-card-ext {
      width: 1rem;
      height: 1rem;
      flex-shrink: 0;
      opacity: 0;
      color: var(--primary);
      transform: translate(-0.2rem, 0.15rem);
      transition:
        opacity 160ms cubic-bezier(0.16, 1, 0.3, 1),
        transform 160ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .friend-card:hover .friend-card-ext,
    .friend-card:focus-visible .friend-card-ext {
      opacity: 1;
      transform: translate(0, 0);
    }

    .friend-card-desc {
      margin: 0;
      font-size: 0.8rem;
      color: color-mix(in oklab, var(--content-meta) 88%, transparent);
    }

    .friend-card-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
      margin-top: 0.2rem;
    }

    .friend-card-tag {
      font-size: 0.65rem;
      padding: 0.1rem 0.4rem;
      border-radius: 999px;
      background: color-mix(in oklab, var(--content-meta) 9%, transparent);
      color: color-mix(in oklab, var(--content-meta) 85%, transparent);
    }

    .friends-spec {
      padding: 1.15rem 1.25rem 1.35rem;
    }

    @media (min-width: 768px) {
      .friends-spec {
        padding: 1.35rem 1.75rem 1.55rem;
      }
    }

    /* —— friends.mdx apply block (scoped via page) —— */
    .friends-spec :global(.friends-apply) {
      --friends-ease: cubic-bezier(0.16, 1, 0.3, 1);
    }

    .friends-spec :global(.friends-split) {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.35rem;
    }

    @media (min-width: 960px) {
      .friends-spec :global(.friends-split) {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 0;
      }

      .friends-spec :global(.friends-col-site) {
        padding-right: 1.35rem;
        border-right: 1px solid color-mix(in oklab, var(--line-color), transparent);
      }

      .friends-spec :global(.friends-col-flow) {
        padding-left: 1.35rem;
      }
    }

    .friends-spec :global(.friends-col-kicker) {
      margin: 0 0 0.3rem;
      font-family: ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.65rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: color-mix(in oklab, var(--content-meta) 78%, transparent);
    }

    .friends-spec :global(.friends-col-title) {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 700;
      line-height: 1.3;
      letter-spacing: -0.015em;
      font-style: normal;
    }

    .friends-spec :global(.friends-site-head) {
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
      margin-bottom: 1rem;
      min-width: 0;
    }

    .friends-spec :global(.friends-site-avatar) {
      position: relative;
      width: 3.5rem;
      height: 3.5rem;
      flex-shrink: 0;
    }

    .friends-spec :global(.friends-site-avatar img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 0.55rem;
      border: 1px solid color-mix(in oklab, var(--line-color), transparent);
    }

    .friends-spec :global(.friends-site-ok) {
      position: absolute;
      right: -0.2rem;
      bottom: -0.2rem;
      width: 1.1rem;
      height: 1.1rem;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--primary);
      color: white;
      box-shadow: 0 0 0 2px var(--card-bg, #fff);
    }

    :global(:root.dark) .friends-spec :global(.friends-site-ok) {
      color: rgba(0, 0, 0, 0.72);
    }

    .friends-spec :global(.friends-site-desc) {
      margin: 0.25rem 0 0;
      font-size: 0.78rem;
      line-height: 1.55;
      color: color-mix(in oklab, var(--content-meta) 90%, transparent);
    }

    .friends-spec :global(.friends-fields) {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
