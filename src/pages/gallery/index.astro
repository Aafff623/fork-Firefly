---
import fs from "node:fs";
import path from "node:path";
import { Icon } from "astro-icon/components";
import AlbumCard from "@/components/pages/gallery/AlbumCard.astro";
import GalleryExplorer from "@/components/pages/gallery/GalleryExplorer.svelte";
import PhotoCard from "@/components/pages/gallery/PhotoCard.astro";
import { galleryConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getAlbumCover, scanAlbumPhotos } from "@/utils/gallery-utils";
import { url } from "@/utils/url-utils";

/** 无限画布专用：同源 demo 画库（避免外链 CORS 导致 WebGL 只剩 1 张图） */
function scanDemoArtworks(): string[] {
	const dir = path.join(process.cwd(), "public", "gallery", "_demo", "artworks");
	if (!fs.existsSync(dir)) return [];
	return fs
		.readdirSync(dir)
		.filter((f) => /\.(jpe?g|png|webp|avif|gif)$/i.test(f))
		.sort()
		.map((f) => url(`/gallery/_demo/artworks/${f}`));
}

// 检查页面是否启用
if (!siteConfig.pages.gallery) {
	return Astro.redirect("/404/");
}

const title = i18n(I18nKey.gallery);
const description = i18n(I18nKey.galleryDescription);

// 构建相册数据（扫描照片、获取封面）
const albums = galleryConfig.albums.map((album) => {
	const photos = scanAlbumPhotos(album.id);
	const cover = getAlbumCover(album, photos);
	return { ...album, cover, photoCount: photos.length, photos };
});

const allPhotos = albums.flatMap((a) => a.photos);
const demoPlaceholders = Array.from({ length: 7 }, (_, i) =>
	url(`/gallery/_demo/placeholders/ph-0${i + 1}.svg`),
);

const DEMO_WORK_META = [
	{ title: "日常切片", description: "把灵感收成可复用的视觉模块。" },
	{ title: "光影节奏", description: "用缓动与比例讲清楚一张图的叙事。" },
	{ title: "柔光留白", description: "柔光蒙版与层次，留给日常留白。" },
	{ title: "漫游取景", description: "滚动与目光同向，让浏览像散步。" },
	{ title: "画布游戏", description: "画布里的自由漫游与取景。" },
	{ title: "结构巧思", description: "少一点装饰，多一点结构节奏。" },
	{ title: "静时片刻", description: "把时间感写进色块与留白。" },
] as const;

function buildWorks() {
	// 多相册：手风琴面板 = 相册
	if (albums.length >= 2) {
		return albums.slice(0, 7).map((album) => ({
			id: album.id,
			title: album.name,
			description: album.description || album.location || album.date || "",
			image: album.cover || demoPlaceholders[0],
			href: url(`/gallery/${album.id}/`),
		}));
	}

	// 单相册或仅有照片：手风琴面板 = 作品图
	const photoPool = allPhotos.length > 0 ? allPhotos : demoPlaceholders;
	return photoPool.slice(0, 7).map((image, index) => {
		const meta = DEMO_WORK_META[index % DEMO_WORK_META.length];
		const album = albums[0];
		return {
			id: `work-${index}`,
			title: meta.title,
			description: album?.description || meta.description,
			image,
			href: album ? url(`/gallery/${album.id}/`) : undefined,
		};
	});
}

const works = buildWorks();
const localAlbumPhotos = allPhotos.filter((p) => !/^https?:\/\//i.test(p));
const demoArtworks = scanDemoArtworks();
// 画布优先：本地相册图 + 原版风格 demo 画库（密度/多样性）；外链不进 WebGL
const explorerPhotos =
	localAlbumPhotos.length + demoArtworks.length > 0
		? [...localAlbumPhotos, ...demoArtworks]
		: demoPlaceholders;
const defaultViewMode = galleryConfig.defaultViewMode || "portfolio";
const columnWidth = galleryConfig.columnWidth || 240;
const homeMasonryEnabled = galleryConfig.homeMasonry?.enabled !== false;
const homeMasonryMax = galleryConfig.homeMasonry?.maxItems ?? 48;

/** 照片墙：带相册/分类元数据，供分类筛选 */
type WallPhoto = { src: string; albumId: string; category: string };
const wallPhotos: WallPhoto[] = homeMasonryEnabled
	? albums
			.flatMap((a) =>
				a.photos
					.filter((p) => !/^https?:\/\//i.test(p))
					.map((src) => ({
						src,
						albumId: a.id,
						category: a.category || "",
					})),
			)
			.slice(0, homeMasonryMax)
	: [];

// 收集所有标签用于筛选
const allTags = [...new Set(albums.flatMap((a) => a.tags || []))].sort();

/** 首页分类栏：配置顺序优先，未出现在相册中的项不显示 */
const usedCategories = new Set(
	albums.map((a) => a.category).filter((c): c is string => !!c),
);
const orderedCategories = (galleryConfig.categories || []).filter((c) =>
	usedCategories.has(c),
);
const extraCategories = [...usedCategories]
	.filter((c) => !orderedCategories.includes(c))
	.sort();
const galleryCategories = [...orderedCategories, ...extraCategories];
---

<MainGridLayout title={title} description={description}>
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-9 py-6 relative w-full overflow-hidden">
      <!-- 页面标题和描述 -->
      <div class="mb-4">
        <div class="flex items-center gap-3 mb-3">
          <div
            class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70"
          >
            <Icon is:inline name="lucide:images" class="text-[1.5rem]" />
          </div>
          <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
            {title}
          </div>
        </div>
        {description && (
          <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
            {description}
          </p>
        )}
      </div>

      <!-- 作品集 / 普通相册 双模式舞台（等比例适配卡片） -->
      <GalleryExplorer
        client:load
        works={works}
        photos={explorerPhotos}
        defaultMode={defaultViewMode}
        labels={{
          portfolio: i18n(I18nKey.galleryModePortfolio),
          normal: i18n(I18nKey.galleryModeNormal),
          viewWork: i18n(I18nKey.galleryViewWork),
          dragHint: i18n(I18nKey.galleryDragHint),
          demoHint: i18n(I18nKey.galleryDemoHint),
          empty: i18n(I18nKey.galleryNoAlbums),
        }}
      />

      <!-- Explorer 下方：本地相册照片 CSS columns 瀑布墙 -->
      {wallPhotos.length > 0 && (
        <section class="gallery-home-masonry mt-6" aria-labelledby="gallery-photo-wall-title">
          <h2
            id="gallery-photo-wall-title"
            class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-3"
          >
            {i18n(I18nKey.galleryPhotoWall)}
          </h2>
          <div
            class="gallery-masonry"
            data-gallery-photo-wall
            style={`column-count: 1; column-gap: 0.75rem; --col-width: ${columnWidth}px;`}
          >
            {wallPhotos.map((photo) => (
              <div
                class="gallery-photo-wrap"
                data-gallery-photo
                data-category={photo.category}
              >
                <PhotoCard src={photo.src} albumId="home" />
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- 搜索 + 分类栏（右侧图标对齐标签墙）+ 标签筛选 -->
      {albums.length > 0 && (
        <gallery-filter class="mb-6 mt-6 block">
          <div class="relative mb-3">
            <Icon is:inline
              name="lucide:search"
              class="absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400 dark:text-neutral-500 text-lg pointer-events-none"
            />
            <input
              type="text"
              data-search
              placeholder={i18n(I18nKey.searchAlbums)}
              class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-(--line-divider) bg-transparent text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-500 focus:border-(--primary) focus:ring-1 focus:ring-(--primary) outline-none transition-all duration-200 text-sm"
            />
          </div>

          {galleryCategories.length > 0 && (
            <section
              class="gallery-categories mb-4"
              aria-labelledby="gallery-categories-title"
            >
              <div class="gallery-categories__head">
                <h2
                  id="gallery-categories-title"
                  class="gallery-categories__title"
                >
                  {i18n(I18nKey.galleryCategories)}
                </h2>
                {/* 样式对齐 Tags.astro 标题右侧 globe/list 切换胶囊 */}
                <div
                  class="gallery-categories__mode"
                  data-gallery-category-mode-toggle
                >
                  <button
                    type="button"
                    class="gallery-categories__mode-btn"
                    data-gallery-category-mode="pills"
                    aria-label={i18n(I18nKey.galleryCategoryPills)}
                    title={i18n(I18nKey.galleryCategoryPills)}
                    aria-pressed="true"
                  >
                    <Icon
                      is:inline
                      name="lucide:globe"
                      class="gallery-categories__mode-icon gallery-categories__mode-icon--globe"
                    />
                  </button>
                  <button
                    type="button"
                    class="gallery-categories__mode-btn"
                    data-gallery-category-mode="list"
                    aria-label={i18n(I18nKey.galleryCategoryList)}
                    title={i18n(I18nKey.galleryCategoryList)}
                    aria-pressed="false"
                  >
                    <Icon
                      is:inline
                      name="lucide:list"
                      class="gallery-categories__mode-icon"
                    />
                  </button>
                </div>
              </div>

              <div
                class="gallery-categories__pills flex flex-wrap gap-2"
                data-gallery-category-view="pills"
              >
                <button
                  type="button"
                  data-category="all"
                  class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
                  data-active
                >
                  {i18n(I18nKey.all)}
                </button>
                {galleryCategories.map((cat) => (
                  <button
                    type="button"
                    data-category={cat}
                    class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
                  >
                    {cat}
                  </button>
                ))}
              </div>

              <ul
                class="gallery-categories__list hidden"
                data-gallery-category-view="list"
                hidden
              >
                <li>
                  <button
                    type="button"
                    data-category="all"
                    class="gallery-categories__list-btn"
                    data-active
                  >
                    {i18n(I18nKey.all)}
                  </button>
                </li>
                {galleryCategories.map((cat) => (
                  <li>
                    <button
                      type="button"
                      data-category={cat}
                      class="gallery-categories__list-btn"
                    >
                      {cat}
                    </button>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {allTags.length > 0 && (
            <div class="flex flex-wrap gap-2" data-gallery-tag-filters>
              <button
                type="button"
                data-tag="all"
                class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
                data-active
              >
                {i18n(I18nKey.all)}
              </button>
              {allTags.map((tag) => (
                <button
                  type="button"
                  data-tag={tag}
                  class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
                >
                  {tag}
                </button>
              ))}
            </div>
          )}
        </gallery-filter>
      )}

      <!-- 相册卡片网格（传统入口，作为双模式舞台的补充索引） -->
      {albums.length > 0 ? (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 my-4">
            {albums.map((album) => (
              <AlbumCard
                id={album.id}
                name={album.name}
                cover={album.cover}
                description={album.description}
                date={album.date}
                location={album.location}
                tags={album.tags}
                category={album.category}
                photoCount={album.photoCount}
                encrypted={!!album.password}
              />
            ))}
          </div>
          {/* 搜索无结果提示 */}
          <div class="albums-empty hidden flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500">
            <Icon is:inline name="lucide:search-x" class="text-4xl mb-3" />
            <div class="text-sm">{i18n(I18nKey.searchNoResults)}</div>
          </div>
        </>
      ) : null}
    </div>
  </div>

  <script slot="head" is:inline>
    if (!customElements.get("gallery-filter")) {
      class GalleryFilter extends HTMLElement {
        selectedTag = "all";
        selectedCategory = "all";
        categoryMode = "pills";

        constructor() {
          super();
        }

        connectedCallback() {
          this.addEventListener("click", this.handleClick);
          const input = this.querySelector("[data-search]");
          if (input) {
            input.addEventListener("input", () => this.applyFilters());
          }
        }

        disconnectedCallback() {
          this.removeEventListener("click", this.handleClick);
        }

        handleClick(e) {
          const button = e.target.closest("button");
          if (!button || !this.contains(button)) return;

          // 分类展示模式：胶囊 / 列表（对齐标签墙右侧图标）
          const mode = button.dataset.galleryCategoryMode;
          if (mode) {
            this.setCategoryMode(mode);
            return;
          }

          if (button.hasAttribute("data-category")) {
            this.selectedCategory = button.dataset.category || "all";
            this.querySelectorAll("[data-category]").forEach((f) => {
              f.removeAttribute("data-active");
            });
            this.querySelectorAll(
              `[data-category="${this.selectedCategory}"]`,
            ).forEach((f) => {
              f.setAttribute("data-active", "");
            });
            this.applyFilters();
            return;
          }

          if (button.hasAttribute("data-tag")) {
            this.selectedTag = button.dataset.tag || "all";
            this.querySelectorAll("[data-tag]").forEach((f) => {
              f.removeAttribute("data-active");
            });
            button.setAttribute("data-active", "");
            this.applyFilters();
          }
        }

        setCategoryMode(mode) {
          this.categoryMode = mode === "list" ? "list" : "pills";
          this.querySelectorAll("[data-gallery-category-mode]").forEach((btn) => {
            const on = btn.dataset.galleryCategoryMode === this.categoryMode;
            btn.setAttribute("aria-pressed", on ? "true" : "false");
          });
          this.querySelectorAll("[data-gallery-category-view]").forEach((view) => {
            const show = view.dataset.galleryCategoryView === this.categoryMode;
            view.classList.toggle("hidden", !show);
            if (show) view.removeAttribute("hidden");
            else view.setAttribute("hidden", "");
          });
        }

        applyFilters() {
          const container = this.closest(".card-base");
          if (!container) return;

          const input = this.querySelector("[data-search]");
          const query = (input?.value || "").toLowerCase().trim();
          const cards = container.querySelectorAll(".album-card");

          let hasVisible = false;

          cards.forEach((card) => {
            const cardEl = card;
            const tags = (cardEl.dataset.tags || "").split(",");
            const category = cardEl.dataset.category || "";
            const name = (
              cardEl.querySelector("h3")?.textContent || ""
            ).toLowerCase();
            const desc = (
              cardEl.querySelector("p")?.textContent || ""
            ).toLowerCase();
            const location = (
              cardEl.querySelector(".inline-flex")?.textContent || ""
            ).toLowerCase();

            const categoryMatch =
              this.selectedCategory === "all" ||
              category === this.selectedCategory;
            const tagMatch =
              this.selectedTag === "all" ||
              (this.selectedTag && tags.includes(this.selectedTag));
            const searchMatch =
              !query ||
              name.includes(query) ||
              desc.includes(query) ||
              location.includes(query) ||
              category.toLowerCase().includes(query) ||
              tags.some((t) => t.toLowerCase().includes(query));

            if (categoryMatch && tagMatch && searchMatch) {
              cardEl.style.display = "";
              cardEl.classList.add("animate-fade-in-up");
              hasVisible = true;
            } else {
              cardEl.style.display = "none";
              cardEl.classList.remove("animate-fade-in-up");
            }
          });

          // 照片墙随分类同步显隐
          container.querySelectorAll("[data-gallery-photo]").forEach((wrap) => {
            const cat = wrap.dataset.category || "";
            const show =
              this.selectedCategory === "all" || cat === this.selectedCategory;
            wrap.style.display = show ? "" : "none";
          });

          const emptyEl = container.querySelector(".albums-empty");
          if (emptyEl) {
            emptyEl.classList.toggle("hidden", hasVisible);
            emptyEl.classList.toggle("flex", !hasVisible);
          }
        }
      }
      customElements.define("gallery-filter", GalleryFilter);
    }
  </script>
</MainGridLayout>
