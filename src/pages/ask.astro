---
import MainGridLayout from "@layouts/MainGridLayout.astro";

const title = "站点问答助手";
const description = "基于站点内容回答你的问题，欢迎来问。";
---

<MainGridLayout title={title} description={description}>
    <div class="card-base z-10 relative w-full overflow-hidden flex flex-col min-h-[70vh]">
        <!-- 消息区 -->
        <div id="ask-messages" class="flex-1 overflow-y-auto p-6 space-y-4">
            <div id="ask-welcome" class="text-center py-12">
                <div class="w-16 h-16 mx-auto mb-4 rounded-2xl flex items-center justify-center text-white text-2xl font-bold" style="background: var(--primary-gradient);">
                    问
                </div>
                <h3 class="text-lg font-bold text-(--deep-text) mb-2">有什么想了解的？</h3>
                <p class="text-sm text-(--content-meta) mb-6">我基于博客的文章内容回答</p>
                <div class="flex flex-wrap gap-2 justify-center">
                    <button class="ask-chip" data-q="这个博客用了什么技术栈？">这个博客用了什么技术栈？</button>
                    <button class="ask-chip" data-q="怎么部署这个博客？">怎么部署这个博客？</button>
                    <button class="ask-chip" data-q="博主最近写了什么？">博主最近写了什么？</button>
                </div>
            </div>
        </div>

        <!-- 输入区 -->
        <div class="shrink-0 border-t border-(--line-divider) p-4">
            <div class="flex items-center gap-3">
                <input
                    id="ask-input"
                    type="text"
                    placeholder="输入你的问题..."
                    class="flex-1 h-11 px-4 rounded-xl bg-(--btn-regular-bg) text-(--deep-text) text-sm outline-none border border-transparent focus:border-(--primary) transition-colors placeholder:text-(--content-meta)"
                />
                <button
                    id="ask-send"
                    class="w-11 h-11 rounded-xl flex items-center justify-center text-white shrink-0 transition-transform hover:scale-105 active:scale-95"
                    style="background: var(--primary);"
                    aria-label="发送"
                >
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
                </button>
            </div>
        </div>
    </div>
</MainGridLayout>

<style>
    .ask-chip {
        padding: 0.5rem 1rem;
        border-radius: 9999px;
        font-size: 0.8125rem;
        background: var(--btn-regular-bg);
        color: var(--btn-content);
        border: 1px solid var(--line-divider);
        cursor: pointer;
        transition: all 0.2s;
    }
    .ask-chip:hover {
        background: var(--btn-regular-bg-hover);
        border-color: var(--primary);
    }

    .ask-msg { display: flex; gap: 0.75rem; }
    .ask-msg.me { flex-direction: row-reverse; }
    .ask-msg-avatar {
        width: 2rem; height: 2rem; border-radius: 0.5rem; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        color: white; font-size: 0.75rem; font-weight: 600;
    }
    .ask-msg-avatar.ai { background: var(--primary-gradient); }
    .ask-msg-avatar.user { background: var(--accent-cool); }
    .ask-msg-body { max-width: 78%; min-width: 0; }
    .ask-msg-bubble {
        padding: 0.75rem 1rem; border-radius: 1rem; font-size: 0.875rem; line-height: 1.6;
        white-space: pre-wrap; word-break: break-word;
    }
    .ask-msg:not(.me) .ask-msg-bubble {
        background: var(--btn-regular-bg); color: var(--deep-text);
        border-bottom-left-radius: 0.25rem;
    }
    .ask-msg.me .ask-msg-bubble {
        background: var(--primary); color: white;
        border-bottom-right-radius: 0.25rem;
    }
    .ask-msg-time { font-size: 0.625rem; color: var(--content-meta); margin-top: 0.25rem; }
    .ask-msg.me .ask-msg-time { text-align: right; }

    .ask-sources {
        margin-top: 0.375rem; padding: 0.375rem 0.75rem; border-radius: 0.5rem;
        background: var(--muted); font-size: 0.6875rem; color: var(--content-meta);
        line-height: 1.5;
    }
    .ask-sources a { color: var(--primary); text-decoration: none; }
    .ask-sources a:hover { text-decoration: underline; }

    .ask-typing { display: flex; gap: 0.25rem; padding: 0.75rem 1rem; }
    .ask-typing span {
        width: 0.4375rem; height: 0.4375rem; border-radius: 50%;
        background: var(--content-meta);
        animation: ask-bounce 1.2s ease-in-out infinite;
    }
    .ask-typing span:nth-child(2) { animation-delay: 0.15s; }
    .ask-typing span:nth-child(3) { animation-delay: 0.3s; }
    @keyframes ask-bounce {
        0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
        30% { transform: translateY(-5px); opacity: 1; }
    }

    @keyframes ask-in {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .ask-animate { animation: ask-in 0.25s var(--ease-decelerate, ease-out) both; }
</style>

<script>
    const API_BASE = "http://localhost:8080/chat/api";
    const ACCESS_TOKEN = "2777601d60679239";

    let token = null;
    let chatId = null;
    let loading = false;

    const messagesEl = document.getElementById("ask-messages");
    const inputEl = document.getElementById("ask-input");
    const sendBtn = document.getElementById("ask-send");

    function now() {
        return new Date().toLocaleTimeString("zh-CN", { hour: "2-digit", minute: "2-digit" });
    }

    function escapeHtml(s) {
        return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    function addMsg(role, content, sources) {
        const welcome = document.getElementById("ask-welcome");
        if (welcome) welcome.remove();
        const isMe = role === "user";
        const row = document.createElement("div");
        row.className = `ask-msg ${isMe ? "me" : ""} ask-animate`;
        let sourcesHtml = "";
        if (sources && sources.length) {
            sourcesHtml = `<div class="ask-sources">📚 ${sources.map(s => `<a href="${s.url}" target="_blank">${escapeHtml(s.title)}</a>`).join(" · ")}</div>`;
        }
        row.innerHTML = `
            <div class="ask-msg-avatar ${isMe ? "user" : "ai"}">${isMe ? "我" : "问"}</div>
            <div class="ask-msg-body">
                <div class="ask-msg-bubble">${escapeHtml(content)}</div>
                ${sourcesHtml}
                <div class="ask-msg-time">${now()}</div>
            </div>`;
        messagesEl.appendChild(row);
        messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function addTyping() {
        const row = document.createElement("div");
        row.className = "ask-msg ask-animate";
        row.id = "ask-typing-row";
        row.innerHTML = `
            <div class="ask-msg-avatar ai">问</div>
            <div class="ask-msg-body">
                <div class="ask-msg-bubble ask-typing"><span></span><span></span><span></span></div>
            </div>`;
        messagesEl.appendChild(row);
        messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function removeTyping() {
        const t = document.getElementById("ask-typing-row");
        if (t) t.remove();
    }

    async function ensureSession() {
        if (!token) {
            const res = await fetch(`${API_BASE}/auth/anonymous`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ access_token: ACCESS_TOKEN }),
            });
            const data = await res.json();
            if (data.code !== 200) throw new Error("auth failed");
            token = data.data;
        }
        if (!chatId) {
            const res = await fetch(`${API_BASE}/open`, {
                headers: { Authorization: "Bearer " + token },
            });
            const data = await res.json();
            if (data.code !== 200) throw new Error("open failed");
            chatId = data.data;
        }
    }

    async function sendMsg() {
        const text = inputEl.value.trim();
        if (!text || loading) return;
        loading = true;
        sendBtn.style.opacity = "0.5";
        inputEl.disabled = true;

        addMsg("user", text);
        inputEl.value = "";
        addTyping();

        try {
            await ensureSession();
            const res = await fetch(`${API_BASE}/chat_message/${chatId}`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    Authorization: "Bearer " + token,
                },
                body: JSON.stringify({ message: text, stream: false, re_chat: false }),
            });
            const data = await res.json();
            removeTyping();
            if (data.code === 200 && data.data) {
                const answer = data.data.content || "（没拿到回答）";
                const sources = (data.data.paragraph_list || []).map(p => ({
                    title: p.title || p.document_name || "文章",
                    url: p.source_url || "#",
                }));
                addMsg("assistant", answer, sources);
            } else {
                addMsg("assistant", `出了点问题：${data.message || "未知错误"}`);
            }
        } catch (e) {
            removeTyping();
            addMsg("assistant", "连不上问答服务。请确认本机 MaxKB（localhost:8080）在跑，然后刷新重试。");
        }

        loading = false;
        sendBtn.style.opacity = "1";
        inputEl.disabled = false;
        inputEl.focus();
    }

    sendBtn.addEventListener("click", sendMsg);
    inputEl.addEventListener("keydown", e => {
        if (e.key === "Enter") sendMsg();
    });
    document.querySelectorAll(".ask-chip").forEach(btn => {
        btn.addEventListener("click", () => {
            inputEl.value = btn.dataset.q || btn.textContent;
            sendMsg();
        });
    });
</script>
