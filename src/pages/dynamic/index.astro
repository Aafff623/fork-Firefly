---
import path from "node:path";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import DynamicTimeline from "@/components/pages/dynamic/react/DynamicTimelineFeed";
import { agentPersonas } from "@/config/agentPersonas";
import {
	commentConfig,
	dynamicConfig,
	profileConfig,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/dynamic.css";
import { DYNAMIC_KIND_LABEL } from "@/utils/dynamic-utils";
import { loadDynamicEntries } from "@/utils/load-dynamic-entries";
import { url } from "@/utils/url-utils";

if (!siteConfig.pages.dynamic) {
	return Astro.redirect("/404/");
}

const title = dynamicConfig.title || i18n(I18nKey.dynamic);
const description =
	dynamicConfig.description || i18n(I18nKey.dynamicDescription);
const itemsPerPage = Math.max(1, dynamicConfig.itemsPerPage ?? 10);
const showInlineComments = Boolean(
	dynamicConfig.showComment !== false &&
		commentConfig.type &&
		commentConfig.type !== "none",
);
const dataUrl = dynamicConfig.apiUrl?.startsWith("http")
	? dynamicConfig.apiUrl
	: url(dynamicConfig.apiUrl || "/api/dynamic.json");
const memos = dynamicConfig.memos;
/** 全量只在服务端计数；hydration 只塞首批，其余客户端拉 /api/dynamic.json + 滚动追加 */
const allEntries = memos?.enable ? undefined : await loadDynamicEntries();
const entryCount = allEntries?.length ?? 0;
const initialEntries = allEntries?.slice(0, itemsPerPage);

const kindLegend = [
	{ kind: "status", label: DYNAMIC_KIND_LABEL.status },
	{ kind: "note", label: DYNAMIC_KIND_LABEL.note },
] as const;

const agentLegend = Object.entries(agentPersonas).map(([key, persona]) => ({
	key,
	label: persona.name,
}));

const profileUrl = url(dynamicConfig.profileUrl || "/about/");

/** 与 ImageWrapper 同策略：src/ 本地图走 Astro 优化 URL，勿直接拼 /assets/… */
async function resolveAvatarUrl(src: string): Promise<string> {
	if (!src) return "";
	if (
		src.startsWith("http://") ||
		src.startsWith("https://") ||
		src.startsWith("//") ||
		src.startsWith("data:")
	) {
		return src;
	}
	if (src.startsWith("/")) return url(src);

	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{png,jpg,jpeg,webp,avif}",
		{ import: "default" },
	);
	const normalizedPath = path
		.normalize(path.join("../../", src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(`[dynamic] avatar not found: ${normalizedPath}`);
		return "";
	}
	const meta = await file();
	const optimized = await getImage({
		src: meta,
		width: 96,
		height: 96,
	});
	return optimized.src;
}

const avatarUrl = await resolveAvatarUrl(profileConfig.avatar || "");
---

<MainGridLayout title={title} description={description}>
	<section class="dynamic-page" aria-labelledby="dynamic-page-title">
		<header class="dynamic-page-header card-base hero-bg">
			<div class="dynamic-page-heading">
				<div class="dynamic-page-title-row">
					<h1 id="dynamic-page-title" class="dynamic-page-title">{title}</h1>
					<span class="dynamic-count" aria-label={i18n(I18nKey.dynamic)}>
						<strong data-dynamic-page-count>{entryCount}</strong>
						<span>{i18n(I18nKey.dynamic)}</span>
					</span>
				</div>
				{description && <p class="dynamic-page-lede">{description}</p>}
			</div>

			<div class="dynamic-toolbar">
				<div class="dynamic-filter">
					<label class="dynamic-search">
						<span class="sr-only">{i18n(I18nKey.dynamicSearch)}</span>
						<Icon is:inline name="lucide:search" />
						<input
							type="search"
							data-dynamic-search
							placeholder={i18n(I18nKey.dynamicSearch)}
						/>
					</label>
					<label class="dynamic-form-select dynamic-year-select">
						<span class="sr-only">{i18n(I18nKey.year)}</span>
						<Icon is:inline name="lucide:calendar-days" />
						<select data-year-select aria-label={i18n(I18nKey.year)}>
							<option value="all">{i18n(I18nKey.dynamicAllYears)}</option>
						</select>
						<Icon is:inline name="lucide:chevron-down" />
					</label>
					<label class="dynamic-form-select dynamic-kind-select">
						<span class="sr-only">{i18n(I18nKey.dynamicKindFilter)}</span>
						<Icon is:inline name="lucide:tags" />
						<select
							data-kind-select
							aria-label={i18n(I18nKey.dynamicKindFilter)}
						>
							<option value="all">{i18n(I18nKey.dynamicAllKinds)}</option>
							{
								kindLegend.map(({ kind, label }) => (
									<option value={kind}>{label}</option>
								))
							}
						</select>
						<Icon is:inline name="lucide:chevron-down" />
					</label>
					<label class="dynamic-form-select dynamic-agent-select">
						<span class="sr-only">{i18n(I18nKey.dynamicAgentFilter)}</span>
						<Icon is:inline name="lucide:users" />
						<select
							data-agent-select
							aria-label={i18n(I18nKey.dynamicAgentFilter)}
						>
							<option value="all">{i18n(I18nKey.dynamicAllAgents)}</option>
							{/* 园主置顶：无 author 字段的动态归园主，别只剩 AI 没大没小 */}
							<option value="owner">{i18n(I18nKey.agentsOwner)}</option>
							{
								agentLegend.map(({ key, label }) => (
									<option value={key}>{label}</option>
								))
							}
						</select>
						<Icon is:inline name="lucide:chevron-down" />
					</label>
				</div>
			</div>
		</header>

		<DynamicTimeline
			client:load
			source={dataUrl}
			{itemsPerPage}
			showComments={showInlineComments}
			emptyText={i18n(I18nKey.dynamicEmpty)}
			noResultsText={i18n(I18nKey.dynamicNoResults)}
			loadingText={i18n(I18nKey.dynamicLoading)}
			allYearsText={i18n(I18nKey.dynamicAllYears)}
			timezone={siteConfig.timezone || "UTC"}
			{memos}
			initialEntries={initialEntries}
			profileName={profileConfig.name}
			{profileUrl}
			{avatarUrl}
			commentsLabel={i18n(I18nKey.comments)}
			pinnedLabel={i18n(I18nKey.pinned)}
			ownerBadgeLabel={i18n(I18nKey.agentsOwner)}
			collapseGalleryLabel={i18n(I18nKey.dynamicCollapseGallery)}
			viewOriginalLabel={i18n(I18nKey.dynamicViewOriginal)}
			prevImageLabel={i18n(I18nKey.dynamicPreviousImage)}
			nextImageLabel={i18n(I18nKey.dynamicNextImage)}
			viewImageLabel={i18n(I18nKey.dynamicViewImage)}
			selectImageLabel={i18n(I18nKey.dynamicSelectImage)}
			loadMoreLabel={i18n(I18nKey.dynamicLoadMore)}
		/>
	</section>
</MainGridLayout>
