---
import path from "node:path";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import { agentPersonas } from "@/config/agentPersonas";
import { profileConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { url } from "@/utils/url-utils";

// 检查页面是否启用
if (!siteConfig.pages.agents) {
	return Astro.redirect("/404/");
}

const title = i18n(I18nKey.agents);
const description = i18n(I18nKey.agentsDescription);
const ownerBadge = i18n(I18nKey.agentsOwner);

/** 与 dynamic/index.astro 同策略：src/ 本地图走 Astro 优化 URL */
async function resolveAvatarUrl(src: string): Promise<string> {
	if (!src) return "";
	if (
		src.startsWith("http://") ||
		src.startsWith("https://") ||
		src.startsWith("//") ||
		src.startsWith("data:")
	) {
		return src;
	}
	if (src.startsWith("/")) return url(src);

	// glob 基必须是 src/assets（本文件在 src/pages/ 下，一层 ../）。
	// 之前误写 "../../**"（仓库根）把 public/ 与 tmp/ 全部图片卷进 SSR 模块图，
	// 产出数千个 _astro 孤儿副本（pets/garden-note 双份 ~16MB 即此成因）
	const files = import.meta.glob<ImageMetadata>(
		"../assets/**/*.{png,jpg,jpeg,webp,avif}",
		{ import: "default" },
	);
	const normalizedPath = path
		.normalize(path.join("../", src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(`[agents] avatar not found: ${normalizedPath}`);
		return "";
	}
	const meta = await file();
	const optimized = await getImage({
		src: meta,
		width: 96,
		height: 96,
	});
	return optimized.src;
}

const ownerAvatar = await resolveAvatarUrl(profileConfig.avatar || "");
const ownerMail =
	profileConfig.links
		.find((link) => link.url.startsWith("mailto:"))
		?.url.replace(/^mailto:/, "") || "";

const agents = Object.values(agentPersonas);
---

<MainGridLayout title={title} description={description}>
	<div class="card-base z-10 relative w-full p-6 md:p-8">
		<div class="flex items-center gap-3 mb-3">
			<div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
				<Icon is:inline name="lucide:users" class="text-[1.5rem]" />
			</div>
			<div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
				{title}
			</div>
		</div>
		{description && (
			<p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-6">
				{description}
			</p>
		)}

		<ul class="agents-list" role="list">
			<li class="agents-item">
				<img
					src={ownerAvatar}
					alt=""
					width="56"
					height="56"
					class="agents-avatar"
					loading="lazy"
					decoding="async"
				/>
				<div class="agents-item-body">
					<div class="agents-item-head">
						<strong class="agents-name">{profileConfig.name}</strong>
						<span class="dynamic-author-badge">{ownerBadge}</span>
					</div>
					{profileConfig.bio && <p class="agents-tone">{profileConfig.bio}</p>}
					{ownerMail && (
						<a class="agents-mail" href={`mailto:${ownerMail}`}>{ownerMail}</a>
					)}
				</div>
			</li>
			{agents.map((persona) => (
				<li class="agents-item">
					<img
						src={url(persona.avatar)}
						alt=""
						width="56"
						height="56"
						class="agents-avatar"
						data-agent
						loading="lazy"
						decoding="async"
					/>
					<div class="agents-item-body">
						<div class="agents-item-head">
							<strong class="agents-name">{persona.name}</strong>
							<span class="dynamic-author-badge" data-agent>{persona.name}</span>
						</div>
						<p class="agents-tone">{persona.tone}</p>
						<a class="agents-mail" href={`mailto:${persona.mail}`}>{persona.mail}</a>
					</div>
				</li>
			))}
		</ul>
	</div>
</MainGridLayout>

<style>
	.agents-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.agents-item {
		display: flex;
		align-items: flex-start;
		gap: 0.85rem;
		padding: 0.85rem 1rem;
		border-radius: 0.85rem;
		background: color-mix(in oklab, var(--content-meta) 5.5%, transparent);
		border: 1px solid color-mix(in oklab, var(--content-meta) 10%, transparent);
	}

	.agents-avatar {
		width: 3.5rem;
		height: 3.5rem;
		flex: 0 0 3.5rem;
		border-radius: 50%;
		object-fit: cover;
		object-position: center;
		background: color-mix(in oklab, var(--content-meta) 8%, transparent);
	}

	.agents-avatar[data-agent] {
		object-fit: contain;
	}

	.agents-item-body {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.agents-item-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
	}

	.agents-name {
		font-size: 1rem;
		font-weight: 700;
	}

	.agents-tone {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.55;
		color: color-mix(in oklab, var(--deep-text) 92%, var(--content-meta));
	}

	.agents-mail {
		font-size: 0.8rem;
		color: var(--content-meta);
		text-decoration: none;
	}

	.agents-mail:hover {
		color: var(--primary);
	}

	:root.dark .agents-item {
		background: color-mix(in oklab, #fff 4.5%, transparent);
		border-color: color-mix(in oklab, #fff 8%, transparent);
	}
</style>
