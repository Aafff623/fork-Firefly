---
/**
 * 全站标签页：黑板立体球 + 粉笔色兜底列表。
 */
import { Icon } from "astro-icon/components";
import TagChalkSphere from "@/components/widget/TagChalkSphere.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getTagList } from "@/utils/content-utils";

const tags = await getTagList();
const ranked = [...tags]
	.map((t) => ({ name: t.name.trim(), count: t.count }))
	.filter((t) => t.name)
	.sort((a, b) => {
		if (b.count !== a.count) return b.count - a.count;
		return a.name.localeCompare(b.name, "zh-CN");
	});
---

<MainGridLayout title={i18n(I18nKey.tags)} description={i18n(I18nKey.allTags)}>
  <div class="tags-page card-base px-6 py-5 mb-4 sm:px-8 sm:py-6">
    <header class="tags-page__head">
      <h1 class="tags-page__title">{i18n(I18nKey.tags)}</h1>
      <p class="tags-page__meta">
        {i18n(I18nKey.allTags)} · {tags.length} {i18n(I18nKey.tagsCount)}
      </p>
    </header>

    {
      ranked.length > 0 ? (
        <div class="tags-page__sphere">
          <TagChalkSphere
            title=""
            tags={ranked}
            limit={Math.min(36, ranked.length)}
            radius={120}
          />
        </div>
      ) : (
        <div class="tags-page__empty">
          <Icon is:inline name="lucide:tags" class="tags-page__empty-icon" aria-hidden="true" />
          <p>{i18n(I18nKey.noData)}</p>
        </div>
      )
    }
  </div>
</MainGridLayout>

<style>
  .tags-page__head {
    margin-bottom: 1.1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgb(0 0 0 / 0.08);
  }

  :global(html.dark) .tags-page__head {
    border-bottom-color: rgb(255 255 255 / 0.08);
  }

  .tags-page__title {
    margin: 0 0 0.25rem;
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--primary);
    font-family:
      "Iowan Old Style",
      "Palatino Linotype",
      Palatino,
      "Songti SC",
      "Noto Serif SC",
      Georgia,
      serif;
  }

  .tags-page__meta {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-color-muted, oklch(0.5 0.02 70));
  }

  .tags-page__sphere {
    max-width: 36rem;
    margin: 0 auto;
  }

  .tags-page__sphere :global(.tag-sphere__frame) {
    min-height: 300px;
  }

  .tags-page__sphere :global(.tag-sphere__stage),
  .tags-page__sphere :global(.tag-sphere__cloud) {
    width: 240px !important;
    height: 240px !important;
  }

  .tags-page__empty {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--text-color-muted, oklch(0.5 0.02 70));
  }

  .tags-page__empty-icon {
    display: block;
    margin: 0 auto 0.75rem;
    font-size: 2.5rem;
    opacity: 0.55;
  }
</style>
