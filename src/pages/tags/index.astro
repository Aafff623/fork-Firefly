---
/**
 * 全站标签页：与侧栏同一套砖墙材质，按篇数排；热门砖加宽。
 * 不再用胶囊渐变 pill（旧 tag-item）。
 */
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getTagList } from "@/utils/content-utils";
import { getTagUrl } from "@/utils/url-utils";

const tags = await getTagList();
const ranked = [...tags].sort((a, b) => {
	if (b.count !== a.count) return b.count - a.count;
	return a.name.localeCompare(b.name, "zh-CN");
});
const maxCount = ranked[0]?.count ?? 1;

function brickSpan(count: number): 1 | 2 {
	if (maxCount <= 1) return 1;
	return count / maxCount >= 0.45 ? 2 : 1;
}
---

<MainGridLayout title={i18n(I18nKey.tags)} description={i18n(I18nKey.allTags)}>
  <div class="tags-page card-base px-6 py-5 mb-4 sm:px-8 sm:py-6">
    <header class="tags-page__head">
      <h1 class="tags-page__title">{i18n(I18nKey.tags)}</h1>
      <p class="tags-page__meta">
        {i18n(I18nKey.allTags)} · {tags.length} {i18n(I18nKey.tagsCount)}
      </p>
    </header>

    {
      ranked.length > 0 ? (
        <div
          class="tag-wall tag-wall--page"
          role="list"
          aria-label={i18n(I18nKey.tagWall)}
        >
          {ranked.map((t) => {
            const name = t.name.trim();
            const span = brickSpan(t.count);
            return (
              <a
                role="listitem"
                href={getTagUrl(name)}
                class:list={[
                  "tag-wall__brick",
                  span === 2 && "tag-wall__brick--wide",
                ]}
                data-tag={name}
                aria-label={`${name}，${t.count} 篇`}
                title={`${name} · ${t.count}`}
              >
                <span class="tag-wall__name">#{name}</span>
                <span class="tag-wall__count">{t.count}</span>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="tags-page__empty">
          <Icon is:inline name="lucide:tags" class="tags-page__empty-icon" aria-hidden="true" />
          <p>{i18n(I18nKey.noData)}</p>
        </div>
      )
    }
  </div>
</MainGridLayout>

<style>
  .tags-page__head {
    margin-bottom: 1.1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgb(0 0 0 / 0.08);
  }

  :global(html.dark) .tags-page__head {
    border-bottom-color: rgb(255 255 255 / 0.08);
  }

  .tags-page__title {
    margin: 0 0 0.25rem;
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--primary);
    font-family:
      "Iowan Old Style",
      "Palatino Linotype",
      Palatino,
      "Songti SC",
      "Noto Serif SC",
      Georgia,
      serif;
  }

  .tags-page__meta {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-color-muted, oklch(0.5 0.02 70));
  }

  .tags-page__empty {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--text-color-muted, oklch(0.5 0.02 70));
  }

  .tags-page__empty-icon {
    display: block;
    margin: 0 auto 0.75rem;
    font-size: 2.5rem;
    opacity: 0.55;
  }

  /* 全页墙：比侧栏更宽、行更高；热门砖横跨两格 */
  :global(.tag-wall.tag-wall--page) {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    grid-auto-rows: 2.75rem !important;
    gap: 4px !important;
    padding: 6px !important;
  }

  @media (min-width: 640px) {
    :global(.tag-wall.tag-wall--page) {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
      grid-auto-rows: 3rem !important;
    }
  }

  @media (min-width: 900px) {
    :global(.tag-wall.tag-wall--page) {
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    }
  }

  :global(.tag-wall.tag-wall--page .tag-wall__brick--wide) {
    grid-column: span 2;
  }

  :global(.tag-wall.tag-wall--page .tag-wall__name) {
    font-size: 0.78rem;
  }

  :global(.tag-wall.tag-wall--page .tag-wall__count) {
    font-size: 0.62rem;
  }
</style>
