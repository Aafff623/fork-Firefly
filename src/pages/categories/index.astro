---
/**
 * 分类页：软木板 + 便利贴墙。
 */
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getCategoryList } from "@/utils/content-utils";

const categories = await getCategoryList();
const totalPosts = categories.reduce((sum, cat) => sum + cat.count, 0);
const maxCount = Math.max(...categories.map((c) => c.count), 1);

function noteWide(count: number): boolean {
	if (maxCount <= 1) return false;
	return count / maxCount >= 0.45;
}
---

<MainGridLayout title={i18n(I18nKey.categories)}>
  <div class="card-base px-6 py-5 mb-4 sm:px-8 sm:py-6">
    <div class="text-2xl font-bold text-(--primary) mb-2">
      {i18n(I18nKey.categories)}
    </div>
    <p class="text-30 text-sm">
      {i18n(I18nKey.allCategories)} · {totalPosts} {i18n(I18nKey.postsCount)}
    </p>
  </div>

  {
    categories.length > 0 ? (
      <div
        class="category-cork card-base mb-4"
        role="list"
        aria-label={i18n(I18nKey.categories)}
      >
        <div class="category-cork__board">
          {categories.map((category, index) => (
            <a
              role="listitem"
              href={category.url}
              class:list={[
                "category-cork__note",
                "onload-animation",
                noteWide(category.count) && "category-cork__note--wide",
              ]}
              style={`animation-delay: calc(var(--content-delay, 0ms) + ${index * 40}ms);`}
              title={`${category.name} · ${category.count}`}
            >
              <span class="category-cork__name">{category.name}</span>
              <span class="category-cork__count">
                {category.count} {i18n(I18nKey.postsCount)}
              </span>
            </a>
          ))}
        </div>
      </div>
    ) : (
      <div class="card-base px-8 py-12 text-center">
        <Icon is:inline name="lucide:folder-x" class="text-5xl text-30 mx-auto mb-4" />
        <p class="text-30">{i18n(I18nKey.noData)}</p>
      </div>
    )
  }
</MainGridLayout>

<style>
  .category-cork {
    --postit-ink: #1c1c1c;
    --postit-y: #fef9c3;
    --postit-p: #fce7f3;
    --postit-b: #dbeafe;
    --postit-g: #dcfce7;
    --postit-o: #ffedd5;
    --cork: #c9a66b;
    --cork-dot: #b8925a;
    padding: 1rem 1rem 1.15rem;
  }

  :global(html.dark) .category-cork {
    --postit-ink: #1a1814;
    --postit-y: #e8dfa0;
    --postit-p: #e4c0d0;
    --postit-b: #b8cce0;
    --postit-g: #b8dcc0;
    --postit-o: #e4c8a8;
    --cork: #5c4a36;
    --cork-dot: #4a3b2c;
  }

  .category-cork__board {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 12px;
    padding: 16px 12px 14px;
    border-radius: 0.75rem;
    background-color: var(--cork);
    background-image:
      radial-gradient(circle at 18% 12%, rgb(255 248 235 / 0.38), transparent 52%),
      radial-gradient(var(--cork-dot) 1px, transparent 1px);
    background-size: auto, 10px 10px;
    box-shadow:
      inset 0 0 0 1px rgb(90 60 30 / 0.22),
      0 2px 8px rgb(60 40 20 / 0.12);
  }

  @media (min-width: 640px) {
    .category-cork__board {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .category-cork__board {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .category-cork__note {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-height: 5.5rem;
    padding: 1.35rem 0.85rem 0.75rem;
    text-decoration: none;
    color: var(--postit-ink);
    border: 1.5px solid rgb(28 28 28 / 0.72);
    box-shadow: 2px 3px 0 rgb(28 28 28 / 0.14);
    transform: rotate(var(--note-rot, -1deg));
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
    background: var(--postit-y);
  }

  .category-cork__note::before {
    content: "";
    position: absolute;
    top: -7px;
    left: 50%;
    width: 48px;
    height: 14px;
    transform: translateX(-50%) rotate(-2deg);
    border-radius: 2px;
    background-color: rgb(253 224 71 / 0.72);
    background-image: repeating-linear-gradient(
      90deg,
      transparent 0 3px,
      rgb(255 255 255 / 0.18) 3px 4px
    );
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .category-cork__board > .category-cork__note:nth-child(5n + 1) {
    --note-rot: -2deg;
    background: var(--postit-y);
  }
  .category-cork__board > .category-cork__note:nth-child(5n + 2) {
    --note-rot: 1.5deg;
    background: var(--postit-p);
  }
  .category-cork__board > .category-cork__note:nth-child(5n + 3) {
    --note-rot: -1deg;
    background: var(--postit-b);
  }
  .category-cork__board > .category-cork__note:nth-child(5n + 4) {
    --note-rot: 2deg;
    background: var(--postit-g);
  }
  .category-cork__board > .category-cork__note:nth-child(5n + 5) {
    --note-rot: -1.4deg;
    background: var(--postit-o);
  }

  .category-cork__note--wide {
    grid-column: span 2;
  }

  .category-cork__name {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.25;
    word-break: break-word;
  }

  .category-cork__count {
    font-size: 0.78rem;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  @media (hover: hover) {
    .category-cork__note:hover {
      z-index: 2;
      transform: rotate(0deg) translateY(-3px);
      box-shadow: 3px 6px 0 rgb(28 28 28 / 0.18);
    }
  }

  .category-cork__note:focus-visible {
    outline: 2px solid #c9a227;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .category-cork__note {
      transition: none;
      transform: none !important;
    }
  }
</style>
