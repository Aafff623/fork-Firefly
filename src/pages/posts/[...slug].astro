---
import { render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import EncryptedPost from "@components/features/EncryptedPost.astro";
import KatexManager from "@components/features/KatexManager.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getRelatedPosts, getSortedPosts } from "@utils/content-utils";
import {
	getFileDirFromPath,
	getPostUrlBySlug,
	toPostSlug,
} from "@utils/url-utils";
import { LEGACY_REDIRECT_TARGETS } from "@utils/legacy-course-redirects";
import { Icon } from "astro-icon/components";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import CoverImage from "@/components/common/CoverImage.astro";
import PostMetadata from "@/components/layout/PostMeta.astro";
import RelatedHighlight from "@/components/misc/RelatedHighlight.astro";
import ShareBar from "@/components/misc/ShareBar.astro";
import { coverImageConfig } from "@/config/coverImageConfig";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import { url } from "@/utils/url-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	const postPaths = blogEntries.map((entry) => {
		// id → slug；草稿箱 `_draftbox/<slug>` 剥前缀，本地预览 URL 与毕业后一致
		const slug = toPostSlug(entry.id);
		return {
			params: { slug },
			props: { entry },
		};
	});
	// 课程合订后遗留的旧分节 URL：物理生成 meta-refresh 跳转页，兜底外链与搜索引擎旧收录
	const legacyRedirectPaths = LEGACY_REDIRECT_TARGETS.flatMap(({ slugs, to }) =>
		slugs.map((slug) => ({
			params: { slug },
			props: { legacyRedirectTo: to },
		})),
	);
	return [...postPaths, ...legacyRedirectPaths];
}

const { entry, legacyRedirectTo } = Astro.props;

const getDirectImageUrl = (src: string | undefined): string | null => {
	if (!src) return null;
	if (
		src.startsWith("http://") ||
		src.startsWith("https://") ||
		src.startsWith("//") ||
		src.startsWith("data:")
	) {
		return src;
	}
	return src.startsWith("/") ? url(src) : null;
};

dayjs.extend(utc);

// 文章数据计算整体收进函数：旧分节跳转请求没有 entry，模板走跳转分支，不触发渲染
async function computePostData(postEntry: NonNullable<typeof entry>) {
	const { Content, headings } = await render(postEntry);

	const { remarkPluginFrontmatter } = await render(postEntry);

	const bannerPostMeta = {
		title: postEntry.data.title,
		description: postEntry.data.description,
		published: postEntry.data.published,
		updated: postEntry.data.updated,
		words: remarkPluginFrontmatter.words,
		minutes: remarkPluginFrontmatter.minutes,
	};

	// 处理随机图：如果image为"api"，则从配置的API获取随机图
	const processedImage = processCoverImageSync(postEntry.data.image, postEntry.id);
	const apiUrls = getApiUrlList(postEntry.data.image, postEntry.id);
	const showPostCover = Boolean(processedImage && coverImageConfig.enableInPost);
	const usePostCoverOverlay =
		showPostCover && (coverImageConfig.enableInPostOverlay ?? true);

	// 海报优先复用页面上已经优化过的图片，本地源路径不再单独导入。
	const posterCoverUrl = showPostCover ? null : getDirectImageUrl(processedImage);
	const posterCoverSelector = showPostCover ? "#post-cover img" : null;
	const posterAvatarUrl = getDirectImageUrl(profileConfig.avatar);
	const posterAvatarSelector = profileConfig.avatar
		? ".profile-avatar-image img"
		: null;

	const jsonLd = {
		"@context": "https://schema.org",
		"@type": "BlogPosting",
		headline: postEntry.data.title,
		description: postEntry.data.description || postEntry.data.title,
		keywords: postEntry.data.tags,
		author: {
			"@type": "Person",
			name: profileConfig.name,
			url: Astro.site,
		},
		datePublished: formatDateToYYYYMMDD(postEntry.data.published),
		inLanguage: postEntry.data.lang
			? postEntry.data.lang.replace("_", "-")
			: siteConfig.lang.replace("_", "-"),
		// TODO include cover image here
	};

	const relatedPosts = await getRelatedPosts(postEntry, 3);
	const relatedHighlight = relatedPosts[0] ?? null;

	return {
		Content,
		headings,
		remarkPluginFrontmatter,
		bannerPostMeta,
		processedImage,
		apiUrls,
		showPostCover,
		usePostCoverOverlay,
		posterCoverUrl,
		posterCoverSelector,
		posterAvatarUrl,
		posterAvatarSelector,
		jsonLd,
		relatedPosts,
		relatedHighlight,
	};
}

const postData = entry ? await computePostData(entry) : null;
const {
	Content,
	headings,
	remarkPluginFrontmatter,
	bannerPostMeta,
	processedImage,
	apiUrls,
	showPostCover,
	usePostCoverOverlay,
	posterCoverUrl,
	posterCoverSelector,
	posterAvatarUrl,
	posterAvatarSelector,
	jsonLd,
	relatedPosts,
	relatedHighlight,
} = (postData ?? {}) as ReturnType<typeof computePostData>;
---

{
  legacyRedirectTo ? (
    <html>
      <head>
        <meta charset="utf-8" />
        <meta http-equiv="refresh" content={`0; url=${legacyRedirectTo}`} />
        <title>内容已合并</title>
      </head>
      <body>
        <p>本页内容已并入课程合订本，正在跳转…</p>
        <p><a href={legacyRedirectTo}>如未自动跳转，请点此继续</a></p>
      </body>
    </html>
  ) : (
<MainGridLayout
  banner={processedImage}
  title={entry.data.title}
  description={entry.data.description}
  lang={entry.data.lang}
  setOGTypeArticle={true}
  postSlug={entry.id}
  postCategory={entry.data.category || undefined}
  postTags={entry.data.tags || []}
  postThemeTags={entry.data.themeTags || []}
  relatedPosts={relatedPosts}
  currentPostId={entry.id}
  headings={headings}
  encrypted={!!entry.data.password}
  bannerPostMeta={bannerPostMeta}
>
  <!-- KaTeX 按需加载 - 仅在文章页面 -->
  <KatexManager slot="head" />
  
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4"
  >
    <div
      id="post-container"
      class:list={[
        "card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
        {},
      ]}
    >
      {
        usePostCoverOverlay && processedImage && (
          <div class="-mx-6 md:-mx-9 -mt-6 mb-6 h-48 md:h-64 relative onload-animation">
            <CoverImage
              id="post-cover"
              src={processedImage}
              basePath={getFileDirFromPath(entry.filePath || "")}
              class="h-full"
              preview={false}
              apiUrls={apiUrls}
            />
            <div class="absolute inset-x-4 top-3 z-10 flex flex-wrap items-center justify-end gap-x-3 gap-y-1 text-xs font-medium text-white drop-shadow-[0_1px_2px_rgb(0_0_0/0.9)]">
              <div class="flex items-center gap-1 whitespace-nowrap">
                <Icon is:inline name="lucide:file-text" class="text-base" />
                <span>
                  {remarkPluginFrontmatter.words}
                  {" " + i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}
                </span>
              </div>
              <div class="flex items-center gap-1 whitespace-nowrap">
                <Icon is:inline name="lucide:clock" class="text-base" />
                <span>
                  {remarkPluginFrontmatter.minutes}
                  {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                </span>
              </div>
              {entry.data.password && (
                <div class="flex items-center gap-1 whitespace-nowrap">
                  <Icon is:inline name="lucide:lock" class="text-base" />
                  <span>{i18n(I18nKey.postEncrypted)}</span>
                </div>
              )}
            </div>
            <div class="absolute inset-x-0 bottom-0 px-6 md:px-9 pt-10 pb-3 bg-gradient-to-t from-black/80 via-black/45 to-transparent">
              <div data-pagefind-body data-pagefind-weight="10">
                <div
                  data-pagefind-meta="title"
                  class="post-banner-title mb-2 text-xl md:text-2xl font-bold leading-tight text-white"
                >
                  {entry.data.title}
                </div>
                <span data-pagefind-meta="tags" class="sr-only">
                  {[...(entry.data.tags || []), ...(entry.data.themeTags || [])].join(" ")}
                </span>
              </div>
              <PostMetadata
                variant="cover"
                className="gap-x-4 gap-y-1"
                published={entry.data.published}
                updated={entry.data.updated}
                category={entry.data.category || undefined}
                tags={entry.data.tags}
                id={entry.id}
              />
            </div>
          </div>
        )
      }

      <!-- word count and reading time -->
      {
        !usePostCoverOverlay && (
          <div
            class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation"
          >
            <div class="flex flex-row items-center">
              <div
                class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
              >
                <Icon is:inline name="lucide:file-text" />
              </div>
              <div class="text-sm">
                {remarkPluginFrontmatter.words}
                {" " + i18n(I18nKey.wordsCount)}
              </div>
            </div>
            <div class="flex flex-row items-center">
              <div
                class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
              >
                <Icon is:inline name="lucide:clock" />
              </div>
              <div class="text-sm">
                {remarkPluginFrontmatter.minutes}
                {
                  " " +
                    i18n(
                      remarkPluginFrontmatter.minutes === 1
                        ? I18nKey.minuteCount
                        : I18nKey.minutesCount
                    )
                }
              </div>
            </div>
            {entry.data.password && (
              <div class="flex flex-row items-center">
                <div
                  class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
                >
                  <Icon is:inline name="lucide:lock" />
                </div>
                <div class="text-sm">
                  {i18n(I18nKey.postEncrypted)}
                </div>
              </div>
            )}
          </div>
        )
      }

      <!-- title -->
      {
        !usePostCoverOverlay && (
          <div class="relative onload-animation">
            <div data-pagefind-body data-pagefind-weight="10">
              <div
                data-pagefind-meta="title"
                class="transition w-full block font-bold mb-3
                          post-article-title-art text-3xl md:text-[2.25rem]/[2.75rem]
                          text-black/90 dark:text-white/90
                          md:before:w-1 before:h-5 before:rounded-md before:bg-(--primary)
                          before:absolute before:top-3 before:-left-4.5"
              >
                {entry.data.title}
              </div>
              <span data-pagefind-meta="tags" class="sr-only">
                {[...(entry.data.tags || []), ...(entry.data.themeTags || [])].join(" ")}
              </span>
            </div>
          </div>
        )
      }

      <!-- metadata -->
      {
        !usePostCoverOverlay && (
          <div class="onload-animation">
            <PostMetadata
              className="mb-5"
              published={entry.data.published}
              updated={entry.data.updated}
              tags={entry.data.tags}
              category={entry.data.category || undefined}
              id={entry.id}
            />
            {
              !showPostCover && (
                <div class="border-(--line-divider) border-dashed border-b mt-3 mb-5" />
              )
            }
          </div>
        )
      }

      {
        showPostCover && !usePostCoverOverlay && processedImage && (
          <div class="mt-4">
            <CoverImage
              id="post-cover"
              src={processedImage}
              basePath={getFileDirFromPath(entry.filePath || "")}
              class="mb-8 rounded-xl banner-container onload-animation"
              preview={false}
              apiUrls={apiUrls}
            />
          </div>
        )
      }

      {entry.data.password ? (
        <EncryptedPost password={entry.data.password} slug={entry.id} hint={entry.data.passwordHint}>
          <Markdown class="mb-6 markdown-content onload-animation">
            <Content />
          </Markdown>

          <ShareBar
            class="mb-6"
            title={entry.data.title}
            author={profileConfig.name}
            description={entry.data.description || entry.data.title}
            pubDate={formatDateToYYYYMMDD(entry.data.published)}
            coverImage={posterCoverUrl}
            coverImageSelector={posterCoverSelector}
            pageUrl={Astro.url.href}
            siteTitle={siteConfig.title}
            avatar={posterAvatarUrl}
            avatarSelector={posterAvatarSelector}
          />

          {
            relatedHighlight && (
              <RelatedHighlight
                post={relatedHighlight}
                class="mb-6"
              />
            )
          }
        </EncryptedPost>
      ) : (
        <>
          <Markdown class="mb-6 markdown-content onload-animation">
            <Content />
          </Markdown>

          <ShareBar
            class="mb-6"
            title={entry.data.title}
            author={profileConfig.name}
            description={entry.data.description || entry.data.title}
            pubDate={formatDateToYYYYMMDD(entry.data.published)}
            coverImage={posterCoverUrl}
            coverImageSelector={posterCoverSelector}
            pageUrl={Astro.url.href}
            siteTitle={siteConfig.title}
            avatar={posterAvatarUrl}
            avatarSelector={posterAvatarSelector}
          />

          {
            relatedHighlight && (
              <RelatedHighlight
                post={relatedHighlight}
                class="mb-6"
              />
            )
          }
        </>
      )}
    </div>
  </div>

  <!-- 上次编辑时间 -->
  {
    siteConfig.post.showLastModified && (() => {
      const lastModified = dayjs(entry.data.updated || entry.data.published);
      const dateStr = lastModified.format("YYYY-MM-DD");
      const outdatedThreshold = siteConfig.post.outdatedThreshold ?? 1;

      // 1. 預設加上 hidden 隱藏，並把時間與閾值綁在 data-* 屬性
      return (
        <div 
          id="outdated-card" 
          class="card-base p-6 mb-4 hidden" 
          data-date={lastModified.toISOString()} 
          data-threshold={outdatedThreshold}
        >
          <div class="flex items-center gap-2">
            <div class="transition h-9 w-9 rounded-lg overflow-hidden relative flex items-center justify-center mr-0">
              <Icon is:inline
                name="lucide:scroll-text"
                class="text-4xl text-(--primary) transition-transform group-hover:translate-x-0.5 bg-(--enter-btn-bg) p-2 rounded-md"
              />
            </div>

            <div class="flex flex-col gap-0.1">
              <div class="text-[1.0rem] leading-tight text-black/75 dark:text-white/75">
                {i18n(I18nKey.lastModifiedPrefix)}{dateStr}
                <span id="days-ago-text" data-template={i18n(I18nKey.lastModifiedDaysAgo)}></span>
              </div>
              <p id="outdated-warning" class="text-[0.8rem] leading-tight text-black/75 dark:text-white/75 hidden">
                {i18n(I18nKey.lastModifiedOutdated)}
              </p>
            </div>
          </div>
        </div>
      );
    })()
  }

  <script>
    const card = document.getElementById('outdated-card');
    const dateStr = card?.dataset.date;

    if (card && dateStr) {
      // 讀取伺服器給的日期，用原生 Date 算出差異天數（避免向客戶端打包整個 dayjs）
      const lastModified = new Date(dateStr);
      const daysDiff = Math.floor(
        (Date.now() - lastModified.getTime()) / 86400000,
      );
      const threshold = Number(card.dataset.threshold);

      // 如果超過閾值，就顯示卡片與提示文字
      if (daysDiff >= threshold) {
        card.classList.remove('hidden');

        if (daysDiff >= 1) {
          const textEl = document.getElementById('days-ago-text');
          if (textEl && textEl.dataset.template) {
            textEl.textContent = `，${textEl.dataset.template.replace("{days}", daysDiff.toString())}`;
          }

          const warningEl = document.getElementById('outdated-warning');
          if (warningEl) {
            warningEl.classList.remove('hidden');
          }
        }
      }
    }
  </script>

  <div
    class="flex flex-col md:flex-row justify-between mb-4 gap-3 overflow-hidden w-full"
  >
    <a
      href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : url("/")}
      class="w-full overflow-hidden active:scale-95"
    >
      <div class="btn-card rounded-2xl w-full min-h-15 max-w-full px-3.5 py-2.5 flex items-center justify-start! gap-2.5">
        <Icon is:inline
          name="lucide:chevron-left"
          class="text-xl shrink-0 text-(--primary)"
        />
        <div class="overflow-hidden transition text-sm font-medium leading-snug line-clamp-2 max-w-[calc(100%-1.75rem)] text-black/75 dark:text-white/75">
          {entry.data.nextTitle || i18n(I18nKey.home)}
        </div>
      </div>
    </a>

    <a
      href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : url("/")}
      class="w-full overflow-hidden active:scale-95"
    >
      <div class="btn-card rounded-2xl w-full min-h-15 max-w-full px-3.5 py-2.5 flex items-center justify-end! gap-2.5">
        <div class="overflow-hidden transition text-sm font-medium leading-snug line-clamp-2 max-w-[calc(100%-1.75rem)] text-black/75 dark:text-white/75 text-right">
          {entry.data.prevTitle || i18n(I18nKey.home)}
        </div>
        <Icon is:inline
          name="lucide:chevron-right"
          class="text-xl shrink-0 text-(--primary)"
        />
      </div>
    </a>
  </div>

  <!-- 评论 -->
  {entry.data.comment && !entry.data.password && <Comment post={entry} />}
</MainGridLayout>
  )}

