---
/**
 * 合集总览页：只展示一级合集；二级挂在一级详情页内。
 */
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getTopLevelCollections } from "@/utils/collection-utils";

const collections = await getTopLevelCollections();
const totalPosts = collections.reduce((sum, c) => sum + c.posts.length, 0);
---

<MainGridLayout title={i18n(I18nKey.collections)} description={i18n(I18nKey.allCollections)}>
  <div class="card-base px-6 py-5 mb-4 sm:px-8 sm:py-6">
    <h1 class="collections-page__title">{i18n(I18nKey.collections)}</h1>
    <p class="collections-page__meta">
      {i18n(I18nKey.allCollections)} · {totalPosts} {i18n(I18nKey.postsCount)}
    </p>
  </div>

  {
    collections.length > 0 ? (
      <div class="collections-grid">
        {
          collections.map(({ meta, url, posts, children }) => (
            <a
              href={url}
              class:list={[
                "collection-card card-base onload-animation",
                meta.cover && "collection-card--has-cover",
              ]}
              title={`${meta.name} · ${posts.length}`}
              style={
                meta.cover
                  ? `--collection-cover: url('${meta.cover}')`
                  : undefined
              }
            >
              {
                meta.emoji && (
                  <span class="collection-card__emoji" aria-hidden="true">
                    {meta.emoji}
                  </span>
                )
              }
              <span class="collection-card__name">{meta.name}</span>
              <span class="collection-card__desc">{meta.description}</span>
              <span class="collection-card__count">
                {
                  children.length > 0 ? (
                    <>
                      {children.length} 个子合集 · {posts.length}{" "}
                      {i18n(I18nKey.postsCount)}
                    </>
                  ) : (
                    <>
                      {posts.length} {i18n(I18nKey.postsCount)}
                    </>
                  )
                }
              </span>
            </a>
          ))
        }
      </div>
    ) : (
      <div class="card-base px-8 py-12 text-center">
        <p class="text-30">{i18n(I18nKey.noData)}</p>
      </div>
    )
  }
</MainGridLayout>

<style>
  /* Hallmark · macrostructure: content registry · theme: existing-DNA + paper safety layer
   * critique: P5 H4 E5 S5 R5 V4 · contrast: pass (min 9.60:1) · mobile: pass
   */
  .collections-page__title {
    margin: 0 0 0.25rem;
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--primary);
    font-family:
      "Iowan Old Style",
      "Palatino Linotype",
      Palatino,
      "Songti SC",
      "Noto Serif SC",
      Georgia,
      serif;
  }

  .collections-page__meta {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-color-muted, oklch(0.5 0.02 70));
  }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 0.9rem;
  }

  .collection-card {
	--collection-paper: oklch(0.97 0.015 92);
	--collection-paper-2: oklch(0.93 0.022 96);
	--collection-ink: oklch(0.25 0.024 72);
	--collection-muted: oklch(0.34 0.022 76);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-height: 11.5rem;
    padding: 1.25rem 1.25rem 1.1rem;
    text-decoration: none;
    color: inherit;
    transition:
		transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
		box-shadow 0.22s cubic-bezier(0.16, 1, 0.3, 1),
		border-color 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid color-mix(in oklch, var(--line-divider) 78%, transparent);
  }

	:global(.dark) .collection-card {
		--collection-paper: oklch(0.19 0.018 82);
		--collection-paper-2: oklch(0.23 0.022 86);
		--collection-ink: oklch(0.94 0.012 92);
		--collection-muted: oklch(0.82 0.014 92);
	}

  .collection-card--has-cover::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: var(--collection-cover);
    background-size: cover;
    background-position: center top;
    transform: scale(1.02);
	filter: brightness(0.92) saturate(0.84) contrast(0.96);
	transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .collection-card--has-cover::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
	/* 图片只负责气氛，文字始终落在同一张高对比“宣纸”安全层上。 */
	background:
		linear-gradient(
			90deg,
			color-mix(in oklch, var(--collection-paper) 94%, transparent) 0%,
			color-mix(in oklch, var(--collection-paper) 88%, transparent) 58%,
			color-mix(in oklch, var(--collection-paper-2) 72%, transparent) 100%
		),
		linear-gradient(
			180deg,
			color-mix(in oklch, var(--collection-paper) 62%, transparent) 0%,
			color-mix(in oklch, var(--collection-paper) 86%, transparent) 100%
		);
	backdrop-filter: blur(1.25px) saturate(0.82);
	-webkit-backdrop-filter: blur(1.25px) saturate(0.82);
  }

  .collection-card__emoji {
    font-size: 1.6rem;
    line-height: 1;
  }

  .collection-card__name {
    font-size: 1.12rem;
    font-weight: 800;
    font-style: normal;
	color: color-mix(in oklch, var(--primary) 58%, var(--collection-ink));
    text-decoration: none;
    letter-spacing: 0.01em;
	text-shadow: none;
  }

  :global(.dark) .collection-card__name {
	color: color-mix(in oklch, var(--primary) 42%, var(--collection-ink));
  }

  .collection-card__desc {
    font-size: 0.85rem;
    line-height: 1.55;
    font-weight: 550;
	color: var(--collection-ink);
  }

  .collection-card--has-cover .collection-card__desc {
	color: var(--collection-ink);
	text-shadow: none;
  }

  :global(.dark) .collection-card__desc,
  :global(.dark) .collection-card--has-cover .collection-card__desc {
	color: var(--collection-ink);
    text-shadow: none;
  }

  .collection-card__count {
    margin-top: auto;
    padding-top: 0.35rem;
    font-size: 0.78rem;
	color: var(--collection-muted);
    font-variant-numeric: tabular-nums;
  }

  .collection-card--has-cover .collection-card__count {
    align-self: flex-start;
    margin-top: auto;
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
    font-weight: 700;
	color: var(--collection-ink);
	background: color-mix(in oklch, var(--collection-paper) 92%, transparent);
	border: 1px solid color-mix(in oklch, var(--collection-ink) 14%, transparent);
	box-shadow: 0 1px 2px color-mix(in oklch, var(--collection-ink) 9%, transparent);
  }

  :global(.dark) .collection-card--has-cover .collection-card__count {
	color: var(--collection-ink);
	background: color-mix(in oklch, var(--collection-paper-2) 90%, transparent);
	border-color: color-mix(in oklch, var(--collection-ink) 18%, transparent);
  }

  @media (hover: hover) {
    .collection-card:hover {
      transform: translateY(-2px);
      border-color: color-mix(in oklch, var(--primary) 34%, var(--line-divider));
      box-shadow: 0 0.45rem 1.1rem color-mix(in oklch, var(--primary) 10%, transparent);
    }

    .collection-card--has-cover:hover::before {
      transform: scale(1.06);
    }
  }

	.collection-card:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 3px;
	}

	.collection-card:active {
		transform: translateY(0);
	}

	@media (prefers-contrast: more) {
		.collection-card--has-cover::after {
			background: color-mix(in oklch, var(--collection-paper) 96%, transparent);
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.collection-card,
		.collection-card--has-cover::before {
			transition: none;
		}

		.collection-card:hover,
		.collection-card--has-cover:hover::before {
			transform: none;
		}
	}
</style>
