---
/**
 * 合集总览页：只展示一级合集；二级挂在一级详情页内。
 */
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getTopLevelCollections } from "@/utils/collection-utils";

const collections = await getTopLevelCollections();
const totalPosts = collections.reduce((sum, c) => sum + c.posts.length, 0);
---

<MainGridLayout title={i18n(I18nKey.collections)} description={i18n(I18nKey.allCollections)}>
  <div class="card-base px-6 py-5 mb-4 sm:px-8 sm:py-6">
    <h1 class="collections-page__title">{i18n(I18nKey.collections)}</h1>
    <p class="collections-page__meta">
      {i18n(I18nKey.allCollections)} · {totalPosts} {i18n(I18nKey.postsCount)}
    </p>
  </div>

  {
    collections.length > 0 ? (
      <div class="collections-grid">
        {
          collections.map(({ meta, url, posts, children }) => (
            <a
              href={url}
              class:list={[
                "collection-card card-base onload-animation",
                meta.cover && "collection-card--has-cover",
              ]}
              title={`${meta.name} · ${posts.length}`}
              style={
                meta.cover
                  ? `--collection-cover: url('${meta.cover}')`
                  : undefined
              }
            >
              {
                meta.emoji && (
                  <span class="collection-card__emoji" aria-hidden="true">
                    {meta.emoji}
                  </span>
                )
              }
              <span class="collection-card__name">{meta.name}</span>
              <span class="collection-card__desc">{meta.description}</span>
              <span class="collection-card__count">
                {
                  children.length > 0 ? (
                    <>
                      {children.length} 个子合集 · {posts.length}{" "}
                      {i18n(I18nKey.postsCount)}
                    </>
                  ) : (
                    <>
                      {posts.length} {i18n(I18nKey.postsCount)}
                    </>
                  )
                }
              </span>
            </a>
          ))
        }
      </div>
    ) : (
      <div class="card-base px-8 py-12 text-center">
        <p class="text-30">{i18n(I18nKey.noData)}</p>
      </div>
    )
  }
</MainGridLayout>

<style>
  .collections-page__title {
    margin: 0 0 0.25rem;
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--primary);
    font-family:
      "Iowan Old Style",
      "Palatino Linotype",
      Palatino,
      "Songti SC",
      "Noto Serif SC",
      Georgia,
      serif;
  }

  .collections-page__meta {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-color-muted, oklch(0.5 0.02 70));
  }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 0.9rem;
  }

  .collection-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-height: 11.5rem;
    padding: 1.25rem 1.25rem 1.1rem;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
    border: 1px solid color-mix(in oklch, var(--line-divider) 78%, transparent);
  }

  .collection-card--has-cover::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: var(--collection-cover);
    background-size: cover;
    background-position: center top;
    transform: scale(1.02);
    filter: brightness(1.06) saturate(1.04);
  }

  .collection-card--has-cover::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      color-mix(in oklch, var(--card-bg) 28%, transparent) 0%,
      color-mix(in oklch, var(--card-bg) 22%, transparent) 38%,
      color-mix(in oklch, var(--card-bg) 62%, transparent) 72%,
      color-mix(in oklch, var(--card-bg) 84%, transparent) 100%
    );
  }

  .collection-card__emoji {
    font-size: 1.6rem;
    line-height: 1;
  }

  .collection-card__name {
    font-size: 1.12rem;
    font-weight: 800;
    font-style: normal;
    color: color-mix(in oklch, var(--primary) 72%, oklch(0.28 0.02 70));
    text-decoration: none;
    letter-spacing: 0.01em;
    text-shadow: 0 1px 0 color-mix(in oklch, var(--card-bg) 85%, transparent);
  }

  :global(.dark) .collection-card__name {
    color: color-mix(in oklch, var(--primary) 55%, oklch(0.92 0.01 70));
  }

  .collection-card__desc {
    font-size: 0.85rem;
    line-height: 1.55;
    font-weight: 550;
    color: oklch(0.28 0.02 70);
  }

  .collection-card--has-cover .collection-card__desc {
    color: oklch(0.22 0.02 70);
    text-shadow: 0 1px 0 color-mix(in oklch, var(--card-bg) 90%, transparent);
  }

  :global(.dark) .collection-card__desc,
  :global(.dark) .collection-card--has-cover .collection-card__desc {
    color: oklch(0.88 0.01 70);
    text-shadow: none;
  }

  .collection-card__count {
    margin-top: auto;
    padding-top: 0.35rem;
    font-size: 0.78rem;
    color: oklch(0.32 0.02 70);
    font-variant-numeric: tabular-nums;
  }

  .collection-card--has-cover .collection-card__count {
    align-self: flex-start;
    margin-top: auto;
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
    font-weight: 700;
    color: oklch(0.2 0.02 70);
    background: color-mix(in oklch, white 92%, var(--card-bg));
    border: 1px solid color-mix(in oklch, black 12%, transparent);
    box-shadow: 0 1px 2px color-mix(in oklch, black 10%, transparent);
  }

  :global(.dark) .collection-card--has-cover .collection-card__count {
    color: oklch(0.92 0.01 70);
    background: color-mix(in oklch, var(--card-bg) 88%, black);
    border-color: color-mix(in oklch, white 18%, transparent);
  }

  @media (hover: hover) {
    .collection-card:hover {
      transform: translateY(-2px);
      border-color: color-mix(in oklch, var(--primary) 34%, var(--line-divider));
      box-shadow: 0 0.45rem 1.1rem color-mix(in oklch, var(--primary) 10%, transparent);
    }

    .collection-card--has-cover:hover::before {
      transform: scale(1.06);
      transition: transform 0.35s ease;
    }
  }
</style>
