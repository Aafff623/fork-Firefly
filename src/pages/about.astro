---

import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
    <div class="about-shell flex w-full overflow-hidden relative min-h-32">
        <div class="about-panel z-10 relative w-full">
            <Markdown class="about-md mt-1">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>

<style>
  .about-shell {
    border-radius: 0.35rem;
  }

  .about-panel {
    background: var(--card-bg);
    border: 1px solid color-mix(in oklab, var(--line-color), transparent);
    border-radius: 0.35rem;
    padding: 1.35rem 1.5rem 1.75rem;
  }

  @media (min-width: 768px) {
    .about-panel {
      padding: 1.75rem 2.25rem 2.25rem;
    }
  }

  :global(.about-md .about-mast) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 1.25rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid color-mix(in oklab, var(--line-color), transparent);
    font-family: ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--content-meta) 80%, transparent);
  }

  :global(.about-md .about-pull) {
    margin: 0 0 1.5rem;
    padding: 0 0 1.1rem;
    border: 0;
    border-bottom: 3px solid var(--primary);
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--deep-text);
    quotes: none;
  }

  :global(.about-md .about-pull p) {
    margin: 0;
  }

  :global(.about-md .about-strike) {
    text-decoration: line-through;
    color: color-mix(in oklab, var(--content-meta) 70%, transparent);
    font-weight: 500;
  }

  :global(.about-md h2) {
    font-family: ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    color: var(--primary);
    margin-top: 1.75rem;
    margin-bottom: 0.65rem;
    border: 0;
    padding: 0;
  }

  :global(.about-md h2:first-of-type) {
    margin-top: 0.25rem;
  }

  :global(.about-md h3) {
    font-size: 1.05rem;
    font-weight: 650;
    margin: 0.35rem 0 0.55rem;
    color: var(--deep-text);
  }

  :global(.about-md .about-hero-img) {
    float: right;
    width: min(42%, 15.5rem);
    max-width: 15.5rem;
    margin: 0 0 0.85rem 1.1rem;
    border-radius: 0.65rem;
    border: 1px solid color-mix(in oklab, var(--line-color), transparent);
    box-shadow: 0 10px 28px color-mix(in oklab, var(--deep-text) 8%, transparent);
    object-fit: cover;
  }

  @media (max-width: 640px) {
    :global(.about-md .about-hero-img) {
      float: none;
      display: block;
      width: min(100%, 16rem);
      max-width: 16rem;
      margin: 0 auto 1rem;
    }
  }

  :global(.about-md .about-reach) {
    clear: both;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0 0 0.35rem;
  }

  :global(.about-md .about-reach a) {
    display: inline-flex;
    align-items: center;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--primary) 28%, var(--line-color));
    background: color-mix(in oklab, var(--primary) 7%, var(--card-bg));
    color: var(--deep-text);
    font-size: 0.82rem;
    font-weight: 550;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  :global(.about-md .about-reach a:hover) {
    background: color-mix(in oklab, var(--primary) 14%, var(--card-bg));
    border-color: color-mix(in oklab, var(--primary) 45%, var(--line-color));
  }

  :global(.about-md table) {
    width: 100%;
    display: table;
    font-size: 0.92rem;
    border-collapse: collapse;
    margin: 0.65rem 0 1rem;
  }

  :global(.about-md table th),
  :global(.about-md table td) {
    border: 1px solid color-mix(in oklab, var(--line-color), transparent);
    padding: 0.45rem 0.65rem;
    vertical-align: top;
  }

  :global(.about-md table th) {
    background: color-mix(in oklab, var(--primary) 8%, var(--card-bg));
    font-weight: 600;
    white-space: nowrap;
  }

  :global(.about-md .about-banner) {
    display: block;
    width: 100%;
    margin: 0.75rem 0 0;
    border-radius: 0.4rem;
    border: 1px solid color-mix(in oklab, var(--line-color), transparent);
  }

  :global(.about-md .about-stats) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: flex-start;
    margin: 0.5rem 0 0;
  }

  :global(.about-md .about-stats img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.4rem;
    border: 1px solid color-mix(in oklab, var(--line-color), transparent);
    background: #fff;
  }

  :global(.about-md .markdown-alert),
  :global(.about-md .callout) {
    margin: 0.75rem 0 1rem;
  }
</style>
