---
import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import FlipComicBook from "@/components/pages/about/FlipComicBook.astro";
import RotatingPopCard from "@/components/pages/about/RotatingPopCard.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const aboutPost = await getEntry("spec", "about");
const aboutSitePost = await getEntry("spec", "about-site");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
const siteRendered = aboutSitePost ? await render(aboutSitePost) : null;
const SiteContent = siteRendered?.Content;
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
    <div class="about-shell flex w-full relative min-h-32">
        <div class="about-panel card-base z-10 relative w-full overflow-hidden">
            <p class="about-mast"><span>THREETWOA</span><span>ABOUT · 2026</span></p>

            <div class="about-intro hero-bg">
              <div class="about-intro-body">
                <blockquote class="about-pull">
                  少写一点代码，多留一点能复用的结构。<br />
                  <span class="about-strike">把工具当玩具</span> · 真要上线，merge 归我。
                </blockquote>
                <RotatingPopCard />
              </div>
            </div>

            <Markdown class="about-md mt-1">
                <Content />
            </Markdown>

            <!-- GitHub Stats 正下方：3D 翻页漫画 -->
            <FlipComicBook />

            {SiteContent && (
              <Markdown class="about-md mt-2">
                <SiteContent />
              </Markdown>
            )}
        </div>
    </div>
</MainGridLayout>

<style>
  .about-shell {
    border-radius: 0.35rem;
    overflow: visible;
  }

  /* 外层大卡片：card-base 供底，与友链/留言同结构 */
  .about-panel {
    padding: 1.35rem 1.5rem 1.75rem;
  }

  @media (min-width: 768px) {
    .about-panel {
      padding: 1.75rem 2.25rem 2.25rem;
    }
  }

  .about-mast {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 1.25rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid color-mix(in oklab, var(--line-color), transparent);
    font-family: ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--content-meta) 80%, transparent);
  }

  /* 顶部氛围带：hero-bg 共享层铺骑士少女底图，坐在大卡片内的圆角带 */
  .about-intro {
    --hero-img: url("/assets/hero/about-hero.gif");
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 0 0 1.5rem;
    padding: 1.1rem 1.15rem 1.25rem;
    border: 0;
    border-radius: 0.65rem;
    overflow: hidden;
  }

  .about-intro-body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .about-intro-body :global(.about-pop-card) {
    margin-left: -0.35rem;
  }

  .about-pull {
    flex: none;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--deep-text);
    quotes: none;
    text-shadow: 0 1px 12px color-mix(in oklab, var(--card-bg) 88%, transparent);
  }

  .about-pull :global(p) {
    margin: 0;
  }

  .about-strike {
    text-decoration: line-through;
    color: color-mix(in oklab, var(--content-meta) 70%, transparent);
    font-weight: 500;
  }

  :global(.about-md h2) {
    font-family: ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    color: var(--primary);
    margin-top: 1.75rem;
    margin-bottom: 0.65rem;
    border: 0;
    padding: 0;
  }

  :global(.about-md h2:first-of-type) {
    margin-top: 0.25rem;
  }

  :global(.about-md h3) {
    font-size: 1.05rem;
    font-weight: 650;
    margin: 0.35rem 0 0.55rem;
    color: var(--deep-text);
  }

  /* 简介：网格分栏，禁止 float 压图 */
  :global(.about-md .about-bio) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) min(15.5rem, 36%);
    gap: 1.25rem 1.5rem;
    align-items: start;
    margin: 0 0 0.5rem;
  }

  :global(.about-md .about-bio__copy) {
    min-width: 0;
  }

  :global(.about-md .about-bio__copy > p) {
    margin: 0 0 0.85rem;
    line-height: 1.75;
    text-align: start;
  }

  :global(.about-md .about-bio__copy > p:last-child) {
    margin-bottom: 0;
  }

  :global(.about-md .about-bio__figure) {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  :global(.about-md .about-bio__photo) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.65rem;
    border: 1px solid color-mix(in oklab, var(--line-color), transparent);
    box-shadow: 0 8px 22px color-mix(in oklab, var(--deep-text) 7%, transparent);
    object-fit: cover;
    cursor: zoom-in;
  }

  @media (max-width: 720px) {
    :global(.about-md .about-bio) {
      grid-template-columns: 1fr;
    }

    :global(.about-md .about-bio__figure) {
      order: -1;
      max-width: 14rem;
      justify-self: center;
    }
  }

  :global(.about-md .about-reach) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.15rem 0 0;
  }

  :global(.about-md .about-reach a) {
    display: inline-flex;
    align-items: center;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--primary) 28%, var(--line-color));
    background: color-mix(in oklab, var(--primary) 7%, var(--card-bg));
    color: var(--deep-text);
    font-size: 0.82rem;
    font-weight: 550;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  :global(.about-md .about-reach a:hover) {
    background: color-mix(in oklab, var(--primary) 14%, var(--card-bg));
    border-color: color-mix(in oklab, var(--primary) 45%, var(--line-color));
  }

  :global(.about-md table) {
    width: 100%;
    display: table;
    font-size: 0.92rem;
    border-collapse: collapse;
    margin: 0.65rem 0 1rem;
  }

  :global(.about-md table th),
  :global(.about-md table td) {
    border: 1px solid color-mix(in oklab, var(--line-color), transparent);
    padding: 0.45rem 0.65rem;
    vertical-align: top;
  }

  :global(.about-md table th) {
    background: color-mix(in oklab, var(--primary) 8%, var(--card-bg));
    font-weight: 600;
    white-space: nowrap;
  }

  :global(.about-md .about-banner) {
    display: block;
    width: 100%;
    margin: 0.75rem 0 0;
    border-radius: 0.4rem;
    border: 1px solid color-mix(in oklab, var(--line-color), transparent);
  }

  :global(.about-md .about-stats) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: flex-start;
    margin: 0.5rem 0 0;
  }

  :global(.about-md .about-stats img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.4rem;
    border: 1px solid color-mix(in oklab, var(--line-color), transparent);
    background: #fff;
  }

  :global(.about-md .markdown-alert),
  :global(.about-md .callout) {
    margin: 0.75rem 0 1rem;
  }
</style>
