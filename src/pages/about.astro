---
import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import GitHubProfile from "@/components/pages/about/GitHubProfile.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/github-profile.css";

const aboutSitePost = await getEntry("spec", "about-site");
const siteRendered = aboutSitePost ? await render(aboutSitePost) : null;
const SiteContent = siteRendered?.Content;
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
	<div class="about-shell w-full relative min-h-32">
		<GitHubProfile />
		{
			SiteContent && (
				<div class="gh-site-note">
					<Markdown class="about-md">
						<SiteContent />
					</Markdown>
				</div>
			)
		}
	</div>
</MainGridLayout>
