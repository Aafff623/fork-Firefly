---
import { getEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "@components/common/Markdown.astro";
import AboutIntroBlocks from "@/components/pages/about/AboutIntroBlocks.astro";
import AboutPracticeBlock from "@/components/pages/about/AboutPracticeBlock.astro";
import FlipComicBook from "@/components/pages/about/FlipComicBook.astro";
import RotatingPopCard from "@/components/pages/about/RotatingPopCard.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const aboutAgentPost = await getEntry("spec", "about-agent");
const aboutRestPost = await getEntry("spec", "about-rest");
const aboutSitePost = await getEntry("spec", "about-site");

if (!aboutAgentPost || !aboutRestPost) {
	throw new Error("About page content not found (about-agent / about-rest)");
}

const { Content: AgentContent } = await render(aboutAgentPost);
const { Content: RestContent } = await render(aboutRestPost);
const siteRendered = aboutSitePost ? await render(aboutSitePost) : null;
const SiteContent = siteRendered?.Content;

const statsLight =
	"https://github-readme-stats-sigma-five.vercel.app/api?username=Aafff623&show_icons=true&bg_color=ffffff&title_color=0969da&text_color=1f2328&icon_color=f59e0b&hide=prs,issues&count_private=true&hide_border=false&border_color=d1d9e0&card_width=500";
const statsDark =
	"https://github-readme-stats-sigma-five.vercel.app/api?username=Aafff623&show_icons=true&bg_color=0d1117&title_color=c9d1d9&text_color=adbac7&icon_color=f59e0b&hide=prs,issues&count_private=true&hide_border=false&border_color=30363d&card_width=500";
const langsLight =
	"https://github-readme-stats-sigma-five.vercel.app/api/top-langs/?username=Aafff623&layout=compact&bg_color=ffffff&title_color=0969da&text_color=1f2328&icon_color=f59e0b&hide=prs,issues&count_private=true&hide_border=false&border_color=d1d9e0&card_width=320";
const langsDark =
	"https://github-readme-stats-sigma-five.vercel.app/api/top-langs/?username=Aafff623&layout=compact&bg_color=0d1117&title_color=c9d1d9&text_color=adbac7&icon_color=f59e0b&hide=prs,issues&count_private=true&hide_border=false&border_color=30363d&card_width=320";

const headingIcons = [
	{ key: "02 · Agent workflow", icon: "lucide:bot" },
	{ key: "03.5 · Currently building", icon: "lucide:hammer" },
	{ key: "04 · Competitions", icon: "lucide:trophy" },
	{ key: "05 · Classic project", icon: "lucide:briefcase" },
	{ key: "06 · Learning", icon: "lucide:graduation-cap" },
	{ key: "关于本站", icon: "lucide:globe" },
] as const;
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
    <div class="about-shell flex w-full relative min-h-32">
        <div class="about-panel card-base z-10 relative w-full overflow-hidden">
            <p class="about-mast"><span>THREETWOA</span><span>ABOUT · 2026</span></p>

            <div
              class="about-intro hero-bg"
              data-about-hero
              data-hero-poster="/assets/hero/about-hero-poster.webp"
              data-hero-gif="/assets/hero/about-hero.gif"
              style="--hero-img: url(/assets/hero/about-hero-poster.webp)"
            >
              <div class="about-intro-body">
                <blockquote class="about-pull">
                  少写一点代码，多留一点可复用的结构。<br />
                  工具负责加速；关键取舍，我来拍板。
                </blockquote>
                <RotatingPopCard />
              </div>
            </div>

            <div class="about-md mt-1">
              <AboutIntroBlocks />

              <Markdown class="about-md">
                <AgentContent />
              </Markdown>

              <AboutPracticeBlock />

              <Markdown class="about-md">
                <RestContent />
              </Markdown>
            </div>

            <FlipComicBook />

            <section class="about-stats-block" aria-labelledby="about-stats-heading">
              <h2 id="about-stats-heading" class="about-section-title" data-about-h2="07 · Stats" data-accent="5">
                <Icon is:inline name="lucide:bar-chart-3" class="about-h2-icon" aria-hidden="true" />
                <span>07 · Stats</span>
              </h2>
              <p class="about-stats">
                <img
                  class="about-stats__light"
                  src={statsLight}
                  alt="GitHub stats"
                  loading="lazy"
                  decoding="async"
                  width="500"
                  height="165"
                />
                <img
                  class="about-stats__dark"
                  src={statsDark}
                  alt="GitHub stats"
                  loading="lazy"
                  decoding="async"
                  width="500"
                  height="165"
                />
                <img
                  class="about-stats__light"
                  src={langsLight}
                  alt="Top languages"
                  loading="lazy"
                  decoding="async"
                  width="320"
                  height="165"
                />
                <img
                  class="about-stats__dark"
                  src={langsDark}
                  alt="Top languages"
                  loading="lazy"
                  decoding="async"
                  width="320"
                  height="165"
                />
              </p>
            </section>

            {SiteContent && (
              <Markdown class="about-md mt-2">
                <SiteContent />
              </Markdown>
            )}

            <!-- MD 章节标题图标库：注入到尚无 .about-h2-icon 的 h2 -->
            <div class="about-icon-bank" hidden aria-hidden="true">
              {
                headingIcons.map((item) => (
                  <template data-about-icon-for={item.key}>
                    <Icon is:inline name={item.icon} class="about-h2-icon" />
                  </template>
                ))
              }
            </div>
        </div>
    </div>
</MainGridLayout>

<script>
  function hydrateAboutHero(root: Element) {
    if (!(root instanceof HTMLElement) || root.dataset.heroHydrated === "1") return;
    const poster = root.dataset.heroPoster;
    const gif = root.dataset.heroGif;
    if (!poster || !gif) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      root.style.setProperty("--hero-img", `url(${poster})`);
      root.dataset.heroHydrated = "1";
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        const img = new Image();
        img.decoding = "async";
        img.onload = () => {
          root.style.setProperty("--hero-img", `url(${gif})`);
          root.dataset.heroHydrated = "1";
        };
        img.src = gif;
        io.disconnect();
      },
      { rootMargin: "80px" },
    );
    io.observe(root);
  }

  function injectHeadingIcons() {
    const panel = document.querySelector(".about-panel");
    if (!(panel instanceof HTMLElement)) return;

    panel.querySelectorAll(".about-md h2").forEach((h2) => {
      if (!(h2 instanceof HTMLElement)) return;
      if (h2.querySelector(".about-h2-icon")) return;
      const key = (h2.textContent || "").trim();
      const tpl = panel.querySelector(
        `template[data-about-icon-for="${CSS.escape(key)}"]`,
      );
      if (!(tpl instanceof HTMLTemplateElement)) return;
      const icon = tpl.content.cloneNode(true);
      const label = document.createElement("span");
      label.textContent = key;
      h2.replaceChildren();
      h2.append(icon, label);
      h2.classList.add("about-section-title");
    });
  }

  function initAboutPage() {
    document.querySelectorAll("[data-about-hero]").forEach(hydrateAboutHero);
    injectHeadingIcons();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAboutPage);
  } else {
    initAboutPage();
  }
  document.addEventListener("swup:contentReplaced", () => setTimeout(initAboutPage, 30));
</script>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=ZCOOL+XiaoWei&display=swap");

  .about-shell {
    border-radius: 0.35rem;
    overflow: visible;
  }

  .about-panel {
    padding: 1.35rem 1.5rem 1.75rem;
    /* 主题色仍跟站点 --primary（紫），辅色系拉开层次 */
    --about-a0: #0d9488; /* teal */
    --about-a1: #d97706; /* amber */
    --about-a2: #7c3aed; /* violet · 主题锚 */
    --about-a3: #0284c7; /* sky */
    --about-a4: #e11d48; /* rose */
    --about-a5: #65a30d; /* lime */
  }

  :global(:root.dark) .about-panel {
    --about-a0: #2dd4bf;
    --about-a1: #fbbf24;
    --about-a2: #a78bfa;
    --about-a3: #38bdf8;
    --about-a4: #fb7185;
    --about-a5: #a3e635;
  }

  @media (min-width: 768px) {
    .about-panel {
      padding: 1.75rem 2.25rem 2.25rem;
    }
  }

  .about-mast {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 1.25rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid color-mix(in oklab, var(--line-color), transparent);
    font-family: ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--content-meta) 80%, transparent);
  }

  .about-intro {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 0 0 1.5rem;
    padding: 1.1rem 1.15rem 1.25rem;
    border: 0;
    border-radius: 0.65rem;
    overflow: hidden;
  }

  .about-intro-body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .about-intro-body :global(.about-pop-card) {
    margin-left: -0.35rem;
  }

  .about-pull {
    flex: none;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    font-family: "Ma Shan Zheng", "ZCOOL XiaoWei", "Songti SC", serif;
    font-size: clamp(1.55rem, 3.2vw, 2.15rem);
    line-height: 1.45;
    letter-spacing: 0.04em;
    font-weight: 400;
    color: var(--deep-text);
    quotes: none;
    text-shadow: 0 1px 12px color-mix(in oklab, var(--card-bg) 88%, transparent);
  }

  .about-section-title,
  :global(.about-md h2) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    color: var(--about-section-accent, var(--about-a2, var(--primary)));
    margin-top: 1.75rem;
    margin-bottom: 0.65rem;
    border: 0;
    padding: 0;
  }

  .about-section-title[data-accent="0"],
  :global(.about-md h2:nth-of-type(6n + 1)) {
    --about-section-accent: var(--about-a0);
  }
  .about-section-title[data-accent="1"],
  :global(.about-md h2:nth-of-type(6n + 2)) {
    --about-section-accent: var(--about-a1);
  }
  .about-section-title[data-accent="2"],
  :global(.about-md h2:nth-of-type(6n + 3)) {
    --about-section-accent: var(--about-a2);
  }
  .about-section-title[data-accent="3"],
  :global(.about-md h2:nth-of-type(6n + 4)) {
    --about-section-accent: var(--about-a3);
  }
  .about-section-title[data-accent="4"],
  :global(.about-md h2:nth-of-type(6n + 5)) {
    --about-section-accent: var(--about-a4);
  }
  .about-section-title[data-accent="5"],
  :global(.about-md h2:nth-of-type(6n)) {
    --about-section-accent: var(--about-a5);
  }

  :global(.about-h2-icon) {
    width: 1.05em;
    height: 1.05em;
    flex-shrink: 0;
    color: currentColor;
  }

  :global(.about-md h2:first-of-type) {
    margin-top: 0.25rem;
  }

  .about-stats-block .about-section-title {
    margin-top: 0.85rem;
  }

  :global(.about-md h3) {
    font-size: 1.05rem;
    font-weight: 650;
    margin: 0.35rem 0 0.55rem;
    color: var(--deep-text);
  }

  :global(.about-bio) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) min(15.5rem, 36%);
    gap: 1.25rem 1.5rem;
    align-items: start;
    margin: 0 0 0.5rem;
  }

  :global(.about-bio__copy) {
    min-width: 0;
    color: var(--deep-text);
  }

  :global(.about-bio__copy > p) {
    margin: 0 0 0.85rem;
    line-height: 1.75;
    text-align: start;
    color: var(--deep-text);
  }

  :global(.about-bio__copy > p:last-child) {
    margin-bottom: 0;
  }

  :global(.about-bio__figure) {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  :global(.about-bio__photo) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.65rem;
    border: 1px solid color-mix(in oklab, var(--line-color), transparent);
    box-shadow: 0 8px 22px color-mix(in oklab, var(--deep-text) 7%, transparent);
    object-fit: cover;
    cursor: zoom-in;
  }

  @media (max-width: 720px) {
    :global(.about-bio) {
      grid-template-columns: 1fr;
    }

    :global(.about-bio__figure) {
      order: -1;
      max-width: 14rem;
      justify-self: center;
    }
  }

  :global(.about-reach) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.15rem 0 0;
  }

  :global(.about-reach a) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--chip-accent, var(--about-a2)) 32%, var(--line-color));
    background: color-mix(in oklab, var(--chip-accent, var(--about-a2)) 8%, var(--card-bg));
    color: var(--deep-text);
    font-size: 0.82rem;
    font-weight: 550;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  :global(.about-reach a:nth-child(6n + 1)) { --chip-accent: var(--about-a2); }
  :global(.about-reach a:nth-child(6n + 2)) { --chip-accent: var(--about-a0); }
  :global(.about-reach a:nth-child(6n + 3)) { --chip-accent: var(--about-a3); }
  :global(.about-reach a:nth-child(6n + 4)) { --chip-accent: var(--about-a1); }
  :global(.about-reach a:nth-child(6n + 5)) { --chip-accent: var(--about-a4); }
  :global(.about-reach a:nth-child(6n + 6)) { --chip-accent: var(--about-a5); }

  :global(.about-reach a:hover) {
    background: color-mix(in oklab, var(--chip-accent, var(--about-a2)) 16%, var(--card-bg));
    border-color: color-mix(in oklab, var(--chip-accent, var(--about-a2)) 50%, var(--line-color));
  }

  :global(.about-reach__icon) {
    width: 0.95em;
    height: 0.95em;
    color: var(--chip-accent, var(--about-a2));
  }

  :global(.about-block__lead) {
    margin: 0 0 0.65rem;
    color: color-mix(in oklab, var(--content-meta) 92%, transparent);
    font-size: 0.92rem;
  }

  :global(.about-icon-list) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  :global(.about-icon-row) {
    --row-accent: var(--about-a2);
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.7rem;
    align-items: start;
    padding: 0.65rem 0.75rem;
    border-radius: 0.55rem;
    border: 1px solid color-mix(in oklab, var(--row-accent) 22%, var(--line-color));
    background: color-mix(in oklab, var(--row-accent) 6%, var(--card-bg));
  }

  :global(.about-icon-row[data-accent="0"]) { --row-accent: var(--about-a0); }
  :global(.about-icon-row[data-accent="1"]) { --row-accent: var(--about-a1); }
  :global(.about-icon-row[data-accent="2"]) { --row-accent: var(--about-a2); }
  :global(.about-icon-row[data-accent="3"]) { --row-accent: var(--about-a3); }
  :global(.about-icon-row[data-accent="4"]) { --row-accent: var(--about-a4); }
  :global(.about-icon-row[data-accent="5"]) { --row-accent: var(--about-a5); }

  :global(.about-icon-row__glyph) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.45rem;
    background: color-mix(in oklab, var(--row-accent) 16%, var(--card-bg));
    color: var(--row-accent);
  }

  :global(.about-icon-row__glyph svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  :global(.about-icon-row__body) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  :global(.about-icon-row__body strong) {
    font-size: 0.92rem;
    color: var(--deep-text);
  }

  :global(.about-icon-row__body span) {
    font-size: 0.88rem;
    line-height: 1.55;
    color: color-mix(in oklab, var(--content-meta) 95%, transparent);
  }

  :global(.about-aside) {
    --row-accent: var(--about-a1);
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    margin: 0.85rem 0 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: color-mix(in oklab, var(--content-meta) 95%, transparent);
  }

  :global(.about-aside[data-accent="0"]) { --row-accent: var(--about-a0); }
  :global(.about-aside[data-accent="1"]) { --row-accent: var(--about-a1); }

  :global(.about-aside__glyph) {
    display: inline-flex;
    margin-top: 0.15rem;
    color: var(--row-accent);
  }

  :global(.about-aside__glyph svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  :global(.about-md table) {
    width: 100%;
    display: table;
    font-size: 0.92rem;
    border-collapse: collapse;
    margin: 0.65rem 0 1rem;
  }

  :global(.about-md table th),
  :global(.about-md table td) {
    border: 1px solid color-mix(in oklab, var(--line-color), transparent);
    padding: 0.45rem 0.65rem;
    vertical-align: top;
  }

  :global(.about-md table th) {
    background: color-mix(in oklab, var(--about-a3) 10%, var(--card-bg));
    font-weight: 600;
    white-space: nowrap;
  }

  :global(.about-md .about-banner) {
    display: block;
    width: 100%;
    margin: 0.75rem 0 0;
    border-radius: 0.4rem;
    border: 1px solid color-mix(in oklab, var(--line-color), transparent);
  }

  :global(.about-md .about-stack) {
    margin: 0.75rem 0 1rem;
    padding: 0.55rem 0.85rem;
    border-radius: 0.55rem;
    border: 1px solid color-mix(in oklab, var(--about-a0) 28%, var(--line-color));
    background: color-mix(in oklab, var(--about-a0) 6%, var(--card-bg));
  }

  :global(.about-md .about-stack > summary) {
    cursor: pointer;
    font-family: ui-monospace, "JetBrains Mono", Menlo, Consolas, monospace;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--about-a0);
    font-weight: 600;
    list-style: none;
  }

  :global(.about-md .about-stack > summary::-webkit-details-marker) {
    display: none;
  }

  :global(.about-md .about-stack > summary::before) {
    content: "▸ ";
  }

  :global(.about-md .about-stack[open] > summary::before) {
    content: "▾ ";
  }

  :global(.about-md .about-stack[open] > summary) {
    margin-bottom: 0.45rem;
  }

  /* Agent tip callout：青绿强调，跳出紫色 */
  :global(.about-md .markdown-alert),
  :global(.about-md .callout) {
    margin: 0.75rem 0 1rem;
    border-left-color: var(--about-a0);
  }

  .about-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: flex-start;
    margin: 0.5rem 0 0;
  }

  .about-stats img {
    max-width: 100%;
    height: auto;
    border-radius: 0.4rem;
    border: 1px solid color-mix(in oklab, var(--line-color), transparent);
  }

  .about-stats__dark {
    display: none;
  }

  :global(:root.dark) .about-stats__light {
    display: none;
  }

  :global(:root.dark) .about-stats__dark {
    display: inline;
    background: #0d1117;
  }
</style>
