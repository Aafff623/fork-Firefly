# 评论附图上传：优先 Cloudflare R2，其次腾讯云 COS（仅服务端，勿加 PUBLIC_）

# —— Cloudflare R2（推荐 · 免出站）——
# 控制台：https://dash.cloudflare.com → R2
# Account ID 在 R2 概览右侧；API Token：Manage R2 API Tokens → Create
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=firefly-comment
# 公网读地址（无尾斜杠）。生产用自定义域；过渡可用 r2.dev 公网域
# https://img.threetwoa.live
R2_PUBLIC_BASE_URL=

# —— 腾讯云 COS（回退；R2 配齐后可不填）——
# 控制台：https://console.cloud.tencent.com/cos
COS_SECRET_ID=
COS_SECRET_KEY=
# 形如 bucket-1250000000（名称-APPID）
COS_BUCKET=
# 推荐与读者近的大陆地域，如 ap-guangzhou / ap-shanghai / ap-beijing
COS_REGION=ap-guangzhou
# 可选：自定义域名或 CDN 域名（无尾斜杠）。空则用默认
# https://{bucket}.cos.{region}.myqcloud.com
COS_PUBLIC_BASE_URL=

# 评论梗图联想 · DeepSeek 官网直连（仅服务端；P1 agentEnabled=true 时用）
# 文档：https://api-docs.deepseek.com
# OpenAI 兼容 base_url：https://api.deepseek.com
DEEPSEEK_API_KEY=
# 可选，默认 https://api.deepseek.com
# DEEPSEEK_API_BASE=https://api.deepseek.com
# 可选，默认 deepseek-v4-flash（关 thinking；低延迟）
# DEEPSEEK_MODEL=deepseek-v4-flash

# 本地问答 /ask 与桌宠浮窗（仅 DEV；生产 siteConfig.pages.ask=false）
# MaxKB 本机 Docker 默认 http://127.0.0.1:8080/chat/api
MAXKB_ACCESS_TOKEN=
# MAXKB_API_BASE=http://127.0.0.1:8080/chat/api
